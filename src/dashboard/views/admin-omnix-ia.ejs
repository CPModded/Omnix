<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Omnix IA — Administration</title>
<link rel="stylesheet" href="/css/omnix-web.css">
<style>
:root{color-scheme:dark;--bg:#08070e;--panel:#100e19;--panel2:#151222;--line:#29233b;--text:#f6f3ff;--muted:#a39bb8;--purple:#8b5cf6;--purple2:#6d3df5;--green:#51d6a4}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#29184c 0,transparent 44%),var(--bg);color:var(--text);font:14px Inter,system-ui,-apple-system,sans-serif}.shell{height:100dvh;min-height:620px;display:grid;grid-template-columns:290px minmax(0,1fr);overflow:hidden}.rail{display:flex;flex-direction:column;min-width:0;background:#0c0a13ed;border-right:1px solid var(--line);padding:17px 13px;gap:13px}.brand{display:flex;align-items:center;gap:10px;padding:5px 5px 15px;border-bottom:1px solid #ffffff0d}.brand-mark{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,#a78bfa,#6d3df5);font-weight:900;font-size:19px;box-shadow:0 8px 24px #7c3aed35}.brand strong{font-size:15px;letter-spacing:.05em}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:3px}.back{display:flex;gap:8px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:11px;color:#ddd3ff;text-decoration:none;background:#ffffff03}.new{background:linear-gradient(120deg,#8b5cf6,#7041dc);border:0;border-radius:11px;padding:12px;color:white;font-weight:800;cursor:pointer}.search{width:100%;padding:11px 12px;background:#171321;border:1px solid var(--line);border-radius:10px;color:white;outline:none}.search:focus,textarea:focus{border-color:#8b5cf6}.rail-title{display:flex;align-items:center;justify-content:space-between;color:#817992;font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.12em;padding:2px 5px}.history{flex:1;overflow:auto;min-height:80px}.session{padding:11px;border-radius:10px;margin:3px 0;cursor:pointer;border:1px solid transparent;overflow:hidden}.session:hover{background:#ffffff08}.session.active{background:#8b5cf61c;border-color:#8b5cf64a}.session b{display:block;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.session small{display:block;color:var(--muted);font-size:10px;margin-top:5px}.rail-foot{font-size:10px;line-height:1.55;color:#817992;padding:12px;border:1px solid #ffffff0c;border-radius:11px;background:#ffffff03}.main{min-width:0;display:flex;flex-direction:column}.top{height:72px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:0 25px;border-bottom:1px solid var(--line);background:#0908118a}.heading{display:flex;align-items:center;gap:11px}.heading h1{font-size:16px;margin:0}.heading p{font-size:11px;color:var(--muted);margin:4px 0 0}.status{font-size:11px;color:var(--green);display:flex;align-items:center;gap:6px}.dot{width:7px;height:7px;background:var(--green);border-radius:50%;box-shadow:0 0 10px #51d6a45c}.stats{display:grid;grid-template-columns:repeat(3,minmax(100px,1fr));gap:9px;padding:13px 22px;border-bottom:1px solid #ffffff0b}.stat{padding:10px 13px;border:1px solid #ffffff0c;border-radius:12px;background:#ffffff03;min-width:0}.stat span{display:block;color:var(--muted);font-size:10px;margin-bottom:6px}.stat strong{font-size:17px;letter-spacing:-.02em}.stat em{font-style:normal;color:#a78bfa;font-size:10px;margin-left:5px}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 285px;flex:1;min-height:0}.conversation{display:flex;flex-direction:column;min-width:0;min-height:0;border-right:1px solid #ffffff0b}.chat{flex:1;overflow:auto;padding:25px max(20px,calc((100% - 850px)/2));scroll-behavior:smooth}.welcome{max-width:720px;margin:7vh auto 30px;text-align:center}.welcome-mark{width:54px;height:54px;margin:auto auto 18px;border-radius:18px;background:linear-gradient(145deg,#a78bfa,#6d3df5);display:grid;place-items:center;font-size:25px;box-shadow:0 12px 38px #6d3df538}.welcome h2{font-size:24px;letter-spacing:-.04em;margin:0 0 10px}.welcome p{color:var(--muted);font-size:13px;line-height:1.7;max-width:510px;margin:auto}.suggestions{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:23px}.suggestions button{border:1px solid #38304e;background:#15111f;color:#d8cef7;border-radius:12px;padding:10px 12px;cursor:pointer;font-size:11px}.msg{display:flex;gap:12px;max-width:850px;margin:0 auto 23px;align-items:flex-start}.avatar{width:30px;height:30px;flex:0 0 30px;display:grid;place-items:center;border-radius:10px;background:#24183c;color:#c4b5fd;font-weight:900}.msg.user .avatar{background:#20202d;color:#eee}.msg-body{min-width:0;flex:1}.msg-role{font-size:11px;color:#a89dbd;font-weight:800;margin:2px 0 8px}.msg-content{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.75;color:#e8e3f4}.msg.user .msg-content{color:#fff}.composer-wrap{padding:12px 20px 17px;border-top:1px solid #ffffff0b;background:#0b0912}.composer{max-width:850px;margin:auto;border:1px solid #3a304f;background:#15111f;border-radius:17px;padding:10px;box-shadow:0 12px 35px #0003}.composer textarea{width:100%;display:block;min-height:50px;max-height:190px;resize:vertical;border:1px solid transparent;background:transparent;color:white;padding:8px 9px;outline:none;font:13px/1.6 inherit}.composer-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:5px 3px 1px}.hint{color:#817992;font-size:10px}.send{border:0;border-radius:10px;background:var(--purple);color:white;font-weight:850;padding:10px 15px;cursor:pointer}.send:disabled{opacity:.5;cursor:wait}.inspector{min-width:0;overflow:auto;padding:17px 14px;background:#0c0a13a8}.panel{border:1px solid #ffffff0e;background:#ffffff03;border-radius:13px;padding:13px;margin-bottom:12px}.panel h3{font-size:11px;margin:0 0 12px;display:flex;justify-content:space-between;align-items:center}.panel h3 span{font-size:9px;color:var(--muted);font-weight:500}.activity-item{padding:10px 0;border-top:1px solid #ffffff0b}.activity-item:first-of-type{border-top:0}.activity-query{font-size:11px;line-height:1.55;color:#e3dcef;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.activity-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px;color:#8f87a5;font-size:9px}.pill{padding:3px 6px;border:1px solid #ffffff10;border-radius:6px}.activity-open{border:0;background:none;color:#bba8ff;padding:5px 0 0;font-size:10px;cursor:pointer}.empty{color:#817992;font-size:11px;text-align:center;padding:20px 10px;line-height:1.6}.tiny{font-size:10px;color:#817992;line-height:1.6}.icon-button{border:1px solid var(--line);background:#171321;color:#cfc4e9;border-radius:8px;padding:5px 8px;cursor:pointer}.search-results{display:none;position:absolute;top:51px;left:0;right:0;z-index:3;max-height:45vh;overflow:auto;border:1px solid var(--line);border-radius:12px;background:#100d19;box-shadow:0 18px 45px #0008}.search-wrap{position:relative}.search-result{padding:11px;border-bottom:1px solid #ffffff0b;cursor:pointer}.search-result:hover{background:#ffffff08}.search-result b{font-size:11px;display:block}.search-result small{font-size:10px;color:var(--muted);display:block;margin-top:5px}.mobile-inspector{display:none}
@media(max-width:1100px){.workspace{grid-template-columns:minmax(0,1fr)}.inspector{display:none}.conversation{border-right:0}.mobile-inspector{display:block}.stats{padding:10px 14px}.top{padding:0 15px}}
@media(max-width:650px){.shell{grid-template-columns:1fr;min-height:0}.rail{display:none}.top{height:62px}.heading p{display:none}.stats{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.stat{padding:9px}.stat strong{font-size:14px}.stat span{font-size:9px}.chat{padding:18px 13px}.welcome{margin:6vh auto 25px}.welcome h2{font-size:21px}.composer-wrap{padding:10px}.workspace{min-height:0}.conversation{min-height:0}.msg{gap:9px;margin-bottom:20px}.avatar{width:27px;height:27px;flex-basis:27px}.msg-content{font-size:12px}}
</style>
</head>
<body>
<div class="shell">
<aside class="rail">
  <div class="brand"><div class="brand-mark">✦</div><div><strong>OMNIX IA</strong><small>ESPACE PRIVÉ DU FONDATEUR</small></div></div>
  <a class="back" href="/admin">← <span>Retour à l’administration</span></a>
  <button class="new" id="newChat">＋ Nouvelle discussion</button>
  <div class="search-wrap"><input class="search" id="searchInput" type="search" placeholder="Rechercher une conversation…" autocomplete="off" aria-label="Rechercher dans les conversations"><div class="search-results" id="searchResults"></div></div>
  <div class="rail-title"><span>Discussions récentes</span><span id="sessionCount">—</span></div>
  <div class="history" id="sessions"><div class="empty">Chargement de l’historique…</div></div>
  <div class="rail-foot">Les discussions sont enregistrées dans la base de données Omnix. Les statistiques affichées sont celles consignées par le serveur.</div>
</aside>
<main class="main">
  <header class="top"><div class="heading"><div class="brand-mark" style="width:34px;height:34px;font-size:17px">✦</div><div><h1>Omnix IA</h1><p>Assistant de développement · accès propriétaire</p></div></div><div class="status"><span class="dot"></span><span id="aiStatus">Vérification du service</span></div></header>
  <section class="stats">
    <div class="stat"><span>Tokens consommés · total enregistré</span><strong id="totalTokens">—</strong><em id="totalRequests">— requêtes</em></div>
    <div class="stat"><span>Dernières 24 heures</span><strong id="dayTokens">—</strong><em id="dayRequests">— requêtes</em></div>
    <div class="stat"><span>7 derniers jours</span><strong id="weekTokens">—</strong><em id="weekRequests">— requêtes</em></div>
  </section>
  <div class="workspace">
    <section class="conversation">
      <div class="chat" id="chat" aria-live="polite">
        <div class="welcome" id="welcome"><div class="welcome-mark">✦</div><h2>Sur quoi travaille-t-on ?</h2><p>Un espace de travail privé pour Omnix. Pose une question, reprends une ancienne conversation ou recherche une demande passée.</p><div class="suggestions"><button data-prompt="Analyse les dernières erreurs de démarrage d’Omnix et propose un plan de diagnostic.">Analyser les erreurs</button><button data-prompt="Aide-moi à diagnostiquer la connexion MySQL d’Omnix sur Eternodes.">Diagnostiquer MySQL</button><button data-prompt="Aide-moi à planifier une correction sans casser les fonctionnalités existantes d’Omnix V13.">Préparer une correction</button></div></div>
      </div>
      <div class="composer-wrap"><form class="composer" id="chatForm"><textarea id="messageInput" placeholder="Écris à Omnix IA… (Entrée pour envoyer, Maj + Entrée pour une nouvelle ligne)" maxlength="30000" aria-label="Message à Omnix IA"></textarea><div class="composer-bottom"><span class="hint">Réponses générées par le modèle configuré sur le serveur.</span><button class="send" id="sendButton" type="submit">Envoyer ↗</button></div></form></div>
    </section>
    <aside class="inspector">
      <section class="panel"><h3>Dernières demandes <span>journal IA</span></h3><div id="activity"><div class="empty">Chargement des requêtes…</div></div><p class="tiny">Cette liste reprend les messages utilisateur enregistrés par Omnix IA. Elle ne signifie pas qu’une recherche Internet a été exécutée.</p></section>
      <section class="panel"><h3>Utilisation des tokens</h3><div class="tiny" id="tokenBreakdown">Récupération des statistiques…</div></section>
      <section class="panel"><h3>Modèle actif</h3><div class="tiny" id="modelInfo">Lecture de la configuration…</div></section>
    </aside>
  </div>
</main>
</div>
<script>
(()=>{
 const $=id=>document.getElementById(id);let currentSessionId=null;let sessions=[];let sending=false;
 const number=n=>Number(n||0).toLocaleString('fr-FR');
 const date=v=>{if(!v)return 'date inconnue';try{return new Date(v).toLocaleString('fr-FR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}catch{return 'date inconnue'}};
 const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
 async function api(url,opt={}){const r=await fetch(url,{credentials:'include',headers:{Accept:'application/json','Content-Type':'application/json',...(opt.headers||{})},...opt});let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.error||`Erreur HTTP ${r.status}`);return d}
 function addMessage(role,content){$('welcome')?.remove();const row=document.createElement('article');row.className='msg '+(role==='user'?'user':'assistant');const avatar=document.createElement('div');avatar.className='avatar';avatar.textContent=role==='user'?'W':'✦';const body=document.createElement('div');body.className='msg-body';const label=document.createElement('div');label.className='msg-role';label.textContent=role==='user'?'Vous':'Omnix IA';const text=document.createElement('div');text.className='msg-content';text.textContent=String(content??'');body.append(label,text);row.append(avatar,body);$('chat').appendChild(row);$('chat').scrollTop=$('chat').scrollHeight;return text}
 function clearChat(){ $('chat').innerHTML='<div class="welcome" id="welcome"><div class="welcome-mark">✦</div><h2>Sur quoi travaille-t-on ?</h2><p>Un espace de travail privé pour Omnix. Pose une question, reprends une ancienne conversation ou recherche une demande passée.</p><div class="suggestions"><button data-prompt="Analyse les dernières erreurs de démarrage d’Omnix et propose un plan de diagnostic.">Analyser les erreurs</button><button data-prompt="Aide-moi à diagnostiquer la connexion MySQL d’Omnix sur Eternodes.">Diagnostiquer MySQL</button><button data-prompt="Aide-moi à planifier une correction sans casser les fonctionnalités existantes d’Omnix V13.">Préparer une correction</button></div></div>'; }
 function bindPrompts(){document.querySelectorAll('[data-prompt]').forEach(b=>b.onclick=()=>{$('messageInput').value=b.dataset.prompt;$('messageInput').focus()})}
 function renderSessions(items){sessions=items||[];$('sessionCount').textContent=sessions.length;$('sessions').innerHTML='';if(!sessions.length){$('sessions').innerHTML='<div class="empty">Aucune discussion enregistrée pour le moment.</div>';return}sessions.forEach(s=>{const el=document.createElement('div');el.className='session'+(s.id===currentSessionId?' active':'');el.tabIndex=0;el.innerHTML=`<b>${esc(s.title||'Nouvelle discussion')}</b><small>${number(s.messageCount)} messages · ${date(s.updatedAt)}</small>`;el.onclick=()=>openSession(s.id);el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openSession(s.id)}};$('sessions').appendChild(el)})}
 async function loadSessions(){try{const d=await api('/api/ai-dev/sessions');renderSessions(d.sessions||[])}catch(e){$('sessions').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}
 async function openSession(id){try{const d=await api('/api/ai-dev/sessions/'+encodeURIComponent(id));currentSessionId=id;clearChat();(d.session.messages||[]).forEach(m=>addMessage(m.role,m.content));$('totalTokens').title=number(d.session.totalTokens)+' tokens dans cette discussion';renderSessions(sessions)}catch(e){addMessage('assistant','Impossible d’ouvrir cette discussion : '+e.message)}}
 function newChat(){currentSessionId=null;clearChat();renderSessions(sessions);$('messageInput').focus()}
 async function sendMessage(text){const input=$('messageInput');const message=String(text??input.value).trim();if(!message||sending)return;sending=true;addMessage('user',message);input.value='';const pending=addMessage('assistant','Je réfléchis…');$('sendButton').disabled=true;try{const d=await api('/api/ai-dev/chat',{method:'POST',body:JSON.stringify({message,sessionId:currentSessionId})});pending.textContent=d.answer||'Réponse vide.';currentSessionId=d.sessionId||currentSessionId;await Promise.all([loadSessions(),loadUsage()])}catch(e){pending.textContent='La requête n’a pas abouti : '+e.message}finally{sending=false;$('sendButton').disabled=false;input.focus()}}
 async function loadUsage(){try{const d=await api('/api/ai-dev/usage');const t=d.totals||{},a=t.all||{},day=t.last24h||{},week=t.last7d||{};$('totalTokens').textContent=number(a.tokens);$('totalRequests').textContent=number(a.requests)+' requêtes';$('dayTokens').textContent=number(day.tokens);$('dayRequests').textContent=number(day.requests)+' requêtes';$('weekTokens').textContent=number(week.tokens);$('weekRequests').textContent=number(week.requests)+' requêtes';$('tokenBreakdown').textContent=`Entrée estimée : ${number(a.promptTokens)} tokens. Sortie estimée : ${number(a.completionTokens)} tokens. Total calculé depuis les journaux conservés.`;const rows=d.activity||[];$('activity').innerHTML=rows.length?rows.map(x=>`<div class="activity-item"><div class="activity-query">${esc(x.query||'(message non enregistré)')}</div><div class="activity-meta"><span class="pill">${number(x.totalTokens)} tokens</span><span class="pill">${esc(x.model||'modèle inconnu')}</span><span>${date(x.createdAt)}</span></div>${x.sessionId?`<button class="activity-open" data-session="${esc(x.sessionId)}">Ouvrir la conversation ↗</button>`:''}${x.status==='error'?`<div class="tiny" style="color:#ff9caa">${esc(x.error||'Erreur')}</div>`:''}</div>`).join(''):'<div class="empty">Aucune requête IA enregistrée.</div>';$('activity').querySelectorAll('[data-session]').forEach(b=>b.onclick=()=>openSessionByLog(b.dataset.session));}catch(e){$('activity').innerHTML=`<div class="empty">${esc(e.message)}</div>`;$('tokenBreakdown').textContent='Statistiques indisponibles.'}}
 async function openSessionByLog(id){const s=sessions.find(x=>x.id===id);if(s)return openSession(id);try{const d=await api('/api/ai-dev/sessions');renderSessions(d.sessions||[]);if(sessions.some(x=>x.id===id))openSession(id)}catch{}}
 async function loadStatus(){try{const d=await api('/api/ai-dev/status');$('aiStatus').textContent=d.ai?.configured?'Service configuré':'Clé IA manquante';$('modelInfo').textContent=`Fournisseur : ${d.ai?.provider||'—'}. Modèle configuré : ${d.ai?.model||'—'}. Statut : ${d.ai?.configured?'prêt':'clé manquante'}.`;if(!d.ai?.configured)$('aiStatus').style.color='#ffb86b'}catch(e){$('aiStatus').textContent='Statut indisponible';$('modelInfo').textContent=e.message}}
 let searchTimer=null; $('searchInput').addEventListener('input',()=>{clearTimeout(searchTimer);searchTimer=setTimeout(runSearch,220)});
 async function runSearch(){const q=$('searchInput').value.trim(),box=$('searchResults');if(!q){box.style.display='none';box.innerHTML='';return}box.style.display='block';box.innerHTML='<div class="empty">Recherche dans les conversations…</div>';try{const d=await api('/api/ai-dev/search?q='+encodeURIComponent(q));const items=d.results||[];box.innerHTML=items.length?items.map(x=>`<div class="search-result" data-result="${esc(x.id)}"><b>${esc(x.title)}</b><small>${esc(x.excerpt)} · ${date(x.updatedAt)}</small></div>`).join(''):'<div class="empty">Aucun résultat dans les conversations sauvegardées.</div>';box.querySelectorAll('[data-result]').forEach(el=>el.onclick=()=>{box.style.display='none';$('searchInput').value='';openSession(el.dataset.result)})}catch(e){box.innerHTML=`<div class="empty">${esc(e.message)}</div>`}}
 document.addEventListener('click',e=>{if(!e.target.closest('.search-wrap'))$('searchResults').style.display='none'});
 $('newChat').onclick=newChat;$('chatForm').onsubmit=e=>{e.preventDefault();sendMessage()};$('messageInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('chatForm').requestSubmit()}});bindPrompts();loadSessions();loadUsage();loadStatus();
})();
</script>
</body>
</html>
