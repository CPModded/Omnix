<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Omnix IA — Administration</title>
<link rel="stylesheet" href="/css/omnix-web.css">
<style>
:root{color-scheme:dark;--bg:#08070e;--panel:#100e19;--panel2:#151222;--line:#29233b;--text:#f6f3ff;--muted:#a39bb8;--purple:#8b5cf6;--purple2:#6d3df5;--green:#51d6a4}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#29184c 0,transparent 44%),var(--bg);color:var(--text);font:14px Inter,system-ui,-apple-system,sans-serif}.shell{height:100dvh;min-height:620px;display:grid;grid-template-columns:290px minmax(0,1fr);overflow:hidden}.rail{display:flex;flex-direction:column;min-width:0;background:#0c0a13ed;border-right:1px solid var(--line);padding:17px 13px;gap:13px}.brand{display:flex;align-items:center;gap:10px;padding:5px 5px 15px;border-bottom:1px solid #ffffff0d}.brand-mark{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,#a78bfa,#6d3df5);font-weight:900;font-size:19px;box-shadow:0 8px 24px #7c3aed35}.brand strong{font-size:15px;letter-spacing:.05em}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:3px}.back{display:flex;gap:8px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:11px;color:#ddd3ff;text-decoration:none;background:#ffffff03}.new{background:linear-gradient(120deg,#8b5cf6,#7041dc);border:0;border-radius:11px;padding:12px;color:white;font-weight:800;cursor:pointer}.search{width:100%;padding:11px 12px;background:#171321;border:1px solid var(--line);border-radius:10px;color:white;outline:none}.search:focus,textarea:focus{border-color:#8b5cf6}.rail-title{display:flex;align-items:center;justify-content:space-between;color:#817992;font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.12em;padding:2px 5px}.history{flex:1;overflow:auto;min-height:80px}.session{padding:11px;border-radius:10px;margin:3px 0;cursor:pointer;border:1px solid transparent;overflow:hidden}.session:hover{background:#ffffff08}.session.active{background:#8b5cf61c;border-color:#8b5cf64a}.session b{display:block;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.session small{display:block;color:var(--muted);font-size:10px;margin-top:5px}.rail-foot{font-size:10px;line-height:1.55;color:#817992;padding:12px;border:1px solid #ffffff0c;border-radius:11px;background:#ffffff03}.main{min-width:0;display:flex;flex-direction:column}.top{height:72px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:15px;padding:0 25px;border-bottom:1px solid var(--line);background:#0908118a}.heading{display:flex;align-items:center;gap:11px}.heading h1{font-size:16px;margin:0}.heading p{font-size:11px;color:var(--muted);margin:4px 0 0}.status{font-size:11px;color:var(--green);display:flex;align-items:center;gap:6px}.dot{width:7px;height:7px;background:var(--green);border-radius:50%;box-shadow:0 0 10px #51d6a45c}.stats{display:grid;grid-template-columns:repeat(3,minmax(100px,1fr));gap:9px;padding:13px 22px;border-bottom:1px solid #ffffff0b}.stat{padding:10px 13px;border:1px solid #ffffff0c;border-radius:12px;background:#ffffff03;min-width:0}.stat span{display:block;color:var(--muted);font-size:10px;margin-bottom:6px}.stat strong{font-size:17px;letter-spacing:-.02em}.stat em{font-style:normal;color:#a78bfa;font-size:10px;margin-left:5px}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 285px;flex:1;min-height:0}.conversation{display:flex;flex-direction:column;min-width:0;min-height:0;border-right:1px solid #ffffff0b}.chat{flex:1;overflow:auto;padding:25px max(20px,calc((100% - 850px)/2));scroll-behavior:smooth}.welcome{max-width:720px;margin:7vh auto 30px;text-align:center}.welcome-mark{width:54px;height:54px;margin:auto auto 18px;border-radius:18px;background:linear-gradient(145deg,#a78bfa,#6d3df5);display:grid;place-items:center;font-size:25px;box-shadow:0 12px 38px #6d3df538}.welcome h2{font-size:24px;letter-spacing:-.04em;margin:0 0 10px}.welcome p{color:var(--muted);font-size:13px;line-height:1.7;max-width:510px;margin:auto}.suggestions{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:23px}.suggestions button{border:1px solid #38304e;background:#15111f;color:#d8cef7;border-radius:12px;padding:10px 12px;cursor:pointer;font-size:11px}.msg{display:flex;gap:12px;max-width:850px;margin:0 auto 23px;align-items:flex-start}.avatar{width:30px;height:30px;flex:0 0 30px;display:grid;place-items:center;border-radius:10px;background:#24183c;color:#c4b5fd;font-weight:900}.msg.user .avatar{background:#20202d;color:#eee}.msg-body{min-width:0;flex:1}.msg-role{font-size:11px;color:#a89dbd;font-weight:800;margin:2px 0 8px}.msg-content{white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.75;color:#e8e3f4}.msg.user .msg-content{color:#fff}.composer-wrap{padding:12px 20px 17px;border-top:1px solid #ffffff0b;background:#0b0912}.composer{max-width:850px;margin:auto;border:1px solid #3a304f;background:#15111f;border-radius:17px;padding:10px;box-shadow:0 12px 35px #0003}.composer textarea{width:100%;display:block;min-height:50px;max-height:190px;resize:vertical;border:1px solid transparent;background:transparent;color:white;padding:8px 9px;outline:none;font:13px/1.6 inherit}.composer-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:5px 3px 1px}.hint{color:#817992;font-size:10px}.send{border:0;border-radius:10px;background:var(--purple);color:white;font-weight:850;padding:10px 15px;cursor:pointer}.send:disabled{opacity:.5;cursor:wait}.inspector{min-width:0;overflow:auto;padding:17px 14px;background:#0c0a13a8}.panel{border:1px solid #ffffff0e;background:#ffffff03;border-radius:13px;padding:13px;margin-bottom:12px}.panel h3{font-size:11px;margin:0 0 12px;display:flex;justify-content:space-between;align-items:center}.panel h3 span{font-size:9px;color:var(--muted);font-weight:500}.activity-item{padding:10px 0;border-top:1px solid #ffffff0b}.activity-item:first-of-type{border-top:0}.activity-query{font-size:11px;line-height:1.55;color:#e3dcef;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.activity-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px;color:#8f87a5;font-size:9px}.pill{padding:3px 6px;border:1px solid #ffffff10;border-radius:6px}.activity-open{border:0;background:none;color:#bba8ff;padding:5px 0 0;font-size:10px;cursor:pointer}.empty{color:#817992;font-size:11px;text-align:center;padding:20px 10px;line-height:1.6}.tiny{font-size:10px;color:#817992;line-height:1.6}.icon-button{border:1px solid var(--line);background:#171321;color:#cfc4e9;border-radius:8px;padding:5px 8px;cursor:pointer}.search-results{display:none;position:absolute;top:51px;left:0;right:0;z-index:3;max-height:45vh;overflow:auto;border:1px solid var(--line);border-radius:12px;background:#100d19;box-shadow:0 18px 45px #0008}.search-wrap{position:relative}.search-result{padding:11px;border-bottom:1px solid #ffffff0b;cursor:pointer}.search-result:hover{background:#ffffff08}.search-result b{font-size:11px;display:block}.search-result small{font-size:10px;color:var(--muted);display:block;margin-top:5px}.mobile-inspector{display:none}.file-list{max-height:190px;overflow:auto}.file-item{display:block;width:100%;text-align:left;padding:7px 8px;border:1px solid #ffffff0b;border-radius:7px;background:#ffffff03;color:#cfc4e9;font:10px/1.4 ui-monospace,monospace;cursor:pointer;overflow-wrap:anywhere;margin:3px 0}.file-item:hover{background:#8b5cf61c;border-color:#8b5cf64a}.file-path{width:100%;padding:8px;background:#15111f;border:1px solid var(--line);border-radius:8px;color:white;font-size:11px}.file-editor{width:100%;min-height:180px;resize:vertical;background:#08070e;color:#e8e3f4;border:1px solid var(--line);border-radius:8px;padding:9px;font:11px/1.5 ui-monospace,monospace}.file-actions{display:flex;gap:6px;margin-top:7px}.file-actions button{flex:1;border:1px solid var(--line);background:#201833;color:#eee5ff;border-radius:8px;padding:8px 5px;font-size:10px;cursor:pointer}.file-status{font-size:10px;color:var(--muted);line-height:1.5;margin-top:7px;white-space:pre-wrap}
@media(max-width:1100px){.workspace{grid-template-columns:minmax(0,1fr)}.inspector{display:block;max-height:42vh;border-top:1px solid var(--line)}.conversation{border-right:0}.mobile-inspector{display:block}.stats{padding:10px 14px}.top{padding:0 15px}}
@media(max-width:650px){.shell{grid-template-columns:1fr;min-height:0}.rail{display:none}.top{height:62px}.heading p{display:none}.stats{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.stat{padding:9px}.stat strong{font-size:14px}.stat span{font-size:9px}.chat{padding:18px 13px}.welcome{margin:6vh auto 25px}.welcome h2{font-size:21px}.composer-wrap{padding:10px}.workspace{min-height:0}.conversation{min-height:0}.msg{gap:9px;margin-bottom:20px}.avatar{width:27px;height:27px;flex-basis:27px}.msg-content{font-size:12px}}

/* UI responsive inspirée des interfaces de chat modernes */
.shell{display:block;width:100%;height:100dvh;min-height:0;overflow:hidden}
.main{height:100%;min-height:0}
.rail{position:fixed;z-index:1002;inset:0 auto 0 0;width:min(330px,88vw);height:100dvh;padding:18px 14px;background:#0d0b15;box-shadow:18px 0 55px #0008;transform:translateX(-110%);visibility:hidden;transition:transform .24s ease,visibility .24s;will-change:transform}
.rail.open{transform:translateX(0);visibility:visible}
.drawer-backdrop{position:fixed;z-index:1001;inset:0;background:#030207a8;backdrop-filter:blur(3px);opacity:0;visibility:hidden;transition:opacity .2s ease,visibility .2s}
.drawer-backdrop.open{opacity:1;visibility:visible}
.logs-button{flex:0 0 auto;border:1px solid var(--line);border-radius:10px;background:#171321;color:#e8ddff;padding:9px 11px;cursor:pointer;font-size:11px;font-weight:750}.logs-button:hover{background:#241936;border-color:#554075}.logs-overlay{position:fixed;z-index:1200;inset:0;display:none;align-items:center;justify-content:center;padding:16px;background:#030207c9;backdrop-filter:blur(5px)}.logs-overlay.open{display:flex}.logs-dialog{width:min(100%,1000px);max-height:min(86dvh,850px);display:flex;flex-direction:column;border:1px solid #39304e;border-radius:16px;background:#0d0b15;box-shadow:0 25px 90px #000a;overflow:hidden}.logs-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line)}.logs-head h2{font-size:14px;margin:0}.logs-controls{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.logs-controls select,.logs-controls button{border:1px solid var(--line);border-radius:8px;background:#171321;color:#eee5ff;padding:8px 10px;font-size:11px}.logs-controls button{cursor:pointer}.logs-meta{padding:9px 16px;color:var(--muted);font-size:10px;border-bottom:1px solid #ffffff0b}.logs-output{flex:1;min-height:180px;max-height:65dvh;overflow:auto;margin:0;padding:15px 17px;white-space:pre-wrap;overflow-wrap:anywhere;color:#d7f7e9;font:11px/1.6 ui-monospace,SFMono-Regular,monospace;touch-action:pan-y;-webkit-overflow-scrolling:touch}.logs-error{color:#ffb7c2}.logs-head .logs-controls button:focus-visible,.logs-button:focus-visible{outline:2px solid #c4b5fd;outline-offset:2px}
.top{gap:12px;padding-inline:clamp(12px,2.5vw,28px)}
.top-start{display:flex;align-items:center;gap:12px;min-width:0}
.drawer-toggle{flex:0 0 auto;display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--line);border-radius:13px;background:#171321;color:#f5efff;font-size:20px;cursor:pointer;box-shadow:0 5px 18px #0002}
.drawer-toggle:hover{background:#241936;border-color:#554075}
.drawer-toggle:focus-visible,.new:focus-visible,.send:focus-visible{outline:2px solid #c4b5fd;outline-offset:3px}
.workspace{grid-template-columns:minmax(0,1fr) 285px;flex:1;min-height:0;overflow:hidden}
.conversation{min-height:0;min-width:0}
.chat{min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior-y:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;scrollbar-gutter:stable}
.composer-wrap{flex:0 0 auto;padding-bottom:max(13px,env(safe-area-inset-bottom))}
.composer textarea{resize:none;max-height:24dvh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
.inspector{overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
.history,.search-results,.file-list{overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
@media(max-width:1100px){.workspace{grid-template-columns:minmax(0,1fr);overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch}.inspector{display:block;max-height:none;overflow:visible;border-top:1px solid var(--line)}.conversation{height:100%;min-height:0}.chat{flex:1}.main{overflow:hidden}}
@media(max-width:650px){
 /* La règle historique .rail{display:none} masquait le tiroir et ne laissait que le flou. */
 .rail{display:flex!important;z-index:1002;pointer-events:auto}
 .drawer-backdrop{z-index:1001;pointer-events:auto}
 body{height:100%;min-height:100%;overflow:hidden;overscroll-behavior-y:none}
 .shell{height:100dvh;min-height:0}
 .top{height:62px;flex:0 0 62px;padding:0 11px}
 .top-start{gap:9px}.drawer-toggle{width:39px;height:39px;border-radius:12px}
 .heading{gap:8px}.heading .brand-mark{width:31px!important;height:31px!important;font-size:15px!important}.heading h1{font-size:15px}.heading p{display:none}
 .status{font-size:10px;max-width:34%;text-align:right}.status span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 .stats{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;padding:8px 9px;flex:0 0 auto}
 .stat{padding:8px 7px;border-radius:10px}.stat strong{font-size:13px}.stat span{font-size:9px;line-height:1.35}.stat em{display:block;margin:4px 0 0;font-size:9px}
 .workspace{display:flex;flex-direction:column;flex:1;min-height:0;overflow:hidden}
 .conversation{display:flex;flex:1;min-height:0;height:auto;border-right:0}
 .chat{flex:1;min-height:0;padding:20px 14px 28px;scroll-padding-bottom:20px}
 .welcome{margin:8vh auto 26px}.welcome h2{font-size:22px}.welcome p{font-size:13px}
 .msg{max-width:100%;gap:9px;margin-bottom:22px}.msg-content{font-size:14px;line-height:1.7}.msg-role{font-size:11px}
 .composer-wrap{padding:9px 10px max(10px,env(safe-area-inset-bottom));background:#0b0912}
 .composer{border-radius:19px;padding:8px 9px}.composer textarea{min-height:46px;max-height:22dvh;font-size:16px;padding:8px}
 .composer-bottom{padding:4px 2px 1px}.hint{max-width:68%;font-size:9px;line-height:1.4}.send{padding:10px 13px}
 .inspector{display:none}
 .rail{width:min(340px,88vw);padding-top:max(16px,env(safe-area-inset-top));padding-bottom:max(16px,env(safe-area-inset-bottom))}
 .rail .history{min-height:100px;overflow-y:auto;touch-action:pan-y}
}
@media(prefers-reduced-motion:reduce){.rail,.drawer-backdrop{transition:none}}

/* Interface recentrée sur une seule conversation, sans panneau latéral parasite */
.stats,.inspector{display:none!important}
.workspace{display:flex!important;flex:1 1 auto;min-height:0;min-width:0;overflow:hidden!important}
.conversation{display:flex;flex:1 1 auto;min-height:0;min-width:0;height:100%;border-right:0!important;overflow:hidden}
.chat{flex:1 1 auto;min-height:0;min-width:0;overflow-y:auto!important;overflow-x:hidden!important;padding:clamp(18px,3vh,32px) clamp(14px,4vw,36px) 28px!important;scrollbar-gutter:stable;overscroll-behavior-y:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y}
.msg{width:100%;max-width:820px;margin:0 auto 26px!important;gap:11px;align-items:flex-start}
.msg .avatar{width:32px;height:32px;flex:0 0 32px;border-radius:11px}
.msg-body{min-width:0;max-width:100%;flex:1}
.msg-role{margin:2px 0 7px!important;font-size:12px;letter-spacing:.01em}
.msg-content{display:block;width:fit-content;max-width:100%;padding:12px 15px;border:1px solid #ffffff10;border-radius:4px 15px 15px 15px;background:#15121f;color:#eee9fa;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px}
.msg.user .msg-body{display:flex;flex-direction:column;align-items:flex-end}
.msg.user .msg-role{align-self:flex-end}
.msg.user .msg-content{background:#292044;border-color:#8b5cf633;color:#fff;border-radius:15px 4px 15px 15px}
.msg.assistant .msg-content{background:#100e19}
.composer-wrap{position:relative;z-index:2;flex:0 0 auto;padding:14px clamp(12px,3vw,28px) max(14px,env(safe-area-inset-bottom))!important;border-top:1px solid #342b48!important;background:#0b0912!important;box-shadow:0 -12px 28px #0002}
.composer{width:100%;max-width:820px;border:1px solid #46385f!important;background:#15111f!important;border-radius:18px!important;padding:10px 12px!important}
.composer:focus-within{border-color:#8b5cf6!important;box-shadow:0 0 0 3px #8b5cf61c,0 12px 35px #0003}
.composer textarea{min-height:48px;max-height:24dvh;resize:vertical;font:14px/1.6 Inter,system-ui,sans-serif!important}
.composer-bottom{border-top:1px solid #ffffff0b;margin-top:4px;padding-top:9px!important}
.hint{max-width:70%;line-height:1.45}
.welcome{margin:clamp(42px,10vh,110px) auto 35px!important}
.top{flex:0 0 auto}
@media(max-width:650px){
 .shell{height:100dvh;min-height:0;overflow:hidden}
 .main{height:100%;min-height:0;overflow:hidden}
 .workspace{flex:1;min-height:0}
 .chat{padding:18px 12px 24px!important}
 .msg{margin-bottom:22px!important;gap:8px}
 .msg .avatar{width:29px;height:29px;flex-basis:29px}
 .msg-content{font-size:14px;padding:11px 12px}
 .composer-wrap{padding:10px 10px max(10px,env(safe-area-inset-bottom))!important}
 .composer textarea{font-size:16px!important;max-height:20dvh}
 .hint{font-size:9px;max-width:58%}
 .welcome{margin:7vh auto 28px!important}
}


/* Métadonnées de conversation et séparateurs journaliers */
.usage-summary,.conversation-info{flex:0 0 auto;padding:8px clamp(12px,3vw,28px);font-size:10px;line-height:1.5;color:#aaa0c2;border-bottom:1px solid #ffffff0a;background:#0b0912;overflow-wrap:anywhere}
.conversation-info{padding-top:6px;padding-bottom:6px;color:#8f87a5;font-size:10px}
.day-divider{display:flex;align-items:center;gap:12px;max-width:820px;margin:8px auto 24px;color:#8f87a5;font-size:10px;text-transform:capitalize}
.day-divider:before,.day-divider:after{content:"";height:1px;background:#ffffff14;flex:1}
.msg-time{margin-top:7px;font-size:10px;color:#8c829f;line-height:1.4}
.msg.user .msg-time{text-align:right}
.history-day{padding:9px 9px 5px;color:#817992;font-size:10px;text-transform:capitalize}
.session{display:block;width:100%;text-align:left;color:inherit;background:transparent;font:inherit}
@media(max-width:650px){.usage-summary{font-size:9px;padding:7px 10px}.conversation-info{font-size:9px;padding:5px 10px}.day-divider{margin-bottom:18px}}


/* Un clic sélectionne un message et révèle son bouton Copier. */
.msg{position:relative;cursor:pointer;border-radius:12px;outline:none}
.msg.selected{background:#8b5cf608;box-shadow:0 0 0 1px #8b5cf638;border-radius:13px}
.msg-tools{display:flex;justify-content:flex-end;min-height:0;margin-top:7px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .12s ease}
.msg.selected .msg-tools{opacity:1;visibility:visible;pointer-events:auto}
.copy-message{border:1px solid #39304e;border-radius:8px;background:#171321;color:#dcd2f4;padding:5px 9px;font:11px/1.3 inherit;cursor:pointer}
.copy-message:hover{background:#241936;border-color:#6950a0}
.copy-message:focus-visible{outline:2px solid #c4b5fd;outline-offset:2px}
.copy-message.copied{color:#8ef0c1;border-color:#326d59}
@media(prefers-reduced-motion:reduce){.msg-tools{transition:none}}

</style>
</head>
<body>
<div class="shell">
<aside class="rail" id="conversationDrawer" aria-label="Menu des conversations">
  <div class="brand"><div class="brand-mark">✦</div><div><strong>OMNIX IA</strong><small>ESPACE PRIVÉ DU FONDATEUR</small></div></div>
  <a class="back" href="/admin">← <span>Retour à l’administration</span></a>
  <button class="new" id="newChat">＋ Nouvelle discussion</button>
  <div class="search-wrap"><input class="search" id="searchInput" type="search" placeholder="Rechercher une conversation…" autocomplete="off" aria-label="Rechercher dans les conversations"><div class="search-results" id="searchResults"></div></div>
  <div class="rail-title"><span>Discussions récentes</span><span id="sessionCount">—</span></div>
  <div class="history" id="sessions"><div class="empty">Chargement de l’historique…</div></div>
  <div class="rail-foot">Les discussions sont enregistrées dans la base de données Omnix. Les statistiques affichées sont celles consignées par le serveur.</div>
</aside>
<main class="main">
  <header class="top"><div class="top-start"><button class="drawer-toggle" id="toggleConversations" type="button" aria-label="Ouvrir les conversations" aria-controls="conversationDrawer" aria-expanded="false" title="Conversations">💬</button><div class="heading"><div class="brand-mark" style="width:34px;height:34px;font-size:17px">✦</div><div><h1>Omnix IA</h1><p>Assistant de développement · accès propriétaire</p></div></div></div><div style="display:flex;align-items:center;gap:10px"><button class="logs-button" id="openLogs" type="button">📜 Logs</button><div class="status"><span class="dot"></span><span id="aiStatus">Vérification du service</span></div></div></header>
  <div class="usage-summary" id="usageSummary" role="status">Chargement des statistiques de tokens…</div>
  <div class="conversation-info" id="conversationInfo">Sélectionne une discussion ou commence-en une nouvelle.</div>
  <div class="workspace">
    <section class="conversation">
      <div class="chat" id="chat" aria-live="polite">
        <div class="welcome" id="welcome"><div class="welcome-mark">✦</div><h2>Sur quoi travaille-t-on ?</h2><p>Un espace de travail privé pour Omnix. Pose une question, reprends une ancienne conversation ou recherche une demande passée.</p><div class="suggestions"><button data-prompt="Analyse les dernières erreurs de démarrage d’Omnix et propose un plan de diagnostic.">Analyser les erreurs</button><button data-prompt="Aide-moi à diagnostiquer la connexion MySQL d’Omnix sur Eternodes.">Diagnostiquer MySQL</button><button data-prompt="Aide-moi à planifier une correction sans casser les fonctionnalités existantes d’Omnix V13.">Préparer une correction</button></div></div>
      </div>
      <div class="composer-wrap"><form class="composer" id="chatForm"><textarea id="messageInput" placeholder="Écris à Omnix IA… (Entrée pour envoyer, Maj + Entrée pour une nouvelle ligne)" maxlength="30000" aria-label="Message à Omnix IA"></textarea><div class="composer-bottom"><span class="hint">Réponses générées par le modèle configuré sur le serveur.</span><button class="send" id="sendButton" type="submit">Envoyer ↗</button></div></form></div>
    </section>

  </div>
</main>
</div>
<div class="drawer-backdrop" id="drawerBackdrop" aria-hidden="true"></div>
<div class="logs-overlay" id="logsOverlay" role="dialog" aria-modal="true" aria-labelledby="logsTitle"><section class="logs-dialog"><header class="logs-head"><h2 id="logsTitle">Journaux de diagnostic</h2><div class="logs-controls"><select id="logsSource" aria-label="Source des journaux"><option value="eternodes">Console Eternodes</option><option value="project">Fichiers logs du projet</option></select><button id="refreshLogs" type="button">↻ Actualiser</button><button id="closeLogs" type="button" aria-label="Fermer les journaux">✕</button></div></header><div class="logs-meta" id="logsMeta">Les secrets détectés sont masqués. Chargement à la demande.</div><pre class="logs-output" id="logsOutput">Appuie sur « Actualiser » pour charger les journaux.</pre></section></div>
<script>
(()=>{
 'use strict';
 const $=id=>document.getElementById(id);
 let currentSessionId=null,sessions=[],sending=false,lastDayKey='';
 const number=n=>Number(n||0).toLocaleString('fr-FR');
 const asDate=v=>{const d=v?new Date(v):new Date();return Number.isNaN(d.getTime())?new Date():d};
 const date=v=>asDate(v).toLocaleString('fr-FR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
 const dayLabel=v=>{const d=asDate(v),now=new Date(),yesterday=new Date();yesterday.setDate(now.getDate()-1);const key=d.toLocaleDateString('fr-CA');if(key===now.toLocaleDateString('fr-CA'))return "Aujourd’hui";if(key===yesterday.toLocaleDateString('fr-CA'))return 'Hier';return d.toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});};
 const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
 async function api(url,opt={}){const r=await fetch(url,{credentials:'include',headers:{Accept:'application/json','Content-Type':'application/json',...(opt.headers||{})},...opt});let d={};try{d=await r.json()}catch{}if(!r.ok||d.success===false)throw Error(d.error||`Erreur HTTP ${r.status}`);return d}
 const drawer=$('conversationDrawer'),drawerButton=$('toggleConversations'),drawerBackdrop=$('drawerBackdrop');
 function setDrawer(open){if(!drawer||!drawerButton||!drawerBackdrop)return;drawer.classList.toggle('open',open);drawerBackdrop.classList.toggle('open',open);drawerButton.setAttribute('aria-expanded',String(open));drawerButton.setAttribute('aria-label',open?'Fermer les conversations':'Ouvrir les conversations');drawerBackdrop.setAttribute('aria-hidden',String(!open));document.body.classList.toggle('drawer-open',open);if(open){drawer.style.display='flex';setTimeout(()=>$('searchInput')?.focus({preventScroll:true}),180)}else{$('toggleConversations')?.focus({preventScroll:true})}}
 drawerButton?.addEventListener('click',()=>setDrawer(!drawer.classList.contains('open')));drawerBackdrop?.addEventListener('click',()=>setDrawer(false));document.addEventListener('keydown',e=>{if(e.key==='Escape')setDrawer(false)});
 function addDayDivider(v){const d=asDate(v),key=`${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;if(key===lastDayKey)return;lastDayKey=key;const divider=document.createElement('div');divider.className='day-divider';divider.innerHTML=`<span>${esc(dayLabel(d))}</span>`;$('chat').appendChild(divider)}
 function addMessage(role,content,createdAt,meta){$('welcome')?.remove();const timestamp=asDate(createdAt);addDayDivider(timestamp);const row=document.createElement('article');row.className='msg '+(role==='user'?'user':'assistant');row.tabIndex=0;row.setAttribute('aria-label',(role==='user'?'Message de vous':'Message Omnix IA')+' — cliquer pour afficher Copier');const avatar=document.createElement('div');avatar.className='avatar';avatar.textContent=role==='user'?'W':'✦';const body=document.createElement('div');body.className='msg-body';const label=document.createElement('div');label.className='msg-role';label.textContent=role==='user'?'Vous':'Omnix IA';const text=document.createElement('div');text.className='msg-content';text.textContent=String(content??'');const stamp=document.createElement('div');stamp.className='msg-time';stamp.textContent=timestamp.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});if(meta&&meta.totalTokens)stamp.textContent+=` · ${number(meta.totalTokens)} tokens`;const tools=document.createElement('div');tools.className='msg-tools';const copy=document.createElement('button');copy.type='button';copy.className='copy-message';copy.textContent='Copier';copy.setAttribute('aria-label','Copier ce message');tools.appendChild(copy);body.append(label,text,stamp,tools);row.append(avatar,body);const selectMessage=()=>{document.querySelectorAll('.msg.selected').forEach(el=>{if(el!==row)el.classList.remove('selected')});row.classList.add('selected')};row.addEventListener('click',e=>{if(e.target.closest('.copy-message'))return;selectMessage()});row.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target===row){e.preventDefault();selectMessage()}});copy.addEventListener('click',async e=>{e.stopPropagation();selectMessage();const value=text.textContent||'';try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(value)}else{const helper=document.createElement('textarea');helper.value=value;helper.style.position='fixed';helper.style.opacity='0';document.body.appendChild(helper);helper.select();const ok=document.execCommand('copy');helper.remove();if(!ok)throw new Error('copie indisponible')}copy.textContent='Copié !';copy.classList.add('copied');setTimeout(()=>{copy.textContent='Copier';copy.classList.remove('copied')},1400)}catch{copy.textContent='Copie impossible';setTimeout(()=>copy.textContent='Copier',1600)}});$('chat').appendChild(row);requestAnimationFrame(()=>{const c=$('chat');c.scrollTop=c.scrollHeight});return {text,stamp,row}}
 function clearChat(){lastDayKey='';$('chat').innerHTML='<div class="welcome" id="welcome"><div class="welcome-mark">✦</div><h2>Sur quoi travaille-t-on ?</h2><p>Un espace de travail privé pour Omnix. Pose une question, reprends une ancienne conversation ou recherche une demande passée.</p><div class="suggestions"><button data-prompt="Analyse les dernières erreurs de démarrage d’Omnix et propose un plan de diagnostic.">Analyser les erreurs</button><button data-prompt="Aide-moi à diagnostiquer la connexion MySQL d’Omnix sur Eternodes.">Diagnostiquer MySQL</button><button data-prompt="Aide-moi à planifier une correction sans casser les fonctionnalités existantes d’Omnix V13.">Préparer une correction</button></div></div>';bindPrompts()}
 function bindPrompts(){document.querySelectorAll('[data-prompt]').forEach(b=>b.onclick=()=>{$('messageInput').value=b.dataset.prompt;$('messageInput').focus()})}
 function renderSessions(items){sessions=Array.isArray(items)?items:[];const count=$('sessionCount');if(count)count.textContent=sessions.length;const host=$('sessions');if(!host)return;host.innerHTML='';if(!sessions.length){host.innerHTML='<div class="empty">Aucune discussion enregistrée pour le moment.</div>';return}let previousDay='';sessions.forEach(s=>{const d=asDate(s.updatedAt||s.createdAt),key=d.toLocaleDateString('fr-CA');if(key!==previousDay){previousDay=key;const heading=document.createElement('div');heading.className='history-day';heading.textContent=dayLabel(d);host.appendChild(heading)}const el=document.createElement('button');el.type='button';el.className='session'+(s.id===currentSessionId?' active':'');el.innerHTML=`<b>${esc(s.title||'Nouvelle discussion')}</b><small>${number(s.messageCount)} messages · ${date(s.updatedAt||s.createdAt)} · ${number(s.totalTokens)} tokens</small>`;el.onclick=()=>{setDrawer(false);openSession(s.id)};host.appendChild(el)})}
 async function loadSessions(){try{const d=await api('/api/ai-dev/sessions');renderSessions(d.sessions||[])}catch(e){const host=$('sessions');if(host)host.innerHTML=`<div class="empty">Historique indisponible : ${esc(e.message)}</div>`}}
 async function openSession(id){try{const d=await api('/api/ai-dev/sessions/'+encodeURIComponent(id));const s=d.session;if(!s)throw Error('La réponse du serveur ne contient pas cette discussion.');currentSessionId=id;clearChat();(s.messages||[]).forEach(m=>addMessage(m.role,m.content,m.createdAt));const total=number(s.totalTokens||0);$('conversationInfo').textContent=`Créée le ${date(s.createdAt)} · dernière activité ${date(s.updatedAt)} · ${number(s.totalRequests)} requêtes · ${total} tokens`;renderSessions(sessions)}catch(e){clearChat();addMessage('assistant','Impossible d’ouvrir cette discussion : '+e.message);}}
 function newChat(){setDrawer(false);currentSessionId=null;clearChat();$('conversationInfo').textContent='Nouvelle discussion · les dates, requêtes et tokens seront affichés ici';renderSessions(sessions);$('messageInput')?.focus()}
 async function sendMessage(text){const input=$('messageInput'),message=String(text??input.value).trim();if(!message||sending)return;sending=true;const now=new Date();addMessage('user',message,now);input.value='';input.style.height='';const pending=addMessage('assistant','Omnix IA réfléchit…',new Date());const send=$('sendButton');send.disabled=true;send.textContent='Recherche…';try{const d=await api('/api/ai-dev/chat',{method:'POST',body:JSON.stringify({message,sessionId:currentSessionId})});if(!d.answer)throw Error('Le serveur a répondu sans texte.');pending.text.textContent=d.answer;const usage=d.usage||{};if(usage.totalTokens)pending.stamp.textContent+=` · ${number(usage.totalTokens)} tokens`;currentSessionId=d.sessionId||currentSessionId;if(currentSessionId){await loadSessions();const s=sessions.find(x=>x.id===currentSessionId);if(s)$('conversationInfo').textContent=`Dernière activité ${date(s.updatedAt||new Date())} · ${number(s.totalRequests)} requêtes · ${number(s.totalTokens||usage.totalTokens)} tokens`}await loadUsage()}catch(e){pending.text.textContent='La requête IA a échoué : '+e.message;pending.stamp.textContent=date(new Date());}finally{sending=false;send.disabled=false;send.textContent='Envoyer ↗';input.focus()}}
 async function loadUsage(){try{const d=await api('/api/ai-dev/usage'),t=d.totals||{},all=t.all||{},day=t.last24h||{},week=t.last7d||{};$('usageSummary').textContent=`Total : ${number(all.tokens)} tokens · ${number(all.requests)} requêtes  |  24 h : ${number(day.tokens)} tokens · ${number(day.requests)} requêtes  |  7 jours : ${number(week.tokens)} tokens · ${number(week.requests)} requêtes`;$('usageSummary').title=`Entrée : ${number(all.promptTokens)} tokens · Sortie : ${number(all.completionTokens)} tokens`;}catch(e){$('usageSummary').textContent='Statistiques de tokens indisponibles : '+e.message}}
 async function loadStatus(){try{const d=await api('/api/ai-dev/status');let label=d.ai?.configured?'IA configurée':'Configuration IA à vérifier';try{const bridge=await api('/api/ai-dev/capabilities');label+=bridge.bridge==='connected'?' · Dev Bridge '+(bridge.tools||[]).length+' outils':' · Dev Bridge indisponible'}catch{label+=' · Dev Bridge indisponible'}$('aiStatus').textContent=label;if(!d.ai?.configured)$('aiStatus').style.color='#ffb86b'}catch(e){$('aiStatus').textContent='Statut indisponible'}}
 let searchTimer=null;$('searchInput')?.addEventListener('input',()=>{clearTimeout(searchTimer);searchTimer=setTimeout(runSearch,250)});
 async function runSearch(){const q=$('searchInput').value.trim(),box=$('searchResults');if(!q){box.style.display='none';box.innerHTML='';return}box.style.display='block';box.innerHTML='<div class="empty">Recherche dans les conversations…</div>';try{const d=await api('/api/ai-dev/search?q='+encodeURIComponent(q));const items=d.results||[];box.innerHTML=items.length?items.map(x=>`<div class="search-result" data-result="${esc(x.id)}"><b>${esc(x.title)}</b><small>${esc(x.excerpt)} · ${date(x.updatedAt)} · ${number(x.totalTokens)} tokens</small></div>`).join(''):'<div class="empty">Aucun résultat dans les conversations sauvegardées.</div>';box.querySelectorAll('[data-result]').forEach(el=>el.onclick=()=>{box.style.display='none';$('searchInput').value='';setDrawer(false);openSession(el.dataset.result)})}catch(e){box.innerHTML=`<div class="empty">Recherche impossible : ${esc(e.message)}</div>`}}
 document.addEventListener('click',e=>{if(!e.target.closest('.search-wrap')&&$('searchResults'))$('searchResults').style.display='none'});
 const logsOverlay=$('logsOverlay');
 function closeLogs(){logsOverlay?.classList.remove('open');$('openLogs')?.focus()}
 async function loadRuntimeLogs(){const source=$('logsSource').value;$('logsOutput').classList.remove('logs-error');$('logsOutput').textContent='Récupération des journaux…';$('logsMeta').textContent='Connexion au Dev Bridge en cours…';try{const d=await api('/api/ai-dev/runtime-logs?source='+encodeURIComponent(source)+'&lines=180');let text='';if(source==='project'){text=(d.files||[]).map(f=>'### '+f.path+'\n'+(f.lines||[]).join('\n')).join('\n\n')||'Aucun fichier de logs trouvé dans les dossiers connus.'}else{text=(d.lines||[]).join('\n')||'La console a répondu, mais aucune ligne de log n’a été retournée.'}$('logsOutput').textContent=text;$('logsMeta').textContent='Source : '+(d.source||source)+' · récupéré le '+new Date(d.retrievedAt||Date.now()).toLocaleString('fr-FR')+' · '+text.split('\n').length+' lignes';}catch(e){$('logsOutput').textContent='Impossible de charger les journaux : '+e.message+'\n\nVérifie la connexion MCP, PTERO_URL, PTERO_API_TOKEN, PTERO_SERVER_IDENTIFIER et les permissions console du token Pterodactyl.';$('logsOutput').classList.add('logs-error');$('logsMeta').textContent='Échec de récupération · aucune analyse en direct n’a été réalisée.'}}
 $('openLogs')?.addEventListener('click',()=>{logsOverlay.classList.add('open');loadRuntimeLogs()});$('closeLogs')?.addEventListener('click',closeLogs);$('refreshLogs')?.addEventListener('click',loadRuntimeLogs);logsOverlay?.addEventListener('click',e=>{if(e.target===logsOverlay)closeLogs()});$('logsSource')?.addEventListener('change',loadRuntimeLogs);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&logsOverlay?.classList.contains('open'))closeLogs()});
 $('newChat')?.addEventListener('click',newChat);$('chatForm')?.addEventListener('submit',e=>{e.preventDefault();sendMessage()});$('messageInput')?.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('chatForm').requestSubmit()}});$('messageInput')?.addEventListener('input',e=>{e.target.style.height='auto';e.target.style.height=Math.min(e.target.scrollHeight,190)+'px'});
 bindPrompts();loadSessions();loadStatus();loadUsage();
})();
</script>
</body>
</html>
