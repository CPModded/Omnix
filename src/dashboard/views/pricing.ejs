<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>OMNIX - Abonnements</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: #030712;
      color: #f1f5f9;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        sans-serif;

      min-height: 100vh;

      display: flex;
      flex-direction: column;

      overflow-x: hidden;

      line-height: 1.5;
    }

    .halo {
      position: fixed;

      top: -150px;
      left: -150px;

      width: 500px;
      height: 500px;

      background:
        rgba(124, 58, 237, 0.05);

      filter: blur(100px);

      border-radius: 50%;

      pointer-events: none;

      z-index: 0;
    }

    header {
      border-bottom:
        1px solid #1e293b;

      background:
        rgba(15, 23, 42, 0.7);

      backdrop-filter:
        blur(12px);

      -webkit-backdrop-filter:
        blur(12px);

      padding:
        16px 24px;

      display: flex;

      justify-content:
        space-between;

      align-items:
        center;

      position: sticky;

      top: 0;

      z-index: 50;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;

      text-decoration: none;
    }

    .logo-img {
      width: 38px;
      height: 38px;

      border-radius: 10px;

      object-fit: cover;
    }

    .logo-text {
      font-weight: 800;

      letter-spacing: 1px;

      background:
        linear-gradient(
          to right,
          #60a5fa,
          #22d3ee,
          #a78bfa
        );

      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;

      font-size: 18px;
    }

    .btn-burger {
      background: none;
      border: none;

      color: #94a3b8;

      cursor: pointer;
    }

    .burger-icon {
      width: 24px;
      height: 24px;

      fill: currentColor;
    }

    main {
      flex: 1;

      max-width: 1100px;

      width: 100%;

      margin: 0 auto;

      padding:
        60px 24px;

      text-align: center;

      position: relative;

      z-index: 10;
    }

    h2 {
      font-size: 32px;

      font-weight: 900;

      color: white;

      margin-bottom: 8px;
    }

    .subtitle {
      font-size: 14px;

      color: #64748b;

      margin-bottom: 48px;
    }

    .section-title {
      font-size: 18px;

      font-weight: 800;

      color: #38bdf8;

      text-align: left;

      margin-top: 48px;

      margin-bottom: 24px;

      text-transform:
        uppercase;

      letter-spacing: 1px;

      border-left:
        4px solid #4f46e5;

      padding-left: 12px;
    }

    .pricing-grid {
      display: grid;

      grid-template-columns:
        1fr;

      gap: 20px;

      margin-bottom: 60px;
    }

    @media (min-width: 600px) {
      .pricing-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }
    }

    @media (min-width: 1000px) {
      .pricing-grid {
        grid-template-columns:
          repeat(4, 1fr);
      }
    }

    .price-card {
      background:
        rgba(15, 23, 42, 0.45);

      border:
        1px solid
        rgba(255, 255, 255, 0.04);

      border-radius: 20px;

      padding:
        32px 20px;

      text-align: center;

      display: flex;

      flex-direction: column;

      justify-content:
        space-between;

      min-height: 230px;

      box-shadow:
        0 10px 30px
        rgba(0, 0, 0, 0.3);

      transition:
        border-color 0.3s,
        box-shadow 0.3s,
        transform 0.2s;
    }

    .price-card:hover {
      border-color:
        rgba(6, 182, 212, 0.25);

      box-shadow:
        0 0 20px
        rgba(6, 182, 212, 0.1);

      transform:
        translateY(-3px);
    }

    .price-card.featured {
      border-color:
        rgba(139, 92, 246, 0.35);

      box-shadow:
        0 0 25px
        rgba(139, 92, 246, 0.15);
    }

    .featured-badge {
      display: inline-block;

      margin-bottom: 12px;

      padding:
        4px 9px;

      border-radius: 999px;

      background:
        rgba(139, 92, 246, 0.12);

      border:
        1px solid
        rgba(139, 92, 246, 0.25);

      color:
        #c084fc;

      font-size: 9px;

      font-weight: 800;

      letter-spacing:
        0.8px;

      text-transform:
        uppercase;
    }

    .card-title {
      font-size: 15px;

      font-weight: 800;

      color: white;

      margin-bottom: 12px;
    }

    .card-price {
      font-size: 28px;

      font-weight: 900;

      color: white;
    }

    .card-monthly {
      font-size: 11px;

      font-weight: 600;

      color: #a78bfa;

      margin-top: 4px;

      margin-bottom: 24px;
    }

    .card-description {
      font-size: 11px;

      color: #64748b;

      margin-bottom: 18px;
    }

    .btn-buy {
      width: 100%;

      padding: 12px;

      background:
        linear-gradient(
          135deg,
          #06b6d4,
          #4f46e5
        );

      color: white;

      font-size: 11px;

      font-weight: 700;

      text-transform:
        uppercase;

      letter-spacing:
        1px;

      border: none;

      border-radius: 12px;

      cursor: pointer;

      text-decoration: none;

      display: block;

      box-shadow:
        0 4px 10px
        rgba(79, 70, 229, 0.2);

      transition:
        transform 0.1s;
    }

    .btn-buy:active {
      transform:
        scale(0.98);
    }

    .free-card {
      background:
        rgba(15, 23, 42, 0.45);

      border:
        1px solid
        rgba(255, 255, 255, 0.04);

      border-radius: 24px;

      padding:
        32px 24px;

      text-align: left;

      box-shadow:
        0 10px 30px
        rgba(0, 0, 0, 0.3);
    }

    .free-title {
      font-size: 18px;

      font-weight: 800;

      color: white;

      margin-bottom: 6px;
    }

    .free-price {
      font-size: 32px;

      font-weight: 900;

      color: white;

      margin-bottom: 24px;
    }

    .free-price span {
      font-size: 13px;

      font-weight: 600;

      color: #475569;
    }

    .features-list {
      list-style: none;

      font-size: 12px;

      color: #94a3b8;
    }

    .features-list li {
      margin-bottom: 12px;

      display: flex;

      align-items: center;

      gap: 8px;
    }

    .check-icon {
      color: #34d399;

      font-weight: bold;
    }

    .empty-state {
      padding: 50px 20px;

      border:
        1px dashed
        rgba(255,255,255,0.08);

      border-radius: 20px;

      color: #64748b;

      font-size: 13px;
    }

    footer {
      border-top:
        1px solid #0f172a;

      padding: 24px;

      text-align: center;

      font-size: 12px;

      color: #475569;

      position: relative;

      z-index: 10;
    }
    .pricing-login-link{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 13px;border-radius:11px;text-decoration:none;background:linear-gradient(135deg,#6366f1,#8b5cf6);border:1px solid rgba(129,140,248,.35);color:#fff;font-size:11px;font-weight:800;box-shadow:0 10px 28px rgba(99,102,241,.16);margin-left:auto;margin-right:9px;transition:.2s}.pricing-login-link:hover{transform:translateY(-1px);box-shadow:0 14px 32px rgba(99,102,241,.23)}
    @media(max-width:520px){.pricing-login-link{padding:0 10px;font-size:10px}}
  </style>
</head>

<body>

  <div class="halo"></div>

  <header>
    <a
      href="/"
      class="logo-area"
    >
      <img
        src="/logo.png"
        id="logo-main-img"
        class="logo-img"
        alt="OMNIX Logo"
        onerror="
          this.style.display='none';
          document.getElementById('logo-fallback-box').style.display='flex';
        "
      >

      <div
        id="logo-fallback-box"
        style="
          display:none;
          width:38px;
          height:38px;
          border-radius:10px;
          background:linear-gradient(135deg,#06b6d4,#7c3aed);
          align-items:center;
          justify-content:center;
          font-weight:900;
          color:white;
          font-size:18px;
        "
      >
        O
      </div>

      <span class="logo-text">
        OMNIX
      </span>
    </a>

    <a
      href="/connexion"
      class="pricing-login-link"
      aria-label="Se connecter à OMNIX"
    >
      Connexion
    </a>

    <button
      onclick="openOmnixSidebar()"
      class="btn-burger"
      type="button"
    >
      <svg
        class="burger-icon"
        viewBox="0 0 24 24"
      >
        <path
          d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
        />
      </svg>
    </button>
  </header>

  <%- include('partials/sidebar') %>

  <main>

    <h2>
      Tarifs & Abonnements OMNIX
    </h2>

    <p class="subtitle">
      Choisissez la formule d'automatisation
      adaptée à votre communauté.
    </p>

    <h3 class="section-title">
      🟦 OMNIX Premium
    </h3>

    <div
      id="pricing-grid"
      class="pricing-grid"
    >
      <div class="empty-state">
        Chargement des offres...
      </div>
    </div>

    <div id="omnix-cart" style="margin-top:20px;padding:20px;border:1px solid rgba(255,255,255,.08);border-radius:16px;background:rgba(15,20,34,.8)">
      <h3 style="margin-top:0">🛒 Votre commande</h3>
      <p id="cart-empty" style="color:#8d98ad">Aucune offre sélectionnée.</p>
      <div id="cart-content" style="display:none">
        <div id="cart-offer"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">
          <input id="promo-code" placeholder="Code promo" style="padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.1);background:#0a111e;color:#fff">
          <button id="promo-apply" type="button" style="padding:10px 14px;border:0;border-radius:10px;background:#334155;color:#fff;cursor:pointer">Appliquer</button>
        </div>
        <div id="promo-result" style="margin-top:10px;color:#8d98ad"></div>
        <div id="cart-total" style="font-size:24px;font-weight:900;margin-top:14px"></div>
        <a id="cart-checkout" href="#" target="_blank" rel="noopener noreferrer" style="display:inline-block;margin-top:12px;padding:11px 16px;border-radius:10px;background:#7c5cff;color:#fff;text-decoration:none">Continuer vers le paiement</a>
      </div>
    </div>

    <h3 class="section-title">
      📊 Offre gratuite
    </h3>

    <div class="free-card">

      <h4 class="free-title">
        🆓 Free
      </h4>

      <p class="free-price">
        0 €
        <span>/ serveur</span>
      </p>

      <ul class="features-list">

        <li>
          <span class="check-icon">
            ✔
          </span>
          Modération basique
        </li>

        <li>
          <span class="check-icon">
            ✔
          </span>
          Tickets de support limités
        </li>

        <li>
          <span class="check-icon">
            ✔
          </span>
          Logs de salons simples
        </li>

        <li>
          <span class="check-icon">
            ✔
          </span>
          Commandes d'économie de base
        </li>

        <li>
          <span class="check-icon">
            ✔
          </span>
          Dashboard web limité
        </li>

      </ul>

    </div>

  </main>

  <footer>
    <p>
      &copy; 2026 OMNIX.
      Tous droits réservés.
    </p>
  </footer>

  <script>
    /* =========================================================
       SIDEBAR
    ========================================================= */

    function legacyToggleDrawer(open) {
      const drawer =
        document.getElementById(
          "side-drawer"
        );

      if (!drawer) {
        return;
      }

      drawer.classList.toggle(
        "open",
        Boolean(open)
      );
    }

    /* =========================================================
       PRICING
    ========================================================= */

    function formatPrice(
      price,
      currency = "EUR"
    ) {
      try {
        return new Intl.NumberFormat(
          "fr-FR",
          {
            style: "currency",
            currency,
            minimumFractionDigits: 2
          }
        ).format(
          Number(price)
        );
      } catch {
        return `${Number(price).toFixed(2)} €`;
      }
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function renderOffers(offers) {
      const grid =
        document.getElementById(
          "pricing-grid"
        );

      if (!grid) {
        return;
      }

      if (
        !Array.isArray(offers) ||
        offers.length === 0
      ) {
        grid.innerHTML = `
          <div class="empty-state">
            Aucune offre Premium n'est actuellement disponible.
          </div>
        `;

        return;
      }

      window.__OMNIX_OFFERS = offers;
      grid.innerHTML =
        offers
          .map((offer) => {

            const name =
              escapeHtml(
                offer.name
              );

            const duration =
              escapeHtml(
                offer.duration
              );

            const description =
              escapeHtml(
                offer.description || ""
              );

            const buttonText =
              escapeHtml(
                offer.buttonText ||
                "S'abonner"
              );

            const price =
              formatPrice(
                offer.price,
                offer.currency ||
                  "EUR"
              );

            const featured =
              Boolean(
                offer.featured
              );

            let monthlyText = "";

            if (
              Number(offer.durationDays) > 30
            ) {
              const monthly =
                Number(offer.price) /
                (
                  Number(
                    offer.durationDays
                  ) / 30
                );

              monthlyText =
                `~ ${formatPrice(
                  monthly,
                  offer.currency ||
                    "EUR"
                )} / mois`;
            } else {
              monthlyText =
                `${price} / mois`;
            }

            return `
              <div
                class="
                  price-card
                  ${featured ? "featured" : ""}
                "
              >

                <div>

                  ${
                    featured
                      ? `
                        <span class="featured-badge">
                          Offre recommandée
                        </span>
                      `
                      : ""
                  }

                  <h3 class="card-title">
                    ${name}
                  </h3>

                  <p class="card-price">
                    ${price}
                  </p>

                  <p class="card-monthly">
                    ${escapeHtml(
                      monthlyText
                    )}
                  </p>

                  ${
                    description
                      ? `
                        <p class="card-description">
                          ${description}
                        </p>
                      `
                      : ""
                  }

                  <p
                    style="
                      color:#64748b;
                      font-size:11px;
                      margin-bottom:18px;
                    "
                  >
                    ${duration}
                  </p>

                </div>

                <button type="button" class="btn-buy" data-offer-id="${escapeHtml(offer._id || offer.id || offer.slug)}">${buttonText}</button>

              </div>
            `;
          })
          .join("");
    }

    let selectedOffer = null;
    let promoState = null;
    function selectOffer(id){
      selectedOffer = (window.__OMNIX_OFFERS||[]).find(o=>String(o._id||o.id||o.slug)===String(id)) || null;
      promoState = null;
      renderCart();
    }
    function renderCart(){
      const empty=document.getElementById('cart-empty'), content=document.getElementById('cart-content');
      if(!selectedOffer){empty.style.display='block';content.style.display='none';return;}
      empty.style.display='none';content.style.display='block';
      document.getElementById('cart-offer').innerHTML=`<strong>${escapeHtml(selectedOffer.name)}</strong><div style="color:#8d98ad">${escapeHtml(selectedOffer.duration||'')}</div>`;
      const base=Number(selectedOffer.price||0); const discount=Number(promoState?.discount||0); document.getElementById('cart-total').textContent=formatPrice(Math.max(0,base-discount),selectedOffer.currency||'EUR');
      document.getElementById('promo-result').textContent=promoState?`Code ${promoState.code} appliqué : -${formatPrice(discount,selectedOffer.currency||'EUR')}`:'Code promo optionnel';
      const link=selectedOffer.stripeUrl||'#'; const checkout=document.getElementById('cart-checkout'); checkout.href=link; checkout.onclick=async(ev)=>{ if(!selectedOffer?.stripePriceId){ return; } ev.preventDefault(); try { const r=await fetch('/api/payments/checkout',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({priceId:selectedOffer.stripePriceId,tier:'premium',durationInDays:Number(selectedOffer.durationDays),promoCode:promoState?.code||''})}); const d=await r.json().catch(()=>({})); if(!r.ok||!d.success) throw new Error(d.error||'Paiement indisponible'); window.location.href=d.url; } catch(err) { document.getElementById('promo-result').textContent='❌ '+(err.message||'Paiement indisponible'); }; };
    }
    document.addEventListener('click',e=>{const b=e.target.closest('[data-offer-id]');if(b)selectOffer(b.dataset.offerId)});
    document.getElementById('promo-apply')?.addEventListener('click',async()=>{if(!selectedOffer)return;const code=document.getElementById('promo-code').value.trim();if(!code)return;try{const r=await fetch('/api/pricing/validate-promo',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({code,offerId:selectedOffer._id||selectedOffer.id})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Code invalide');promoState=d;renderCart()}catch(e){promoState=null;document.getElementById('promo-result').textContent='❌ '+e.message;renderCart()}});

    async function loadPricing() {
      const grid =
        document.getElementById(
          "pricing-grid"
        );

      try {

        const response =
          await fetch(
            "/api/pricing/offers",
            {
              method: "GET",
              credentials: "same-origin"
            }
          );

        const data =
          await response.json();

        if (
          !response.ok ||
          !data.success
        ) {
          throw new Error(
            data.error ||
            "Impossible de charger les offres."
          );
        }

        renderOffers(
          data.offers
        );

      } catch (error) {

        console.error(
          "[OMNIX] Pricing :",
          error
        );

        if (grid) {
          grid.innerHTML = `
            <div class="empty-state">
              Impossible de charger les offres actuellement.
            </div>
          `;
        }
      }
    }

    /* =========================================================
       ADMIN LINK
    ========================================================= */

    async function loadAdminLink() {
      try { const r=await fetch('/api/auth/me',{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}}); if(!r.ok)return; const d=await r.json(),u=d?.user; if(!u?.isAdmin&&!u?.isOwner)return; const nav=document.getElementById('drawer-nav'); if(!nav||document.getElementById('nav-admin-link'))return; const a=document.createElement('a'); a.href='/admin'; a.id='nav-admin-link'; a.className='admin-nav-link'; a.innerText='Staff Panel'; nav.appendChild(a); } catch {}
    }

    document.addEventListener(
      "DOMContentLoaded",
      () => {

        loadPricing();
        loadAdminLink();
      }
    );
  </script>

</body>
</html>