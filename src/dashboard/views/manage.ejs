<%
/* =========================================================
   OMNIX — MANAGE
   PARTIE 1/2 — STRUCTURE EJS / HTML
========================================================= */
const currentGuildId = guildId || "";
%>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <title>
    OMNIX — Gestion du serveur
  </title>
  <link
    rel="stylesheet"
    href="/css/dashboard.css"
  >
  <style>
    /* =====================================================
       MANAGE
    ===================================================== */
    .manage-page {
      min-height: 100vh;
      padding: 32px;
    }
    .manage-container {
      max-width: 1500px;
      margin: 0 auto;
    }
    .manage-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }
    .manage-title {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      color: #fff;
    }
    .manage-subtitle {
      margin: 8px 0 0;
      color: #94a3b8;
      font-size: 14px;
    }
    .license-card {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border-radius: 14px;
      background: rgba(15, 23, 42, .75);
      border: 1px solid rgba(255,255,255,.08);
    }
    .license-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .license-label {
      color: #fff;
      font-size: 13px;
      font-weight: 700;
    }
    .license-key {
      color:#cbd5e1;
      font-size:10px;
      font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
      letter-spacing:.3px;
    }
    .license-expiration {
      color: #64748b;
      font-size: 11px;
    }
    .badge-premium,
    .badge-free {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 60px;
      padding: 5px 9px;
      border-radius: 7px;
      font-size: 10px;
      font-weight: 800;
    }
    .badge-premium {
      color: #ddd6fe;
      background: rgba(124,58,237,.18);
      border: 1px solid rgba(167,139,250,.25);
    }
    .badge-free {
      color: #94a3b8;
      background: rgba(100,116,139,.12);
      border: 1px solid rgba(100,116,139,.2);
    }
    /* =====================================================
       LAYOUT
    ===================================================== */
    .manage-layout {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }
    .manage-tabs {
      position: sticky;
      top: 24px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      padding: 12px;
      border-radius: 16px;
      background: rgba(15,23,42,.72);
      border: 1px solid rgba(255,255,255,.07);
      backdrop-filter: blur(18px);
      max-height: calc(100vh - 48px);
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: rgba(99,102,241,.55) transparent;
    }
    .manage-tabs::-webkit-scrollbar { width: 5px; }
    .manage-tabs::-webkit-scrollbar-track { background: transparent; }
    .manage-tabs::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg,#6366f1,#06b6d4);
      border-radius: 999px;
    }
    .manage-tab-button {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 12px 13px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
      transition: .2s ease;
    }
    .manage-tab-button:hover {
      background: rgba(255,255,255,.05);
      color: #fff;
    }
    .manage-tab-button.active {
      background: rgba(79,70,229,.18);
      color: #fff;
      box-shadow: inset 3px 0 0 #6366f1;
    }
    .tab-icon {
      width: 22px;
      text-align: center;
      font-size: 15px;
    }
    /* =====================================================
       CONFIG PANEL
    ===================================================== */
    .config-panel {
      min-width: 0;
      padding: 24px;
      border-radius: 18px;
      background: rgba(15,23,42,.72);
      border: 1px solid rgba(255,255,255,.07);
      backdrop-filter: blur(18px);
    }
    .tab-content {
      display: block;
    }
    .tab-content.hidden {
      display: none;
    }
    .section-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
    }
    .section-title {
      margin: 0;
      color: #fff;
      font-size: 21px;
      font-weight: 800;
    }
    .section-description {
      margin: 7px 0 0;
      color: #64748b;
      font-size: 13px;
      line-height: 1.5;
    }
    .config-card {
      margin-bottom: 18px;
      padding: 20px;
      border-radius: 14px;
      background: rgba(2,6,23,.42);
      border: 1px solid rgba(255,255,255,.06);
    }
    .config-card:last-child {
      margin-bottom: 0;
    }
    .config-card-title {
      margin: 0 0 5px;
      color: #f8fafc;
      font-size: 14px;
      font-weight: 800;
    }
    .config-card-description {
      margin: 0 0 18px;
      color: #64748b;
      font-size: 12px;
    }
    /* =====================================================
       FORM
    ===================================================== */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .form-group {
      margin-bottom: 16px;
    }
    .form-group:last-child {
      margin-bottom: 0;
    }
    .form-group.full {
      grid-column: 1 / -1;
    }
    .form-group label {
      display: block;
      margin-bottom: 7px;
      color: #cbd5e1;
      font-size: 11px;
      font-weight: 700;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 11px 12px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 9px;
      outline: none;
      background: rgba(15,23,42,.85);
      color: #fff;
      font-family: inherit;
      font-size: 12px;
      transition: .2s ease;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 90px;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: rgba(99,102,241,.65);
      box-shadow: 0 0 0 3px rgba(99,102,241,.08);
    }
    .form-group input:disabled,
    .form-group select:disabled,
    .form-group textarea:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    /* =====================================================
       SWITCH
    ===================================================== */
    .switch-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .switch-row:last-child {
      border-bottom: 0;
    }
    .switch-title {
      color: #f8fafc;
      font-size: 13px;
      font-weight: 700;
    }
    .switch-description {
      margin-top: 4px;
      color: #64748b;
      font-size: 11px;
      line-height: 1.45;
    }
    .switch {
      position: relative;
      width: 46px;
      min-width: 46px;
      height: 24px;
    }
    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .slider {
      position: absolute;
      inset: 0;
      cursor: pointer;
      border-radius: 999px;
      background: #334155;
      transition: .2s ease;
    }
    .slider::before {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      left: 3px;
      top: 3px;
      border-radius: 50%;
      background: #fff;
      transition: .2s ease;
    }
    .switch input:checked + .slider {
      background: #4f46e5;
    }
    .switch input:checked + .slider::before {
      transform: translateX(22px);
    }
    .switch input:disabled + .slider {
      opacity: .4;
      cursor: not-allowed;
    }
    /* =====================================================
       BUTTONS
    ===================================================== */
    .manage-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 15px;
      border: 0;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .2s ease;
    }
    .manage-button:hover {
      transform: translateY(-1px);
    }
    .button-primary {
      background: #4f46e5;
      color: #fff;
    }
    .button-secondary {
      background: rgba(255,255,255,.06);
      color: #cbd5e1;
      border: 1px solid rgba(255,255,255,.08);
    }
    .button-danger {
      background: rgba(220,38,38,.14);
      color: #f87171;
      border: 1px solid rgba(220,38,38,.2);
    }
    .actions-bar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.06);
    }
    /* =====================================================
       TICKETS
    ===================================================== */
    #categories-container {
      margin-top: 15px;
    }
    .categories-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 14px;
    }
    .categories-title {
      color: #f8fafc;
      font-size: 13px;
      font-weight: 800;
    }
    /* =====================================================
       TOAST
    ===================================================== */
    #toast {
      position: fixed;
      right: 25px;
      bottom: 25px;
      z-index: 9999;
      padding: 13px 18px;
      border-radius: 10px;
      background: #16a34a;
      transform: translateX(140%);
      opacity: 0;
      transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .25s ease;
      border:1px solid rgba(255,255,255,.12);
    }
    #toast.show {
      transform: translateX(0);
      opacity:1;
    }
    #toast.error {
      background:#dc2626;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      box-shadow: 0 12px 30px rgba(0,0,0,.25);
    }
    #toast.hidden {
      display: none;
    }
    /* =====================================================
       ADVANCED DASHBOARD
    ===================================================== */
    .config-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .command-row,.backup-row{display:grid;grid-template-columns:1fr 1.5fr auto;gap:10px;align-items:start;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.06)}
    .command-row:last-child,.backup-row:last-child{border-bottom:0}
    .command-row input,.command-row textarea,.advanced-input{width:100%;padding:11px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.08);background:rgba(2,6,23,.55);color:#fff;outline:none}
    .command-row textarea{min-height:70px;resize:vertical}
    .command-list{margin-top:8px}
    .mini-actions{display:flex;gap:8px;flex-wrap:wrap}
    .btn-danger-soft{background:rgba(239,68,68,.10)!important;color:#fca5a5!important;border:1px solid rgba(239,68,68,.18)!important}
    .backup-status{display:inline-flex;align-items:center;gap:7px;color:#94a3b8;font-size:12px}
    .premium-note{padding:12px 14px;border-radius:12px;background:rgba(124,92,255,.08);border:1px solid rgba(124,92,255,.18);color:#c4b5fd;font-size:12px;line-height:1.5}
    .advanced-card{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .advanced-card .form-group.full{grid-column:1/-1}
    .field-hint{margin-top:5px;color:#64748b;font-size:11px}
    .save-bar{position:sticky;bottom:12px;z-index:20;margin-top:22px;padding:12px;border-radius:14px;background:rgba(8,11,20,.88);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.08);display:flex;justify-content:flex-end;gap:10px}
    /* =====================================================
       OMNIX MODERN PERSONALIZATION
    ===================================================== */
    .manage-button{border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px 13px;cursor:pointer;font-size:12px;font-weight:800;transition:.2s ease}.manage-button:hover{transform:translateY(-1px)}
    .button-secondary{background:rgba(255,255,255,.06);color:#fff}.button-secondary:hover{background:rgba(124,92,255,.16);border-color:rgba(124,92,255,.3)}
    .manage-page{background:radial-gradient(circle at 85% 0%,rgba(124,92,255,.10),transparent 32%),radial-gradient(circle at 10% 30%,rgba(16,185,129,.06),transparent 28%)}
    .manage-header{padding:18px 20px;border:1px solid rgba(255,255,255,.07);border-radius:20px;background:linear-gradient(135deg,rgba(15,23,42,.86),rgba(8,11,20,.72));box-shadow:0 18px 50px rgba(0,0,0,.18)}
    .manage-tabs{max-height:calc(100vh - 150px);overflow-y:auto;scrollbar-width:thin}.manage-tabs::-webkit-scrollbar{width:5px}.manage-tabs::-webkit-scrollbar-thumb{background:rgba(124,92,255,.45);border-radius:99px}
    .config-panel{background:linear-gradient(145deg,rgba(15,23,42,.78),rgba(8,11,20,.72));box-shadow:0 20px 60px rgba(0,0,0,.16)}
    .config-card{transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.config-card:hover{transform:translateY(-2px);border-color:rgba(124,92,255,.16);box-shadow:0 14px 35px rgba(0,0,0,.15)}
    body.omnix-compact .config-card{padding:14px;margin-bottom:12px}body.omnix-compact .switch-row{padding:10px 0}
    body.omnix-no-animations *,body.omnix-no-animations *::before,body.omnix-no-animations *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
    body.omnix-density-compact .manage-tabs{gap:4px;padding:8px}body.omnix-density-compact .manage-tab-button{padding:9px 11px}
    #manage-preferences{position:fixed;inset:0;z-index:11000;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(2,6,23,.72);backdrop-filter:blur(14px)}
    #manage-preferences.open{display:flex}.manage-pref-panel{width:min(720px,100%);max-height:min(760px,92vh);overflow:auto;border:1px solid rgba(255,255,255,.09);border-radius:22px;padding:22px;background:linear-gradient(145deg,#111827,#080b14);box-shadow:0 30px 90px rgba(0,0,0,.5)}
    .manage-pref-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}.manage-pref-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px;border:1px solid rgba(255,255,255,.06);border-radius:14px;background:rgba(255,255,255,.025);cursor:pointer}.manage-pref-row span{font-size:12px;font-weight:800}.manage-pref-row small{display:block;color:#64748b;font-size:10px;font-weight:500;margin-top:4px}.manage-pref-row input{width:18px;height:18px;accent-color:#7c5cff}.manage-pref-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:18px}
    #manage-pref-toast{position:fixed;right:22px;bottom:22px;z-index:12000;min-width:250px;max-width:380px;padding:14px 16px;border-radius:14px;color:#fff;font-size:12px;font-weight:800;box-shadow:0 18px 45px rgba(0,0,0,.35);transform:translateX(130%);opacity:0;transition:.38s cubic-bezier(.2,.8,.2,1)}#manage-pref-toast.show{transform:translateX(0);opacity:1}#manage-pref-toast.success{background:#059669;border:1px solid rgba(110,231,183,.25)}#manage-pref-toast.error{background:#dc2626;border:1px solid rgba(252,165,165,.25)}

    /* =====================================================
       RESPONSIVE
    ===================================================== */
    @media (max-width: 1000px) {
      .manage-layout {
        grid-template-columns: 1fr;
      }
      .manage-tabs {
        position: static;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }
    }
    @media (max-width: 700px) {
      .manage-page {
        padding: 16px;
      }
      .manage-header {
        flex-direction: column;
        align-items: stretch;
      }
      .manage-tabs {
        grid-template-columns: repeat(2, 1fr);
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
      .form-group.full {
        grid-column: auto;
      }
      .config-panel {
        padding: 16px;
      }
    }

    /* =====================================================
       OMNIX GLOBAL THEME — ALIGNEMENT AVEC LES PAGES PUBLIQUES
       Override visuel uniquement : aucune logique métier modifiée.
    ===================================================== */
    :root{
      --om-bg:#030712;
      --om-bg-2:#070b16;
      --om-panel:rgba(10,15,29,.72);
      --om-panel-strong:rgba(15,23,42,.86);
      --om-line:rgba(148,163,184,.12);
      --om-text:#f8fafc;
      --om-muted:#94a3b8;
      --om-dim:#64748b;
      --om-cyan:#06b6d4;
      --om-indigo:#6366f1;
      --om-violet:#8b5cf6;
    }
    html{background:var(--om-bg)!important;}
    body{
      min-height:100vh!important;
      margin:0!important;
      color:var(--om-text)!important;
      background:
        radial-gradient(circle at 12% -10%,rgba(99,102,241,.20),transparent 34%),
        radial-gradient(circle at 92% 12%,rgba(6,182,212,.10),transparent 28%),
        radial-gradient(circle at 52% 100%,rgba(139,92,246,.07),transparent 34%),
        linear-gradient(180deg,#030712 0%,#050914 52%,#030712 100%)!important;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif!important;
      overflow-x:hidden!important;
      position:relative;
    }
    body::before{
      content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;opacity:.14;
      background-image:linear-gradient(rgba(148,163,184,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.055) 1px,transparent 1px);
      background-size:48px 48px;
      mask-image:linear-gradient(to bottom,#000 0%,transparent 92%);
    }
    .manage-page{
      min-height:100vh!important;
      padding:32px!important;
      background:transparent!important;
    }
    .manage-container{width:min(1320px,100%)!important;max-width:1320px!important;margin:0 auto!important;}
    .manage-header{
      position:relative!important;overflow:hidden!important;
      min-height:86px!important;padding:18px 20px!important;
      border:1px solid rgba(148,163,184,.13)!important;border-radius:20px!important;
      background:linear-gradient(135deg,rgba(15,23,42,.82),rgba(3,7,18,.70))!important;
      box-shadow:0 24px 70px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.035)!important;
      backdrop-filter:blur(20px)!important;-webkit-backdrop-filter:blur(20px)!important;
    }
    .manage-header::after{
      content:"";position:absolute;width:320px;height:150px;right:-100px;top:-100px;
      background:rgba(99,102,241,.17);filter:blur(65px);pointer-events:none;
    }
    .manage-title{position:relative;z-index:1;font-size:26px!important;letter-spacing:-.5px!important;}
    .manage-subtitle{position:relative;z-index:1;color:#64748b!important;}
    .license-card{
      position:relative;z-index:2!important;
      background:rgba(255,255,255,.025)!important;
      border:1px solid rgba(103,232,249,.13)!important;
      border-radius:14px!important;
      box-shadow:0 10px 30px rgba(0,0,0,.18)!important;
    }
    .badge-premium{background:linear-gradient(135deg,rgba(99,102,241,.22),rgba(139,92,246,.14))!important;color:#c4b5fd!important;border-color:rgba(167,139,250,.28)!important;}
    .badge-free{background:rgba(100,116,139,.10)!important;color:#94a3b8!important;}
    .manage-layout{grid-template-columns:230px minmax(0,1fr)!important;gap:18px!important;margin-top:18px!important;}
    .manage-tabs{
      position:sticky!important;top:20px!important;
      max-height:calc(100vh - 40px)!important;overflow-y:auto!important;
      padding:10px!important;gap:4px!important;
      border:1px solid rgba(148,163,184,.11)!important;border-radius:18px!important;
      background:rgba(8,13,25,.68)!important;
      box-shadow:0 20px 55px rgba(0,0,0,.20)!important;
      backdrop-filter:blur(20px)!important;-webkit-backdrop-filter:blur(20px)!important;
    }
    .manage-tabs::-webkit-scrollbar{width:4px!important}.manage-tabs::-webkit-scrollbar-thumb{background:linear-gradient(#6366f1,#06b6d4)!important;border-radius:99px!important}
    .manage-tab-button{
      min-height:42px!important;padding:10px 12px!important;border:1px solid transparent!important;
      border-radius:12px!important;color:#8d98ad!important;font-size:11px!important;
      background:transparent!important;transition:.22s ease!important;
    }
    .manage-tab-button:hover{color:#fff!important;background:rgba(255,255,255,.035)!important;border-color:rgba(148,163,184,.08)!important;transform:translateX(2px);}
    .manage-tab-button.active{
      color:#fff!important;
      background:linear-gradient(135deg,rgba(99,102,241,.18),rgba(6,182,212,.07))!important;
      border-color:rgba(99,102,241,.20)!important;
      box-shadow:inset 3px 0 0 #6366f1,0 8px 22px rgba(79,70,229,.08)!important;
    }
    .tab-icon{color:#67e8f9!important;width:20px!important;}
    .config-panel{
      min-height:620px!important;padding:24px!important;
      border:1px solid rgba(148,163,184,.11)!important;border-radius:20px!important;
      background:linear-gradient(145deg,rgba(15,23,42,.72),rgba(3,7,18,.72))!important;
      box-shadow:0 25px 75px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.025)!important;
      backdrop-filter:blur(18px)!important;-webkit-backdrop-filter:blur(18px)!important;
    }
    .section-title{font-size:20px!important;letter-spacing:-.25px!important}.section-description{color:#64748b!important}
    .config-card{
      background:rgba(2,6,23,.34)!important;border:1px solid rgba(148,163,184,.08)!important;
      border-radius:16px!important;padding:18px!important;
    }
