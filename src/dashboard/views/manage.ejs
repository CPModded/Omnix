<script>
  const guildId = "<%= guildId %>";
  /* =========================================================
     SESSION
  ========================================================= */
  function getToken() {
    try {
      const token = localStorage.getItem("jwt_token");
      if (token) {
        document.cookie =
          `jwt_token=${encodeURIComponent(token)}; ` +
          `path=/; ` +
          `max-age=604800; ` +
          `SameSite=Lax; ` +
          `Secure`;
      }
      return token;
    } catch (error) {
      console.error("[OMNIX] Impossible de récupérer le token :", error);
      return null;
    }
  }
  function setToken(token) {
    try {
      if (!token) return;
      localStorage.setItem("jwt_token", token);
      document.cookie =
        `jwt_token=${encodeURIComponent(token)}; ` +
        `path=/; ` +
        `max-age=604800; ` +
        `SameSite=Lax; ` +
        `Secure`;
    } catch (error) {
      console.error("[OMNIX] Échec de synchronisation de la session :", error);
    }
  }
  function logout() {
    try {
      localStorage.removeItem("jwt_token");
      document.cookie =
        "jwt_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC; SameSite=Lax; Secure";
    } catch (error) {
      console.error("[OMNIX] Erreur lors de la déconnexion :", error);
    }
    window.location.href = "/";
  }
  function parseJwt(token) {
    if (
      !token ||
      token === "null" ||
      token === "undefined" ||
      !token.includes(".")
    ) {
      return null;
    }
    try {
      const base64Url = token.split(".")[1];
      if (!base64Url) return null;
      const base64 = base64Url
        .replace(/-/g, "+")
        .replace(/_/g, "/");
      const pad = base64.length % 4;
      const paddedBase64 = pad
        ? base64 + "=".repeat(4 - pad)
        : base64;
      const rawBinary = window.atob(paddedBase64);
      const bytes = new Uint8Array(rawBinary.length);
      for (let i = 0; i < rawBinary.length; i++) {
        bytes[i] = rawBinary.charCodeAt(i);
      }
      const decoder = new TextDecoder("utf-8");
      return JSON.parse(decoder.decode(bytes));
    } catch (error) {
      console.warn("[OMNIX] JWT invalide ou illisible.");
      return null;
    }
  }
  const jwtToken = getToken();
  if (!jwtToken) {
    window.location.href = "/";
  }
  /* =========================================================
     DRAWER
     
     Le sidebar centralisé reste chargé par :
     
     <%- include('partials/sidebar') %>
     
     On ne recrée PAS le sidebar ici.
  ========================================================= */
  function legacyToggleDrawer(open) {
    const drawer = document.getElementById("side-drawer");
    if (!drawer) {
      console.warn("[OMNIX] #side-drawer introuvable dans le sidebar.");
      return;
    }
    drawer.classList.toggle("open", Boolean(open));
  }
  /* =========================================================
     ONGLETS MANAGE
  ========================================================= */
  const MANAGE_TAB_BUTTONS = [
    "btn-tab-general",
    "btn-tab-welcome",
    "btn-tab-moderation",
    "btn-tab-tickets",
    "btn-tab-economy",
    "btn-tab-ai",
    "btn-tab-backups"
  ];
  function switchTab(tabId) {
    const target = document.getElementById(tabId);
    if (!target) {
      console.error(
        `[OMNIX] Onglet introuvable : ${tabId}`
      );
      return;
    }
    /*
     * Masque uniquement les sections du panneau Manage.
     * Aucun élément du sidebar n'est touché.
     */
    document
      .querySelectorAll(".config-panel > .tab-content")
      .forEach((section) => {
        section.classList.add("hidden");
      });
    target.classList.remove("hidden");
    /*
     * Réinitialisation uniquement des boutons Manage.
     *
     * IMPORTANT :
     * On ne fait plus :
     *
     * document.querySelectorAll('aside button')
     *
     * car cela pourrait toucher le sidebar centralisé.
     */
    MANAGE_TAB_BUTTONS.forEach((buttonId) => {
      const button = document.getElementById(buttonId);
      if (button) {
        button.classList.remove("active");
      }
    });
    /*
     * Correspondance explicite entre les sections
     * et leurs boutons.
     *
     * Cela corrige notamment :
     *
     * tab-overview -> btn-tab-general
     *
     * qui était cassé dans l'ancien code.
     */
    const tabButtonMap = {
      "tab-overview": "btn-tab-general",
      "tab-welcome": "btn-tab-welcome",
      "tab-moderation": "btn-tab-moderation",
      "tab-tickets": "btn-tab-tickets",
      "tab-economy": "btn-tab-economy",
      "tab-ai": "btn-tab-ai",
      "tab-backups": "btn-tab-backups"
    };
    const activeButtonId = tabButtonMap[tabId];
    if (activeButtonId) {
      const activeButton =
        document.getElementById(activeButtonId);
      if (activeButton) {
        activeButton.classList.add("active");
      }
    }
  }
  /* =========================================================
     CATÉGORIES TICKETS
  ========================================================= */
  let activeCategories = [];
  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
  function renderCategories() {
    const container =
      document.getElementById("categories-container");
    if (!container) {
      console.error(
        "[OMNIX] #categories-container introuvable."
      );
      return;
    }
    container.innerHTML = "";
    if (!Array.isArray(activeCategories) || activeCategories.length === 0) {
      container.innerHTML = `
        <div style="
          text-align:center;
          color:#475569;
          font-size:12px;
          padding:24px 0;
        ">
          Aucune catégorie personnalisée active.
          Cliquez sur "+ Ajouter" pour en créer une.
        </div>
      `;
      return;
    }
    activeCategories.forEach((cat, index) => {
      const block = document.createElement("div");
      block.className = "switch-row";
      block.style.flexDirection = "column";
      block.style.alignItems = "stretch";
      block.style.gap = "16px";
      block.style.padding = "20px";
      block.style.marginBottom = "16px";
      const emoji = escapeHtml(cat?.emoji || "🎫");
      const name = escapeHtml(cat?.name || "Nouvelle catégorie");
      const targetId = escapeHtml(cat?.targetId || "");
      const welcomeMessage = escapeHtml(
        cat?.welcomeMessage || ""
      );
      const type = cat?.type || "category";
      block.innerHTML = `
        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
          border-bottom:1px solid rgba(255,255,255,0.05);
          padding-bottom:12px;
        ">
          <div style="
            display:flex;
            align-items:center;
            gap:8px;
            flex:1;
          ">
            <input
              type="text"
              value="${emoji}"
              id="cat-emoji-${index}"
              style="
                width:44px;
                text-align:center;
                padding:8px;
                border-radius:8px;
              "
              placeholder="🎫"
              maxlength="8"
            >
            <input
              type="text"
              value="${name}"
              id="cat-name-${index}"
              style="
                font-weight:700;
                color:white;
                background:none;
                border:none;
                font-size:14px;
                flex:1;
              "
              placeholder="Nom de la catégorie"
            >
          </div>
          <button
            type="button"
            onclick="deleteCategory(${index})"
            style="
              background:rgba(220,38,38,0.15);
              color:#f87171;
              border:1px solid rgba(220,38,38,0.25);
              padding:6px 12px;
              border-radius:8px;
              font-size:11px;
              font-weight:700;
              cursor:pointer;
            "
          >
            Supprimer
          </button>
        </div>
        <div class="form-grid">
          <div
            class="form-group"
            style="margin-bottom:0;"
          >
            <label>Routage (Où ouvrir les tickets)</label>
            <select
              id="cat-type-${index}"
              style="
                padding:10px;
                border-radius:8px;
              "
            >
              <option
                value="category"
                ${type === "category" ? "selected" : ""}
              >
                Catégorie Discord (Nouveau salon)
              </option>
              <option
                value="channel"
                ${type === "channel" ? "selected" : ""}
              >
                Dans un salon existant (Nouveau salon)
              </option>
              <option
                value="thread"
                ${type === "thread" ? "selected" : ""}
              >
                Fil de discussion (Thread)
              </option>
            </select>
          </div>
          <div
            class="form-group"
            style="margin-bottom:0;"
          >
            <label>ID cible (Catégorie ou Salon Discord)</label>
            <input
              type="text"
              value="${targetId}"
              id="cat-target-${index}"
              style="
                padding:10px;
                border-radius:8px;
              "
              placeholder="Ex: 1211490202246189167"
            >
          </div>
        </div>
        <div
          class="form-group"
          style="
            margin-bottom:0;
            margin-top:8px;
          "
        >
          <label>
            Message de bienvenue à l'entrée du ticket
          </label>
          <textarea
            id="cat-welcome-${index}"
            rows="2"
            style="
              padding:10px;
              font-size:12px;
              border-radius:8px;
            "
            placeholder="Variables autorisées : {user}"
          >${welcomeMessage}</textarea>
        </div>
      `;
      container.appendChild(block);
    });
  }
  function addCategoryRow() {
    activeCategories.push({
      id:
        "cat_" +
        Math.random()
          .toString(36)
          .substring(2, 10),
      name: "Nouvelle catégorie",
      emoji: "🎫",
      type: "category",
      targetId: null,
      welcomeMessage:
        "Bonjour {user}, un conseiller prend en charge votre demande. Décrivez votre problème."
    });
    renderCategories();
  }
  function deleteCategory(index) {
    if (
      !Number.isInteger(index) ||
      index < 0 ||
      index >= activeCategories.length
    ) {
      return;
    }
    activeCategories.splice(index, 1);
    renderCategories();
  }
  /* =========================================================
     SYNCHRONISATION DES TOGGLES
  ========================================================= */
  function setupCheckboxSync() {
    const pairs = [
      {
        main: "ai-enabled",
        toggle: "ai-enabled-toggle"
      },
      {
        main: "backups-enabled",
        toggle: "backups-enabled-toggle"
      },
      {
        main: "economy-enabled",
        toggle: "economy-enabled-toggle"
      },
      {
        main: "moderation-enabled",
        toggle: "moderation-enabled-toggle"
      },
      {
        main: "tickets-enabled",
        toggle: "tickets-enabled-toggle"
      }
    ];
    pairs.forEach(({ main, toggle }) => {
      const mainEl = document.getElementById(main);
      const toggleEl = document.getElementById(toggle);
      if (!mainEl || !toggleEl) {
        console.warn(
          `[OMNIX] Synchronisation impossible : ${main} / ${toggle}`
        );
        return;
      }
      mainEl.addEventListener("change", (event) => {
        toggleEl.checked =
          Boolean(event.target.checked);
      });
      toggleEl.addEventListener("change", (event) => {
        mainEl.checked =
          Boolean(event.target.checked);
      });
    });
  }
  /* =========================================================
     PREMIUM
  ========================================================= */
  function addPremiumLockLabel(elementId) {
    const element =
      document.getElementById(elementId);
    if (!element) return;
    const row =
      element.closest(".switch-row");
    if (!row) return;
    const title =
      row.querySelector(".switch-title");
    if (!title) return;
    if (title.querySelector(".premium-lock-label")) {
      return;
    }
    const badge =
      document.createElement("span");
    badge.className =
      "premium-lock-label";
    badge.style.cssText = `
      color:#a78bfa;
      font-size:10px;
      font-weight:800;
      background:rgba(124,58,237,0.1);
      padding:2px 6px;
      border-radius:4px;
      margin-left:6px;
    `;
    badge.textContent = "🔒 Premium";
    title.appendChild(badge);
  }
  function setPremiumState(isPremium) {
    const premiumControls = [
      "ai-enabled-toggle",
      "ai-enabled",
      "ai-prompt",
      "backups-enabled-toggle",
      "backups-enabled",
      "honeypot-enabled",
      "honeypot-channel"
    ];
    premiumControls.forEach((id) => {
      const element =
        document.getElementById(id);
      if (element) {
        element.disabled = !isPremium;
      }
    });
    const aiPrompt =
      document.getElementById("ai-prompt");
    if (aiPrompt) {
      aiPrompt.placeholder = isPremium
        ? ""
        : "🔒 Module Premium - Pour personnaliser le prompt, activez un abonnement OMNIX.";
    }
    const honeypotChannel =
      document.getElementById("honeypot-channel");
    if (honeypotChannel) {
      honeypotChannel.placeholder = isPremium
        ? "Ex: 1211490202246189167"
        : "🔒 Entrez votre ID de salon piégé (Abonnement requis)";
    }
    addPremiumLockLabel("ai-enabled-toggle");
    addPremiumLockLabel("backups-enabled-toggle");
    addPremiumLockLabel("honeypot-enabled");
    const backupBtn =
      document.getElementById("backup-btn");
    if (!backupBtn) return;
    backupBtn.disabled = !isPremium;
    if (!isPremium) {
      backupBtn.innerText =
        "🔒 Sauvegardes (Premium Uniquement)";
      backupBtn.style.background = "#1e293b";
      backupBtn.style.color = "#64748b";
      backupBtn.style.border = "1px solid #334155";
      backupBtn.style.cursor = "not-allowed";
      backupBtn.style.boxShadow = "none";
    } else {
      backupBtn.innerText =
        "Créer un instantané manuel";
      backupBtn.style.background = "#4f46e5";
      backupBtn.style.color = "white";
      backupBtn.style.border = "none";
      backupBtn.style.cursor = "pointer";
      backupBtn.style.boxShadow = "";
    }
  }
  /* =========================================================
     CHARGEMENT CONFIGURATION
  ========================================================= */
  async function loadConfig() {
    try {
      const response = await fetch(
        `/api/guilds/${guildId}/config`,
        {
          headers: jwtToken
            ? {
                Authorization:
                  `Bearer ${jwtToken}`
              }
            : {},
          credentials: "same-origin"
        }
      );
      if (!response.ok) {
        const errData =
          await response
            .json()
            .catch(() => ({}));
        throw new Error(
          errData.details ||
          errData.error ||
          errData.message ||
          `Erreur HTTP ${response.status}`
        );
      }
      const config =
        await response.json();
      /* -------------------------------------------------------
         LICENCE
      ------------------------------------------------------- */
      const payload =
        parseJwt(jwtToken);
      const isUserPremium =
        Boolean(
          payload &&
          (
            payload.isPremium ||
            payload.isAdmin
          )
        );
      const isGuildPremium =
        Boolean(
          config?.premium?.isPremium
        );
      const isPremium =
        isGuildPremium ||
        isUserPremium;
      const licenseLabel =
        document.getElementById(
          "license-label"
        );
      const licenseExpiration =
        document.getElementById(
          "license-expiration"
        );
      const badge =
        document.getElementById(
          "license-badge"
        );
      if (isPremium) {
        const tier =
          config?.premium?.tier;
        licenseLabel.innerText =
          isGuildPremium && tier
            ? `Premium Activé (${String(tier).toUpperCase()})`
            : "Premium Actif (Licence Utilisateur Personnelle)";
        badge.className =
          "badge-premium";
        badge.innerText =
          "PREMIUM";
        if (
          config?.premium?.expiresAt
        ) {
          licenseExpiration.innerText =
            `Expiration : ${new Date(
              config.premium.expiresAt
            ).toLocaleDateString("fr-FR")}`;
        } else {
          licenseExpiration.innerText = "";
        }
      } else {
        licenseLabel.innerText =
          "Version d'évaluation standard";
        badge.className =
          "badge-free";
        badge.innerText =
          "FREE";
        licenseExpiration.innerText =
          "";
      }
      /* -------------------------------------------------------
         PREMIUM
      ------------------------------------------------------- */
      setPremiumState(isPremium);
      if (!isPremium) {
        addTerminalLog(
          "warn",
          "Vérification : Ce serveur n'est pas licencié Premium. Modules Premium verrouillés."
        );
      }
      /* -------------------------------------------------------
         WELCOME
      ------------------------------------------------------- */
      const welcome =
        config?.modules?.welcome || {};
      document.getElementById(
        "welcome-enabled"
      ).checked =
        Boolean(welcome.enabled);
      document.getElementById(
        "welcome-message"
      ).value =
        welcome.message ||
        "Bienvenue {user} !";
      document.getElementById(
        "welcome-channel"
      ).value =
        welcome.channelId || "";
      /* -------------------------------------------------------
         GOODBYE
      ------------------------------------------------------- */
      const goodbye =
        config?.modules?.goodbye || {};
      document.getElementById(
        "goodbye-enabled"
      ).checked =
        Boolean(goodbye.enabled);
      document.getElementById(
        "goodbye-message"
      ).value =
        goodbye.message ||
        "Au revoir {user}...";
      document.getElementById(
        "goodbye-channel"
      ).value =
        goodbye.channelId || "";
      /* -------------------------------------------------------
         MODERATION
      ------------------------------------------------------- */
      const moderation =
        config?.modules?.moderation || {};
      document.getElementById(
        "moderation-enabled"
      ).checked =
        Boolean(moderation.enabled);
      document.getElementById(
        "moderation-log"
      ).value =
        moderation.logChannelId || "";
      /* -------------------------------------------------------
         AUTOMOD
      ------------------------------------------------------- */
      const autoMod =
        config?.modules?.autoMod || {};
      document.getElementById(
        "automod-enabled"
      ).checked =
        Boolean(autoMod.enabled);
      document.getElementById(
        "automod-words"
      ).value =
        Array.isArray(
          autoMod.blacklistedWords
        )
          ? autoMod.blacklistedWords.join(", ")
          : "";
      /* -------------------------------------------------------
         HONEYPOT
      ------------------------------------------------------- */
      const honeypot =
        config?.modules?.honeypot || {};
      document.getElementById(
        "honeypot-enabled"
      ).checked =
        Boolean(honeypot.enabled);
      document.getElementById(
        "honeypot-channel"
      ).value =
        honeypot.channelId || "";
      /* -------------------------------------------------------
         TICKETS
      ------------------------------------------------------- */
      const tickets =
        config?.modules?.tickets || {};
      document.getElementById(
        "tickets-enabled"
      ).checked =
        Boolean(tickets.enabled);
      document.getElementById(
        "tickets-category"
      ).value =
        tickets.categoryId || "";
      activeCategories =
        Array.isArray(
          tickets.categoriesList
        )
          ? tickets.categoriesList
          : [];
      renderCategories();
      /* -------------------------------------------------------
         ECONOMY
      ------------------------------------------------------- */
      const economy =
        config?.modules?.economy || {};
      document.getElementById(
        "economy-enabled"
      ).checked =
        Boolean(economy.enabled);
      document.getElementById(
        "economy-symbol"
      ).value =
        economy.currencySymbol || "$";
      document.getElementById(
        "economy-cooldown"
      ).value =
        Number.isFinite(
          Number(economy.workCooldownMinutes)
        )
          ? economy.workCooldownMinutes
          : 60;
      /* -------------------------------------------------------
         LEVELS
      ------------------------------------------------------- */
      const levels =
        config?.modules?.levels || {};
      document.getElementById(
        "levels-enabled"
      ).checked =
        Boolean(levels.enabled);
      document.getElementById(
        "levels-xp"
      ).value =
        Number.isFinite(
          Number(levels.xpPerMessage)
        )
          ? levels.xpPerMessage
          : 15;
      /* -------------------------------------------------------
         IA
      ------------------------------------------------------- */
      const ai =
        config?.modules?.ai || {};
      document.getElementById(
        "ai-enabled"
      ).checked =
        Boolean(ai.enabled);
      document.getElementById(
        "ai-prompt"
      ).value =
        ai.systemPrompt ||
        "Tu es un assistant utile sur ce serveur Discord.";
      /* -------------------------------------------------------
         BACKUPS
      ------------------------------------------------------- */
      const backups =
        config?.modules?.backups || {};
      document.getElementById(
        "backups-enabled"
      ).checked =
        Boolean(backups.enabled);
      /* -------------------------------------------------------
         TOGGLES VUE D'ENSEMBLE
      ------------------------------------------------------- */
      document.getElementById(
        "ai-enabled-toggle"
      ).checked =
        Boolean(ai.enabled);
      document.getElementById(
        "backups-enabled-toggle"
      ).checked =
        Boolean(backups.enabled);
      document.getElementById(
        "economy-enabled-toggle"
      ).checked =
        Boolean(economy.enabled);
      document.getElementById(
        "moderation-enabled-toggle"
      ).checked =
        Boolean(moderation.enabled);
      document.getElementById(
        "tickets-enabled-toggle"
      ).checked =
        Boolean(tickets.enabled);
      /* -------------------------------------------------------
         PING
         
         CORRECTION IMPORTANTE :
         
         Ancien code :
         config.modules?.ping?.enabled || true
         
         false devenait true.
      ------------------------------------------------------- */
      const ping =
        config?.modules?.ping || {};
      document.getElementById(
        "ping-enabled-toggle"
      ).checked =
        ping.enabled !== undefined
          ? Boolean(ping.enabled)
          : true;
    } catch (error) {
      console.error(
        "[OMNIX] Erreur loadConfig :",
        error
      );
      alert(
        "Impossible de charger les configurations :\n\n" +
        error.message
      );
      window.location.href =
        "/dashboard";
    }
  }
  /* =========================================================
     SAUVEGARDE CONFIGURATION
  ========================================================= */
  async function saveConfig() {
    try {
      /*
       * On reconstruit la liste des catégories
       * à partir des champs réellement présents.
       */
      const updatedCategoriesList =
        activeCategories.map((cat, index) => {
          const nameEl =
            document.getElementById(
              `cat-name-${index}`
            );
          const emojiEl =
            document.getElementById(
              `cat-emoji-${index}`
            );
          const typeEl =
            document.getElementById(
              `cat-type-${index}`
            );
          const targetEl =
            document.getElementById(
              `cat-target-${index}`
            );
          const welcomeEl =
            document.getElementById(
              `cat-welcome-${index}`
            );
          return {
            id: cat?.id || `cat_${index}`,
            name:
              nameEl?.value?.trim() ||
              "Nouvelle catégorie",
            emoji:
              emojiEl?.value?.trim() ||
              "🎫",
            type:
              typeEl?.value ||
              "category",
            targetId:
              targetEl?.value?.trim() ||
              null,
            welcomeMessage:
              welcomeEl?.value ||
              ""
          };
        });
      const payload = {
        modules: {
          welcome: {
            enabled:
              document.getElementById(
                "welcome-enabled"
              ).checked,
            message:
              document.getElementById(
                "welcome-message"
              ).value,
            channelId:
              document.getElementById(
                "welcome-channel"
              ).value.trim() || null,
            useEmbed: false
          },
          goodbye: {
            enabled:
              document.getElementById(
                "goodbye-enabled"
              ).checked,
            message:
              document.getElementById(
                "goodbye-message"
              ).value,
            channelId:
              document.getElementById(
                "goodbye-channel"
              ).value.trim() || null,
            useEmbed: false
          },
          moderation: {
            enabled:
              document.getElementById(
                "moderation-enabled"
              ).checked ||
              document.getElementById(
                "moderation-enabled-toggle"
              ).checked,
            logChannelId:
              document.getElementById(
                "moderation-log"
              ).value.trim() || null
          },
          autoMod: {
            enabled:
              document.getElementById(
                "automod-enabled"
              ).checked,
            blacklistedWords:
              document
                .getElementById(
                  "automod-words"
                )
                .value
                .split(",")
                .map((word) => word.trim())
                .filter(Boolean)
          },
          tickets: {
            enabled:
              document.getElementById(
                "tickets-enabled"
              ).checked ||
              document.getElementById(
                "tickets-enabled-toggle"
              ).checked,
            categoryId:
              document.getElementById(
                "tickets-category"
              ).value.trim() || null,
            counter:
              Number.isFinite(
                Number(
                  config?.modules?.tickets?.counter
                )
              )
                ? Number(
                    config.modules.tickets.counter
                  )
                : 0,
            categoriesList:
              updatedCategoriesList
          },
          economy: {
            enabled:
              document.getElementById(
                "economy-enabled"
              ).checked ||
              document.getElementById(
                "economy-enabled-toggle"
              ).checked,
            currencySymbol:
              document.getElementById(
                "economy-symbol"
              ).value || "$",
            workCooldownMinutes:
              parseInt(
                document.getElementById(
                  "economy-cooldown"
                ).value,
                10
              ) || 60
          },
          levels: {
            enabled:
              document.getElementById(
                "levels-enabled"
              ).checked,
            xpPerMessage:
              parseInt(
                document.getElementById(
                  "levels-xp"
                ).value,
                10
              ) || 15,
            rewardRoles: []
          },
          ai: {
            enabled:
              document.getElementById(
                "ai-enabled"
              ).checked ||
              document.getElementById(
                "ai-enabled-toggle"
              ).checked,
            systemPrompt:
              document.getElementById(
                "ai-prompt"
              ).value,
            contextLimit: 10
          },
          backups: {
            enabled:
              document.getElementById(
                "backups-enabled"
              ).checked ||
              document.getElementById(
                "backups-enabled-toggle"
              ).checked
          },
          ping: {
            enabled:
              document.getElementById(
                "ping-enabled-toggle"
              ).checked
          },
          honeypot: {
            enabled:
              document.getElementById(
                "honeypot-enabled"
              ).checked,
            channelId:
              document.getElementById(
                "honeypot-channel"
              ).value.trim() || null
          }
        }
      };
      /* -------------------------------------------------------
         PUT /api/guilds/:guildId/config
         
         ROUTE CONSERVÉE
      ------------------------------------------------------- */
      const response = await fetch(
        `/api/guilds/${guildId}/config`,
        {
          method: "PUT",
          headers: {
            ...(jwtToken
              ? {
                  Authorization:
                    `Bearer ${jwtToken}`
                }
              : {}),
            "Content-Type":
              "application/json"
          },
          credentials:
            "same-origin",
          body:
            JSON.stringify(payload)
        }
      );
      if (!response.ok) {
        const errData =
          await response
            .json()
            .catch(() => ({}));
        throw new Error(
          errData.message ||
          errData.error ||
          errData.details ||
          `Erreur HTTP ${response.status}`
        );
      }
      const toast =
        document.getElementById("toast");
      if (toast) {
        toast.classList.remove("hidden");
        setTimeout(() => {
          toast.classList.add("hidden");
        }, 3000);
      }
      /*
       * Recharge la configuration serveur
       * afin de confirmer que les données
       * correspondent à celles enregistrées.
       */
      await loadConfig();
    } catch (error) {
      console.error(
        "[OMNIX] Erreur saveConfig :",
        error
      );
      alert(
        "Une erreur est survenue lors de l'enregistrement : " +
        error.message
      );
    }
  }
  /* =========================================================
     BACKUP
     
     ROUTE CONSERVÉE
  ========================================================= */
  async function triggerBackup() {
    const backupButton =
      document.getElementById(
        "backup-btn"
      );
    if (
      backupButton &&
      backupButton.disabled
    ) {
      return;
    }
    try {
      const response = await fetch(
        `/api/guilds/${guildId}/backups`,
        {
          method: "POST",
          headers: jwtToken
            ? {
                Authorization:
                  `Bearer ${jwtToken}`
              }
            : {},
          credentials:
            "same-origin"
        }
      );
      if (!response.ok) {
        const errData =
          await response
            .json()
            .catch(() => ({}));
        throw new Error(
          errData.message ||
          errData.error ||
          errData.details ||
          `Erreur HTTP ${response.status}`
        );
      }
      alert(
        "✅ Instantané de sauvegarde créé avec succès !"
      );
    } catch (error) {
      console.error(
        "[OMNIX] Erreur backup :",
        error
      );
      alert(
        "❌ Échec de la création de la sauvegarde : " +
        error.message
      );
    }
  }
  /* =========================================================
     DIAGNOSTIC
  ========================================================= */
  function addTerminalLog(type, message) {
    console.log(
      `[OMNIX][${String(type).toUpperCase()}] ${message}`
    );
  }
  /* =========================================================
     INITIALISATION
  ========================================================= */
  document.addEventListener(
    "DOMContentLoaded",
    () => {
      setupCheckboxSync();
      /*
       * Vue d'ensemble par défaut.
       *
       * Correction :
       * le bouton est btn-tab-general,
       * pas btn-tab-tab-overview.
       */
      switchTab("tab-overview");
      loadConfig();
    }
  );
</script>