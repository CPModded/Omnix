<%
/* =========================================================
   OMNIX — MANAGE
   PARTIE 1/2 — STRUCTURE EJS / HTML
========================================================= */
const currentGuildId = guildId || "";
%>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <title>
    OMNIX — Gestion du serveur
  </title>
  <link
    rel="stylesheet"
    href="/css/dashboard.css"
  >
  <style>
    /* =====================================================
       MANAGE
    ===================================================== */
    .manage-page {
      min-height: 100vh;
      padding: 32px;
    }
    .manage-container {
      max-width: 1500px;
      margin: 0 auto;
    }
    .manage-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }
    .manage-title {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      color: #fff;
    }
    .manage-subtitle {
      margin: 8px 0 0;
      color: #94a3b8;
      font-size: 14px;
    }
    .license-card {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border-radius: 14px;
      background: rgba(15, 23, 42, .75);
      border: 1px solid rgba(255,255,255,.08);
    }
    .license-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .license-label {
      color: #fff;
      font-size: 13px;
      font-weight: 700;
    }
    .license-key {
      color:#cbd5e1;
      font-size:10px;
      font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
      letter-spacing:.3px;
    }
    .license-expiration {
      color: #64748b;
      font-size: 11px;
    }
    .badge-premium,
    .badge-free {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 60px;
      padding: 5px 9px;
      border-radius: 7px;
      font-size: 10px;
      font-weight: 800;
    }
    .badge-premium {
      color: #ddd6fe;
      background: rgba(124,58,237,.18);
      border: 1px solid rgba(167,139,250,.25);
    }
    .badge-free {
      color: #94a3b8;
      background: rgba(100,116,139,.12);
      border: 1px solid rgba(100,116,139,.2);
    }
    /* =====================================================
       LAYOUT
    ===================================================== */
    .manage-layout {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }
    .manage-tabs {
      position: sticky;
      top: 24px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      padding: 12px;
      border-radius: 16px;
      background: rgba(15,23,42,.72);
      border: 1px solid rgba(255,255,255,.07);
      backdrop-filter: blur(18px);
      max-height: calc(100vh - 48px);
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: rgba(99,102,241,.55) transparent;
    }
    .manage-tabs::-webkit-scrollbar { width: 5px; }
    .manage-tabs::-webkit-scrollbar-track { background: transparent; }
    .manage-tabs::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg,#6366f1,#06b6d4);
      border-radius: 999px;
    }
    .manage-tab-button {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 12px 13px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
      transition: .2s ease;
    }
    .manage-tab-button:hover {
      background: rgba(255,255,255,.05);
      color: #fff;
    }
    .manage-tab-button.active {
      background: rgba(79,70,229,.18);
      color: #fff;
      box-shadow: inset 3px 0 0 #6366f1;
    }
    .tab-icon {
      width: 22px;
      text-align: center;
      font-size: 15px;
    }
    /* =====================================================
       CONFIG PANEL
    ===================================================== */
    .config-panel {
      min-width: 0;
      padding: 24px;
      border-radius: 18px;
      background: rgba(15,23,42,.72);
      border: 1px solid rgba(255,255,255,.07);
      backdrop-filter: blur(18px);
    }
    .tab-content {
      display: block;
    }
    .tab-content.hidden {
      display: none;
    }
    .section-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
    }
    .section-title {
      margin: 0;
      color: #fff;
      font-size: 21px;
      font-weight: 800;
    }
    .section-description {
      margin: 7px 0 0;
      color: #64748b;
      font-size: 13px;
      line-height: 1.5;
    }
    .config-card {
      margin-bottom: 18px;
      padding: 20px;
      border-radius: 14px;
      background: rgba(2,6,23,.42);
      border: 1px solid rgba(255,255,255,.06);
    }
    .config-card:last-child {
      margin-bottom: 0;
    }
    .config-card-title {
      margin: 0 0 5px;
      color: #f8fafc;
      font-size: 14px;
      font-weight: 800;
    }
    .config-card-description {
      margin: 0 0 18px;
      color: #64748b;
      font-size: 12px;
    }
    /* =====================================================
       FORM
    ===================================================== */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .form-group {
      margin-bottom: 16px;
    }
    .form-group:last-child {
      margin-bottom: 0;
    }
    .form-group.full {
      grid-column: 1 / -1;
    }
    .form-group label {
      display: block;
      margin-bottom: 7px;
      color: #cbd5e1;
      font-size: 11px;
      font-weight: 700;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 11px 12px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 9px;
      outline: none;
      background: rgba(15,23,42,.85);
      color: #fff;
      font-family: inherit;
      font-size: 12px;
      transition: .2s ease;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 90px;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: rgba(99,102,241,.65);
      box-shadow: 0 0 0 3px rgba(99,102,241,.08);
    }
    .form-group input:disabled,
    .form-group select:disabled,
    .form-group textarea:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    /* =====================================================
       SWITCH
    ===================================================== */
    .switch-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .switch-row:last-child {
      border-bottom: 0;
    }
    .switch-title {
      color: #f8fafc;
      font-size: 13px;
      font-weight: 700;
    }
    .switch-description {
      margin-top: 4px;
      color: #64748b;
      font-size: 11px;
      line-height: 1.45;
    }
    .switch {
      position: relative;
      width: 46px;
      min-width: 46px;
      height: 24px;
    }
    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .slider {
      position: absolute;
      inset: 0;
      cursor: pointer;
      border-radius: 999px;
      background: #334155;
      transition: .2s ease;
    }
    .slider::before {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      left: 3px;
      top: 3px;
      border-radius: 50%;
      background: #fff;
      transition: .2s ease;
    }
    .switch input:checked + .slider {
      background: #4f46e5;
    }
    .switch input:checked + .slider::before {
      transform: translateX(22px);
    }
    .switch input:disabled + .slider {
      opacity: .4;
      cursor: not-allowed;
    }
    /* =====================================================
       BUTTONS
    ===================================================== */
    .manage-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 15px;
      border: 0;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .2s ease;
    }
    .manage-button:hover {
      transform: translateY(-1px);
    }
    .button-primary {
      background: #4f46e5;
      color: #fff;
    }
    .button-secondary {
      background: rgba(255,255,255,.06);
      color: #cbd5e1;
      border: 1px solid rgba(255,255,255,.08);
    }
    .button-danger {
      background: rgba(220,38,38,.14);
      color: #f87171;
      border: 1px solid rgba(220,38,38,.2);
    }
    .actions-bar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.06);
    }
    /* =====================================================
       TICKETS
    ===================================================== */
    #categories-container {
      margin-top: 15px;
    }
    .categories-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 14px;
    }
    .categories-title {
      color: #f8fafc;
      font-size: 13px;
      font-weight: 800;
    }
    /* =====================================================
       TOAST
    ===================================================== */
    #toast {
      position: fixed;
      right: 25px;
      bottom: 25px;
      z-index: 9999;
      padding: 13px 18px;
      border-radius: 10px;
      background: #16a34a;
      transform: translateX(140%);
      opacity: 0;
      transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .25s ease;
      border:1px solid rgba(255,255,255,.12);
    }
    #toast.show {
      transform: translateX(0);
      opacity:1;
    }
    #toast.error {
      background:#dc2626;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      box-shadow: 0 12px 30px rgba(0,0,0,.25);
    }
    #toast.hidden {
      display: none;
    }
    /* =====================================================
       ADVANCED DASHBOARD
    ===================================================== */
    .config-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .command-row,.backup-row{display:grid;grid-template-columns:1fr 1.5fr auto;gap:10px;align-items:start;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.06)}
    .command-row:last-child,.backup-row:last-child{border-bottom:0}
    .command-row input,.command-row textarea,.advanced-input{width:100%;padding:11px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.08);background:rgba(2,6,23,.55);color:#fff;outline:none}
    .command-row textarea{min-height:70px;resize:vertical}
    .command-list{margin-top:8px}
    .mini-actions{display:flex;gap:8px;flex-wrap:wrap}
    .btn-danger-soft{background:rgba(239,68,68,.10)!important;color:#fca5a5!important;border:1px solid rgba(239,68,68,.18)!important}
    .backup-status{display:inline-flex;align-items:center;gap:7px;color:#94a3b8;font-size:12px}
    .premium-note{padding:12px 14px;border-radius:12px;background:rgba(124,92,255,.08);border:1px solid rgba(124,92,255,.18);color:#c4b5fd;font-size:12px;line-height:1.5}
    .advanced-card{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .advanced-card .form-group.full{grid-column:1/-1}
    .field-hint{margin-top:5px;color:#64748b;font-size:11px}
    .save-bar{position:sticky;bottom:12px;z-index:20;margin-top:22px;padding:12px;border-radius:14px;background:rgba(8,11,20,.88);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.08);display:flex;justify-content:flex-end;gap:10px}
    /* =====================================================
       OMNIX MODERN PERSONALIZATION
    ===================================================== */
    .manage-button{border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:10px 13px;cursor:pointer;font-size:12px;font-weight:800;transition:.2s ease}.manage-button:hover{transform:translateY(-1px)}
    .button-secondary{background:rgba(255,255,255,.06);color:#fff}.button-secondary:hover{background:rgba(124,92,255,.16);border-color:rgba(124,92,255,.3)}
    .manage-page{background:radial-gradient(circle at 85% 0%,rgba(124,92,255,.10),transparent 32%),radial-gradient(circle at 10% 30%,rgba(16,185,129,.06),transparent 28%)}
    .manage-header{padding:18px 20px;border:1px solid rgba(255,255,255,.07);border-radius:20px;background:linear-gradient(135deg,rgba(15,23,42,.86),rgba(8,11,20,.72));box-shadow:0 18px 50px rgba(0,0,0,.18)}
    .manage-tabs{max-height:calc(100vh - 150px);overflow-y:auto;scrollbar-width:thin}.manage-tabs::-webkit-scrollbar{width:5px}.manage-tabs::-webkit-scrollbar-thumb{background:rgba(124,92,255,.45);border-radius:99px}
    .config-panel{background:linear-gradient(145deg,rgba(15,23,42,.78),rgba(8,11,20,.72));box-shadow:0 20px 60px rgba(0,0,0,.16)}
    .config-card{transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.config-card:hover{transform:translateY(-2px);border-color:rgba(124,92,255,.16);box-shadow:0 14px 35px rgba(0,0,0,.15)}
    body.omnix-compact .config-card{padding:14px;margin-bottom:12px}body.omnix-compact .switch-row{padding:10px 0}
    body.omnix-no-animations *,body.omnix-no-animations *::before,body.omnix-no-animations *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
    body.omnix-density-compact .manage-tabs{gap:4px;padding:8px}body.omnix-density-compact .manage-tab-button{padding:9px 11px}
    #manage-preferences{position:fixed;inset:0;z-index:11000;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(2,6,23,.72);backdrop-filter:blur(14px)}
    #manage-preferences.open{display:flex}.manage-pref-panel{width:min(720px,100%);max-height:min(760px,92vh);overflow:auto;border:1px solid rgba(255,255,255,.09);border-radius:22px;padding:22px;background:linear-gradient(145deg,#111827,#080b14);box-shadow:0 30px 90px rgba(0,0,0,.5)}
    .manage-pref-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}.manage-pref-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px;border:1px solid rgba(255,255,255,.06);border-radius:14px;background:rgba(255,255,255,.025);cursor:pointer}.manage-pref-row span{font-size:12px;font-weight:800}.manage-pref-row small{display:block;color:#64748b;font-size:10px;font-weight:500;margin-top:4px}.manage-pref-row input{width:18px;height:18px;accent-color:#7c5cff}.manage-pref-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:18px}
    #manage-pref-toast{position:fixed;right:22px;bottom:22px;z-index:12000;min-width:250px;max-width:380px;padding:14px 16px;border-radius:14px;color:#fff;font-size:12px;font-weight:800;box-shadow:0 18px 45px rgba(0,0,0,.35);transform:translateX(130%);opacity:0;transition:.38s cubic-bezier(.2,.8,.2,1)}#manage-pref-toast.show{transform:translateX(0);opacity:1}#manage-pref-toast.success{background:#059669;border:1px solid rgba(110,231,183,.25)}#manage-pref-toast.error{background:#dc2626;border:1px solid rgba(252,165,165,.25)}

    /* =====================================================
       RESPONSIVE
    ===================================================== */
    @media (max-width: 1000px) {
      .manage-layout {
        grid-template-columns: 1fr;
      }
      .manage-tabs {
        position: static;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }
    }
    @media (max-width: 700px) {
      .manage-page {
        padding: 16px;
      }
      .manage-header {
        flex-direction: column;
        align-items: stretch;
      }
      .manage-tabs {
        grid-template-columns: repeat(2, 1fr);
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
      .form-group.full {
        grid-column: auto;
      }
      .config-panel {
        padding: 16px;
      }
    }

    /* =====================================================
       OMNIX GLOBAL THEME — ALIGNEMENT AVEC LES PAGES PUBLIQUES
       Override visuel uniquement : aucune logique métier modifiée.
    ===================================================== */
    :root{
      --om-bg:#030712;
      --om-bg-2:#070b16;
      --om-panel:rgba(10,15,29,.72);
      --om-panel-strong:rgba(15,23,42,.86);
      --om-line:rgba(148,163,184,.12);
      --om-text:#f8fafc;
      --om-muted:#94a3b8;
      --om-dim:#64748b;
      --om-cyan:#06b6d4;
      --om-indigo:#6366f1;
      --om-violet:#8b5cf6;
    }
    html{background:var(--om-bg)!important;}
    body{
      min-height:100vh!important;
      margin:0!important;
      color:var(--om-text)!important;
      background:
        radial-gradient(circle at 12% -10%,rgba(99,102,241,.20),transparent 34%),
        radial-gradient(circle at 92% 12%,rgba(6,182,212,.10),transparent 28%),
        radial-gradient(circle at 52% 100%,rgba(139,92,246,.07),transparent 34%),
        linear-gradient(180deg,#030712 0%,#050914 52%,#030712 100%)!important;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif!important;
      overflow-x:hidden!important;
      position:relative;
    }
    body::before{
      content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;opacity:.14;
      background-image:linear-gradient(rgba(148,163,184,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.055) 1px,transparent 1px);
      background-size:48px 48px;
      mask-image:linear-gradient(to bottom,#000 0%,transparent 92%);
    }
    .manage-page{
      min-height:100vh!important;
      padding:32px!important;
      background:transparent!important;
    }
    .manage-container{width:min(1320px,100%)!important;max-width:1320px!important;margin:0 auto!important;}
    .manage-header{
      position:relative!important;overflow:hidden!important;
      min-height:86px!important;padding:18px 20px!important;
      border:1px solid rgba(148,163,184,.13)!important;border-radius:20px!important;
      background:linear-gradient(135deg,rgba(15,23,42,.82),rgba(3,7,18,.70))!important;
      box-shadow:0 24px 70px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.035)!important;
      backdrop-filter:blur(20px)!important;-webkit-backdrop-filter:blur(20px)!important;
    }
    .manage-header::after{
      content:"";position:absolute;width:320px;height:150px;right:-100px;top:-100px;
      background:rgba(99,102,241,.17);filter:blur(65px);pointer-events:none;
    }
    .manage-title{position:relative;z-index:1;font-size:26px!important;letter-spacing:-.5px!important;}
    .manage-subtitle{position:relative;z-index:1;color:#64748b!important;}
    .license-card{
      position:relative;z-index:2!important;
      background:rgba(255,255,255,.025)!important;
      border:1px solid rgba(103,232,249,.13)!important;
      border-radius:14px!important;
      box-shadow:0 10px 30px rgba(0,0,0,.18)!important;
    }
    .badge-premium{background:linear-gradient(135deg,rgba(99,102,241,.22),rgba(139,92,246,.14))!important;color:#c4b5fd!important;border-color:rgba(167,139,250,.28)!important;}
    .badge-free{background:rgba(100,116,139,.10)!important;color:#94a3b8!important;}
    .manage-layout{grid-template-columns:230px minmax(0,1fr)!important;gap:18px!important;margin-top:18px!important;}
    .manage-tabs{
      position:sticky!important;top:20px!important;
      max-height:calc(100vh - 40px)!important;overflow-y:auto!important;
      padding:10px!important;gap:4px!important;
      border:1px solid rgba(148,163,184,.11)!important;border-radius:18px!important;
      background:rgba(8,13,25,.68)!important;
      box-shadow:0 20px 55px rgba(0,0,0,.20)!important;
      backdrop-filter:blur(20px)!important;-webkit-backdrop-filter:blur(20px)!important;
    }
    .manage-tabs::-webkit-scrollbar{width:4px!important}.manage-tabs::-webkit-scrollbar-thumb{background:linear-gradient(#6366f1,#06b6d4)!important;border-radius:99px!important}
    .manage-tab-button{
      min-height:42px!important;padding:10px 12px!important;border:1px solid transparent!important;
      border-radius:12px!important;color:#8d98ad!important;font-size:11px!important;
      background:transparent!important;transition:.22s ease!important;
    }
    .manage-tab-button:hover{color:#fff!important;background:rgba(255,255,255,.035)!important;border-color:rgba(148,163,184,.08)!important;transform:translateX(2px);}
    .manage-tab-button.active{
      color:#fff!important;
      background:linear-gradient(135deg,rgba(99,102,241,.18),rgba(6,182,212,.07))!important;
      border-color:rgba(99,102,241,.20)!important;
      box-shadow:inset 3px 0 0 #6366f1,0 8px 22px rgba(79,70,229,.08)!important;
    }
    .tab-icon{color:#67e8f9!important;width:20px!important;}
    .config-panel{
      min-height:620px!important;padding:24px!important;
      border:1px solid rgba(148,163,184,.11)!important;border-radius:20px!important;
      background:linear-gradient(145deg,rgba(15,23,42,.72),rgba(3,7,18,.72))!important;
      box-shadow:0 25px 75px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.025)!important;
      backdrop-filter:blur(18px)!important;-webkit-backdrop-filter:blur(18px)!important;
    }
    .section-title{font-size:20px!important;letter-spacing:-.25px!important}.section-description{color:#64748b!important}
    .config-card{
      background:rgba(2,6,23,.34)!important;border:1px solid rgba(148,163,184,.08)!important;
      border-radius:16px!important;padding:18px!important;
    }
    .config-card:hover{border-color:rgba(99,102,241,.20)!important;background:rgba(8,13,27,.48)!important;}
    .config-card-title{font-size:13px!important}.config-card-description{color:#64748b!important}
    .switch-row{border-bottom-color:rgba(148,163,184,.07)!important;}
    .form-group input,.form-group select,.form-group textarea,.command-row input,.command-row textarea,.advanced-input{
      background:rgba(2,6,23,.48)!important;border-color:rgba(148,163,184,.11)!important;color:#f8fafc!important;
    }
    .form-group input:focus,.form-group select:focus,.form-group textarea:focus,.command-row input:focus,.command-row textarea:focus,.advanced-input:focus{
      border-color:rgba(99,102,241,.58)!important;box-shadow:0 0 0 3px rgba(99,102,241,.08)!important;
    }
    .save-bar{background:rgba(3,7,18,.82)!important;border-color:rgba(148,163,184,.10)!important;backdrop-filter:blur(18px)!important;}
    .manage-button{border-color:rgba(148,163,184,.11)!important;}
    .manage-button:not(.button-secondary){background:linear-gradient(135deg,#6366f1,#8b5cf6)!important;box-shadow:0 10px 25px rgba(99,102,241,.18)!important;}
    .button-secondary{background:rgba(255,255,255,.035)!important;color:#cbd5e1!important;}
    .button-secondary:hover{background:rgba(99,102,241,.10)!important;border-color:rgba(99,102,241,.25)!important;}
    #manage-preferences{background:rgba(1,4,12,.72)!important;}
    .manage-pref-panel{background:linear-gradient(145deg,#0f172a,#030712)!important;border-color:rgba(148,163,184,.12)!important;}
    .manage-pref-row{background:rgba(255,255,255,.025)!important;border-color:rgba(148,163,184,.08)!important;}
    #manage-pref-toast{right:22px!important;bottom:22px!important;}
    @media(max-width:1000px){
      .manage-layout{grid-template-columns:1fr!important}.manage-tabs{position:static!important;max-height:260px!important;display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;}
    }
    @media(max-width:700px){
      .manage-page{padding:14px!important}.manage-header{padding:16px!important}.manage-title{font-size:22px!important}.manage-layout{gap:12px!important}.manage-tabs{grid-template-columns:1fr!important;max-height:300px!important}.config-panel{padding:15px!important;min-height:auto!important}.manage-pref-grid{grid-template-columns:1fr!important}
    }

  </style>
</head>
<body>
  <!-- =======================================================
       SIDEBAR CENTRALISÉ OMNIX
  ======================================================== -->
  <%- include('partials/sidebar') %>
  <!-- =======================================================
       PAGE MANAGE
  ======================================================== -->
  <main class="manage-page">
    <div class="manage-container">
      <!-- ===================================================
           HEADER
      ==================================================== -->
      <header class="manage-header">
        <div>
          <h1 class="manage-title">
            Gestion du serveur
          </h1>
          <p class="manage-subtitle">
            Configurez les modules et fonctionnalités de votre serveur Discord.
          </p>
        </div>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end">
          <button type="button" class="manage-button button-secondary" onclick="openManagePreferences()">⚙️ Personnaliser</button>
          <div class="license-card">
          <div class="license-info">
            <span
              id="license-label"
              class="license-label"
            >
              Chargement de la licence...
            </span>
            <span
              id="license-expiration"
              class="license-expiration"
            ></span>
            <span id="license-key" class="license-key"></span>
          </div>
          <span
            id="license-badge"
            class="badge-free"
          >
            FREE
          </span>
          </div>
        </div>
      </header>
      <!-- ===================================================
           LAYOUT
      ==================================================== -->
      <div class="manage-layout">
        <!-- =================================================
             ONGLETS
        ================================================== -->
        <nav class="manage-tabs" aria-label="Configuration du serveur">
          <button type="button" id="btn-tab-general" class="manage-tab-button active" onclick="switchTab('tab-overview')">
            <span class="tab-icon">◈</span><span>Vue d’ensemble</span>
          </button>
          <button type="button" id="btn-tab-welcome" class="manage-tab-button" onclick="switchTab('tab-welcome')">
            <span class="tab-icon">👋</span><span>Accueil</span>
          </button>
          <button type="button" id="btn-tab-moderation" class="manage-tab-button" onclick="switchTab('tab-moderation')">
            <span class="tab-icon">🛡️</span><span>Modération</span>
          </button>
          <button type="button" id="btn-tab-tickets" class="manage-tab-button" onclick="switchTab('tab-tickets')">
            <span class="tab-icon">🎫</span><span>Tickets</span>
          </button>
          <button type="button" id="btn-tab-economy" class="manage-tab-button" onclick="switchTab('tab-economy')">
            <span class="tab-icon">💰</span><span>Économie</span>
          </button>
          <button type="button" id="btn-tab-ai" class="manage-tab-button" onclick="switchTab('tab-ai')">
            <span class="tab-icon">🤖</span><span>Intelligence artificielle</span>
          </button>
          <button type="button" id="btn-tab-backups" class="manage-tab-button" onclick="switchTab('tab-backups')">
            <span class="tab-icon">💾</span><span>Sauvegardes</span>
          </button>
          <button type="button" id="btn-tab-commands" class="manage-tab-button" onclick="switchTab('tab-commands')">
            <span class="tab-icon">⌘</span><span>Commandes personnalisées</span>
          </button>
          <button type="button" id="btn-tab-advanced" class="manage-tab-button" onclick="switchTab('tab-advanced')">
            <span class="tab-icon">🧩</span><span>Options avancées</span>
          </button>
        </nav>
        <!-- =================================================
             PANNEAU CONFIGURATION
        ================================================== -->
        <section class="config-panel">
          <!-- ===============================================
               VUE D'ENSEMBLE
          ================================================ -->
          <section
            id="tab-overview"
            class="tab-content"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Vue d'ensemble
                </h2>
                <p class="section-description">
                  Activez ou désactivez rapidement les principaux modules OMNIX.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Modules principaux
              </h3>
              <p class="config-card-description">
                État général des fonctionnalités du serveur.
              </p>
              <!-- IA -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Intelligence artificielle
                  </div>
                  <div class="switch-description">
                    Active l'assistant IA OMNIX sur le serveur.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="ai-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- BACKUPS -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Sauvegardes
                  </div>
                  <div class="switch-description">
                    Permet de conserver des instantanés de configuration.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="backups-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- ECONOMY -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Économie
                  </div>
                  <div class="switch-description">
                    Active le système économique du serveur.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="economy-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- MODERATION -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Modération
                  </div>
                  <div class="switch-description">
                    Active les fonctionnalités de modération OMNIX.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="moderation-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- TICKETS -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Tickets
                  </div>
                  <div class="switch-description">
                    Active le système de tickets.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="tickets-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- PING -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Ping
                  </div>
                  <div class="switch-description">
                    Active les fonctionnalités de ping et diagnostic.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="ping-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
            </div>
            <!-- Hidden controls utilisés par le script -->
            <input
              type="checkbox"
              id="ai-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="backups-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="economy-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="moderation-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="tickets-enabled"
              hidden
            >
          </section>
          <!-- ===============================================
               WELCOME
          ================================================ -->
          <section
            id="tab-welcome"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Accueil
                </h2>
                <p class="section-description">
                  Configurez les messages d'arrivée et de départ.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Message de bienvenue
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les messages de bienvenue
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="welcome-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="welcome-message">
                    Message
                  </label>
                  <textarea
                    id="welcome-message"
                    placeholder="Bienvenue {user} !"
                  ></textarea>
                </div>
                <div class="form-group full">
                  <label for="welcome-channel">
                    ID du salon
                  </label>
                  <input
                    type="text"
                    id="welcome-channel"
                    placeholder="Ex: 1211490202246189167"
                  >
                </div>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Message de départ
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les messages de départ
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="goodbye-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="goodbye-message">
                    Message
                  </label>
                  <textarea
                    id="goodbye-message"
                    placeholder="Au revoir..."
                  ></textarea>
                </div>
                <div class="form-group full">
                  <label for="goodbye-channel">
                    ID du salon
                  </label>
                  <input
                    type="text"
                    id="goodbye-channel"
                    placeholder="Ex: 1211490202246189167"
                  >
                </div>
              </div>
            </div>
          </section>
          <!-- ===============================================
               MODERATION
          ================================================ -->
          <section
            id="tab-moderation"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Modération
                </h2>
                <p class="section-description">
                  Configurez la modération et l'AutoMod de votre serveur.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Modération générale
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer la modération
                  </div>
                  <div class="switch-description">
                    Active les systèmes de modération OMNIX.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="moderation-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="moderation-log">
                  Salon des logs
                </label>
                <input
                  type="text"
                  id="moderation-log"
                  placeholder="ID du salon de logs"
                >
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                AutoMod
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer AutoMod
                  </div>
                  <div class="switch-description">
                    Bloque automatiquement les mots configurés.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="automod-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="automod-words">
                  Mots interdits
                </label>
                <input
                  type="text"
                  id="automod-words"
                  placeholder="mot1, mot2, mot3"
                >
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Honeypot
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Salon piège
                  </div>
                  <div class="switch-description">
                    Fonctionnalité Premium de protection contre les comportements suspects.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="honeypot-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="honeypot-channel">
                  ID du salon piège
                </label>
                <input
                  type="text"
                  id="honeypot-channel"
                  placeholder="Ex: 1211490202246189167"
                >
              </div>
            </div>
          </section>
          <!-- ===============================================
               TICKETS
          ================================================ -->
          <section
            id="tab-tickets"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Tickets
                </h2>
                <p class="section-description">
                  Configurez le système de support et les catégories de tickets.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Configuration générale
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les tickets
                  </div>
                  <div class="switch-description">
                    Permet aux membres d'ouvrir des tickets.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="tickets-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="tickets-category">
                  Catégorie Discord par défaut
                </label>
                <input
                  type="text"
                  id="tickets-category"
                  placeholder="ID de la catégorie Discord"
                >
              </div>
            </div>
            <div class="config-card">
              <div class="categories-header">
                <div>
                  <div class="categories-title">
                    Catégories personnalisées
                  </div>
                </div>
                <button
                  type="button"
                  class="manage-button button-primary"
                  onclick="addCategoryRow()"
                >
                  + Ajouter
                </button>
              </div>
              <div id="categories-container"></div>
            </div>
          </section>
          <!-- ===============================================
               ECONOMY
          ================================================ -->
          <section
            id="tab-economy"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Économie
                </h2>
                <p class="section-description">
                  Configurez la monnaie et les récompenses économiques.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Configuration économique
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer l'économie
                  </div>
                  <div class="switch-description">
                    Active les fonctionnalités économiques du bot.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="economy-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label for="economy-symbol">
                    Symbole de la monnaie
                  </label>
                  <input
                    type="text"
                    id="economy-symbol"
                    value="$"
                    maxlength="5"
                  >
                </div>
                <div class="form-group">
                  <label for="economy-cooldown">
                    Cooldown Work (minutes)
                  </label>
                  <input
                    type="number"
                    id="economy-cooldown"
                    value="60"
                    min="1"
                  >
                </div>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Niveaux
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les niveaux
                  </div>
                  <div class="switch-description">
                    Attribue de l'XP aux membres actifs.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="levels-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="levels-xp">
                  XP par message
                </label>
                <input
                  type="number"
                  id="levels-xp"
                  value="15"
                  min="0"
                >
              </div>
            </div>
          </section>
          <!-- ===============================================
               IA
          ================================================ -->
          <section
            id="tab-ai"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Intelligence artificielle
                </h2>
                <p class="section-description">
                  Configurez l'assistant IA de votre serveur.
                </p>
              </div>
            </div>
            <div class="config-card">
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer l'IA
                  </div>
                  <div class="switch-description">
                    Active l'assistant IA OMNIX.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="ai-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="ai-prompt">
                  Prompt système
                </label>
                <textarea
                  id="ai-prompt"
                  rows="8"
                  placeholder="Tu es un assistant utile sur ce serveur Discord."
                ></textarea>
              </div>
            </div>
          </section>
          <!-- ===============================================
               BACKUPS
          ================================================ -->
          <section id="tab-commands" class="tab-content hidden">
            <div class="section-header"><div><h2 class="section-title">Commandes personnalisées</h2><p class="section-description">Créez des commandes simples avec une réponse personnalisée. Elles sont enregistrées dans la configuration du serveur.</p></div></div>
            <div class="config-card">
              <div class="switch-row"><div><div class="switch-title">Activer les commandes personnalisées</div><div class="switch-description">Permet d'utiliser les commandes définies ci-dessous.</div></div><label class="switch"><input type="checkbox" id="custom-commands-enabled"><span class="slider"></span></label></div>
              <div class="premium-note">💡 Utilisez des noms simples sans espace, par exemple <b>regles</b>, <b>ip</b> ou <b>socials</b>. Les réponses peuvent contenir des mentions et du texte libre.</div>
              <div id="custom-command-list" class="command-list"></div>
              <div class="mini-actions" style="margin-top:14px"><button class="btn btn-secondary" type="button" onclick="addCustomCommand()">＋ Ajouter une commande</button></div>
            </div>
          </section>

          <section id="tab-advanced" class="tab-content hidden">
            <div class="section-header"><div><h2 class="section-title">Options avancées</h2><p class="section-description">Personnalisez les protections, les logs, les niveaux, la vérification, les automatismes et les statistiques.</p></div></div>
            <div class="config-card"><h3 class="config-card-title">🛡️ Protection</h3><div class="advanced-card">
              <div class="form-group"><label><input type="checkbox" id="advanced-antiraid-enabled"> Anti-Raid</label><input class="advanced-input" id="advanced-antiraid-threshold" type="number" min="2" placeholder="Seuil d'entrées"><div class="field-hint">Nombre d'entrées déclenchant la protection.</div></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-antispam-enabled"> Anti-Spam</label><input class="advanced-input" id="advanced-antispam-max" type="number" min="2" placeholder="Messages autorisés"><div class="field-hint">Fenêtre de détection en millisecondes.</div></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-antilink-enabled"> Anti-Liens</label><input class="advanced-input" id="advanced-antilink-whitelist" type="text" placeholder="discord.com, youtube.com"><div class="field-hint">Domaines autorisés séparés par des virgules.</div></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-verification-enabled"> Vérification</label><input class="advanced-input" id="advanced-verification-role" type="text" placeholder="ID du rôle vérifié"></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-autorole-enabled"> Auto-rôle</label><input class="advanced-input" id="advanced-autorole-role" type="text" placeholder="ID du rôle automatique"></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-polls-enabled"> Sondages</label><input class="advanced-input" id="advanced-polls-channel" type="text" placeholder="ID du salon"></div>
            </div></div>
            <div class="config-card"><h3 class="config-card-title">📋 Logs & statistiques</h3><div class="advanced-card">
              <div class="form-group"><label><input type="checkbox" id="advanced-logs-enabled"> Logs OMNIX</label><input class="advanced-input" id="advanced-logs-channel" type="text" placeholder="ID salon général"></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-stats-enabled"> Statistiques</label><input class="advanced-input" id="advanced-stats-channel" type="text" placeholder="ID salon statistiques"></div>
              <div class="form-group"><label>Intervalle statistiques (ms)</label><input class="advanced-input" id="advanced-stats-interval" type="number" min="30000" step="1000"></div>
              <div class="form-group"><label>Préfixe</label><input class="advanced-input" id="advanced-prefix" type="text" maxlength="5" placeholder="/"></div>
              <div class="form-group full"><label>Locale</label><select class="advanced-input" id="advanced-locale"><option value="fr">Français</option><option value="en">English</option></select></div>
            </div></div>
            <div class="config-card"><h3 class="config-card-title">🤖 IA & mémoire</h3><div class="advanced-card">
              <div class="form-group"><label>Salon IA</label><input class="advanced-input" id="advanced-ai-channel" type="text" placeholder="ID du salon"></div>
              <div class="form-group"><label>Nombre maximum de tokens</label><input class="advanced-input" id="advanced-ai-tokens" type="number" min="256" max="8000"></div>
              <div class="form-group full"><label>Mémoire IA du serveur</label><input class="advanced-input" id="advanced-ai-history" type="number" min="1" max="75"><div class="field-hint">Maximum recommandé : 75 messages par utilisateur.</div></div>
            </div></div>
          </section>

          <section
            id="tab-backups"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Sauvegardes
                </h2>
                <p class="section-description">
                  Protégez la configuration de votre serveur.
                </p>
              </div>
            </div>
            <div class="config-card">
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les sauvegardes
                  </div>
                  <div class="switch-description">
                    Permet à OMNIX de gérer les sauvegardes de configuration.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="backups-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid" style="margin-top:14px">
                <div class="form-group"><label><input type="checkbox" id="backups-automatic"> Sauvegardes automatiques</label><div class="field-hint">Crée des instantanés selon l'intervalle choisi.</div></div>
                <div class="form-group"><label for="backups-interval">Intervalle (heures)</label><input class="advanced-input" id="backups-interval" type="number" min="1" max="720" value="24"></div>
                <div class="form-group"><label for="backups-retention">Nombre de sauvegardes conservées</label><input class="advanced-input" id="backups-retention" type="number" min="1" max="100" value="10"></div>
              </div>
              <div class="actions-bar">
                <button
                  type="button"
                  id="backup-btn"
                  class="manage-button button-primary"
                  onclick="triggerBackup()"
                >
                  Créer un instantané manuel
                </button>
              </div>
            </div>
          </section>
          <!-- ===============================================
               ACTIONS GLOBALES
          ================================================ -->
          <div class="actions-bar">
            <button
              type="button"
              class="manage-button button-secondary"
              onclick="window.location.href='/dashboard'"
            >
              Annuler
            </button>
            <button
              type="button"
              class="manage-button button-primary"
              onclick="saveConfig()"
            >
              💾 Enregistrer les modifications
            </button>
          </div>
        </section>
      </div>
    </div>
  </main>
  <!-- =======================================================
       TOAST
  ======================================================== -->
  <div
    id="toast"
    class="hidden"
  >
    Configuration enregistrée avec succès.
  </div>
  <!-- =======================================================
       PARTIE 2
       
       COLLER ICI LE SCRIPT FOURNI PRÉCÉDEMMENT
  ======================================================== -->
  <!--
    La PARTIE 2 que tu m'as envoyée vient directement ici.
  -->
  
<script>
  const guildId = "<%= guildId %>";
  let currentConfig = {};
  /* =========================================================
     SESSION — cookie httpOnly uniquement
  ========================================================= */
  async function getCurrentUser() {
    try { const r=await fetch('/api/auth/me',{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}}); if(!r.ok)return null; const d=await r.json(); return d?.user||null; } catch { return null; }
  }

  /* =========================================================
     DRAWER
     
     Le sidebar centralisé est déjà inclus dans le HTML de la page.
     Ce script ne recrée pas le sidebar.
  ========================================================= */
  function legacyToggleDrawer(open) {
    const drawer = document.getElementById("side-drawer");
    if (!drawer) {
      console.warn("[OMNIX] #side-drawer introuvable dans le sidebar.");
      return;
    }
    drawer.classList.toggle("open", Boolean(open));
  }
  /* =========================================================
     ONGLETS MANAGE
  ========================================================= */
  const MANAGE_TAB_BUTTONS = [
    "btn-tab-general",
    "btn-tab-welcome",
    "btn-tab-moderation",
    "btn-tab-tickets",
    "btn-tab-economy",
    "btn-tab-ai",
    "btn-tab-backups",
    "btn-tab-commands",
    "btn-tab-advanced"
  ];
  function switchTab(tabId) {
    const target = document.getElementById(tabId);
    if (!target) {
      console.error(
        `[OMNIX] Onglet introuvable : ${tabId}`
      );
      return;
    }
    /*
     * Masque uniquement les sections du panneau Manage.
     * Aucun élément du sidebar n'est touché.
     */
    document
      .querySelectorAll(".config-panel > .tab-content")
      .forEach((section) => {
        section.classList.add("hidden");
      });
    target.classList.remove("hidden");
    /*
     * Réinitialisation uniquement des boutons Manage.
     *
     * IMPORTANT :
     * On ne fait plus :
     *
     * document.querySelectorAll('aside button')
     *
     * car cela pourrait toucher le sidebar centralisé.
     */
    MANAGE_TAB_BUTTONS.forEach((buttonId) => {
      const button = document.getElementById(buttonId);
      if (button) {
        button.classList.remove("active");
      }
    });
    /*
     * Correspondance explicite entre les sections
     * et leurs boutons.
     *
     * Cela corrige notamment :
     *
     * tab-overview -> btn-tab-general
     *
     * qui était cassé dans l'ancien code.
     */
    const tabButtonMap = {
      "tab-overview": "btn-tab-general",
      "tab-welcome": "btn-tab-welcome",
      "tab-moderation": "btn-tab-moderation",
      "tab-tickets": "btn-tab-tickets",
      "tab-economy": "btn-tab-economy",
      "tab-ai": "btn-tab-ai",
      "tab-backups": "btn-tab-backups",
      "tab-commands": "btn-tab-commands",
      "tab-advanced": "btn-tab-advanced"
    };
    const activeButtonId = tabButtonMap[tabId];
    if (activeButtonId) {
      const activeButton =
        document.getElementById(activeButtonId);
      if (activeButton) {
        activeButton.classList.add("active");
      }
    }
  }
  /* =========================================================
     CATÉGORIES TICKETS
  ========================================================= */
  let activeCategories = [];
  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
  function renderCategories() {
    const container =
      document.getElementById("categories-container");
    if (!container) {
      console.error(
        "[OMNIX] #categories-container introuvable."
      );
      return;
    }
    container.innerHTML = "";
    if (!Array.isArray(activeCategories) || activeCategories.length === 0) {
      container.innerHTML = `
        <div style="
          text-align:center;
          color:#475569;
          font-size:12px;
          padding:24px 0;
        ">
          Aucune catégorie personnalisée active.
          Cliquez sur "+ Ajouter" pour en créer une.
        </div>
      `;
      return;
    }
    activeCategories.forEach((cat, index) => {
      const block = document.createElement("div");
      block.className = "switch-row";
      block.style.flexDirection = "column";
      block.style.alignItems = "stretch";
      block.style.gap = "16px";
      block.style.padding = "20px";
      block.style.marginBottom = "16px";
      const emoji = escapeHtml(cat?.emoji || "🎫");
      const name = escapeHtml(cat?.name || "Nouvelle catégorie");
      const targetId = escapeHtml(cat?.targetId || "");
      const welcomeMessage = escapeHtml(
        cat?.welcomeMessage || ""
      );
      const type = cat?.type || "category";
      block.innerHTML = `
        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
          border-bottom:1px solid rgba(255,255,255,0.05);
          padding-bottom:12px;
        ">
          <div style="
            display:flex;
            align-items:center;
            gap:8px;
            flex:1;
          ">
            <input
              type="text"
              value="${emoji}"
              id="cat-emoji-${index}"
              style="
                width:44px;
                text-align:center;
                padding:8px;
                border-radius:8px;
              "
              placeholder="🎫"
              maxlength="8"
            >
            <input
              type="text"
              value="${name}"
              id="cat-name-${index}"
              style="
                font-weight:700;
                color:white;
                background:none;
                border:none;
                font-size:14px;
                flex:1;
              "
              placeholder="Nom de la catégorie"
            >
          </div>
          <button
            type="button"
            onclick="deleteCategory(${index})"
            style="
              background:rgba(220,38,38,0.15);
              color:#f87171;
              border:1px solid rgba(220,38,38,0.25);
              padding:6px 12px;
              border-radius:8px;
              font-size:11px;
              font-weight:700;
              cursor:pointer;
            "
          >
            Supprimer
          </button>
        </div>
        <div class="form-grid">
          <div
            class="form-group"
            style="margin-bottom:0;"
          >
            <label>Routage (Où ouvrir les tickets)</label>
            <select
              id="cat-type-${index}"
              style="
                padding:10px;
                border-radius:8px;
              "
            >
              <option
                value="category"
                ${type === "category" ? "selected" : ""}
              >
                Catégorie Discord (Nouveau salon)
              </option>
              <option
                value="channel"
                ${type === "channel" ? "selected" : ""}
              >
                Dans un salon existant (Nouveau salon)
              </option>
              <option
                value="thread"
                ${type === "thread" ? "selected" : ""}
              >
                Fil de discussion (Thread)
              </option>
            </select>
          </div>
          <div
            class="form-group"
            style="margin-bottom:0;"
          >
            <label>ID cible (Catégorie ou Salon Discord)</label>
            <input
              type="text"
              value="${targetId}"
              id="cat-target-${index}"
              style="
                padding:10px;
                border-radius:8px;
              "
              placeholder="Ex: 1211490202246189167"
            >
          </div>
        </div>
        <div
          class="form-group"
          style="
            margin-bottom:0;
            margin-top:8px;
          "
        >
          <label>
            Message de bienvenue à l'entrée du ticket
          </label>
          <textarea
            id="cat-welcome-${index}"
            rows="2"
            style="
              padding:10px;
              font-size:12px;
              border-radius:8px;
            "
            placeholder="Variables autorisées : {user}"
          >${welcomeMessage}</textarea>
        </div>
      `;
      container.appendChild(block);
    });
  }
  function addCategoryRow() {
    activeCategories.push({
      id:
        "cat_" +
        Math.random()
          .toString(36)
          .substring(2, 10),
      name: "Nouvelle catégorie",
      emoji: "🎫",
      type: "category",
      targetId: null,
      welcomeMessage:
        "Bonjour {user}, un conseiller prend en charge votre demande. Décrivez votre problème."
    });
    renderCategories();
  }
  function deleteCategory(index) {
    if (
      !Number.isInteger(index) ||
      index < 0 ||
      index >= activeCategories.length
    ) {
      return;
    }
    activeCategories.splice(index, 1);
    renderCategories();
  }
  /* =========================================================
     SYNCHRONISATION DES TOGGLES
  ========================================================= */
  function setupCheckboxSync() {
    const pairs = [
      {
        main: "ai-enabled",
        toggle: "ai-enabled-toggle"
      },
      {
        main: "backups-enabled",
        toggle: "backups-enabled-toggle"
      },
      {
        main: "economy-enabled",
        toggle: "economy-enabled-toggle"
      },
      {
        main: "moderation-enabled",
        toggle: "moderation-enabled-toggle"
      },
      {
        main: "tickets-enabled",
        toggle: "tickets-enabled-toggle"
      }
    ];
    pairs.forEach(({ main, toggle }) => {
      const mainEl = document.getElementById(main);
      const toggleEl = document.getElementById(toggle);
      if (!mainEl || !toggleEl) {
        console.warn(
          `[OMNIX] Synchronisation impossible : ${main} / ${toggle}`
        );
        return;
      }
      mainEl.addEventListener("change", (event) => {
        toggleEl.checked =
          Boolean(event.target.checked);
      });
      toggleEl.addEventListener("change", (event) => {
        mainEl.checked =
          Boolean(event.target.checked);
      });
    });
  }
  /* =========================================================
     PREMIUM
  ========================================================= */
  function addPremiumLockLabel(elementId) {
    const element =
      document.getElementById(elementId);
    if (!element) return;
    const row =
      element.closest(".switch-row");
    if (!row) return;
    const title =
      row.querySelector(".switch-title");
    if (!title) return;
    if (title.querySelector(".premium-lock-label")) {
      return;
    }
    const badge =
      document.createElement("span");
    badge.className =
      "premium-lock-label";
    badge.style.cssText = `
      color:#a78bfa;
      font-size:10px;
      font-weight:800;
      background:rgba(124,58,237,0.1);
      padding:2px 6px;
      border-radius:4px;
      margin-left:6px;
    `;
    badge.textContent = "🔒 Premium";
    title.appendChild(badge);
  }
  function setPremiumState(isPremium) {
    const premiumControls = [
      "ai-enabled-toggle",
      "ai-enabled",
      "ai-prompt",
      "backups-enabled-toggle",
      "backups-enabled",
      "honeypot-enabled",
      "honeypot-channel"
    ];
    premiumControls.forEach((id) => {
      const element =
        document.getElementById(id);
      if (element) {
        element.disabled = !isPremium;
      }
    });
    const aiPrompt =
      document.getElementById("ai-prompt");
    if (aiPrompt) {
      aiPrompt.placeholder = isPremium
        ? ""
        : "🔒 Module Premium - Pour personnaliser le prompt, activez un abonnement OMNIX.";
    }
    const honeypotChannel =
      document.getElementById("honeypot-channel");
    if (honeypotChannel) {
      honeypotChannel.placeholder = isPremium
        ? "Ex: 1211490202246189167"
        : "🔒 Entrez votre ID de salon piégé (Abonnement requis)";
    }
    addPremiumLockLabel("ai-enabled-toggle");
    addPremiumLockLabel("backups-enabled-toggle");
    addPremiumLockLabel("honeypot-enabled");
    const backupBtn =
      document.getElementById("backup-btn");
    if (!backupBtn) return;
    backupBtn.disabled = !isPremium;
    if (!isPremium) {
      backupBtn.innerText =
        "🔒 Sauvegardes (Premium Uniquement)";
      backupBtn.style.background = "#1e293b";
      backupBtn.style.color = "#64748b";
      backupBtn.style.border = "1px solid #334155";
      backupBtn.style.cursor = "not-allowed";
      backupBtn.style.boxShadow = "none";
    } else {
      backupBtn.innerText =
        "Créer un instantané manuel";
      backupBtn.style.background = "#4f46e5";
      backupBtn.style.color = "white";
      backupBtn.style.border = "none";
      backupBtn.style.cursor = "pointer";
      backupBtn.style.boxShadow = "";
    }
  }
  /* =========================================================
     CHARGEMENT CONFIGURATION
  ========================================================= */
  async function loadConfig() {
    try {
      const response = await fetch(
        `/api/guilds/${guildId}/config`,
        {
          // La session OMNIX est portée par le cookie httpOnly jwt_token.
          // Le JWT reste uniquement dans le cookie httpOnly.
          credentials: "include"
        }
      );
      if (!response.ok) {
        const errData =
          await response
            .json()
            .catch(() => ({}));
        throw new Error(
          errData.details ||
          errData.error ||
          errData.message ||
          `Erreur HTTP ${response.status}`
        );
      }
      const config =
        await response.json();
      currentConfig = config || {};
      /* -------------------------------------------------------
         LICENCE
      ------------------------------------------------------- */
      const currentUser = await getCurrentUser();
      let license = null;
      try {
        const lr = await fetch(`/api/licenses/me?guildId=${encodeURIComponent(guildId)}`, { credentials:'same-origin', cache:'no-store' });
        if (lr.ok) { const ld = await lr.json(); license = ld?.license || null; }
      } catch {}
      const isGuildPremium = Boolean((config?.premium?.isPremium || (config?.plan && config.plan !== 'free')) && (!config?.premium?.expiresAt || new Date(config.premium.expiresAt).getTime() > Date.now()));
      const isActivatedLicense = Boolean(license && license.activatedGuildId === guildId);
      const isPremium = isGuildPremium || isActivatedLicense;
      const licenseLabel =
        document.getElementById(
          "license-label"
        );
      const licenseExpiration =
        document.getElementById(
          "license-expiration"
        );
      const badge =
        document.getElementById(
          "license-badge"
        );
      if (isPremium) {
        const tier = license?.tier || config?.premium?.tier;
        licenseLabel.innerText =
          isGuildPremium && tier
            ? `Premium Activé (${String(tier).toUpperCase()})`
            : "Premium Actif (Licence Utilisateur Personnelle)";
        badge.className =
          "badge-premium";
        badge.innerText =
          "PREMIUM";
        const expiry = license?.expiresAt || config?.premium?.expiresAt;
        if (expiry) {
          licenseExpiration.innerText = `Expiration : ${new Date(expiry).toLocaleDateString('fr-FR')}`;
        } else {
          licenseExpiration.innerText = "";
        }
        const keyEl=document.getElementById('license-key');
        if(keyEl) keyEl.textContent=license?.key ? `Licence : ${license.key}` : 'Licence : Premium actif';
      } else {
        licenseLabel.innerText =
          "Version d'évaluation standard";
        badge.className =
          "badge-free";
        badge.innerText =
          "FREE";
        licenseExpiration.innerText =
          "";
        const keyEl=document.getElementById('license-key');
        if(keyEl) keyEl.textContent='';
      }
      /* -------------------------------------------------------
         PREMIUM
      ------------------------------------------------------- */
      setPremiumState(isPremium);
      if (!isPremium) {
        addTerminalLog(
          "warn",
          "Vérification : Ce serveur n'est pas licencié Premium. Modules Premium verrouillés."
        );
      }
      /* -------------------------------------------------------
         WELCOME
      ------------------------------------------------------- */
      const welcome =
        config?.modules?.welcome || {};
      document.getElementById(
        "welcome-enabled"
      ).checked =
        Boolean(welcome.enabled);
      document.getElementById(
        "welcome-message"
      ).value =
        welcome.message ||
        "Bienvenue {user} !";
      document.getElementById(
        "welcome-channel"
      ).value =
        welcome.channelId || "";
      /* -------------------------------------------------------
         GOODBYE
      ------------------------------------------------------- */
      const goodbye =
        config?.modules?.goodbye || {};
      document.getElementById(
        "goodbye-enabled"
      ).checked =
        Boolean(goodbye.enabled);
      document.getElementById(
        "goodbye-message"
      ).value =
        goodbye.message ||
        "Au revoir {user}...";
      document.getElementById(
        "goodbye-channel"
      ).value =
        goodbye.channelId || "";
      /* -------------------------------------------------------
         MODERATION
      ------------------------------------------------------- */
      const moderation =
        config?.modules?.moderation || {};
      document.getElementById(
        "moderation-enabled"
      ).checked =
        Boolean(moderation.enabled);
      document.getElementById(
        "moderation-log"
      ).value =
        moderation.logChannelId || "";
      /* -------------------------------------------------------
         AUTOMOD
      ------------------------------------------------------- */
      const autoMod =
        config?.modules?.autoMod || {};
      document.getElementById(
        "automod-enabled"
      ).checked =
        Boolean(autoMod.enabled);
      document.getElementById(
        "automod-words"
      ).value =
        Array.isArray(
          autoMod.badWords
        )
          ? autoMod.badWords.join(", ")
          : "";
      /* -------------------------------------------------------
         HONEYPOT
      ------------------------------------------------------- */
      const honeypot =
        config?.modules?.honeypot || {};
      document.getElementById(
        "honeypot-enabled"
      ).checked =
        Boolean(honeypot.enabled);
      document.getElementById(
        "honeypot-channel"
      ).value =
        honeypot.channelId || "";
      /* -------------------------------------------------------
         TICKETS
      ------------------------------------------------------- */
      const tickets =
        config?.modules?.tickets || {};
      document.getElementById(
        "tickets-enabled"
      ).checked =
        Boolean(tickets.enabled);
      document.getElementById(
        "tickets-category"
      ).value =
        tickets.categoryId || "";
      activeCategories =
        Array.isArray(
          tickets.categoriesList
        )
          ? tickets.categoriesList
          : [];
      renderCategories();
      /* -------------------------------------------------------
         ECONOMY
      ------------------------------------------------------- */
      const economy =
        config?.modules?.economy || {};
      document.getElementById(
        "economy-enabled"
      ).checked =
        Boolean(economy.enabled);
      document.getElementById(
        "economy-symbol"
      ).value =
        economy.currencySymbol || "$";
      document.getElementById("economy-cooldown").value = Number.isFinite(Number(economy.messageCooldown)) ? Math.max(1, Math.round(Number(economy.messageCooldown) / 60000)) : 60;
      /* -------------------------------------------------------
         LEVELS
      ------------------------------------------------------- */
      const levels =
        config?.modules?.levels || {};
      document.getElementById(
        "levels-enabled"
      ).checked =
        Boolean(levels.enabled);
      document.getElementById(
        "levels-xp"
      ).value =
        Number.isFinite(
          Number(levels.xpPerMessage)
        )
          ? levels.xpPerMessage
          : 15;
      /* -------------------------------------------------------
         IA
      ------------------------------------------------------- */
      const ai =
        config?.modules?.ai || {};
      document.getElementById(
        "ai-enabled"
      ).checked =
        Boolean(ai.enabled);
      document.getElementById(
        "ai-prompt"
      ).value =
        ai.systemPrompt ||
        "Tu es un assistant utile sur ce serveur Discord.";
      /* -------------------------------------------------------
         BACKUPS
      ------------------------------------------------------- */
      const backups =
        config?.modules?.backups || {};
      document.getElementById("backups-enabled").checked = Boolean(backups.enabled);
      const backupAutomatic = document.getElementById("backups-automatic");
      if (backupAutomatic) backupAutomatic.checked = Boolean(backups.automatic);
      const backupInterval = document.getElementById("backups-interval");
      if (backupInterval) backupInterval.value = Math.max(1, Math.round(Number(backups.interval || 86400000) / 3600000));
      const backupRetention = document.getElementById("backups-retention");
      if (backupRetention) backupRetention.value = Number(backups.retention || 10);
      /* -------------------------------------------------------
         TOGGLES VUE D'ENSEMBLE
      ------------------------------------------------------- */
      document.getElementById(
        "ai-enabled-toggle"
      ).checked =
        Boolean(ai.enabled);
      document.getElementById(
        "backups-enabled-toggle"
      ).checked =
        Boolean(backups.enabled);
      document.getElementById(
        "economy-enabled-toggle"
      ).checked =
        Boolean(economy.enabled);
      document.getElementById(
        "moderation-enabled-toggle"
      ).checked =
        Boolean(moderation.enabled);
      document.getElementById(
        "tickets-enabled-toggle"
      ).checked =
        Boolean(tickets.enabled);
      /* -------------------------------------------------------
         PING
         
         CORRECTION IMPORTANTE :
         
         Ancien code :
         config.modules?.ping?.enabled || true
         
         false devenait true.
      ------------------------------------------------------- */
      const ping =
        config?.modules?.ping || {};
      document.getElementById(
        "ping-enabled-toggle"
      ).checked =
        ping.enabled !== undefined
          ? Boolean(ping.enabled)
          : true;
      document.getElementById("custom-commands-enabled").checked = Boolean(config?.modules?.customCommands?.enabled);
      renderCustomCommands(config?.modules?.customCommands?.commands || []);

      const antiRaid = config?.modules?.antiRaid || {};
      document.getElementById("advanced-antiraid-enabled").checked = Boolean(antiRaid.enabled);
      document.getElementById("advanced-antiraid-threshold").value = Number(antiRaid.threshold || 10);
      const antiSpam = config?.modules?.antiSpam || {};
      document.getElementById("advanced-antispam-enabled").checked = Boolean(antiSpam.enabled);
      document.getElementById("advanced-antispam-max").value = Number(antiSpam.maxMessages || 5);
      const antiLink = config?.modules?.antiLink || {};
      document.getElementById("advanced-antilink-enabled").checked = Boolean(antiLink.enabled);
      document.getElementById("advanced-antilink-whitelist").value = Array.isArray(antiLink.whitelist) ? antiLink.whitelist.join(', ') : '';
      const verification = config?.modules?.verification || {};
      document.getElementById("advanced-verification-enabled").checked = Boolean(verification.enabled);
      document.getElementById("advanced-verification-role").value = verification.verifiedRoleId || '';
      const autoRole = config?.modules?.autoRole || {};
      document.getElementById("advanced-autorole-enabled").checked = Boolean(autoRole.enabled);
      document.getElementById("advanced-autorole-role").value = autoRole.roleId || '';
      const polls = config?.modules?.polls || {};
      document.getElementById("advanced-polls-enabled").checked = Boolean(polls.enabled);
      document.getElementById("advanced-polls-channel").value = polls.channelId || '';
      const logs = config?.modules?.logs || {};
      document.getElementById("advanced-logs-enabled").checked = Boolean(logs.enabled);
      document.getElementById("advanced-logs-channel").value = logs.channelIds?.bot || logs.channelIds?.errors || '';
      const statistics = config?.modules?.statistics || {};
      document.getElementById("advanced-stats-enabled").checked = Boolean(statistics.enabled);
      document.getElementById("advanced-stats-channel").value = statistics.channelId || '';
      document.getElementById("advanced-stats-interval").value = Number(statistics.updateInterval || 300000);
      document.getElementById("advanced-prefix").value = config?.prefix || '/';
      document.getElementById("advanced-locale").value = config?.locale || 'fr';
      document.getElementById("advanced-ai-channel").value = ai.channelId || '';
      document.getElementById("advanced-ai-tokens").value = Number(ai.maxTokens || 2000);
      document.getElementById("advanced-ai-history").value = Math.min(75, Number(ai.maxHistoryMessages || 20));
      loadBackupHistory();
    } catch (error) {
      console.error(
        "[OMNIX] Erreur loadConfig :",
        error
      );
      alert(
        "Impossible de charger les configurations :\n\n" +
        error.message
      );
      window.location.href =
        "/dashboard";
    }
  }
  /* =========================================================
     SAUVEGARDE CONFIGURATION
  ========================================================= */
  async function saveConfig() {
    try {
      /*
       * On reconstruit la liste des catégories
       * à partir des champs réellement présents.
       */
      const updatedCategoriesList =
        activeCategories.map((cat, index) => {
          const nameEl =
            document.getElementById(
              `cat-name-${index}`
            );
          const emojiEl =
            document.getElementById(
              `cat-emoji-${index}`
            );
          const typeEl =
            document.getElementById(
              `cat-type-${index}`
            );
          const targetEl =
            document.getElementById(
              `cat-target-${index}`
            );
          const welcomeEl =
            document.getElementById(
              `cat-welcome-${index}`
            );
          return {
            id: cat?.id || `cat_${index}`,
            name:
              nameEl?.value?.trim() ||
              "Nouvelle catégorie",
            emoji:
              emojiEl?.value?.trim() ||
              "🎫",
            type:
              typeEl?.value ||
              "category",
            targetId:
              targetEl?.value?.trim() ||
              null,
            welcomeMessage:
              welcomeEl?.value ||
              ""
          };
        });
      const payload = {
        modules: {
          welcome: {
            enabled:
              document.getElementById(
                "welcome-enabled"
              ).checked,
            message:
              document.getElementById(
                "welcome-message"
              ).value,
            channelId:
              document.getElementById(
                "welcome-channel"
              ).value.trim() || null,
            useEmbed: false
          },
          goodbye: {
            enabled:
              document.getElementById(
                "goodbye-enabled"
              ).checked,
            message:
              document.getElementById(
                "goodbye-message"
              ).value,
            channelId:
              document.getElementById(
                "goodbye-channel"
              ).value.trim() || null,
            useEmbed: false
          },
          moderation: {
            enabled:
              document.getElementById(
                "moderation-enabled"
              ).checked ||
              document.getElementById(
                "moderation-enabled-toggle"
              ).checked,
            logChannelId:
              document.getElementById(
                "moderation-log"
              ).value.trim() || null
          },
          autoMod: {
            enabled:
              document.getElementById(
                "automod-enabled"
              ).checked,
            badWords:
              document
                .getElementById(
                  "automod-words"
                )
                .value
                .split(",")
                .map((word) => word.trim())
                .filter(Boolean)
          },
          tickets: {
            enabled:
              document.getElementById(
                "tickets-enabled"
              ).checked ||
              document.getElementById(
                "tickets-enabled-toggle"
              ).checked,
            categoryId:
              document.getElementById(
                "tickets-category"
              ).value.trim() || null,
            counter:
              Number.isFinite(
                Number(
                  config?.modules?.tickets?.counter
                )
              )
                ? Number(
                    config.modules.tickets.counter
                  )
                : 0,
            categoriesList:
              updatedCategoriesList
          },
          economy: {
            enabled:
              document.getElementById(
                "economy-enabled"
              ).checked ||
              document.getElementById(
                "economy-enabled-toggle"
              ).checked,
            currencySymbol:
              document.getElementById(
                "economy-symbol"
              ).value || "$",
            messageCooldown:
              (parseInt(document.getElementById("economy-cooldown").value, 10) || 60) * 60000
          },
          levels: {
            enabled:
              document.getElementById(
                "levels-enabled"
              ).checked,
            xpPerMessage:
              parseInt(
                document.getElementById(
                  "levels-xp"
                ).value,
                10
              ) || 15,
            rewardRoles: []
          },
          ai: {
            enabled:
              document.getElementById(
                "ai-enabled"
              ).checked ||
              document.getElementById(
                "ai-enabled-toggle"
              ).checked,
            systemPrompt:
              document.getElementById(
                "ai-prompt"
              ).value,
            channelId: document.getElementById("advanced-ai-channel").value.trim() || null,
            model: (currentConfig?.modules?.ai?.model || "openrouter"),
            maxTokens: Number(document.getElementById("advanced-ai-tokens").value) || 2000,
            maxHistoryMessages: Math.min(75, Number(document.getElementById("advanced-ai-history").value) || 20)
          },
          backups: {
            enabled: document.getElementById("backups-enabled").checked || document.getElementById("backups-enabled-toggle").checked,
            automatic: Boolean(document.getElementById("backups-automatic")?.checked),
            interval: (Number(document.getElementById("backups-interval")?.value) || 24) * 3600000,
            retention: Number(document.getElementById("backups-retention")?.value) || 10
          },
          customCommands: {
            enabled: document.getElementById("custom-commands-enabled").checked,
            commands: readCustomCommands()
          },
          antiRaid: { enabled: document.getElementById("advanced-antiraid-enabled").checked, threshold: Number(document.getElementById("advanced-antiraid-threshold").value) || 10 },
          antiSpam: { enabled: document.getElementById("advanced-antispam-enabled").checked, maxMessages: Number(document.getElementById("advanced-antispam-max").value) || 5 },
          antiLink: { enabled: document.getElementById("advanced-antilink-enabled").checked, whitelist: document.getElementById("advanced-antilink-whitelist").value.split(',').map(v=>v.trim()).filter(Boolean), action: "delete" },
          verification: { enabled: document.getElementById("advanced-verification-enabled").checked, verifiedRoleId: document.getElementById("advanced-verification-role").value.trim() || null },
          autoRole: { enabled: document.getElementById("advanced-autorole-enabled").checked, roleId: document.getElementById("advanced-autorole-role").value.trim() || null },
          polls: { enabled: document.getElementById("advanced-polls-enabled").checked, channelId: document.getElementById("advanced-polls-channel").value.trim() || null },
          logs: { ...(currentConfig?.modules?.logs || {}), enabled: document.getElementById("advanced-logs-enabled").checked, channelIds: { ...((currentConfig?.modules?.logs?.channelIds) || {}), bot: document.getElementById("advanced-logs-channel").value.trim() || null } },
          statistics: { enabled: document.getElementById("advanced-stats-enabled").checked, channelId: document.getElementById("advanced-stats-channel").value.trim() || null, updateInterval: Number(document.getElementById("advanced-stats-interval").value) || 300000 },
          ping: { enabled: document.getElementById("ping-enabled-toggle").checked },
          honeypot: { enabled: document.getElementById("honeypot-enabled").checked, channelId: document.getElementById("honeypot-channel").value.trim() || null }
        },
        prefix: document.getElementById("advanced-prefix").value.trim() || '/',
        locale: document.getElementById("advanced-locale").value || 'fr'
      };
      /* -------------------------------------------------------
         PUT /api/guilds/:guildId/config
         
         ROUTE CONSERVÉE
      ------------------------------------------------------- */
      const response = await fetch(
        `/api/guilds/${guildId}/config`,
        {
          method: "PUT",
          headers: {
            "Content-Type":
              "application/json"
          },
          credentials:
            "include",
          body:
            JSON.stringify(payload)
        }
      );
      if (!response.ok) {
        const errData =
          await response
            .json()
            .catch(() => ({}));
        throw new Error(
          errData.message ||
          errData.error ||
          errData.details ||
          `Erreur HTTP ${response.status}`
        );
      }
      const toast =
        document.getElementById("toast");
      if (toast) {
        toast.classList.remove('hidden','error');
        toast.classList.add('show');
        toast.textContent='✓ Modifications enregistrées';
        setTimeout(() => { toast.classList.remove('show'); }, 3000);
      }
      /*
       * Recharge la configuration serveur
       * afin de confirmer que les données
       * correspondent à celles enregistrées.
       */
      await loadConfig();
    } catch (error) {
      console.error(
        "[OMNIX] Erreur saveConfig :",
        error
      );
      const toast=document.getElementById('toast');
      if(toast){ toast.classList.remove('hidden','show'); toast.classList.add('error','show'); toast.textContent='✕ Échec de l’enregistrement'; setTimeout(()=>toast.classList.remove('show'),3500); }
    }
  }
  /* =========================================================
     COMMANDES PERSONNALISÉES
  ========================================================= */
  let customCommandsDraft = [];
  function renderCustomCommands(commands){
    customCommandsDraft = Array.isArray(commands) ? commands.map(c=>({name:String(c?.name||''),response:String(c?.response||''),enabled:c?.enabled!==false})) : [];
    const box=document.getElementById('custom-command-list'); if(!box)return;
    box.innerHTML='';
    if(!customCommandsDraft.length){box.innerHTML='<div class="empty-state">Aucune commande personnalisée. Ajoutez votre première commande.</div>';return;}
    customCommandsDraft.forEach((cmd,i)=>{
      const row=document.createElement('div'); row.className='command-row';
      row.innerHTML=`<div><input data-cmd-name="${i}" value="${escapeAttr(cmd.name)}" placeholder="nom"><label style="display:block;margin-top:8px;font-size:11px;color:#94a3b8"><input type="checkbox" data-cmd-enabled="${i}" ${cmd.enabled?'checked':''}> Active</label></div><textarea data-cmd-response="${i}" placeholder="Réponse de la commande">${escapeHtml(cmd.response)}</textarea><button type="button" class="btn btn-danger-soft" onclick="removeCustomCommand(${i})">Supprimer</button>`; box.appendChild(row);
    });
  }
  function escapeAttr(v){return String(v??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  function readCustomCommands(){
    return customCommandsDraft.map((cmd,i)=>({name:document.querySelector(`[data-cmd-name="${i}"]`)?.value.trim().toLowerCase()||'',response:document.querySelector(`[data-cmd-response="${i}"]`)?.value||'',enabled:Boolean(document.querySelector(`[data-cmd-enabled="${i}"]`)?.checked)})).filter(c=>/^[a-z0-9_-]{1,32}$/.test(c.name)&&c.response.trim());
  }
  function addCustomCommand(){customCommandsDraft.push({name:'nouvelle-commande',response:'',enabled:true});renderCustomCommands(customCommandsDraft);}
  function removeCustomCommand(i){customCommandsDraft.splice(i,1);renderCustomCommands(customCommandsDraft);}

  async function loadBackupHistory(){
    const box=document.getElementById('backup-history'); if(!box||!guildId)return;
    try{const r=await fetch(`/api/guilds/${guildId}/backups`,{credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok)throw new Error(d.error||`HTTP ${r.status}`);const rows=d.backups||[];box.innerHTML=rows.length?rows.map(b=>`<div class="backup-row"><div><b>${escapeHtml(b.name||'Sauvegarde')}</b><div class="field-hint">${b.backupId||''} · ${b.createdAt?new Date(b.createdAt).toLocaleString('fr-FR'):''}</div></div><div class="backup-status">${b.status==='completed'?'✓ Terminée':'• '+escapeHtml(b.status||'')}</div><button type="button" class="btn btn-secondary" onclick="restoreBackup('${escapeAttr(b.backupId)}')">Restaurer</button></div>`).join(''):'<div class="empty-state">Aucune sauvegarde disponible.</div>';}catch(e){box.innerHTML=`<div class="empty-state">Historique indisponible : ${escapeHtml(e.message)}</div>`;}
  }
  async function restoreBackup(id){if(!id||!confirm('Restaurer cette configuration ? Les réglages actuels seront remplacés.'))return;try{const r=await fetch(`/api/guilds/${guildId}/backups/${encodeURIComponent(id)}/restore`,{method:'POST',credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok)throw new Error(d.error||`HTTP ${r.status}`);alert('✅ Configuration restaurée.');await loadConfig();}catch(e){alert('❌ '+e.message);}}

  /* =========================================================
     BACKUP
     
     ROUTE CONSERVÉE
  ========================================================= */
  async function triggerBackup() {
    const backupButton =
      document.getElementById(
        "backup-btn"
      );
    if (
      backupButton &&
      backupButton.disabled
    ) {
      return;
    }
    try {
      const response = await fetch(
        `/api/guilds/${guildId}/backups`,
        {
          method: "POST",
          // Authentification via le cookie httpOnly de session.
          credentials:
            "include"
        }
      );
      if (!response.ok) {
        const errData =
          await response
            .json()
            .catch(() => ({}));
        throw new Error(
          errData.message ||
          errData.error ||
          errData.details ||
          `Erreur HTTP ${response.status}`
        );
      }
      alert("✅ Instantané de sauvegarde créé avec succès !");
      await loadBackupHistory();
    } catch (error) {
      console.error(
        "[OMNIX] Erreur backup :",
        error
      );
      alert(
        "❌ Échec de la création de la sauvegarde : " +
        error.message
      );
    }
  }
  /* =========================================================
     DIAGNOSTIC
  ========================================================= */
  function addTerminalLog(type, message) {
    console.log(
      `[OMNIX][${String(type).toUpperCase()}] ${message}`
    );
  }
  /* =========================================================
     INITIALISATION
  ========================================================= */
  document.addEventListener(
    "DOMContentLoaded",
    () => {
      setupCheckboxSync();
      /*
       * Vue d'ensemble par défaut.
       *
       * Correction :
       * le bouton est btn-tab-general,
       * pas btn-tab-tab-overview.
       */
      switchTab("tab-overview");
      loadConfig();
    }
  );
</script>

  <div id="manage-preferences" role="dialog" aria-modal="true" aria-labelledby="manage-pref-title">
    <div class="manage-pref-panel">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px">
        <div><h2 id="manage-pref-title" style="font-size:20px;margin:0">Personnaliser OMNIX</h2><p style="margin-top:6px;color:#7f8ba3;font-size:11px">Ces préférences sont enregistrées uniquement pour votre compte.</p></div>
        <button type="button" class="manage-button button-secondary" onclick="closeManagePreferences()">✕</button>
      </div>
      <div class="manage-pref-grid">
        <label class="manage-pref-row"><span>Mode compact<small>Réduit les espacements des cartes.</small></span><input id="mp-compact" type="checkbox"></label>
        <label class="manage-pref-row"><span>Animations<small>Active les transitions OMNIX.</small></span><input id="mp-animations" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Statistiques<small>Afficher les indicateurs principaux.</small></span><input id="mp-stats" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Serveurs<small>Afficher les éléments liés aux serveurs.</small></span><input id="mp-servers" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Activité<small>Afficher les blocs d’activité.</small></span><input id="mp-activity" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Analyses<small>Afficher les statistiques détaillées.</small></span><input id="mp-statistics" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Barre latérale réduite<small>Réduit la navigation quand possible.</small></span><input id="mp-sidebar" type="checkbox"></label>
        <label class="manage-pref-row"><span>Densité compacte<small>Interface plus serrée.</small></span><input id="mp-density" type="checkbox"></label>
      </div>
      <div class="manage-pref-actions"><button type="button" class="manage-button button-secondary" onclick="closeManagePreferences()">Annuler</button><button type="button" class="manage-button" style="background:linear-gradient(135deg,#7c5cff,#4f46e5);color:#fff" onclick="saveManagePreferences()">💾 Enregistrer</button></div>
    </div>
  </div>
  <div id="manage-pref-toast"></div>

  <script>
  (function(){
    const $=id=>document.getElementById(id);
    const defaults={compactMode:false,sidebarCollapsed:false,animations:true,showStats:true,showServers:true,showActivity:true,showStatistics:true,density:'comfortable'};
    let current={...defaults};
    function toast(msg,ok){const t=$('manage-pref-toast');if(!t)return;t.textContent=(ok?'✓ ':'✕ ')+msg;t.className='show '+(ok?'success':'error');clearTimeout(window.__mpToast);window.__mpToast=setTimeout(()=>t.classList.remove('show'),3200)}
    function apply(p){current={...defaults,...p};document.body.classList.toggle('omnix-compact',!!current.compactMode);document.body.classList.toggle('omnix-no-animations',current.animations===false);document.body.classList.toggle('omnix-density-compact',current.density==='compact');document.body.classList.toggle('omnix-sidebar-compact',!!current.sidebarCollapsed)}
    function fill(p){$('mp-compact').checked=!!p.compactMode;$('mp-animations').checked=p.animations!==false;$('mp-stats').checked=p.showStats!==false;$('mp-servers').checked=p.showServers!==false;$('mp-activity').checked=p.showActivity!==false;$('mp-statistics').checked=p.showStatistics!==false;$('mp-sidebar').checked=!!p.sidebarCollapsed;$('mp-density').checked=p.density==='compact'}
    async function load(){try{const r=await fetch('/api/dashboard/preferences',{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();apply(d.preferences||defaults)}catch(e){console.warn('[OMNIX] Préférences indisponibles',e)}}
    window.openManagePreferences=async function(){fill(current);$('manage-preferences').classList.add('open');await load();fill(current)};
    window.closeManagePreferences=()=> $('manage-preferences').classList.remove('open');
    window.saveManagePreferences=async function(){const p={compactMode:$('mp-compact').checked,animations:$('mp-animations').checked,showStats:$('mp-stats').checked,showServers:$('mp-servers').checked,showActivity:$('mp-activity').checked,showStatistics:$('mp-statistics').checked,sidebarCollapsed:$('mp-sidebar').checked,density:$('mp-density').checked?'compact':'comfortable'};try{const r=await fetch('/api/dashboard/preferences',{method:'PATCH',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(p)});const d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw new Error(d.error||('HTTP '+r.status));apply(d.preferences||p);closeManagePreferences();toast('Préférences enregistrées',true)}catch(e){console.error('[OMNIX] Préférences:',e);toast(e.message||'Échec de l’enregistrement',false)}};
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeManagePreferences()});
    load();
  })();
  </script>
</body>
</html>
