<%
/* =========================================================
   OMNIX — MANAGE
   PARTIE 1/2 — STRUCTURE EJS / HTML
========================================================= */
const currentGuildId = guildId || "";
%>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <title>
    OMNIX — Gestion du serveur
  </title>
  <link
    rel="stylesheet"
    href="/css/dashboard.css"
  >
  <style>
    /* =====================================================
       MANAGE
    ===================================================== */
    .manage-page {
      min-height: 100vh;
      padding: 32px;
    }
    .manage-container {
      max-width: 1500px;
      margin: 0 auto;
    }
    .manage-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }
    .manage-title {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      color: #fff;
    }
    .manage-subtitle {
      margin: 8px 0 0;
      color: #94a3b8;
      font-size: 14px;
    }
    .license-card {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border-radius: 14px;
      background: rgba(15, 23, 42, .75);
      border: 1px solid rgba(255,255,255,.08);
    }
    .license-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .license-label {
      color: #fff;
      font-size: 13px;
      font-weight: 700;
    }
    .license-expiration {
      color: #64748b;
      font-size: 11px;
    }
    .badge-premium,
    .badge-free {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 60px;
      padding: 5px 9px;
      border-radius: 7px;
      font-size: 10px;
      font-weight: 800;
    }
    .badge-premium {
      color: #ddd6fe;
      background: rgba(124,58,237,.18);
      border: 1px solid rgba(167,139,250,.25);
    }
    .badge-free {
      color: #94a3b8;
      background: rgba(100,116,139,.12);
      border: 1px solid rgba(100,116,139,.2);
    }
    /* =====================================================
       LAYOUT
    ===================================================== */
    .manage-layout {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }
    .manage-tabs {
      position: sticky;
      top: 24px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      padding: 12px;
      border-radius: 16px;
      background: rgba(15,23,42,.72);
      border: 1px solid rgba(255,255,255,.07);
      backdrop-filter: blur(18px);
    }
    .manage-tab-button {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 12px 13px;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: #94a3b8;
      font-size: 13px;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
      transition: .2s ease;
    }
    .manage-tab-button:hover {
      background: rgba(255,255,255,.05);
      color: #fff;
    }
    .manage-tab-button.active {
      background: rgba(79,70,229,.18);
      color: #fff;
      box-shadow: inset 3px 0 0 #6366f1;
    }
    .tab-icon {
      width: 22px;
      text-align: center;
      font-size: 15px;
    }
    /* =====================================================
       CONFIG PANEL
    ===================================================== */
    .config-panel {
      min-width: 0;
      padding: 24px;
      border-radius: 18px;
      background: rgba(15,23,42,.72);
      border: 1px solid rgba(255,255,255,.07);
      backdrop-filter: blur(18px);
    }
    .tab-content {
      display: block;
    }
    .tab-content.hidden {
      display: none;
    }
    .section-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
    }
    .section-title {
      margin: 0;
      color: #fff;
      font-size: 21px;
      font-weight: 800;
    }
    .section-description {
      margin: 7px 0 0;
      color: #64748b;
      font-size: 13px;
      line-height: 1.5;
    }
    .config-card {
      margin-bottom: 18px;
      padding: 20px;
      border-radius: 14px;
      background: rgba(2,6,23,.42);
      border: 1px solid rgba(255,255,255,.06);
    }
    .config-card:last-child {
      margin-bottom: 0;
    }
    .config-card-title {
      margin: 0 0 5px;
      color: #f8fafc;
      font-size: 14px;
      font-weight: 800;
    }
    .config-card-description {
      margin: 0 0 18px;
      color: #64748b;
      font-size: 12px;
    }
    /* =====================================================
       FORM
    ===================================================== */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .form-group {
      margin-bottom: 16px;
    }
    .form-group:last-child {
      margin-bottom: 0;
    }
    .form-group.full {
      grid-column: 1 / -1;
    }
    .form-group label {
      display: block;
      margin-bottom: 7px;
      color: #cbd5e1;
      font-size: 11px;
      font-weight: 700;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      box-sizing: border-box;
      padding: 11px 12px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 9px;
      outline: none;
      background: rgba(15,23,42,.85);
      color: #fff;
      font-family: inherit;
      font-size: 12px;
      transition: .2s ease;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 90px;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: rgba(99,102,241,.65);
      box-shadow: 0 0 0 3px rgba(99,102,241,.08);
    }
    .form-group input:disabled,
    .form-group select:disabled,
    .form-group textarea:disabled {
      opacity: .45;
      cursor: not-allowed;
    }
    /* =====================================================
       SWITCH
    ===================================================== */
    .switch-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .switch-row:last-child {
      border-bottom: 0;
    }
    .switch-title {
      color: #f8fafc;
      font-size: 13px;
      font-weight: 700;
    }
    .switch-description {
      margin-top: 4px;
      color: #64748b;
      font-size: 11px;
      line-height: 1.45;
    }
    .switch {
      position: relative;
      width: 46px;
      min-width: 46px;
      height: 24px;
    }
    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .slider {
      position: absolute;
      inset: 0;
      cursor: pointer;
      border-radius: 999px;
      background: #334155;
      transition: .2s ease;
    }
    .slider::before {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      left: 3px;
      top: 3px;
      border-radius: 50%;
      background: #fff;
      transition: .2s ease;
    }
    .switch input:checked + .slider {
      background: #4f46e5;
    }
    .switch input:checked + .slider::before {
      transform: translateX(22px);
    }
    .switch input:disabled + .slider {
      opacity: .4;
      cursor: not-allowed;
    }
    /* =====================================================
       BUTTONS
    ===================================================== */
    .manage-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 15px;
      border: 0;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .2s ease;
    }
    .manage-button:hover {
      transform: translateY(-1px);
    }
    .button-primary {
      background: #4f46e5;
      color: #fff;
    }
    .button-secondary {
      background: rgba(255,255,255,.06);
      color: #cbd5e1;
      border: 1px solid rgba(255,255,255,.08);
    }
    .button-danger {
      background: rgba(220,38,38,.14);
      color: #f87171;
      border: 1px solid rgba(220,38,38,.2);
    }
    .actions-bar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.06);
    }
    /* =====================================================
       TICKETS
    ===================================================== */
    #categories-container {
      margin-top: 15px;
    }
    .categories-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 14px;
    }
    .categories-title {
      color: #f8fafc;
      font-size: 13px;
      font-weight: 800;
    }
    /* =====================================================
       TOAST
    ===================================================== */
    #toast {
      position: fixed;
      right: 25px;
      bottom: 25px;
      z-index: 9999;
      padding: 13px 18px;
      border-radius: 10px;
      background: #16a34a;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      box-shadow: 0 12px 30px rgba(0,0,0,.25);
    }
    #toast.hidden {
      display: none;
    }
    /* =====================================================
       RESPONSIVE
    ===================================================== */
    @media (max-width: 1000px) {
      .manage-layout {
        grid-template-columns: 1fr;
      }
      .manage-tabs {
        position: static;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }
    }
    @media (max-width: 700px) {
      .manage-page {
        padding: 16px;
      }
      .manage-header {
        flex-direction: column;
        align-items: stretch;
      }
      .manage-tabs {
        grid-template-columns: repeat(2, 1fr);
      }
      .form-grid {
        grid-template-columns: 1fr;
      }
      .form-group.full {
        grid-column: auto;
      }
      .config-panel {
        padding: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- =======================================================
       SIDEBAR CENTRALISÉ OMNIX
  ======================================================== -->
  <%- include('partials/sidebar') %>
  <!-- =======================================================
       PAGE MANAGE
  ======================================================== -->
  <main class="manage-page">
    <div class="manage-container">
      <!-- ===================================================
           HEADER
      ==================================================== -->
      <header class="manage-header">
        <div>
          <h1 class="manage-title">
            Gestion du serveur
          </h1>
          <p class="manage-subtitle">
            Configurez les modules et fonctionnalités de votre serveur Discord.
          </p>
        </div>
        <div class="license-card">
          <div class="license-info">
            <span
              id="license-label"
              class="license-label"
            >
              Chargement de la licence...
            </span>
            <span
              id="license-expiration"
              class="license-expiration"
            ></span>
          </div>
          <span
            id="license-badge"
            class="badge-free"
          >
            FREE
          </span>
        </div>
      </header>
      <!-- ===================================================
           LAYOUT
      ==================================================== -->
      <div class="manage-layout">
        <!-- =================================================
             ONGLETS
        ================================================== -->
        <nav class="manage-tabs">
          <button
            type="button"
            id="btn-tab-general"
            class="manage-tab-button active"
            onclick="switchTab('tab-overview')"
          >
            <span class="tab-icon">⚙️</span>
            Général
          </button>
          <button
            type="button"
            id="btn-tab-welcome"
            class="manage-tab-button"
            onclick="switchTab('tab-welcome')"
          >
            <span class="tab-icon">👋</span>
            Accueil
          </button>
          <button
            type="button"
            id="btn-tab-moderation"
            class="manage-tab-button"
            onclick="switchTab('tab-moderation')"
          >
            <span class="tab-icon">🛡️</span>
            Modération
          </button>
          <button
            type="button"
            id="btn-tab-tickets"
            class="manage-tab-button"
            onclick="switchTab('tab-tickets')"
          >
            <span class="tab-icon">🎫</span>
            Tickets
          </button>
          <button
            type="button"
            id="btn-tab-economy"
            class="manage-tab-button"
            onclick="switchTab('tab-economy')"
          >
            <span class="tab-icon">💰</span>
            Économie
          </button>
          <button
            type="button"
            id="btn-tab-ai"
            class="manage-tab-button"
            onclick="switchTab('tab-ai')"
          >
            <span class="tab-icon">🤖</span>
            Intelligence artificielle
          </button>
          <button
            type="button"
            id="btn-tab-backups"
            class="manage-tab-button"
            onclick="switchTab('tab-backups')"
          >
            <span class="tab-icon">💾</span>
            Sauvegardes
          </button>
        </nav>
        <!-- =================================================
             PANNEAU CONFIGURATION
        ================================================== -->
        <section class="config-panel">
          <!-- ===============================================
               VUE D'ENSEMBLE
          ================================================ -->
          <section
            id="tab-overview"
            class="tab-content"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Vue d'ensemble
                </h2>
                <p class="section-description">
                  Activez ou désactivez rapidement les principaux modules OMNIX.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Modules principaux
              </h3>
              <p class="config-card-description">
                État général des fonctionnalités du serveur.
              </p>
              <!-- IA -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Intelligence artificielle
                  </div>
                  <div class="switch-description">
                    Active l'assistant IA OMNIX sur le serveur.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="ai-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- BACKUPS -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Sauvegardes
                  </div>
                  <div class="switch-description">
                    Permet de conserver des instantanés de configuration.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="backups-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- ECONOMY -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Économie
                  </div>
                  <div class="switch-description">
                    Active le système économique du serveur.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="economy-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- MODERATION -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Modération
                  </div>
                  <div class="switch-description">
                    Active les fonctionnalités de modération OMNIX.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="moderation-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- TICKETS -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Tickets
                  </div>
                  <div class="switch-description">
                    Active le système de tickets.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="tickets-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <!-- PING -->
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Ping
                  </div>
                  <div class="switch-description">
                    Active les fonctionnalités de ping et diagnostic.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="ping-enabled-toggle"
                  >
                  <span class="slider"></span>
                </label>
              </div>
            </div>
            <!-- Hidden controls utilisés par le script -->
            <input
              type="checkbox"
              id="ai-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="backups-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="economy-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="moderation-enabled"
              hidden
            >
            <input
              type="checkbox"
              id="tickets-enabled"
              hidden
            >
          </section>
          <!-- ===============================================
               WELCOME
          ================================================ -->
          <section
            id="tab-welcome"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Accueil
                </h2>
                <p class="section-description">
                  Configurez les messages d'arrivée et de départ.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Message de bienvenue
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les messages de bienvenue
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="welcome-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="welcome-message">
                    Message
                  </label>
                  <textarea
                    id="welcome-message"
                    placeholder="Bienvenue {user} !"
                  ></textarea>
                </div>
                <div class="form-group full">
                  <label for="welcome-channel">
                    ID du salon
                  </label>
                  <input
                    type="text"
                    id="welcome-channel"
                    placeholder="Ex: 1211490202246189167"
                  >
                </div>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Message de départ
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les messages de départ
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="goodbye-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="goodbye-message">
                    Message
                  </label>
                  <textarea
                    id="goodbye-message"
                    placeholder="Au revoir..."
                  ></textarea>
                </div>
                <div class="form-group full">
                  <label for="goodbye-channel">
                    ID du salon
                  </label>
                  <input
                    type="text"
                    id="goodbye-channel"
                    placeholder="Ex: 1211490202246189167"
                  >
                </div>
              </div>
            </div>
          </section>
          <!-- ===============================================
               MODERATION
          ================================================ -->
          <section
            id="tab-moderation"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Modération
                </h2>
                <p class="section-description">
                  Configurez la modération et l'AutoMod de votre serveur.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Modération générale
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer la modération
                  </div>
                  <div class="switch-description">
                    Active les systèmes de modération OMNIX.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="moderation-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="moderation-log">
                  Salon des logs
                </label>
                <input
                  type="text"
                  id="moderation-log"
                  placeholder="ID du salon de logs"
                >
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                AutoMod
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer AutoMod
                  </div>
                  <div class="switch-description">
                    Bloque automatiquement les mots configurés.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="automod-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="automod-words">
                  Mots interdits
                </label>
                <input
                  type="text"
                  id="automod-words"
                  placeholder="mot1, mot2, mot3"
                >
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Honeypot
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Salon piège
                  </div>
                  <div class="switch-description">
                    Fonctionnalité Premium de protection contre les comportements suspects.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="honeypot-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="honeypot-channel">
                  ID du salon piège
                </label>
                <input
                  type="text"
                  id="honeypot-channel"
                  placeholder="Ex: 1211490202246189167"
                >
              </div>
            </div>
          </section>
          <!-- ===============================================
               TICKETS
          ================================================ -->
          <section
            id="tab-tickets"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Tickets
                </h2>
                <p class="section-description">
                  Configurez le système de support et les catégories de tickets.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Configuration générale
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les tickets
                  </div>
                  <div class="switch-description">
                    Permet aux membres d'ouvrir des tickets.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="tickets-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="tickets-category">
                  Catégorie Discord par défaut
                </label>
                <input
                  type="text"
                  id="tickets-category"
