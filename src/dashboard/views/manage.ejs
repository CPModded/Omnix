@media(max-width:900px){.manage-page{margin-left:0!important;padding:0 15px 50px!important}.manage-header{padding-top:18px!important}.clean-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.clean-quick-grid{grid-template-columns:1fr}.clean-hero{padding:22px 18px}.clean-hero-logo{width:62px;height:62px;flex-basis:62px;border-radius:17px}.clean-hero-title{font-size:23px}}
@media(max-width:900px){.omnix-sidebar{left:0!important;right:auto!important;transform:none!important;visibility:visible!important;pointer-events:auto!important;width:220px!important;border-right:1px solid rgba(255,255,255,.075)!important;border-left:0!important}.manage-page{margin-left:220px!important;padding-left:18px!important;padding-right:18px!important}.sidebar-overlay{display:none!important}}
@media(max-width:560px){.omnix-sidebar{width:205px!important}.manage-page{margin-left:205px!important;padding:0 10px 40px!important}.manage-title{font-size:23px!important}.manage-header{align-items:flex-start!important}.license-card{display:none!important}.manage-tabs{margin-left:-2px!important;margin-right:-2px!important}.clean-strip{padding:10px 11px}.clean-hero{min-height:150px;padding:20px 15px}.clean-hero-content{gap:13px}.clean-hero-logo{width:58px;height:58px;flex-basis:58px}.clean-hero-title{font-size:20px}.clean-start-row{grid-template-columns:1fr;gap:9px}.clean-start-button{justify-self:start}.clean-stats{gap:9px}.clean-stat{min-height:78px;padding:12px}.clean-stat-value{font-size:21px}.clean-chart{height:90px}}
</style>

<meta name="omnix-dashboard-version" content="3.6.4-clean-locks-2">
</head>
<body>
  <!-- =======================================================
       SIDEBAR CENTRALISÉ OMNIX
  ======================================================== -->
  <%- include('partials/sidebar') %>
  <!-- =======================================================
       PAGE MANAGE
  ======================================================== -->
  <main class="manage-page">
    <div class="manage-container">
      <!-- ===================================================
           HEADER
      ==================================================== -->
      <header class="manage-header">
        <div>
          <h1 class="manage-title">
            Gestion du serveur
          </h1>
          <p class="manage-subtitle">
            Configurez les modules et fonctionnalités de votre serveur Discord.
          </p>
        </div>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end">
          <button type="button" class="manage-button button-secondary" onclick="openManagePreferences()">⚙️ Personnaliser</button>
          <div class="license-card">
          <div class="license-info">
            <span
              id="license-label"
              class="license-label"
            >
              Chargement de la licence...
            </span>
            <span
              id="license-expiration"
              class="license-expiration"
            ></span>
            <span id="license-key" class="license-key"></span>
          </div>
          <span
            id="license-badge"
            class="badge-free"
          >
            FREE
          </span>
          </div>
        </div>
      </header>
      <!-- ===================================================
           LAYOUT
      ==================================================== -->
      <div class="manage-layout">
        <!-- =================================================
             ONGLETS
        ================================================== -->
        <nav class="manage-tabs" aria-label="Configuration du serveur">
          <button type="button" id="btn-tab-general" class="manage-tab-button active" onclick="switchTab('tab-overview')">
            <span class="tab-icon">◈</span><span>Vue d’ensemble</span>
          </button>
          <button type="button" id="btn-tab-welcome" class="manage-tab-button" onclick="switchTab('tab-welcome')">
            <span class="tab-icon">👋</span><span>Accueil</span>
          </button>
          <button type="button" id="btn-tab-moderation" class="manage-tab-button" onclick="switchTab('tab-moderation')">
            <span class="tab-icon">🛡️</span><span>Modération</span>
          </button>
          <button type="button" id="btn-tab-tickets" class="manage-tab-button" onclick="switchTab('tab-tickets')">
            <span class="tab-icon">🎫</span><span>Tickets</span>
          </button>
          <button type="button" id="btn-tab-economy" class="manage-tab-button" onclick="switchTab('tab-economy')">
            <span class="tab-icon">💰</span><span>Économie</span>
          </button>
          <button type="button" id="btn-tab-ai" class="manage-tab-button" onclick="switchTab('tab-ai')">
            <span class="tab-icon">🤖</span><span>Intelligence artificielle</span>
          </button>
          <button type="button" id="btn-tab-backups" class="manage-tab-button" onclick="switchTab('tab-backups')">
            <span class="tab-icon">💾</span><span>Sauvegardes</span>
          </button>
          <button type="button" id="btn-tab-commands" class="manage-tab-button" onclick="switchTab('tab-commands')">
            <span class="tab-icon">⌘</span><span>Commandes personnalisées</span>
          </button>
          <button type="button" id="btn-tab-advanced" class="manage-tab-button" onclick="switchTab('tab-advanced')">
            <span class="tab-icon">🧩</span><span>Options avancées</span>
          </button>
        </nav>
        <!-- =================================================
             PANNEAU CONFIGURATION
        ================================================== -->
        <section class="config-panel">
          <!-- ===============================================
               VUE D'ENSEMBLE
          ================================================ -->
          <section id="tab-overview" class="tab-content">
            <div class="clean-overview">
              <div class="clean-strip">
                <span class="clean-strip-icon">▦</span>
                <span><strong>L’état de votre serveur en un coup d’œil.</strong> Configurez OMNIX sans vous perdre dans les menus.</span>
              </div>

              <section class="clean-hero">
                <div class="clean-hero-content">
                  <div class="clean-hero-logo">
                    <img src="/logo.png" alt="OMNIX" onerror="this.src='/logo.svg'">
                  </div>
                  <div class="clean-hero-copy">
                    <div class="clean-hero-kicker">Votre serveur Discord</div>
                    <h2 class="clean-hero-title">Bienvenue sur OMNIX <span>FREE</span></h2>
                    <p class="clean-hero-desc">Tout votre serveur, protégé et administré depuis un seul endroit.</p>
                    <a class="clean-hero-link" href="/">omnix · control center</a>
                  </div>
                </div>
              </section>

              <section class="clean-start">
                <div class="clean-start-head">
                  <span class="clean-start-title">Pour bien démarrer</span>
                  <span class="clean-start-count">0/6 configurés</span>
                </div>
                <div class="clean-start-list">
                  <div class="clean-start-row">
                    <div class="clean-start-main"><strong>Accueillir les nouveaux membres</strong><p>Configurez un message de bienvenue automatique et choisissez le salon où il sera envoyé.</p></div>
                    <button class="clean-start-button" type="button" onclick="switchTab('tab-welcome')">Configurer</button>
                  </div>
                  <div class="clean-start-row">
                    <div class="clean-start-main"><strong>Filtrer les messages indésirables</strong><p>Activez la modération et les protections automatiques pour garder votre serveur propre.</p></div>
                    <button class="clean-start-button" type="button" onclick="switchTab('tab-moderation')">Configurer</button>
                  </div>
                  <div class="clean-start-row">
                    <div class="clean-start-main"><strong>Garder une trace de ce qui se passe</strong><p>Préparez vos logs et centralisez les événements importants du serveur.</p></div>
                    <button class="clean-start-button" type="button" onclick="switchTab('tab-moderation')">Configurer</button>
                  </div>
                  <div class="clean-start-row">
                    <div class="clean-start-main"><strong>Laisser vos membres demander de l’aide</strong><p>Configurez les tickets et permettez à votre équipe de répondre au même endroit.</p></div>
                    <button class="clean-start-button" type="button" onclick="switchTab('tab-tickets')">Configurer</button>
                  </div>
                  <div class="clean-start-row">
                    <div class="clean-start-main"><strong>Ajouter l’intelligence à votre serveur</strong><p>Activez OMNIX AI et choisissez les paramètres adaptés à votre communauté.</p></div>
                    <button class="clean-start-button" type="button" onclick="switchTab('tab-ai')">Configurer</button>
                  </div>
                  <div class="clean-start-row">
                    <div class="clean-start-main"><strong>Préparer une sauvegarde</strong><p>Gardez une copie de votre configuration pour pouvoir revenir en arrière si nécessaire.</p></div>
                    <button class="clean-start-button" type="button" onclick="switchTab('tab-backups')">Configurer</button>
                  </div>
                </div>
              </section>

              <section class="clean-stats">
                <article class="clean-stat"><div class="clean-stat-top"><span class="clean-stat-value"><%= (guild && guild.memberCount != null) ? guild.memberCount : 0 %></span><span class="clean-stat-icon">♙</span></div><div class="clean-stat-label">Membres</div></article>
                <article class="clean-stat"><div class="clean-stat-top"><span class="clean-stat-value">—</span><span class="clean-stat-icon">◉</span></div><div class="clean-stat-label">En ligne</div></article>
                <article class="clean-stat"><div class="clean-stat-top"><span class="clean-stat-value">0</span><span class="clean-stat-icon">△</span></div><div class="clean-stat-label">Infractions</div></article>
                <article class="clean-stat"><div class="clean-stat-top"><span class="clean-stat-value">0</span><span class="clean-stat-icon">□</span></div><div class="clean-stat-label">Tickets</div></article>
              </section>

              <section class="clean-activity">
                <div class="clean-activity-head">Activité — 7 derniers jours</div>
                <div class="clean-chart"><span class="clean-bar" style="height:18%"></span><span class="clean-bar" style="height:28%"></span><span class="clean-bar" style="height:42%"></span><span class="clean-bar" style="height:24%"></span><span class="clean-bar" style="height:58%"></span><span class="clean-bar" style="height:34%"></span><span class="clean-bar" style="height:48%"></span></div>
                <div class="clean-days"><span>lun.</span><span>mar.</span><span>mer.</span><span>jeu.</span><span>ven.</span><span>sam.</span><span>dim.</span></div>
              </section>

              <section class="clean-quick-grid">
                <article class="clean-quick"><h3>Protection</h3><p>AutoMod, anti-raid, anti-nuke, sanctions et logs depuis les outils de modération.</p></article>
                <article class="clean-quick"><h3>Communauté</h3><p>Bienvenue, rôles, niveaux, suggestions, sondages et outils d’engagement.</p></article>
                <article class="clean-quick"><h3>OMNIX AI</h3><p>Assistant, modération IA et mémoire persistante avec les limites de votre offre.</p></article>
              </section>

              <input type="checkbox" id="ai-enabled" hidden>
              <input type="checkbox" id="backups-enabled" hidden>
              <input type="checkbox" id="economy-enabled" hidden>
              <input type="checkbox" id="moderation-enabled" hidden>
              <input type="checkbox" id="tickets-enabled" hidden>
            </div>
          </section>
          <!-- ===============================================
               WELCOME
          ================================================ -->
          <section
            id="tab-welcome"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Accueil
                </h2>
                <p class="section-description">
                  Configurez les messages d'arrivée et de départ.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Message de bienvenue
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les messages de bienvenue
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="welcome-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="welcome-message">
                    Message
                  </label>
                  <textarea
                    id="welcome-message"
                    placeholder="Bienvenue {user} !"
                  ></textarea>
                </div>
                <div class="form-group full">
                  <label for="welcome-channel">
                    ID du salon
                  </label>
                  <input
                    type="text"
                    id="welcome-channel"
                    placeholder="Ex: 1211490202246189167"
                  >
                </div>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Message de départ
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les messages de départ
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="goodbye-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="goodbye-message">
                    Message
                  </label>
                  <textarea
                    id="goodbye-message"
                    placeholder="Au revoir..."
                  ></textarea>
                </div>
                <div class="form-group full">
                  <label for="goodbye-channel">
                    ID du salon
                  </label>
                  <input
                    type="text"
                    id="goodbye-channel"
                    placeholder="Ex: 1211490202246189167"
                  >
                </div>
              </div>
            </div>
          </section>
          <!-- ===============================================
               MODERATION
          ================================================ -->
          <section
            id="tab-moderation"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Modération
                </h2>
                <p class="section-description">
                  Configurez la modération et l'AutoMod de votre serveur.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Modération générale
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer la modération
                  </div>
                  <div class="switch-description">
                    Active les systèmes de modération OMNIX.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="moderation-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="moderation-log">
                  Salon des logs
                </label>
                <input
                  type="text"
                  id="moderation-log"
                  placeholder="ID du salon de logs"
                >
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                AutoMod
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer AutoMod
                  </div>
                  <div class="switch-description">
                    Bloque automatiquement les mots configurés.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="automod-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="automod-words">
                  Mots interdits
                </label>
                <input
                  type="text"
                  id="automod-words"
                  placeholder="mot1, mot2, mot3"
                >
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Honeypot
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Salon piège
                  </div>
                  <div class="switch-description">
                    Fonctionnalité Premium de protection contre les comportements suspects.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="honeypot-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="honeypot-channel">
                  ID du salon piège
                </label>
                <input
                  type="text"
                  id="honeypot-channel"
                  placeholder="Ex: 1211490202246189167"
                >
              </div>
            </div>
          </section>
          <!-- ===============================================
               TICKETS
          ================================================ -->
          <section
            id="tab-tickets"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Tickets
                </h2>
                <p class="section-description">
                  Configurez le système de support et les catégories de tickets.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Configuration générale
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les tickets
                  </div>
                  <div class="switch-description">
                    Permet aux membres d'ouvrir des tickets.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="tickets-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="tickets-category">
                  Catégorie Discord par défaut
                </label>
                <input
                  type="text"
                  id="tickets-category"
                  placeholder="ID de la catégorie Discord"
                >
              </div>
            </div>
            <div class="config-card">
              <div class="categories-header">
                <div>
                  <div class="categories-title">
                    Catégories personnalisées
                  </div>
                </div>
                <button
                  type="button"
                  class="manage-button button-primary"
                  onclick="addCategoryRow()"
                >
                  + Ajouter
                </button>
              </div>
              <div id="categories-container"></div>
            </div>
          </section>
          <!-- ===============================================
               ECONOMY
          ================================================ -->
          <section
            id="tab-economy"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Économie
                </h2>
                <p class="section-description">
                  Configurez la monnaie et les récompenses économiques.
                </p>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Configuration économique
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer l'économie
                  </div>
                  <div class="switch-description">
                    Active les fonctionnalités économiques du bot.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="economy-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label for="economy-symbol">
                    Symbole de la monnaie
                  </label>
                  <input
                    type="text"
                    id="economy-symbol"
                    value="$"
                    maxlength="5"
                  >
                </div>
                <div class="form-group">
                  <label for="economy-cooldown">
                    Cooldown Work (minutes)
                  </label>
                  <input
                    type="number"
                    id="economy-cooldown"
                    value="60"
                    min="1"
                  >
                </div>
              </div>
            </div>
            <div class="config-card">
              <h3 class="config-card-title">
                Niveaux
              </h3>
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les niveaux
                  </div>
                  <div class="switch-description">
                    Attribue de l'XP aux membres actifs.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="levels-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="levels-xp">
                  XP par message
                </label>
                <input
                  type="number"
                  id="levels-xp"
                  value="15"
                  min="0"
                >
              </div>
            </div>
          </section>
          <!-- ===============================================
               IA
          ================================================ -->
          <section
            id="tab-ai"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Intelligence artificielle
                </h2>
                <p class="section-description">
                  Configurez l'assistant IA de votre serveur.
                </p>
              </div>
            </div>
            <div class="config-card">
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer l'IA
                  </div>
                  <div class="switch-description">
                    Active l'assistant IA OMNIX.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="ai-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-group">
                <label for="ai-prompt">
                  Prompt système
                </label>
                <textarea
                  id="ai-prompt"
                  rows="8"
                  placeholder="Tu es un assistant utile sur ce serveur Discord."
                ></textarea>
              </div>
            </div>
          </section>
          <!-- ===============================================
               BACKUPS
          ================================================ -->
          <section id="tab-commands" class="tab-content hidden">
            <div class="section-header"><div><h2 class="section-title">Commandes personnalisées</h2><p class="section-description">Créez des commandes simples avec une réponse personnalisée. Elles sont enregistrées dans la configuration du serveur.</p></div></div>
            <div class="config-card">
              <div class="switch-row"><div><div class="switch-title">Activer les commandes personnalisées</div><div class="switch-description">Permet d'utiliser les commandes définies ci-dessous.</div></div><label class="switch"><input type="checkbox" id="custom-commands-enabled"><span class="slider"></span></label></div>
              <div class="premium-note">💡 Utilisez des noms simples sans espace, par exemple <b>regles</b>, <b>ip</b> ou <b>socials</b>. Les réponses peuvent contenir des mentions et du texte libre.</div>
              <div id="custom-command-list" class="command-list"></div>
              <div class="mini-actions" style="margin-top:14px"><button class="btn btn-secondary" type="button" onclick="addCustomCommand()">＋ Ajouter une commande</button></div>
            </div>
          </section>

          <section id="tab-advanced" class="tab-content hidden">
            <div class="section-header"><div><h2 class="section-title">Options avancées</h2><p class="section-description">Personnalisez les protections, les logs, les niveaux, la vérification, les automatismes et les statistiques.</p></div></div>
            <div class="config-card"><h3 class="config-card-title">🛡️ Protection</h3><div class="advanced-card">
              <div class="form-group"><label><input type="checkbox" id="advanced-antiraid-enabled"> Anti-Raid</label><input class="advanced-input" id="advanced-antiraid-threshold" type="number" min="2" placeholder="Seuil d'entrées"><div class="field-hint">Nombre d'entrées déclenchant la protection.</div></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-antispam-enabled"> Anti-Spam</label><input class="advanced-input" id="advanced-antispam-max" type="number" min="2" placeholder="Messages autorisés"><div class="field-hint">Fenêtre de détection en millisecondes.</div></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-antilink-enabled"> Anti-Liens</label><input class="advanced-input" id="advanced-antilink-whitelist" type="text" placeholder="discord.com, youtube.com"><div class="field-hint">Domaines autorisés séparés par des virgules.</div></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-verification-enabled"> Vérification</label><input class="advanced-input" id="advanced-verification-role" type="text" placeholder="ID du rôle vérifié"></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-autorole-enabled"> Auto-rôle</label><input class="advanced-input" id="advanced-autorole-role" type="text" placeholder="ID du rôle automatique"></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-polls-enabled"> Sondages</label><input class="advanced-input" id="advanced-polls-channel" type="text" placeholder="ID du salon"></div>
            </div></div>
            <div class="config-card"><h3 class="config-card-title">📋 Logs & statistiques</h3><div class="advanced-card">
              <div class="form-group"><label><input type="checkbox" id="advanced-logs-enabled"> Logs OMNIX</label><input class="advanced-input" id="advanced-logs-channel" type="text" placeholder="ID salon général"></div>
              <div class="form-group"><label><input type="checkbox" id="advanced-stats-enabled"> Statistiques</label><input class="advanced-input" id="advanced-stats-channel" type="text" placeholder="ID salon statistiques"></div>
              <div class="form-group"><label>Intervalle statistiques (ms)</label><input class="advanced-input" id="advanced-stats-interval" type="number" min="30000" step="1000"></div>
              <div class="form-group"><label>Préfixe</label><input class="advanced-input" id="advanced-prefix" type="text" maxlength="5" placeholder="/"></div>
              <div class="form-group full"><label>Locale</label><select class="advanced-input" id="advanced-locale"><option value="fr">Français</option><option value="en">English</option></select></div>
            </div></div>
            <div class="config-card"><h3 class="config-card-title">🤖 IA & mémoire</h3><div class="advanced-card">
              <div class="form-group"><label>Salon IA</label><input class="advanced-input" id="advanced-ai-channel" type="text" placeholder="ID du salon"></div>
              <div class="form-group"><label>Nombre maximum de tokens</label><input class="advanced-input" id="advanced-ai-tokens" type="number" min="256" max="8000"></div>
              <div class="form-group full"><label>Mémoire IA du serveur</label><input class="advanced-input" id="advanced-ai-history" type="number" min="1" max="150"><div class="field-hint">Limite serveur : jusqu’à 150 messages par heure et par utilisateur, avec compteur persistant MongoDB.</div></div>
              <div class="config-card" style="grid-column:1/-1">
                <h3 class="config-card-title">🛡️ Security Center</h3>
                <p class="config-card-description">Niveau de protection global et anti-nuke. Les contrôles restent limités aux permissions réellement disponibles au bot.</p>
                <div class="form-grid">
                  <div class="form-group"><label>Niveau de sécurité</label><select class="advanced-input" id="advanced-security-level"><option value="low">LOW</option><option value="normal">NORMAL</option><option value="high">HIGH</option><option value="maximum">MAXIMUM</option></select></div>
                  <div class="form-group"><label><input type="checkbox" id="advanced-antinuke-enabled"> Anti-Nuke</label><input class="advanced-input" id="advanced-antinuke-threshold" type="number" min="1" max="50" value="5"><div class="field-hint">Nombre d’actions sensibles avant déclenchement.</div></div>
                </div>
              </div>
              <div class="config-card" style="grid-column:1/-1">
                <h3 class="config-card-title">🎭 Personnalisation Discord</h3>
                <p class="config-card-description">Le nom ci-dessous modifie uniquement le surnom d’Omnix sur ce serveur, pas son nom global Discord.</p>
                <div class="form-grid"><div class="form-group full"><label>Surnom Omnix</label><input class="advanced-input" id="advanced-bot-nickname" maxlength="32" placeholder="Omnix"></div></div>
              </div>
            </div></div>
          </section>

          <section
            id="tab-backups"
            class="tab-content hidden"
          >
            <div class="section-header">
              <div>
                <h2 class="section-title">
                  Sauvegardes
                </h2>
                <p class="section-description">
                  Protégez la configuration de votre serveur.
                </p>
              </div>
            </div>
            <div class="config-card">
              <div class="switch-row">
                <div>
                  <div class="switch-title">
                    Activer les sauvegardes
                  </div>
                  <div class="switch-description">
                    Permet à OMNIX de gérer les sauvegardes de configuration.
                  </div>
                </div>
                <label class="switch">
                  <input
                    type="checkbox"
                    id="backups-enabled"
                  >
                  <span class="slider"></span>
                </label>
              </div>
              <div class="form-grid" style="margin-top:14px">
                <div class="form-group"><label><input type="checkbox" id="backups-automatic"> Sauvegardes automatiques</label><div class="field-hint">Crée des instantanés selon l'intervalle choisi.</div></div>
                <div class="form-group"><label for="backups-interval">Intervalle (heures)</label><input class="advanced-input" id="backups-interval" type="number" min="1" max="720" value="24"></div>
                <div class="form-group"><label for="backups-retention">Nombre de sauvegardes conservées</label><input class="advanced-input" id="backups-retention" type="number" min="1" max="100" value="10"></div>
              </div>
              <div class="actions-bar">
                <button
                  type="button"
                  id="backup-btn"
                  class="manage-button button-primary"
                  onclick="triggerBackup()"
                >
                  Créer un instantané manuel
                </button>
              </div>
            </div>
          </section>
          <!-- ===============================================
               ACTIONS GLOBALES
          ================================================ -->
          <div class="actions-bar">
            <button
              type="button"
              class="manage-button button-secondary"
              onclick="window.location.href='/dashboard'"
            >
              Annuler
            </button>
            <button
              type="button"
              class="manage-button button-primary"
              onclick="saveConfig()"
            >
              💾 Enregistrer les modifications
            </button>
          </div>
        </section>
      </div>
    </div>
  </main>
  <!-- =======================================================
       TOAST
  ======================================================== -->
  <div
    id="toast"
    class="hidden"
  >
    Configuration enregistrée avec succès.
  </div>
  <!-- =======================================================
       PARTIE 2
       
       COLLER ICI LE SCRIPT FOURNI PRÉCÉDEMMENT
  ======================================================== -->
  <!--
    La PARTIE 2 que tu m'as envoyée vient directement ici.
  -->
  
<script>
  const guildId = "<%= guildId %>";
  let currentConfig = {};
  /* =========================================================
     SESSION — cookie httpOnly uniquement
  ========================================================= */
  async function getCurrentUser() {
    try { const r=await fetch('/api/auth/me',{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}}); if(!r.ok)return null; const d=await r.json(); return d?.user||null; } catch { return null; }
  }

  /* =========================================================
     DRAWER
     
     Le sidebar centralisé est déjà inclus dans le HTML de la page.
     Ce script ne recrée pas le sidebar.
  ========================================================= */
  function legacyToggleDrawer(open) {
    const drawer = document.getElementById("side-drawer");
    if (!drawer) {
      console.warn("[OMNIX] #side-drawer introuvable dans le sidebar.");
      return;
    }
    drawer.classList.toggle("open", Boolean(open));
  }
  /* =========================================================
     ONGLETS MANAGE
  ========================================================= */
  const MANAGE_TAB_BUTTONS = [
    "btn-tab-general",
    "btn-tab-welcome",
    "btn-tab-moderation",
    "btn-tab-tickets",
    "btn-tab-economy",
    "btn-tab-ai",
    "btn-tab-backups",
    "btn-tab-commands",
    "btn-tab-advanced"
  ];
  function switchTab(tabId) {
    const target = document.getElementById(tabId);
    if (!target) {
      console.error(
        `[OMNIX] Onglet introuvable : ${tabId}`
      );
      return;
    }
    /*
     * Masque uniquement les sections du panneau Manage.
     * Aucun élément du sidebar n'est touché.
     */
    document
      .querySelectorAll(".config-panel > .tab-content")
      .forEach((section) => {
        section.classList.add("hidden");
      });
    target.classList.remove("hidden");
    /*
     * Réinitialisation uniquement des boutons Manage.
     *
     * IMPORTANT :
     * On ne fait plus :
     *
     * document.querySelectorAll('aside button')
     *
     * car cela pourrait toucher le sidebar centralisé.
     */
    MANAGE_TAB_BUTTONS.forEach((buttonId) => {
      const button = document.getElementById(buttonId);
      if (button) {
        button.classList.remove("active");
      }
    });
    /*
     * Correspondance explicite entre les sections
     * et leurs boutons.
     *
     * Cela corrige notamment :
     *
     * tab-overview -> btn-tab-general
     *
     * qui était cassé dans l'ancien code.
     */
    const tabButtonMap = {
      "tab-overview": "btn-tab-general",
      "tab-welcome": "btn-tab-welcome",
      "tab-moderation": "btn-tab-moderation",
      "tab-tickets": "btn-tab-tickets",
      "tab-economy": "btn-tab-economy",
      "tab-ai": "btn-tab-ai",
      "tab-backups": "btn-tab-backups",
      "tab-commands": "btn-tab-commands",
      "tab-advanced": "btn-tab-advanced"
    };
    const activeButtonId = tabButtonMap[tabId];
    if (activeButtonId) {
      const activeButton =
        document.getElementById(activeButtonId);
      if (activeButton) {
        activeButton.classList.add("active");
      }
    }
  }
  /* =========================================================
     CATÉGORIES TICKETS
  ========================================================= */
  let activeCategories = [];
  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
  function renderCategories() {
    const container =
      document.getElementById("categories-container");
    if (!container) {
      console.error(
        "[OMNIX] #categories-container introuvable."
      );
      return;
    }
    container.innerHTML = "";
    if (!Array.isArray(activeCategories) || activeCategories.length === 0) {
      container.innerHTML = `
        <div style="
          text-align:center;
          color:#475569;
          font-size:12px;
          padding:24px 0;
        ">
          Aucune catégorie personnalisée active.
          Cliquez sur "+ Ajouter" pour en créer une.
        </div>
      `;
      return;
    }
    activeCategories.forEach((cat, index) => {
      const block = document.createElement("div");
      block.className = "switch-row";
      block.style.flexDirection = "column";
      block.style.alignItems = "stretch";
      block.style.gap = "16px";
      block.style.padding = "20px";
      block.style.marginBottom = "16px";
      const emoji = escapeHtml(cat?.emoji || "🎫");
      const name = escapeHtml(cat?.name || "Nouvelle catégorie");
      const targetId = escapeHtml(cat?.targetId || "");
      const welcomeMessage = escapeHtml(
        cat?.welcomeMessage || ""
      );
      const type = cat?.type || "category";
      block.innerHTML = `
        <div style="
          display:flex;
          justify-content:space-between;
          align-items:center;
          border-bottom:1px solid rgba(255,255,255,0.05);
          padding-bottom:12px;
        ">
          <div style="
            display:flex;
            align-items:center;
            gap:8px;
            flex:1;
          ">
            <input
              type="text"
              value="${emoji}"
              id="cat-emoji-${index}"
              style="
                width:44px;
                text-align:center;
                padding:8px;
                border-radius:8px;
              "
              placeholder="🎫"
              maxlength="8"
            >
            <input
              type="text"
              value="${name}"
              id="cat-name-${index}"
              style="
                font-weight:700;
                color:white;
                background:none;
                border:none;
                font-size:14px;
                flex:1;
              "
              placeholder="Nom de la catégorie"
            >
          </div>
          <button
            type="button"
            onclick="deleteCategory(${index})"
            style="
              background:rgba(220,38,38,0.15);
              color:#f87171;
              border:1px solid rgba(220,38,38,0.25);
              padding:6px 12px;
              border-radius:8px;
              font-size:11px;
              font-weight:700;
              cursor:pointer;
            "
          >
            Supprimer
          </button>
        </div>
        <div class="form-grid">
          <div
            class="form-group"
            style="margin-bottom:0;"
          >
            <label>Routage (Où ouvrir les tickets)</label>
            <select
              id="cat-type-${index}"
              style="
                padding:10px;
                border-radius:8px;
              "
            >
              <option
                value="category"
                ${type === "category" ? "selected" : ""}
              >
                Catégorie Discord (Nouveau salon)
              </option>
              <option
                value="channel"
                ${type === "channel" ? "selected" : ""}
              >
                Dans un salon existant (Nouveau salon)
              </option>
              <option
                value="thread"
                ${type === "thread" ? "selected" : ""}
              >
                Fil de discussion (Thread)
              </option>
            </select>
          </div>
          <div
            class="form-group"
            style="margin-bottom:0;"
          >
            <label>ID cible (Catégorie ou Salon Discord)</label>
            <input
              type="text"
              value="${targetId}"
              id="cat-target-${index}"
              style="
                padding:10px;
                border-radius:8px;
              "
              placeholder="Ex: 1211490202246189167"
            >
          </div>
        </div>
        <div
          class="form-group"
          style="
            margin-bottom:0;
            margin-top:8px;
          "
        >
          <label>
            Message de bienvenue à l'entrée du ticket
          </label>
          <textarea
            id="cat-welcome-${index}"
            rows="2"
            style="
              padding:10px;
              font-size:12px;
              border-radius:8px;
            "
            placeholder="Variables autorisées : {user}"
          >${welcomeMessage}</textarea>
        </div>
      `;
      container.appendChild(block);
    });
  }
  function addCategoryRow() {
    activeCategories.push({
      id:
        "cat_" +
        Math.random()
          .toString(36)
          .substring(2, 10),
      name: "Nouvelle catégorie",
      emoji: "🎫",
      type: "category",
      targetId: null,
      welcomeMessage:
        "Bonjour {user}, un conseiller prend en charge votre demande. Décrivez votre problème."
    });
    renderCategories();
  }
  function deleteCategory(index) {
    if (
      !Number.isInteger(index) ||
      index < 0 ||
      index >= activeCategories.length
    ) {
      return;
    }
    activeCategories.splice(index, 1);
    renderCategories();
  }
  /* =========================================================
     CONTROLES DOM SÉCURISÉS
  ========================================================= */
  function dom(id) { return document.getElementById(id); }
  function setChecked(id, value) { const el = dom(id); if (el) el.checked = Boolean(value); }
  function setValue(id, value) { const el = dom(id); if (el) el.value = value ?? ""; }
  function isChecked(id) { const el = dom(id); return Boolean(el?.checked); }
  function inputValue(id, fallback = "") { const el = dom(id); return el ? String(el.value ?? "") : fallback; }

  /* =========================================================
     PREMIUM
  ========================================================= */
  function addPremiumLockLabel(elementId) {
    const element =
      document.getElementById(elementId);
    if (!element) return;
    const row =
      element.closest(".switch-row");
    if (!row) return;
    const title =
      row.querySelector(".switch-title");
    if (!title) return;
    if (title.querySelector(".premium-lock-label")) {
      return;
    }
    const badge =
      document.createElement("span");
    badge.className =
      "premium-lock-label";
    badge.style.cssText = `
      color:#a78bfa;
      font-size:10px;
      font-weight:800;
      background:rgba(124,58,237,0.1);
      padding:2px 6px;
      border-radius:4px;
      margin-left:6px;
    `;
    badge.textContent = "🔒 Premium";
    title.appendChild(badge);
  }
  function setPremiumState(isPremium) {
    const premiumControls = [
      "ai-enabled",
      "ai-prompt",
      "backups-enabled",
      "honeypot-enabled",
      "honeypot-channel"
    ];
    premiumControls.forEach((id) => {
      const element =
        document.getElementById(id);
      if (element) {
        element.disabled = !isPremium;
      }
    });
    const aiPrompt =
      document.getElementById("ai-prompt");
    if (aiPrompt) {
      aiPrompt.placeholder = isPremium
        ? ""
        : "🔒 Module Premium - Pour personnaliser le prompt, activez un abonnement OMNIX.";
    }
    const honeypotChannel =
      document.getElementById("honeypot-channel");
    if (honeypotChannel) {
      honeypotChannel.placeholder = isPremium
        ? "Ex: 1211490202246189167"
        : "🔒 Entrez votre ID de salon piégé (Abonnement requis)";
    }
    addPremiumLockLabel("honeypot-enabled");
    const backupBtn =
      document.getElementById("backup-btn");
    if (!backupBtn) return;
    backupBtn.disabled = !isPremium;
    if (!isPremium) {
      backupBtn.innerText =
        "🔒 Sauvegardes (Premium Uniquement)";
      backupBtn.style.background = "#1e293b";
      backupBtn.style.color = "#64748b";
      backupBtn.style.border = "1px solid #334155";
      backupBtn.style.cursor = "not-allowed";
      backupBtn.style.boxShadow = "none";
    } else {
      backupBtn.innerText =
        "Créer un instantané manuel";
      backupBtn.style.background = "#4f46e5";
      backupBtn.style.color = "white";
      backupBtn.style.border = "none";
      backupBtn.style.cursor = "pointer";
      backupBtn.style.boxShadow = "";
    }
  }
  /* =========================================================
     CHARGEMENT CONFIGURATION
  ========================================================= */
  async function loadConfig() {
    try {
      const response = await fetch(
        `/api/guilds/${guildId}/config`,
        {
          // La session OMNIX est portée par le cookie httpOnly jwt_token.
          // Le JWT reste uniquement dans le cookie httpOnly.
          credentials: "include"
        }
      );
      if (!response.ok) {
        const errData =
          await response
            .json()
            .catch(() => ({}));
        throw new Error(
          errData.details ||
          errData.error ||
          errData.message ||
          `Erreur HTTP ${response.status}`
        );
      }
      const config =
        await response.json();
      currentConfig = config || {};
      /* -------------------------------------------------------
         LICENCE
      ------------------------------------------------------- */
      const currentUser = await getCurrentUser();
      let license = null;
      try {
        const lr = await fetch(`/api/licenses/me?guildId=${encodeURIComponent(guildId)}`, { credentials:'same-origin', cache:'no-store' });
        if (lr.ok) { const ld = await lr.json(); license = ld?.license || null; }
      } catch {}
      const isGuildPremium = Boolean((config?.premium?.isPremium || (config?.plan && config.plan !== 'free')) && (!config?.premium?.expiresAt || new Date(config.premium.expiresAt).getTime() > Date.now()));
      const isActivatedLicense = Boolean(license && license.activatedGuildId === guildId);
      const isPremium = isGuildPremium || isActivatedLicense;
      const licenseLabel =
        document.getElementById(
          "license-label"
        );
      const licenseExpiration =
        document.getElementById(
          "license-expiration"
        );
      const badge =
        document.getElementById(
          "license-badge"
        );
      if (isPremium) {
        const tier = license?.tier || config?.premium?.tier;
        licenseLabel.innerText =
          isGuildPremium && tier
            ? `Premium Activé (${String(tier).toUpperCase()})`
            : "Premium Actif (Licence Utilisateur Personnelle)";
        badge.className =
          "badge-premium";
        badge.innerText =
          "PREMIUM";
        const expiry = license?.expiresAt || config?.premium?.expiresAt;
        if (expiry) {
          licenseExpiration.innerText = `Expiration : ${new Date(expiry).toLocaleDateString('fr-FR')}`;
        } else {
          licenseExpiration.innerText = "";
        }
        const keyEl=document.getElementById('license-key');
        if(keyEl) keyEl.textContent=license?.key ? `Licence : ${license.key}` : 'Licence : Premium actif';
      } else {
        licenseLabel.innerText =
          "Version d'évaluation standard";
        badge.className =
          "badge-free";
        badge.innerText =
          "FREE";
        licenseExpiration.innerText =
          "";
        const keyEl=document.getElementById('license-key');
        if(keyEl) keyEl.textContent='';
      }
      /* -------------------------------------------------------
         PREMIUM
      ------------------------------------------------------- */
      setPremiumState(isPremium);
      if (!isPremium) {
        addTerminalLog(
          "warn",
          "Vérification : Ce serveur n'est pas licencié Premium. Modules Premium verrouillés."
        );
      }
      /* -------------------------------------------------------
         WELCOME
      ------------------------------------------------------- */
      const welcome =
        config?.modules?.welcome || {};
      document.getElementById(
        "welcome-enabled"
      ).checked =
        Boolean(welcome.enabled);
      document.getElementById(
        "welcome-message"
      ).value =
        welcome.message ||
        "Bienvenue {user} !";
      document.getElementById(
        "welcome-channel"
      ).value =
        welcome.channelId || "";
      /* -------------------------------------------------------
         GOODBYE
      ------------------------------------------------------- */
      const goodbye =
        config?.modules?.goodbye || {};
      document.getElementById(
        "goodbye-enabled"
      ).checked =
        Boolean(goodbye.enabled);
      document.getElementById(
        "goodbye-message"
      ).value =
        goodbye.message ||
        "Au revoir {user}...";
      document.getElementById(
        "goodbye-channel"
      ).value =
        goodbye.channelId || "";
      /* -------------------------------------------------------
         MODERATION
      ------------------------------------------------------- */
      const moderation =
        config?.modules?.moderation || {};
      document.getElementById(
        "moderation-enabled"
      ).checked =
        Boolean(moderation.enabled);
      document.getElementById(
        "moderation-log"
      ).value =
        moderation.logChannelId || "";
      /* -------------------------------------------------------
         AUTOMOD
      ------------------------------------------------------- */
      const autoMod =
        config?.modules?.autoMod || {};
      document.getElementById(
        "automod-enabled"
      ).checked =
        Boolean(autoMod.enabled);
      document.getElementById(
        "automod-words"
      ).value =
        Array.isArray(
          autoMod.badWords
        )
          ? autoMod.badWords.join(", ")
          : "";
      /* -------------------------------------------------------
         HONEYPOT
      ------------------------------------------------------- */
      const honeypot =
        config?.modules?.honeypot || {};
      document.getElementById(
        "honeypot-enabled"
      ).checked =
        Boolean(honeypot.enabled);
      document.getElementById(
        "honeypot-channel"
      ).value =
        honeypot.channelId || "";
      /* -------------------------------------------------------
         TICKETS
      ------------------------------------------------------- */
      const tickets =
        config?.modules?.tickets || {};
      document.getElementById(
        "tickets-enabled"
      ).checked =
        Boolean(tickets.enabled);
      document.getElementById(
        "tickets-category"
      ).value =
        tickets.categoryId || "";
      activeCategories =
        Array.isArray(
          tickets.categoriesList
        )
          ? tickets.categoriesList
          : [];
      renderCategories();
      /* -------------------------------------------------------
         ECONOMY
      ------------------------------------------------------- */
      const economy =
        config?.modules?.economy || {};
      document.getElementById(
        "economy-enabled"
      ).checked =
        Boolean(economy.enabled);
      document.getElementById(
        "economy-symbol"
      ).value =
        economy.currencySymbol || "$";
      document.getElementById("economy-cooldown").value = Number.isFinite(Number(economy.messageCooldown)) ? Math.max(1, Math.round(Number(economy.messageCooldown) / 60000)) : 60;
      /* -------------------------------------------------------
         LEVELS
      ------------------------------------------------------- */
      const levels =
        config?.modules?.levels || {};
      document.getElementById(
        "levels-enabled"
      ).checked =
        Boolean(levels.enabled);
      document.getElementById(
        "levels-xp"
      ).value =
        Number.isFinite(
          Number(levels.xpPerMessage)
        )
          ? levels.xpPerMessage
          : 15;
      /* -------------------------------------------------------
         IA
      ------------------------------------------------------- */
      const ai =
        config?.modules?.ai || {};
      setChecked("ai-enabled", ai.enabled);
      setValue("ai-prompt", ai.systemPrompt || "Tu es un assistant utile sur ce serveur Discord.");
      /* -------------------------------------------------------
         BACKUPS
      ------------------------------------------------------- */
      const backups =
        config?.modules?.backups || {};
      setChecked("backups-enabled", backups.enabled);
      const backupAutomatic = document.getElementById("backups-automatic");
      if (backupAutomatic) backupAutomatic.checked = Boolean(backups.automatic);
      const backupInterval = document.getElementById("backups-interval");
      if (backupInterval) backupInterval.value = Math.max(1, Math.round(Number(backups.interval || 86400000) / 3600000));
      const backupRetention = document.getElementById("backups-retention");
      if (backupRetention) backupRetention.value = Number(backups.retention || 10);
      /* -------------------------------------------------------
         PING
         
         CORRECTION IMPORTANTE :
         
         Ancien code :
         config.modules?.ping?.enabled || true
         
         false devenait true.
      ------------------------------------------------------- */
      const ping =
        config?.modules?.ping || {};
      document.getElementById(
        "ping-enabled-toggle"
      ).checked =
        ping.enabled !== undefined
          ? Boolean(ping.enabled)
          : true;
      setChecked("custom-commands-enabled", config?.modules?.customCommands?.enabled);
      renderCustomCommands(config?.modules?.customCommands?.commands || []);

      const antiRaid = config?.modules?.antiRaid || {};
      setChecked("advanced-antiraid-enabled", antiRaid.enabled);
      setValue("advanced-antiraid-threshold", Number(antiRaid.threshold || 10));
      const antiSpam = config?.modules?.antiSpam || {};
      setChecked("advanced-antispam-enabled", antiSpam.enabled);
      setValue("advanced-antispam-max", Number(antiSpam.maxMessages || 5));
      const antiLink = config?.modules?.antiLink || {};
      setChecked("advanced-antilink-enabled", antiLink.enabled);
      setValue("advanced-antilink-whitelist", Array.isArray(antiLink.whitelist) ? antiLink.whitelist.join(', ') : "");
      const verification = config?.modules?.verification || {};
      setChecked("advanced-verification-enabled", verification.enabled);
      setValue("advanced-verification-role", verification.verifiedRoleId || "");
      const autoRole = config?.modules?.autoRole || {};
      setChecked("advanced-autorole-enabled", autoRole.enabled);
      setValue("advanced-autorole-role", autoRole.roleId || "");
      const polls = config?.modules?.polls || {};
      setChecked("advanced-polls-enabled", polls.enabled);
      setValue("advanced-polls-channel", polls.channelId || "");
      const logs = config?.modules?.logs || {};
      setChecked("advanced-logs-enabled", logs.enabled);
      setValue("advanced-logs-channel", logs.channelIds?.bot || logs.channelIds?.errors || "");
      const statistics = config?.modules?.statistics || {};
      setChecked("advanced-stats-enabled", statistics.enabled);
      setValue("advanced-stats-channel", statistics.channelId || "");
      setValue("advanced-stats-interval", Number(statistics.updateInterval || 300000));
      setValue("advanced-prefix", config?.prefix || "/");
      setValue("advanced-locale", config?.locale || "fr");
      setValue("advanced-ai-channel", ai.channelId || "");
      setValue("advanced-ai-tokens", Number(ai.maxTokens || 2000));
      setValue("advanced-ai-history", Math.min(150, Number(ai.maxHistoryMessages || 20)));
      loadBackupHistory();
    } catch (error) {
      console.error(
        "[OMNIX] Erreur loadConfig :",
        error
      );
      alert(
        "Impossible de charger les configurations :\n\n" +
        error.message
      );
      window.location.href =
        "/dashboard";
    }
  }
  /* =========================================================
     SAUVEGARDE CONFIGURATION
  ========================================================= */
  async function saveConfig() {
    try {
      /*
       * On reconstruit la liste des catégories
       * à partir des champs réellement présents.
       */
      const updatedCategoriesList =
        activeCategories.map((cat, index) => {
          const nameEl =
            document.getElementById(
              `cat-name-${index}`
            );
          const emojiEl =
            document.getElementById(
              `cat-emoji-${index}`
            );
          const typeEl =
            document.getElementById(
              `cat-type-${index}`
            );
          const targetEl =
            document.getElementById(
              `cat-target-${index}`
            );
          const welcomeEl =
            document.getElementById(
              `cat-welcome-${index}`
            );
          return {
            id: cat?.id || `cat_${index}`,
            name:
              nameEl?.value?.trim() ||
              "Nouvelle catégorie",
            emoji:
              emojiEl?.value?.trim() ||
              "🎫",
            type:
              typeEl?.value ||
              "category",
            targetId:
              targetEl?.value?.trim() ||
              null,
            welcomeMessage:
              welcomeEl?.value ||
              ""
          };
        });
      const payload = {
        modules: {
          welcome: {
            enabled:
              document.getElementById(
                "welcome-enabled"
              ).checked,
            message:
              document.getElementById(
                "welcome-message"
              ).value,
            channelId:
              document.getElementById(
                "welcome-channel"
              ).value.trim() || null,
            useEmbed: false
          },
          goodbye: {
            enabled:
              document.getElementById(
                "goodbye-enabled"
              ).checked,
            message:
              document.getElementById(
                "goodbye-message"
              ).value,
            channelId:
              document.getElementById(
                "goodbye-channel"
              ).value.trim() || null,
            useEmbed: false
          },
          moderation: {
            enabled:
              document.getElementById(
                "moderation-enabled"
              ).checked ||
              Boolean(document.getElementById("moderation-enabled-toggle")?.checked),
            logChannelId:
              document.getElementById(
                "moderation-log"
              ).value.trim() || null
          },
          autoMod: {
            enabled:
              document.getElementById(
                "automod-enabled"
              ).checked,
            badWords:
              document
                .getElementById(
                  "automod-words"
                )
                .value
                .split(",")
                .map((word) => word.trim())
                .filter(Boolean)
          },
          tickets: {
            enabled:
              document.getElementById(
                "tickets-enabled"
              ).checked ||
              Boolean(document.getElementById("tickets-enabled-toggle")?.checked),
            categoryId:
              document.getElementById(
                "tickets-category"
              ).value.trim() || null,
            counter:
              Number.isFinite(
                Number(
                  currentConfig?.modules?.tickets?.counter
                )
              )
                ? Number(
                    currentConfig.modules.tickets.counter
                  )
                : 0,
            categoriesList:
              updatedCategoriesList
          },
          economy: {
            enabled:
              document.getElementById(
                "economy-enabled"
              ).checked ||
              Boolean(document.getElementById("economy-enabled-toggle")?.checked),
            currencySymbol:
              document.getElementById(
                "economy-symbol"
              ).value || "$",
            messageCooldown:
              (parseInt(document.getElementById("economy-cooldown").value, 10) || 60) * 60000
          },
          levels: {
            enabled:
              document.getElementById(
                "levels-enabled"
              ).checked,
            xpPerMessage:
              parseInt(
                document.getElementById(
                  "levels-xp"
                ).value,
                10
              ) || 15,
            rewardRoles: []
          },
          ai: {
            enabled:
              document.getElementById(
                "ai-enabled"
              ).checked ||
              isChecked("ai-enabled"),
            systemPrompt:
              document.getElementById(
                "ai-prompt"
              ).value,
            channelId: document.getElementById("advanced-ai-channel").value.trim() || null,
            model: (currentConfig?.modules?.ai?.model || "openrouter"),
            maxTokens: Number(document.getElementById("advanced-ai-tokens").value) || 2000,
            maxHistoryMessages: Math.min(150, Number(document.getElementById("advanced-ai-history").value) || 20)
          },
          backups: {
            enabled: isChecked("backups-enabled"),
            automatic: Boolean(document.getElementById("backups-automatic")?.checked),
            interval: (Number(document.getElementById("backups-interval")?.value) || 24) * 3600000,
            retention: Number(document.getElementById("backups-retention")?.value) || 10
          },
          customCommands: {
            enabled: document.getElementById("custom-commands-enabled").checked,
            commands: readCustomCommands()
          },
          antiRaid: { enabled: document.getElementById("advanced-antiraid-enabled").checked, threshold: Number(document.getElementById("advanced-antiraid-threshold").value) || 10 },
          antiSpam: { enabled: document.getElementById("advanced-antispam-enabled").checked, maxMessages: Number(document.getElementById("advanced-antispam-max").value) || 5 },
          antiLink: { enabled: document.getElementById("advanced-antilink-enabled").checked, whitelist: document.getElementById("advanced-antilink-whitelist").value.split(',').map(v=>v.trim()).filter(Boolean), action: "delete" },
          verification: { enabled: document.getElementById("advanced-verification-enabled").checked, verifiedRoleId: document.getElementById("advanced-verification-role").value.trim() || null },
          autoRole: { enabled: document.getElementById("advanced-autorole-enabled").checked, roleId: document.getElementById("advanced-autorole-role").value.trim() || null },
          polls: { enabled: document.getElementById("advanced-polls-enabled").checked, channelId: document.getElementById("advanced-polls-channel").value.trim() || null },
          logs: { ...(currentConfig?.modules?.logs || {}), enabled: document.getElementById("advanced-logs-enabled").checked, channelIds: { ...((currentConfig?.modules?.logs?.channelIds) || {}), bot: document.getElementById("advanced-logs-channel").value.trim() || null } },
          statistics: { enabled: document.getElementById("advanced-stats-enabled").checked, channelId: document.getElementById("advanced-stats-channel").value.trim() || null, updateInterval: Number(document.getElementById("advanced-stats-interval").value) || 300000 },
          ping: { enabled: Boolean(document.getElementById("ping-enabled-toggle")?.checked) },
          honeypot: { enabled: document.getElementById("honeypot-enabled").checked, channelId: document.getElementById("honeypot-channel").value.trim() || null }
        },
        prefix: document.getElementById("advanced-prefix").value.trim() || '/',
        locale: document.getElementById("advanced-locale").value || 'fr'
      };
      /* -------------------------------------------------------
         PUT /api/guilds/:guildId/config
         
         ROUTE CONSERVÉE
      ------------------------------------------------------- */
      const response = await fetch(
        `/api/guilds/${guildId}/config`,
        {
          method: "PUT",
          headers: {
            "Content-Type":
              "application/json"
          },
          credentials:
            "include",
          body:
            JSON.stringify(payload)
        }
      );
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.success === false) {
        throw new Error(
          result.message ||
          result.error ||
          result.details ||
          `Erreur HTTP ${response.status}`
        );
      }
      const toast =
        document.getElementById("toast");
      if (toast) {
        toast.classList.remove('hidden','error');
        toast.classList.add('show');
        toast.textContent='✓ Modifications enregistrées';
        setTimeout(() => { toast.classList.remove('show'); }, 3000);
      }
      /*
       * Recharge la configuration serveur
       * afin de confirmer que les données
       * correspondent à celles enregistrées.
       */
      await loadConfig();
    } catch (error) {
      console.error(
        "[OMNIX] Erreur saveConfig :",
        error
      );
      const toast=document.getElementById('toast');
      if(toast){ toast.classList.remove('hidden','show'); toast.classList.add('error','show'); toast.textContent='✕ Échec : '+(error?.message||'enregistrement impossible'); setTimeout(()=>toast.classList.remove('show'),3500); }
    }
  }
  /* =========================================================
     COMMANDES PERSONNALISÉES
  ========================================================= */
  let customCommandsDraft = [];
  function renderCustomCommands(commands){
    customCommandsDraft = Array.isArray(commands) ? commands.map(c=>({name:String(c?.name||''),response:String(c?.response||''),enabled:c?.enabled!==false})) : [];
    const box=document.getElementById('custom-command-list'); if(!box)return;
    box.innerHTML='';
    if(!customCommandsDraft.length){box.innerHTML='<div class="empty-state">Aucune commande personnalisée. Ajoutez votre première commande.</div>';return;}
    customCommandsDraft.forEach((cmd,i)=>{
      const row=document.createElement('div'); row.className='command-row';
      row.innerHTML=`<div><input data-cmd-name="${i}" value="${escapeAttr(cmd.name)}" placeholder="nom"><label style="display:block;margin-top:8px;font-size:11px;color:#94a3b8"><input type="checkbox" data-cmd-enabled="${i}" ${cmd.enabled?'checked':''}> Active</label></div><textarea data-cmd-response="${i}" placeholder="Réponse de la commande">${escapeHtml(cmd.response)}</textarea><button type="button" class="btn btn-danger-soft" onclick="removeCustomCommand(${i})">Supprimer</button>`; box.appendChild(row);
    });
  }
  function escapeAttr(v){return String(v??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  function readCustomCommands(){
    return customCommandsDraft.map((cmd,i)=>({name:document.querySelector(`[data-cmd-name="${i}"]`)?.value.trim().toLowerCase()||'',response:document.querySelector(`[data-cmd-response="${i}"]`)?.value||'',enabled:Boolean(document.querySelector(`[data-cmd-enabled="${i}"]`)?.checked)})).filter(c=>/^[a-z0-9_-]{1,32}$/.test(c.name)&&c.response.trim());
  }
  function addCustomCommand(){customCommandsDraft.push({name:'nouvelle-commande',response:'',enabled:true});renderCustomCommands(customCommandsDraft);}
  function removeCustomCommand(i){customCommandsDraft.splice(i,1);renderCustomCommands(customCommandsDraft);}

  async function loadBackupHistory(){
    const box=document.getElementById('backup-history'); if(!box||!guildId)return;
    try{const r=await fetch(`/api/guilds/${guildId}/backups`,{credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok)throw new Error(d.error||`HTTP ${r.status}`);const rows=d.backups||[];box.innerHTML=rows.length?rows.map(b=>`<div class="backup-row"><div><b>${escapeHtml(b.name||'Sauvegarde')}</b><div class="field-hint">${b.backupId||''} · ${b.createdAt?new Date(b.createdAt).toLocaleString('fr-FR'):''}</div></div><div class="backup-status">${b.status==='completed'?'✓ Terminée':'• '+escapeHtml(b.status||'')}</div><button type="button" class="btn btn-secondary" onclick="restoreBackup('${escapeAttr(b.backupId)}')">Restaurer</button></div>`).join(''):'<div class="empty-state">Aucune sauvegarde disponible.</div>';}catch(e){box.innerHTML=`<div class="empty-state">Historique indisponible : ${escapeHtml(e.message)}</div>`;}
  }
  async function restoreBackup(id){if(!id||!confirm('Restaurer cette configuration ? Les réglages actuels seront remplacés.'))return;try{const r=await fetch(`/api/guilds/${guildId}/backups/${encodeURIComponent(id)}/restore`,{method:'POST',credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok)throw new Error(d.error||`HTTP ${r.status}`);alert('✅ Configuration restaurée.');await loadConfig();}catch(e){alert('❌ '+e.message);}}

  /* =========================================================
     BACKUP
     
     ROUTE CONSERVÉE
  ========================================================= */
  async function triggerBackup() {
    const backupButton =
      document.getElementById(
        "backup-btn"
      );
    if (
      backupButton &&
      backupButton.disabled
    ) {
      return;
    }
    try {
      const response = await fetch(
        `/api/guilds/${guildId}/backups`,
        {
          method: "POST",
          // Authentification via le cookie httpOnly de session.
          credentials:
            "include"
        }
      );
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.success === false) {
        throw new Error(
          result.message ||
          result.error ||
          result.details ||
          `Erreur HTTP ${response.status}`
        );
      }
      alert("✅ Instantané de sauvegarde créé avec succès !");
      await loadBackupHistory();
    } catch (error) {
      console.error(
        "[OMNIX] Erreur backup :",
        error
      );
      alert(
        "❌ Échec de la création de la sauvegarde : " +
        error.message
      );
    }
  }
  /* =========================================================
     DIAGNOSTIC
  ========================================================= */
  function addTerminalLog(type, message) {
    console.log(
      `[OMNIX][${String(type).toUpperCase()}] ${message}`
    );
  }
  /* =========================================================
     INITIALISATION
  ========================================================= */
  document.addEventListener(
    "DOMContentLoaded",
    () => {
      setupCheckboxSync();
      /*
       * Vue d'ensemble par défaut.
       *
       * Correction :
       * le bouton est btn-tab-general,
       * pas btn-tab-tab-overview.
       */
      const hashTabs = {welcome:"tab-welcome",moderation:"tab-moderation",tickets:"tab-tickets",economy:"tab-economy",ai:"tab-ai",backups:"tab-backups",commands:"tab-commands",advanced:"tab-advanced"};
      const requestedTab = hashTabs[window.location.hash.replace('#','')];
      switchTab(requestedTab || "tab-overview");
      loadConfig();
    }
  );
</script>

  <div id="manage-preferences" role="dialog" aria-modal="true" aria-labelledby="manage-pref-title">
    <div class="manage-pref-panel">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px">
        <div><h2 id="manage-pref-title" style="font-size:20px;margin:0">Personnaliser OMNIX</h2><p style="margin-top:6px;color:#7f8ba3;font-size:11px">Ces préférences sont enregistrées uniquement pour votre compte.</p></div>
        <button type="button" class="manage-button button-secondary" onclick="closeManagePreferences()">✕</button>
      </div>
      <div class="manage-pref-grid">
        <label class="manage-pref-row"><span>Mode compact<small>Réduit les espacements des cartes.</small></span><input id="mp-compact" type="checkbox"></label>
        <label class="manage-pref-row"><span>Animations<small>Active les transitions OMNIX.</small></span><input id="mp-animations" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Statistiques<small>Afficher les indicateurs principaux.</small></span><input id="mp-stats" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Serveurs<small>Afficher les éléments liés aux serveurs.</small></span><input id="mp-servers" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Activité<small>Afficher les blocs d’activité.</small></span><input id="mp-activity" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Analyses<small>Afficher les statistiques détaillées.</small></span><input id="mp-statistics" type="checkbox" checked></label>
        <label class="manage-pref-row"><span>Barre latérale réduite<small>Réduit la navigation quand possible.</small></span><input id="mp-sidebar" type="checkbox"></label>
        <label class="manage-pref-row"><span>Densité compacte<small>Interface plus serrée.</small></span><input id="mp-density" type="checkbox"></label>
      </div>
      <div class="manage-pref-actions"><button type="button" class="manage-button button-secondary" onclick="closeManagePreferences()">Annuler</button><button type="button" class="manage-button" style="background:linear-gradient(135deg,#7c5cff,#4f46e5);color:#fff" onclick="saveManagePreferences()">💾 Enregistrer</button></div>
    </div>
  </div>
  <div id="manage-pref-toast"></div>

  <script>
  (function(){
    const $=id=>document.getElementById(id);
    const defaults={compactMode:false,sidebarCollapsed:false,animations:true,showStats:true,showServers:true,showActivity:true,showStatistics:true,density:'comfortable'};
    let current={...defaults};
    function toast(msg,ok){const t=$('manage-pref-toast');if(!t)return;t.textContent=(ok?'✓ ':'✕ ')+msg;t.className='show '+(ok?'success':'error');clearTimeout(window.__mpToast);window.__mpToast=setTimeout(()=>t.classList.remove('show'),3200)}
    function apply(p){current={...defaults,...p};document.body.classList.toggle('omnix-compact',!!current.compactMode);document.body.classList.toggle('omnix-no-animations',current.animations===false);document.body.classList.toggle('omnix-density-compact',current.density==='compact');document.body.classList.toggle('omnix-sidebar-compact',!!current.sidebarCollapsed)}
    function fill(p){$('mp-compact').checked=!!p.compactMode;$('mp-animations').checked=p.animations!==false;$('mp-stats').checked=p.showStats!==false;$('mp-servers').checked=p.showServers!==false;$('mp-activity').checked=p.showActivity!==false;$('mp-statistics').checked=p.showStatistics!==false;$('mp-sidebar').checked=!!p.sidebarCollapsed;$('mp-density').checked=p.density==='compact'}
    async function load(){try{const r=await fetch('/api/dashboard/preferences',{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();apply(d.preferences||defaults)}catch(e){console.warn('[OMNIX] Préférences indisponibles',e)}}
    window.openManagePreferences=async function(){fill(current);$('manage-preferences').classList.add('open');await load();fill(current)};
    window.closeManagePreferences=()=> $('manage-preferences').classList.remove('open');
    window.saveManagePreferences=async function(){const p={compactMode:$('mp-compact').checked,animations:$('mp-animations').checked,showStats:$('mp-stats').checked,showServers:$('mp-servers').checked,showActivity:$('mp-activity').checked,showStatistics:$('mp-statistics').checked,sidebarCollapsed:$('mp-sidebar').checked,density:$('mp-density').checked?'compact':'comfortable'};try{const r=await fetch('/api/dashboard/preferences',{method:'PATCH',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(p)});const d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw new Error(d.error||('HTTP '+r.status));apply(d.preferences||p);closeManagePreferences();toast('Préférences enregistrées',true)}catch(e){console.error('[OMNIX] Préférences:',e);toast(e.message||'Échec de l’enregistrement',false)}};
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeManagePreferences()});
    load();
  })();
  </script>
</body>
</html>
