<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OMNIX — Contact</title><style>:root{--bg:#050914;--panel:#0b1220;--line:rgba(255,255,255,.09);--text:#eef2ff;--muted:#94a3b8;--pri:#7c5cff;--ok:#10b981}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 10% 10%,rgba(124,92,255,.13),transparent 35%),var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}.wrap{width:min(1050px,calc(100% - 28px));margin:auto;padding:55px 0 80px}.top{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:25px}.brand{font-weight:900;letter-spacing:1.5px}.back{color:#cbd5e1;text-decoration:none;font-size:12px}.hero{margin-bottom:20px}.hero span{color:#67e8f9;font-size:10px;font-weight:800;letter-spacing:1.5px}.hero h1{font-size:clamp(32px,6vw,52px);margin:12px 0}.hero p{max-width:720px;color:var(--muted);line-height:1.8}.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.card{background:linear-gradient(145deg,rgba(15,23,42,.78),rgba(3,7,18,.72));border:1px solid var(--line);border-radius:20px;padding:20px}.card h2{margin:0 0 7px;font-size:17px}.muted{color:var(--muted);font-size:12px;line-height:1.7}.input,.textarea{width:100%;background:#080f1c;color:#fff;border:1px solid var(--line);border-radius:11px;padding:11px;margin-top:9px;outline:none}.textarea{min-height:130px;resize:vertical}.btn{margin-top:10px;border:0;border-radius:11px;padding:11px 15px;background:linear-gradient(135deg,#7c5cff,#8b5cf6);color:#fff;font-weight:800;cursor:pointer}.ticket{border:1px solid var(--line);border-radius:14px;padding:13px;margin-top:9px;cursor:pointer}.ticket:hover{border-color:rgba(124,92,255,.4)}.ticket b{font-size:12px}.status{float:right;font-size:10px;color:#6ee7b7}.messages{max-height:340px;overflow:auto;margin:14px 0}.msg{padding:10px 12px;border-bottom:1px solid var(--line)}.msg strong{font-size:11px}.msg p{margin:5px 0;color:#cbd5e1;font-size:12px;white-space:pre-wrap}.actions{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:760px){.grid{grid-template-columns:1fr}.wrap{padding-top:30px}}</style></head><body><main class="wrap"><div class="top"><div class="brand">OMNIX</div><a class="back" href="/">Retour à l'accueil</a></div><section class="hero"><span>ASSISTANCE OMNIX</span><h1>Contact & support</h1><p>Créez un ticket directement depuis votre espace. Le ticket reste privé et peut être suivi depuis cette page. Les demandes liées à une suspension peuvent également être déposées ici.</p></section><div class="grid"><section class="card"><h2>Nouveau ticket</h2><div class="muted">Expliquez clairement votre demande. Ne transmettez jamais de mot de passe, token ou clé API.</div><input id="subject" class="input" maxlength="160" placeholder="Sujet"><textarea id="content" class="textarea" maxlength="4000" placeholder="Votre message"></textarea><button class="btn" onclick="createTicket()">Créer le ticket</button><div id="createMsg" class="muted"></div></section><section class="card"><h2>Mes tickets</h2><div id="tickets"><div class="muted">Chargement…</div></div></section></div><section class="card" style="margin-top:15px;display:none" id="viewer"><div class="actions"><button class="btn" onclick="closeViewer()">← Retour</button><button id="statusBtn" class="btn" onclick="toggleStatus()">Fermer</button></div><h2 id="ticketTitle" style="margin-top:18px"></h2><div id="messages" class="messages"></div><textarea id="reply" class="textarea" placeholder="Répondre au ticket…"></textarea><button class="btn" onclick="sendReply()">Envoyer</button></section><section class="card" style="margin-top:15px"><h2>Autres moyens de contact</h2><div class="muted">Communauté Discord : <a href="https://discord.gg/rmes9YdgG9" target="_blank" rel="noopener noreferrer" style="color:#c4b5fd">serveur officiel OMNIX</a></div></section></main><script>let current=null;const $=id=>document.getElementById(id);async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(opt.headers||{})},...opt});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Erreur');return d}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}async function loadTickets(){try{const d=await api('/api/support/tickets');$('tickets').innerHTML=(d.data||[]).map(t=>`<div class="ticket" onclick="openTicket(${t.ticketNumber})"><b>#${t.ticketNumber} · ${esc(t.subject)}</b><span class="status">${t.status==='open'?'Ouvert':'Fermé'}</span><div class="muted">Mis à jour : ${new Date(t.updatedAt).toLocaleString('fr-FR')}</div></div>`).join('')||'<div class="muted">Aucun ticket.</div>'}catch(e){$('tickets').innerHTML='<div class="muted">'+esc(e.message)+'</div>'}}async function createTicket(){try{const d=await api('/api/support/tickets',{method:'POST',body:JSON.stringify({subject:$('subject').value,content:$('content').value})});$('subject').value='';$('content').value='';$('createMsg').textContent='Ticket #'+d.data.ticketNumber+' créé.';await loadTickets();openTicket(d.data.ticketNumber)}catch(e){$('createMsg').textContent=e.message}}async function openTicket(id){try{current=await api('/api/support/tickets/'+id);const t=current.data;$('viewer').style.display='block';$('ticketTitle').textContent='#'+t.ticketNumber+' · '+t.subject;$('messages').innerHTML=(t.messages||[]).map(m=>`<div class="msg"><strong>${esc(m.authorName)} · ${esc(m.authorRole)}</strong><div class="muted">${new Date(m.createdAt).toLocaleString('fr-FR')}</div><p>${esc(m.content)}</p></div>`).join('');$('statusBtn').textContent=t.status==='open'?'Fermer':'Rouvrir';$('viewer').scrollIntoView({behavior:'smooth'})}catch(e){alert(e.message)}}function closeViewer(){$('viewer').style.display='none';current=null}async function sendReply(){if(!current)return;try{await api('/api/support/tickets/'+current.data.ticketNumber+'/messages',{method:'POST',body:JSON.stringify({content:$('reply').value})});$('reply').value='';await openTicket(current.data.ticketNumber);await loadTickets()}catch(e){alert(e.message)}}async function toggleStatus(){if(!current)return;const status=current.data.status==='open'?'closed':'open';await api('/api/support/tickets/'+current.data.ticketNumber+'/status',{method:'PATCH',body:JSON.stringify({status})});await openTicket(current.data.ticketNumber);await loadTickets()}loadTickets();</script></body></html>
