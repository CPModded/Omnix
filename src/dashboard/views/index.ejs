function setupLogoFallback() {
  const image = document.getElementById('logo-main-img');
  const fallback = document.getElementById('logo-fallback-box');
  if (!image || !fallback) return;
  const showFallback = () => {
    image.style.display = 'none';
    fallback.style.display = 'flex';
  };
  image.addEventListener('error', showFallback, { once: true });
  if (image.complete && image.naturalWidth === 0) showFallback();
}


/* =========================================================
   DOM READY
========================================================= */

if (
  document.readyState ===
  'loading'
) {

  document.addEventListener(
    'DOMContentLoaded',
    function() {

      setupLogoFallback();

      void bootIndex();

    },
    {
      once: true
    }
  );

} else {

  setupLogoFallback();

  void bootIndex();

}

</script>


