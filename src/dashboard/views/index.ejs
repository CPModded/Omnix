      Se connecter
    </a>

  `;


  ctaArea.innerHTML = `

    <a
      href="/api/auth/login"
      class="cta-button cta-primary"
    >

      ${discordIcon()}

      Entrer dans l'application

    </a>

    <a
      href="/pricing"
      class="cta-button cta-secondary"
    >
      Découvrir les offres
    </a>

  `;

}


/* =========================================================
   ANIMATION DES STATISTIQUES
========================================================= */

function animateValue(
  element,
  start,
  end,
  duration,
  suffix = ''
) {

  if (!element) {
    return;
  }


  const numericStart =
    Number(start);

  const numericEnd =
    Number(end);


  if (
    !Number.isFinite(
      numericEnd
    )
  ) {

    element.textContent =
      '--';

    return;

  }


  let startTimestamp =
    null;


  function step(timestamp) {

    if (
      startTimestamp === null
    ) {

      startTimestamp =
        timestamp;

    }


    const progress =
      Math.min(
        (
          timestamp -
          startTimestamp
        ) /
        duration,
        1
      );


    /*
     * Easing cubic-out.
     */

    const easedProgress =
      1 -
      Math.pow(
        1 - progress,
        3
      );


    const value =
      Math.floor(
        easedProgress *
        (
          numericEnd -
          numericStart
        ) +
        numericStart
      );


    element.textContent =
      value.toLocaleString(
        'fr-FR'
      ) +
      suffix;


    if (
      progress < 1
    ) {

      window.requestAnimationFrame(
        step
      );

    }

  }


  window.requestAnimationFrame(
    step
  );

}


/* =========================================================
   STATISTIQUES OMNIX
========================================================= */

async function loadRealStats() {

  const servers =
    document.getElementById(
      's-servers'
    );

  const users =
    document.getElementById(
      's-users'
    );

  const commands =
    document.getElementById(
      's-commands'
    );

  const uptime =
    document.getElementById(
      's-uptime'
    );

  const latency =
    document.getElementById(
      's-latency'
    );


  addLaunchLog(
    'info',
    'Connexion à l’API statistiques...'
  );


  try {

    const started =
      performance.now();


    const response =
      await fetch(
        '/api/stats',
        {
          method:
            'GET',

          credentials:
            'include',

          cache:
            'no-store',

          headers: {
            Accept:
              'application/json'
          }
        }
      );


    const requestLatency =
      Math.round(
        performance.now() -
        started
      );


    if (
      !response.ok
    ) {

      throw new Error(
        `HTTP ${response.status}`
      );

    }


    const data =
      await response.json();


    addLaunchLog(
      'debug',
      'Réponse /api/stats reçue.'
    );


    /*
     * Structure attendue par OMNIX :
     *
     * data.bot.guildsCount
     * data.bot.uptime
     * data.bot.ping
     * data.database.totalUsers
     * data.commands
     */

    const bot =
      data &&
      data.bot
        ? data.bot
        : {};


    const database =
      data &&
      data.database
        ? data.database
        : {};


    const guildCount =
      Number(
        bot.guildsCount
      );


    const userCount =
      Number(
        database.totalUsers
      );


    const commandCount =
      Number(
        data.commands
      );


    const uptimeValue =
      Number(
        bot.uptime
      );


    const botPing =
      Number(
        bot.ping
      );


    /* =====================================================
       SERVEURS
    ====================================================== */

    if (
      Number.isFinite(
        guildCount
      )
    ) {

      animateValue(
        servers,
        0,
        guildCount,
        800
      );

    } else if (servers) {

      servers.textContent =
        '--';

    }


    /* =====================================================
       MEMBRES
    ====================================================== */

    if (
      Number.isFinite(
        userCount
      )
    ) {

      animateValue(
        users,
        0,
        userCount,
        800
      );

    } else if (users) {

      users.textContent =
        '--';

    }


    /* =====================================================
       COMMANDES
    ====================================================== */

    if (
      Number.isFinite(
        commandCount
      )
    ) {

      animateValue(
        commands,
        0,
        commandCount,
        800
      );

    } else if (commands) {

      commands.textContent =
        '--';

    }


    /* =====================================================
       UPTIME
    ====================================================== */

    if (
      Number.isFinite(
        uptimeValue
      )
    ) {

      animateValue(
        uptime,
        0,
        uptimeValue,
        800,
        '%'
      );

    } else if (uptime) {

      uptime.textContent =
        '--';

    }


    /* =====================================================
       LATENCE
    ====================================================== */

    const finalPing =
      Number.isFinite(
        botPing
      )
        ? botPing
        : requestLatency;


    if (latency) {

      animateValue(
        latency,
        0,
        finalPing,
        800,
        ' ms'
      );

    }


    addLaunchLog(
      'success',
      `OMNIX en temps réel : ${
        Number.isFinite(guildCount)
          ? guildCount
          : '--'
      } serveurs / ${
        Number.isFinite(userCount)
          ? userCount
          : '--'
      } membres / ${
        Number.isFinite(commandCount)
          ? commandCount
          : '--'
      } commandes / ${
        finalPing
      } ms`
    );


  } catch (error) {

    const message =
      error instanceof Error
        ? error.message
        : String(error);


    console.error(
      '[OMNIX STATS]',
      error
    );


    addLaunchLog(
      'error',
      `API statistiques indisponible : ${message}`
    );


    /*
     * IMPORTANT :
     *
     * Une donnée indisponible n'est jamais
     * remplacée artificiellement par 0.
     */

    [
      servers,
      users,
      commands,
      uptime,
      latency
    ].forEach(
      function(element) {

        if (element) {

          element.textContent =
            '--';

        }

      }
    );

  }

}


/* =========================================================
   RAFRAÎCHISSEMENT AUTOMATIQUE DES STATS
========================================================= */

let statsRefreshTimer =
  null;


function startStatsRefresh() {

  if (
    statsRefreshTimer
  ) {

    clearInterval(
      statsRefreshTimer
    );

  }


  /*
   * Actualisation toutes les
   * 30 secondes.
   */

  statsRefreshTimer =
    window.setInterval(
      function() {

        void loadRealStats();

      },
      30000
    );

}


/* =========================================================
   BOOT OMNIX
========================================================= */

async function bootIndex() {

  addLaunchLog(
    'info',
    'Initialisation de la plateforme OMNIX...'
  );


  /*
   * Authentification et statistiques
   * sont chargées en parallèle.
   */

  await Promise.allSettled([
    setupDynamicButtons(),
    loadRealStats()
  ]);


  /*
   * Activation du rafraîchissement
   * automatique des statistiques.
   */

  startStatsRefresh();


  addLaunchLog(
    'success',
    'OMNIX est opérationnel.'
  );

}


