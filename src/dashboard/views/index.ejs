<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="OMNIX — Plateforme intelligente de gestion, sécurité et automatisation Discord."
  >

  <meta
    name="theme-color"
    content="#030712"
  >

  <title>OMNIX — Plateforme Officielle</title>

  <style>

    /* =========================================================
       RESET
    ========================================================= */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;

      background: #030712;

      color: #f8fafc;

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

      line-height: 1.5;

      overflow-x: hidden;

      position: relative;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    a {
      color: inherit;
    }


    /* =========================================================
       BACKGROUND
    ========================================================= */

    .omnix-background {
      position: fixed;
      inset: 0;

      z-index: -10;

      overflow: hidden;

      pointer-events: none;

      background:
        radial-gradient(
          circle at 50% -15%,
          rgba(79, 70, 229, 0.14),
          transparent 42%
        ),
        radial-gradient(
          circle at 100% 50%,
          rgba(6, 182, 212, 0.05),
          transparent 35%
        ),
        #030712;
    }

    .omnix-background-grid {
      position: absolute;
      inset: 0;

      opacity: 0.18;

      background-image:
        linear-gradient(
          rgba(148, 163, 184, 0.045) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(148, 163, 184, 0.045) 1px,
          transparent 1px
        );

      background-size: 48px 48px;

      mask-image:
        linear-gradient(
          to bottom,
          black 0%,
          rgba(0, 0, 0, 0.8) 45%,
          transparent 90%
        );
    }

    .omnix-halo {
      position: absolute;

      width: 520px;
      height: 520px;

      border-radius: 50%;

      filter: blur(110px);

      pointer-events: none;
    }

    .omnix-halo-top {
      top: -280px;
      left: -180px;

      background:
        rgba(79, 70, 229, 0.20);
    }

    .omnix-halo-right {
      top: 30%;
      right: -330px;

      background:
        rgba(6, 182, 212, 0.12);
    }

    .omnix-halo-bottom {
      bottom: -350px;
      left: 20%;

      background:
        rgba(124, 58, 237, 0.10);
    }


    /* =========================================================
       HEADER
    ========================================================= */

    header {
      position: sticky;
      top: 0;

      z-index: 100;

      width: 100%;

      border-bottom:
        1px solid
        rgba(148, 163, 184, 0.08);

      background:
        rgba(3, 7, 18, 0.76);

      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }

    .omnix-header-inner {
      width:
        min(1180px, calc(100% - 32px));

      min-height: 72px;

      margin: 0 auto;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;
    }


    /* =========================================================
       LOGO
    ========================================================= */

    .logo-area {
      display: inline-flex;

      align-items: center;

      gap: 12px;

      text-decoration: none;

      flex-shrink: 0;
    }

    .logo-wrapper {
      width: 40px;
      height: 40px;

      position: relative;

      overflow: hidden;

      border-radius: 12px;

      box-shadow:
        0 8px 30px
        rgba(79, 70, 229, 0.25);
    }

    .logo-img {
      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;
    }

    .logo-fallback {
      position: absolute;

      inset: 0;

      display: none;

      align-items: center;
      justify-content: center;

      background:
        linear-gradient(
          135deg,
          #06b6d4,
          #4f46e5,
          #7c3aed
        );

      color: white;

      font-size: 19px;
      font-weight: 900;
    }

    .logo-text {
      font-size: 18px;

      font-weight: 900;

      letter-spacing: 1.5px;

      background:
        linear-gradient(
          90deg,
          #60a5fa,
          #22d3ee,
          #a78bfa
        );

      -webkit-background-clip: text;
      background-clip: text;

      -webkit-text-fill-color: transparent;
    }

    .brand-status {
      display: none;

      align-items: center;

      gap: 7px;

      padding:
        5px 9px;

      border:
        1px solid
        rgba(52, 211, 153, 0.14);

      border-radius: 999px;

      background:
        rgba(52, 211, 153, 0.06);

      color:
        #6ee7b7;

      font-size: 9px;

      font-weight: 800;

      letter-spacing: 0.6px;

      text-transform: uppercase;
    }

    .brand-status-dot {
      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: #34d399;

      box-shadow:
        0 0 10px
        rgba(52, 211, 153, 0.8);
    }

    @media (min-width: 700px) {

      .brand-status {
        display: inline-flex;
      }

    }


    /* =========================================================
       HEADER AUTH
    ========================================================= */

    .header-controls {
      display: flex;

      align-items: center;

      gap: 10px;
    }

    #auth-buttons-header {
      display: flex;

      align-items: center;

      gap: 10px;
    }

    .header-button {
      min-height: 40px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      padding:
        0 15px;

      border:
        1px solid
        rgba(148, 163, 184, 0.12);

      border-radius: 10px;

      background:
        rgba(15, 23, 42, 0.72);

      color:
        #cbd5e1;

      text-decoration: none;

      font-size: 12px;

      font-weight: 800;

      transition:
        transform 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .header-button:hover {
      transform: translateY(-1px);

      border-color:
        rgba(96, 165, 250, 0.30);

      background:
        rgba(30, 41, 59, 0.85);

      color: white;
    }

    .header-button-primary {
      border-color: transparent;

      background:
        linear-gradient(
          135deg,
          #4f46e5,
          #06b6d4
        );

      color: white;

      box-shadow:
        0 8px 24px
        rgba(79, 70, 229, 0.20);
    }

    .header-button-primary:hover {
      border-color: transparent;

      background:
        linear-gradient(
          135deg,
          #4338ca,
          #0891b2
        );
    }

    .header-button-admin {
      border-color: transparent;

      background:
        linear-gradient(
          135deg,
          #7c3aed,
          #a855f7
        );

      color: white;
    }

    .header-button-admin:hover {
      border-color: transparent;
    }

    .btn-nav-logout {
      border: none;

      background: transparent;

      color: #64748b;

      cursor: pointer;

      padding: 8px;

      font-size: 12px;

      font-weight: 700;

      transition:
        color 0.2s ease;
    }

    .btn-nav-logout:hover {
      color: #f87171;
    }


    /* =========================================================
       BURGER
    ========================================================= */

    .btn-burger {
      width: 42px;
      height: 42px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      border:
        1px solid
        rgba(148, 163, 184, 0.10);

      border-radius: 11px;

      background:
        rgba(15, 23, 42, 0.65);

      color: #94a3b8;

      cursor: pointer;

      transition:
        0.2s ease;
    }

    .btn-burger:hover {
      border-color:
        rgba(96, 165, 250, 0.25);

      background:
        rgba(30, 41, 59, 0.80);

      color: white;
    }

    .burger-icon {
      width: 20px;
      height: 20px;

      fill: currentColor;
    }


    /* =========================================================
       MAIN
    ========================================================= */

    main {
      width:
        min(1120px, calc(100% - 32px));

      margin: 0 auto;

      padding:
        75px 0 100px;

      position: relative;

      z-index: 5;
    }

    @media (min-width: 768px) {

      main {
        padding:
          110px 0 125px;
      }

    }


    /* =========================================================
       HERO
    ========================================================= */

    .hero {
      max-width: 920px;

      margin: 0 auto;

      text-align: center;
    }

    .tag {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding:
        7px 14px;

      margin-bottom: 25px;

      border:
        1px solid
        rgba(129, 140, 248, 0.20);

      border-radius: 999px;

      background:
        rgba(99, 102, 241, 0.07);

      color:
        #a5b4fc;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: 1.1px;

      text-transform: uppercase;
    }

    .tag::before {
      content: "";

      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: #818cf8;

      box-shadow:
        0 0 10px
        rgba(129, 140, 248, 0.85);
    }

    h1 {
      max-width: 920px;

      margin:
        0 auto 25px;

      color: white;

      font-size:
        clamp(38px, 7vw, 76px);

      font-weight: 950;

      line-height: 1.02;

      letter-spacing: -3px;
    }

    h1 span {
      background:
        linear-gradient(
          90deg,
          #60a5fa,
          #22d3ee 42%,
          #a78bfa 85%
        );

      -webkit-background-clip: text;
      background-clip: text;

      -webkit-text-fill-color: transparent;

      filter:
        drop-shadow(
          0 0 28px
          rgba(56, 189, 248, 0.12)
        );
    }

    p.subtitle {
      max-width: 760px;

      margin:
        0 auto 40px;

      color: #94a3b8;

      font-size:
        clamp(14px, 2vw, 17px);

      line-height: 1.75;
    }


    /* =========================================================
       CTA
    ========================================================= */

    .cta-area {
      width:
        min(100%, 570px);

      margin:
        0 auto 75px;

      display: grid;

      grid-template-columns: 1fr;

      gap: 12px;
    }

    @media (min-width: 620px) {

      .cta-area {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    .cta-button {
      min-height: 56px;

      display: flex;

      align-items: center;
      justify-content: center;

      gap: 10px;

      padding:
        0 20px;

      border-radius: 14px;

      text-decoration: none;

      font-size: 13px;

      font-weight: 850;

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease;
    }

    .cta-button:hover {
      transform:
        translateY(-3px);
    }

    .cta-primary {
      color: white;

      background:
        linear-gradient(
          135deg,
          #4f46e5,
          #06b6d4
        );

      box-shadow:
        0 14px 35px
        rgba(79, 70, 229, 0.24);
    }

    .cta-primary:hover {
      box-shadow:
        0 18px 45px
        rgba(6, 182, 212, 0.25);
    }

    .cta-secondary {
      color: #e2e8f0;

      border:
        1px solid
        rgba(148, 163, 184, 0.12);

      background:
        rgba(15, 23, 42, 0.72);

      box-shadow:
        0 10px 30px
        rgba(0, 0, 0, 0.16);
    }

    .cta-secondary:hover {
      border-color:
        rgba(96, 165, 250, 0.25);

      background:
        rgba(30, 41, 59, 0.80);
    }

    .discord-svg {
      width: 19px;
      height: 19px;

      fill: currentColor;
    }


    /* =========================================================
       PRODUCT PREVIEW
    ========================================================= */

    .product-preview {
      width: 100%;

      position: relative;

      margin-bottom: 75px;

      padding: 1px;

      border-radius: 25px;

      background:
        linear-gradient(
          135deg,
          rgba(96, 165, 250, 0.20),
          rgba(34, 211, 238, 0.06),
          rgba(167, 139, 250, 0.18)
        );

      box-shadow:
        0 35px 100px
        rgba(0, 0, 0, 0.35);
    }

    .product-preview-inner {
      min-height: 340px;

      position: relative;

      overflow: hidden;

      border-radius: 24px;

      background:
        linear-gradient(
          145deg,
          rgba(15, 23, 42, 0.96),
          rgba(3, 7, 18, 0.98)
        );
    }

    .preview-glow {
      position: absolute;

      width: 380px;
      height: 380px;

      top: -230px;
      right: -100px;

      border-radius: 50%;

      background:
        rgba(6, 182, 212, 0.12);

      filter: blur(80px);

      pointer-events: none;
    }

    .preview-header {
      height: 60px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding:
        0 20px;

      border-bottom:
        1px solid
        rgba(148, 163, 184, 0.08);

      background:
        rgba(15, 23, 42, 0.65);
    }

    .preview-brand {
      display: flex;

      align-items: center;

      gap: 9px;

      color: #cbd5e1;

      font-size: 11px;

      font-weight: 800;

      letter-spacing: 0.8px;

      text-transform: uppercase;
    }

    .preview-brand-icon {
      width: 25px;
      height: 25px;

      display: flex;

      align-items: center;
      justify-content: center;

      border-radius: 7px;

      background:
        linear-gradient(
          135deg,
          #4f46e5,
          #06b6d4
        );

      color: white;

      font-size: 11px;

      font-weight: 900;
    }

    .preview-status {
      display: flex;

      align-items: center;

      gap: 7px;

      color: #6ee7b7;

      font-size: 9px;

      font-weight: 800;

      letter-spacing: 0.7px;

      text-transform: uppercase;
    }

    .preview-status::before {
      content: "";

      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: #34d399;

      box-shadow:
        0 0 10px
        rgba(52, 211, 153, 0.8);
    }

    .preview-content {
      padding: 24px;

      display: grid;

      grid-template-columns: 1fr;

      gap: 14px;
    }

    @media (min-width: 700px) {

      .preview-content {
        grid-template-columns:
          1.3fr 0.7fr;
      }

    }

    .preview-main-card,
    .preview-small-card {
      border:
        1px solid
        rgba(148, 163, 184, 0.08);

      background:
        rgba(15, 23, 42, 0.55);

      border-radius: 17px;

      padding: 20px;

      text-align: left;
    }

    .preview-main-card {
      min-height: 220px;
    }

    .preview-small-stack {
      display: grid;

      gap: 14px;
    }

    .preview-small-card {
      min-height: 103px;
    }

    .preview-label {
      margin-bottom: 9px;

      color: #64748b;

      font-size: 9px;

      font-weight: 800;

      letter-spacing: 0.9px;

      text-transform: uppercase;
    }

    .preview-title {
      margin-bottom: 8px;

      color: white;

      font-size: 19px;

      font-weight: 850;
    }

    .preview-description {
      color: #64748b;

      font-size: 11px;

      line-height: 1.65;
    }

    .preview-value {
      color: white;

      font-size: 24px;

      font-weight: 900;
    }

    .preview-value span {
      color: #22d3ee;

      font-size: 10px;

      font-weight: 800;
    }


    /* =========================================================
       SECTION HEADINGS
    ========================================================= */

    .section-heading {
      margin-bottom: 26px;

      text-align: center;
    }

    .section-kicker {
      display: block;

      margin-bottom: 8px;

      color: #818cf8;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: 1.5px;

      text-transform: uppercase;
    }

    .section-title {
      color: white;

      font-size:
        clamp(22px, 4vw, 30px);

      font-weight: 900;

      letter-spacing: -0.8px;
    }


    /* =========================================================
       STATS
    ========================================================= */

    .stats-grid {
      width: 100%;

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 10px;

      margin-bottom: 60px;

      padding: 10px;

      border:
        1px solid
        rgba(148, 163, 184, 0.07);

      border-radius: 22px;

      background:
        rgba(15, 23, 42, 0.52);

      box-shadow:
        0 25px 70px
        rgba(0, 0, 0, 0.20);
    }

    @media (min-width: 600px) {

      .stats-grid {
        grid-template-columns:
          repeat(5, 1fr);
      }

    }

    .stat-item {
      min-height: 105px;

      display: flex;

      flex-direction: column;

      align-items: center;
      justify-content: center;

      padding: 15px 8px;

      border-radius: 15px;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .stat-item:hover {
      background:
        rgba(30, 41, 59, 0.50);

      transform:
        translateY(-2px);
    }

    .stat-num {
      min-height: 40px;

      display: flex;

      align-items: center;

      color: white;

      font-size:
        clamp(22px, 4vw, 30px);

      font-weight: 900;

      letter-spacing: -1px;

      background:
        linear-gradient(
          90deg,
          #38bdf8,
          #818cf8
        );

      -webkit-background-clip: text;
      background-clip: text;

      -webkit-text-fill-color: transparent;
    }

    .stat-label {
      margin-top: 5px;

      color: #64748b;

      font-size: 8px;

      font-weight: 800;

      letter-spacing: 1px;

      text-transform: uppercase;

      text-align: center;
    }


    /* =========================================================
       TERMINAL
    ========================================================= */

    .terminal-wrapper {
      width: 100%;

      max-width: 950px;

      margin: 0 auto;
    }

    .terminal {
      width: 100%;

      overflow: hidden;

      border:
        1px solid
        rgba(148, 163, 184, 0.11);

      border-radius: 18px;

      background: #020617;

      box-shadow:
        0 30px 80px
        rgba(0, 0, 0, 0.45);
    }

    .terminal-header {
      min-height: 52px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding:
        0 16px;

      background: #0f172a;

      border-bottom:
        1px solid
        rgba(148, 163, 184, 0.08);
    }

    .terminal-left {
      display: flex;

      align-items: center;

      gap: 10px;
    }

    .terminal-dots {
      display: flex;

      gap: 6px;
    }

    .terminal-dot {
      width: 9px;
      height: 9px;

      border-radius: 50%;
    }

    .terminal-title {
      color: #64748b;

      font-size: 10px;

      font-weight: 800;

      letter-spacing: 0.8px;

      text-transform: uppercase;
    }

    .terminal-live {
      display: inline-flex;

      align-items: center;

      gap: 6px;

      color: #38bdf8;

      font-size: 9px;

      font-weight: 900;

      letter-spacing: 0.8px;
    }

    .terminal-live::before {
      content: "";

      width: 5px;
      height: 5px;

      border-radius: 50%;

      background: #38bdf8;

      box-shadow:
        0 0 9px
        rgba(56, 189, 248, 0.9);

      animation:
        omnixPulse 1.8s infinite;
    }

    .terminal-screen {
      height: 215px;

      padding: 17px;

      overflow-y: auto;

      background: #030712;

      color: #a3e635;

      font-family:
        "SFMono-Regular",
        Consolas,
        "Liberation Mono",
        monospace;

      font-size: 11px;

      line-height: 1.7;

      scrollbar-width: thin;

      scrollbar-color:
        #334155
        transparent;
    }


    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      width: 100%;

      border-top:
        1px solid
        rgba(148, 163, 184, 0.06);

      background:
        rgba(3, 7, 18, 0.70);

      padding: 25px 16px;

      text-align: center;
    }

    footer p {
      color: #475569;

      font-size: 11px;
    }


    /* =========================================================
       DRAWER OVERLAY
    ========================================================= */

    .drawer-overlay {
      position: fixed;

      inset: 0;

      z-index: 900;

      background:
        rgba(0, 0, 0, 0.55);

      backdrop-filter: blur(3px);

      opacity: 0;

      visibility: hidden;

      transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
    }

    .drawer-overlay.open {
      opacity: 1;

      visibility: visible;
    }


    /* =========================================================
       ACCESSIBILITY
    ========================================================= */

    :focus-visible {
      outline:
        2px solid
        #38bdf8;

      outline-offset: 3px;
    }


    /* =========================================================
       ANIMATIONS
    ========================================================= */

    @keyframes omnixPulse {

      0%,
      100% {
        opacity: 0.45;
        transform: scale(0.85);
      }

      50% {
        opacity: 1;
        transform: scale(1.15);
      }

    }

    @keyframes omnixAppear {

      from {
        opacity: 0;

        transform:
          translateY(15px);
      }

      to {
        opacity: 1;

        transform:
          translateY(0);
      }

    }

    .hero,
    .product-preview,
    .stats-grid,
    .terminal-wrapper {
      animation:
        omnixAppear
        0.7s
        ease
        both;
    }

    .product-preview {
      animation-delay: 0.08s;
    }

    .stats-grid {
      animation-delay: 0.15s;
    }

    .terminal-wrapper {
      animation-delay: 0.22s;
    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 599px) {

      .omnix-header-inner {
        width:
          min(
            100% - 20px,
            1180px
          );

        min-height: 64px;
      }

      .logo-text {
        font-size: 16px;
      }

      #auth-buttons-header
      .btn-nav-logout {
