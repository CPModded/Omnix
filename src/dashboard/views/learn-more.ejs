  <!-- =========================================================
       DRAWER OVERLAY
  ========================================================== -->

  <div
    id="drawer-overlay"
    class="drawer-overlay"
    onclick="toggleDrawer(false)"
    aria-hidden="true"
  ></div>


  <!-- =========================================================
       OMNIX JAVASCRIPT
  ========================================================== -->

  <script>

    /* =========================================================
       GLOBAL STATE
    ========================================================= */

    window.OMNIX =
      window.OMNIX || {

        drawerOpen:
          false

      };


    /* =========================================================
       DRAWER
    ========================================================= */

    function toggleDrawer(open) {

      const drawer =
        document.getElementById(
          'omnix-drawer'
        );

      const overlay =
        document.getElementById(
          'drawer-overlay'
        );


      if (!drawer) {
        return;
      }


      const shouldOpen =
        typeof open === 'boolean'
          ? open
          : !drawer.classList.contains('open');


      drawer.classList.toggle(
        'open',
        shouldOpen
      );


      if (overlay) {

        overlay.classList.toggle(
          'open',
          shouldOpen
        );

      }


      document.body.classList.toggle(
        'drawer-open',
        shouldOpen
      );


      window.OMNIX.drawerOpen =
        shouldOpen;


      drawer.setAttribute(
        'aria-hidden',
        String(!shouldOpen)
      );


      const burgerButton =
        document.querySelector(
          '.btn-burger'
        );


      if (burgerButton) {

        burgerButton.setAttribute(
          'aria-expanded',
          String(shouldOpen)
        );

      }

    }


    /* =========================================================
       ESCAPE KEY
    ========================================================= */

    document.addEventListener(
      'keydown',
      (event) => {

        if (
          event.key === 'Escape' &&
          window.OMNIX.drawerOpen
        ) {

          toggleDrawer(false);

        }

      }
    );


    /* =========================================================
       DRAWER NAVIGATION
    ========================================================= */

    document.addEventListener(
      'click',
      (event) => {

        const target =
          event.target.closest(
            '#omnix-drawer a'
          );


        if (!target) {
          return;
        }


        toggleDrawer(false);

      }
    );


    /* =========================================================
       LOGO FALLBACK
    ========================================================= */

    const logoImage =
      document.getElementById(
        'logo-main-img'
      );

    const logoFallback =
      document.getElementById(
        'logo-fallback-box'
      );


    if (
      logoImage &&
      logoFallback
    ) {

      logoImage.addEventListener(
        'error',
        () => {

          logoImage.style.display =
            'none';

          logoFallback.style.display =
            'flex';

        },
        {
          once: true
        }
      );

    }


    /* =========================================================
       PAGE READY
    ========================================================= */

    document.addEventListener(
      'DOMContentLoaded',
      () => {

        document.body.classList.add(
          'page-ready'
        );


        toggleDrawer(false);

      }
    );

  </script>


  <!-- =========================================================
       ACCESSIBILITY / REDUCED MOTION
  ========================================================== -->

  <script>

    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );


    if (reducedMotion.matches) {

      document.documentElement.style.scrollBehavior =
        'auto';

    }


    reducedMotion.addEventListener(
      'change',
      (event) => {

        document.documentElement.style.scrollBehavior =
          event.matches
            ? 'auto'
            : 'smooth';

      }
    );

  </script>


