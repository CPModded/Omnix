<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Connexion à OMNIX — Connectez-vous avec Discord ou utilisez Google lorsqu'il sera disponible.">
  <meta name="theme-color" content="#030712">
  <title>OMNIX — Connexion</title>

  <style>
    :root {
      --bg: #030712;
      --panel: rgba(15, 23, 42, .72);
      --panel-strong: rgba(8, 15, 30, .98);
      --border: rgba(148, 163, 184, .11);
      --text: #f8fafc;
      --muted: #94a3b8;
      --dim: #64748b;
      --blue: #60a5fa;
      --cyan: #22d3ee;
      --violet: #a78bfa;
      --purple: #7c3aed;
      --green: #34d399;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { min-height: 100%; scroll-behavior: smooth; }
    body {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.5;
      overflow-x: hidden;
    }
    button, a { -webkit-tap-highlight-color: transparent; }
    button { font: inherit; }
    a { color: inherit; }

    .background { position: fixed; inset: 0; z-index: -10; pointer-events: none; overflow: hidden; background:
      radial-gradient(circle at 50% -15%, rgba(79,70,229,.16), transparent 42%),
      radial-gradient(circle at 100% 50%, rgba(6,182,212,.07), transparent 35%),
      #030712;
    }
    .grid { position: absolute; inset: 0; opacity: .18; background-image:
      linear-gradient(rgba(148,163,184,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148,163,184,.045) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: linear-gradient(to bottom, black, rgba(0,0,0,.75) 50%, transparent 100%);
    }
    .halo { position: absolute; width: 520px; height: 520px; border-radius: 50%; filter: blur(115px); }
    .halo.one { top: -300px; left: -180px; background: rgba(79,70,229,.22); }
    .halo.two { right: -330px; top: 28%; background: rgba(6,182,212,.11); }

    header {
      position: sticky; top: 0; z-index: 100;
      border-bottom: 1px solid rgba(148,163,184,.08);
      background: rgba(3,7,18,.76);
      backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
    }
    .header-inner {
      width: min(1180px, calc(100% - 32px)); min-height: 72px; margin: auto;
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
    }
    .logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
    .logo-box {
      width: 40px; height: 40px; border-radius: 12px; overflow: hidden;
      background: linear-gradient(135deg,#06b6d4,#6366f1,#8b5cf6);
      box-shadow: 0 8px 30px rgba(79,70,229,.25);
    }
    .logo-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .logo-fallback { display: none; width: 100%; height: 100%; align-items: center; justify-content: center; font-weight: 900; }
    .logo-text strong { display: block; font-size: 15px; letter-spacing: 1.5px; }
    .logo-text span { display: block; margin-top: 1px; color: var(--dim); font-size: 9px; text-transform: uppercase; letter-spacing: 1px; }

    .menu-button {
      width: 44px; height: 44px; border: 1px solid rgba(148,163,184,.11); border-radius: 12px;
      background: rgba(255,255,255,.025); color: #cbd5e1; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; transition: .18s ease;
    }
    .menu-button:hover { color: #fff; background: rgba(255,255,255,.06); border-color: rgba(148,163,184,.2); }
    .menu-icon { width: 20px; height: 20px; position: relative; display: block; }
    .menu-icon i { position: absolute; left: 1px; width: 18px; height: 2px; border-radius: 2px; background: currentColor; transition: .2s ease; }
    .menu-icon i:nth-child(1) { top: 4px; }
    .menu-icon i:nth-child(2) { top: 9px; }
    .menu-icon i:nth-child(3) { top: 14px; }
    body.menu-open .menu-icon i:nth-child(1) { top: 9px; transform: rotate(45deg); }
    body.menu-open .menu-icon i:nth-child(2) { opacity: 0; }
    body.menu-open .menu-icon i:nth-child(3) { top: 9px; transform: rotate(-45deg); }

    main {
      width: min(1180px, calc(100% - 32px)); min-height: calc(100vh - 73px);
      margin: auto; padding: 72px 0 100px; display: flex; align-items: center; justify-content: center;
      transition: padding-right .28s cubic-bezier(.4,0,.2,1);
    }
    body.menu-open main { padding-right: min(340px, 30vw); }

    .login-card {
      width: min(520px, 100%); padding: 42px; position: relative; overflow: hidden;
      border: 1px solid var(--border); border-radius: 28px;
      background: linear-gradient(180deg, rgba(15,23,42,.78), rgba(3,7,18,.68));
      box-shadow: 0 30px 90px rgba(0,0,0,.42), inset 0 1px rgba(255,255,255,.035);
    }
    .login-card::before { content: ""; position: absolute; width: 240px; height: 240px; top: -170px; left: 50%; transform: translateX(-50%); background: rgba(99,102,241,.2); filter: blur(70px); pointer-events: none; }
    .eyebrow { position: relative; display: inline-flex; align-items: center; gap: 7px; padding: 6px 10px; border: 1px solid rgba(96,165,250,.16); border-radius: 999px; background: rgba(96,165,250,.06); color: #93c5fd; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; }
    .eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px rgba(52,211,153,.7); }
    h1 { position: relative; margin-top: 18px; font-size: clamp(30px, 5vw, 42px); line-height: 1.08; letter-spacing: -.04em; }
    .intro { position: relative; margin-top: 12px; color: var(--muted); font-size: 14px; }

    .options { position: relative; display: grid; gap: 12px; margin-top: 30px; }
    .auth-option {
      min-height: 74px; width: 100%; padding: 12px 14px; border: 1px solid rgba(148,163,184,.11); border-radius: 17px;
      display: flex; align-items: center; gap: 14px; text-decoration: none; text-align: left;
      background: rgba(255,255,255,.025); transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }
    .auth-option:not(.disabled):hover { transform: translateY(-2px); border-color: rgba(96,165,250,.3); background: rgba(96,165,250,.055); box-shadow: 0 14px 35px rgba(0,0,0,.2); }
    .auth-icon { width: 46px; height: 46px; flex: 0 0 46px; border-radius: 13px; display: grid; place-items: center; background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.06); }
    .auth-icon svg { width: 24px; height: 24px; }
    .auth-copy { min-width: 0; flex: 1; }
    .auth-copy strong { display: block; color: #f8fafc; font-size: 14px; }
    .auth-copy span { display: block; margin-top: 2px; color: var(--dim); font-size: 11px; }
    .arrow { color: #64748b; font-size: 18px; transition: transform .18s ease, color .18s ease; }
    .auth-option:hover .arrow { transform: translateX(3px); color: #93c5fd; }

    .auth-option.disabled { cursor: not-allowed; opacity: .62; background: rgba(255,255,255,.018); }
    .suspended { margin-left: auto; flex: 0 0 auto; padding: 4px 7px; border: 1px solid rgba(248,113,113,.18); border-radius: 6px; background: rgba(248,113,113,.055); color: #fca5a5; font-size: 8px; font-weight: 900; text-transform: uppercase; letter-spacing: .7px; }
    .divider { position: relative; display: flex; align-items: center; gap: 12px; margin: 24px 0 0; color: #475569; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; }
    .divider::before,.divider::after { content: ""; height: 1px; flex: 1; background: rgba(148,163,184,.08); }
    .notice { margin-top: 18px; padding: 12px 13px; border: 1px solid rgba(167,139,250,.12); border-radius: 12px; background: rgba(124,58,237,.045); color: #94a3b8; font-size: 10px; line-height: 1.6; }
    .back { display: inline-flex; margin-top: 22px; color: #64748b; font-size: 11px; text-decoration: none; transition: color .18s ease; }
    .back:hover { color: #cbd5e1; }

    /* =========================================================
       OMNIX — MENU DROIT INTERACTIF
       Même logique visuelle que le sidebar existant du projet.
       L'ouverture réserve de l'espace au contenu sur desktop.
    ========================================================= */
    .sidebar-overlay { position: fixed; inset: 0; z-index: 1190; background: rgba(0,0,0,.55); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; visibility: hidden; pointer-events: none; transition: .25s ease; }
    .sidebar-overlay.open { opacity: 1; visibility: visible; pointer-events: auto; }
    .sidebar {
      position: fixed; top: 0; right: 0; bottom: 0; z-index: 1200; width: min(340px, 92vw); height: 100dvh;
      padding: 18px 14px; overflow-x: hidden; overflow-y: auto; display: flex; flex-direction: column;
      background: linear-gradient(180deg, rgba(8,15,30,.99), rgba(3,7,18,.99));
      border-left: 1px solid rgba(148,163,184,.12); box-shadow: -24px 0 70px rgba(0,0,0,.35);
      transform: translateX(105%); visibility: hidden; pointer-events: none;
      transition: transform .28s cubic-bezier(.4,0,.2,1), visibility .28s ease;
      scrollbar-width: thin; scrollbar-color: rgba(100,116,139,.3) transparent;
    }
    .sidebar.open { transform: translateX(0); visibility: visible; pointer-events: auto; }
    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb { background: rgba(100,116,139,.3); border-radius: 999px; }
    .sidebar-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 22px; }
    .sidebar-brand { display: flex; align-items: center; gap: 11px; text-decoration: none; min-width: 0; }
    .sidebar-brand-logo { width: 40px; height: 40px; border-radius: 12px; overflow: hidden; flex: 0 0 40px; background: linear-gradient(135deg,#06b6d4,#6366f1,#8b5cf6); }
    .sidebar-brand-logo img { width: 100%; height: 100%; object-fit: cover; }
    .sidebar-brand-copy strong { display: block; font-size: 15px; letter-spacing: 1.5px; }
    .sidebar-brand-copy span { display: block; margin-top: 2px; color: #64748b; font-size: 9px; text-transform: uppercase; letter-spacing: 1px; }
    .close { width: 38px; height: 38px; border: 1px solid rgba(148,163,184,.1); border-radius: 10px; background: rgba(255,255,255,.025); color: #94a3b8; font-size: 24px; cursor: pointer; }
    .close:hover { color: #fff; background: rgba(255,255,255,.06); }
    .menu-status { display: flex; align-items: center; gap: 9px; padding: 10px; margin-bottom: 22px; border: 1px solid rgba(255,255,255,.045); border-radius: 14px; background: rgba(255,255,255,.025); }
    .status-dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px rgba(16,185,129,.8); }
    .menu-status strong { display: block; font-size: 11px; color: #e2e8f0; }
    .menu-status span { display: block; margin-top: 2px; color: #64748b; font-size: 9px; }
    .nav-section { margin-bottom: 22px; }
    .nav-title { display: block; padding: 0 10px 8px; color: #475569; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.4px; }
    .nav-link { position: relative; display: flex; align-items: center; gap: 11px; min-height: 42px; padding: 9px 11px; margin-bottom: 3px; border-radius: 11px; color: #64748b; text-decoration: none; font-size: 12px; font-weight: 650; transition: .18s ease; }
    .nav-link:hover { color: #e2e8f0; background: rgba(255,255,255,.035); transform: translateX(-2px); }
    .nav-link.active { color: #fff; background: linear-gradient(270deg,rgba(79,70,229,.18),rgba(6,182,212,.06)); box-shadow: inset -2px 0 0 #6366f1; }
    .nav-icon { width: 20px; text-align: center; color: #64748b; font-size: 15px; }
    .nav-link.active .nav-icon { color: #67e8f9; }
    .nav-badge { margin-left: auto; padding: 3px 5px; border: 1px solid rgba(167,139,250,.25); border-radius: 5px; background: rgba(139,92,246,.08); color: #a78bfa; font-size: 7px; font-weight: 900; }
    .menu-footer { margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.05); }
    .menu-footer p { padding: 8px 10px 12px; color: #475569; font-size: 9px; }
    .menu-footer a { display: block; padding: 10px; border-radius: 10px; color: #64748b; text-decoration: none; font-size: 11px; }
    .menu-footer a:hover { color: #f87171; background: rgba(239,68,68,.05); }
    body.menu-open { overflow-x: hidden; }

    @media (max-width: 760px) {
      main { padding-top: 42px; align-items: flex-start; }
      body.menu-open main { padding-right: 0; }
      .login-card { padding: 30px 20px; border-radius: 22px; }
    }
    @media (prefers-reduced-motion: reduce) { *,*::before,*::after { scroll-behavior: auto !important; transition: none !important; } }
  </style>
</head>
<body>
  <div class="background" aria-hidden="true"><div class="grid"></div><div class="halo one"></div><div class="halo two"></div></div>

  <header>
    <div class="header-inner">
      <a href="/" class="logo" aria-label="Accueil OMNIX">
        <div class="logo-box">
          <img src="/logo.png" alt="OMNIX" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
          <span class="logo-fallback">O</span>
        </div>
        <div class="logo-text"><strong>OMNIX</strong><span>Control Center</span></div>
      </a>
      <button class="menu-button" type="button" id="menuButton" aria-label="Ouvrir le menu" aria-controls="omnix-menu" aria-expanded="false">
        <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </header>

  <main>
    <section class="login-card" aria-labelledby="connexion-title">
      <span class="eyebrow">Accès sécurisé</span>
      <h1 id="connexion-title">Bienvenue sur OMNIX</h1>
      <p class="intro">Choisissez votre méthode de connexion pour accéder à votre espace OMNIX.</p>

      <div class="options">
        <a class="auth-option" href="/api/auth/login" aria-label="Continuer avec Discord">
          <span class="auth-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M19.54 5.1A16.3 16.3 0 0 0 15.5 3.86l-.5 1.02a15 15 0 0 0-6 0l-.5-1.02A16.3 16.3 0 0 0 4.46 5.1C1.9 8.9 1.2 12.6 1.55 16.25a16.3 16.3 0 0 0 4.98 2.52l1.2-1.65a9.9 9.9 0 0 1-1.86-.9l.46-.35c3.58 1.65 7.46 1.65 11 0l.47.35c-.6.35-1.23.65-1.87.9l1.2 1.65a16.3 16.3 0 0 0 4.98-2.52c.41-4.23-.7-7.9-2.57-11.15Z" fill="#93c5fd"/><circle cx="8.6" cy="12.1" r="1.35" fill="#030712"/><circle cx="15.4" cy="12.1" r="1.35" fill="#030712"/></svg>
          </span>
          <span class="auth-copy"><strong>Continuer avec Discord</strong><span>Connexion OAuth sécurisée avec votre compte Discord</span></span>
          <span class="arrow" aria-hidden="true">›</span>
        </a>

        <div class="auth-option disabled" aria-disabled="true">
          <span class="auth-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M21.35 12.23c0-.72-.06-1.41-.18-2.07H12v3.92h5.23a4.47 4.47 0 0 1-1.94 2.93v2.44h3.14c1.84-1.69 2.92-4.18 2.92-7.22Z" fill="#60a5fa"/><path d="M12 21.5c2.63 0 4.83-.87 6.44-2.35l-3.14-2.44c-.87.58-1.98.92-3.3.92-2.54 0-4.7-1.72-5.47-4.03H3.29v2.52A9.72 9.72 0 0 0 12 21.5Z" fill="#34d399"/><path d="M6.53 13.6a5.84 5.84 0 0 1 0-3.72V7.36H3.29a9.76 9.76 0 0 0 0 8.76l3.24-2.52Z" fill="#fbbf24"/><path d="M12 5.85c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.83 2.95 14.63 2 12 2a9.72 9.72 0 0 0-8.71 5.36l3.24 2.52C7.3 7.57 9.46 5.85 12 5.85Z" fill="#f87171"/></svg>
          </span>
          <span class="auth-copy"><strong>Continuer avec Google</strong><span>Cette méthode de connexion est temporairement indisponible</span></span>
          <span class="suspended">Suspendue</span>
        </div>
      </div>

      <div class="divider">OMNIX</div>
      <p class="notice">En continuant avec Discord, vous serez redirigé vers Discord pour autoriser OMNIX. La session OMNIX utilise ensuite un cookie sécurisé <strong>httpOnly</strong>.</p>
      <a class="back" href="/">← Retour à l’accueil</a>
    </section>
  </main>

  <div class="sidebar-overlay" id="menuOverlay" aria-hidden="true"></div>
  <aside class="sidebar" id="omnix-menu" aria-label="Navigation principale OMNIX" aria-hidden="true">
    <div class="sidebar-head">
      <a href="/" class="sidebar-brand" aria-label="Accueil OMNIX">
        <span class="sidebar-brand-logo"><img src="/logo.png" alt="OMNIX"></span>
        <span class="sidebar-brand-copy"><strong>OMNIX</strong><span>Control Center</span></span>
      </a>
      <button class="close" id="menuClose" type="button" aria-label="Fermer le menu">×</button>
    </div>

    <div class="menu-status"><span class="status-dot"></span><div><strong>OMNIX Online</strong><span>Système opérationnel</span></div></div>

    <nav>
      <div class="nav-section">
        <span class="nav-title">Général</span>
        <a class="nav-link" href="/"><span class="nav-icon">◈</span><span>Accueil</span></a>
        <a class="nav-link active" href="/connexion"><span class="nav-icon">↪</span><span>Connexion</span></a>
      </div>
      <div class="nav-section">
        <span class="nav-title">OMNIX</span>
        <a class="nav-link" href="/pricing"><span class="nav-icon">◇</span><span>Abonnement</span><span class="nav-badge">PRO</span></a>
        <a class="nav-link" href="/learn-more"><span class="nav-icon">?</span><span>Learn more</span></a>
        <a class="nav-link" href="/founder"><span class="nav-icon">♛</span><span>Founder</span></a>
        <a class="nav-link" href="/contact"><span class="nav-icon">✉</span><span>Contact</span></a>
        <a class="nav-link" href="/cgv"><span class="nav-icon">§</span><span>CGV</span></a>
        <a class="nav-link" href="/confidentialite"><span class="nav-icon">⌁</span><span>Confidentialité</span></a>
        <a class="nav-link" href="/cookies"><span class="nav-icon">◌</span><span>Cookies</span></a>
        <a class="nav-link" href="/mentions-legales"><span class="nav-icon">ℹ</span><span>Mentions légales</span></a>
      </div>
    </nav>

    <div class="menu-footer"><p>Vous avez déjà un compte ?</p><a href="/api/auth/login">↪ Se connecter avec Discord</a></div>
  </aside>

  <script>
    (() => {
      'use strict';
      const button = document.getElementById('menuButton');
      const close = document.getElementById('menuClose');
      const menu = document.getElementById('omnix-menu');
      const overlay = document.getElementById('menuOverlay');

      function setMenu(open) {
        const value = Boolean(open);
        document.body.classList.toggle('menu-open', value);
        menu.classList.toggle('open', value);
        overlay.classList.toggle('open', value);
        menu.setAttribute('aria-hidden', String(!value));
        overlay.setAttribute('aria-hidden', String(!value));
        button.setAttribute('aria-expanded', String(value));
        button.setAttribute('aria-label', value ? 'Fermer le menu' : 'Ouvrir le menu');
        if (value) close.focus(); else button.focus();
      }

      button.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
      close.addEventListener('click', () => setMenu(false));
      overlay.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.classList.contains('open')) setMenu(false);
      });
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    })();
  </script>
</body>
</html>
