<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#030712">
  <meta name="description" content="Connexion sécurisée à OMNIX.">
  <link rel="icon" href="/logo.png">
  <title>OMNIX — Connexion</title>
  <style>
    :root{--bg:#030712;--text:#f8fafc;--muted:#94a3b8;--dim:#64748b;--line:rgba(148,163,184,.12);--primary:#6366f1;--cyan:#06b6d4;--violet:#8b5cf6}
    *{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(circle at 18% -12%,rgba(79,70,229,.2),transparent 34%),radial-gradient(circle at 100% 45%,rgba(6,182,212,.08),transparent 30%),#030712;color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;overflow-x:hidden}.bg{position:fixed;inset:0;z-index:-2;pointer-events:none}.grid{position:absolute;inset:0;opacity:.16;background-image:linear-gradient(rgba(148,163,184,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.05) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,black,transparent 92%)}.glow{position:absolute;width:480px;height:480px;border-radius:50%;filter:blur(110px)}.g1{top:-300px;left:-180px;background:rgba(99,102,241,.18)}.g2{right:-300px;top:32%;background:rgba(6,182,212,.09)}
    .shell{min-height:100vh;display:flex;flex-direction:column;transition:margin-right .28s cubic-bezier(.4,0,.2,1)}header{position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,.06);background:rgba(3,7,18,.72);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}.head{width:min(1120px,calc(100% - 32px));min-height:72px;margin:auto;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;color:#fff;text-decoration:none}.logo{width:40px;height:40px;border-radius:12px;overflow:hidden;background:linear-gradient(135deg,#06b6d4,#6366f1,#8b5cf6);box-shadow:0 10px 28px rgba(99,102,241,.22)}.logo img{width:100%;height:100%;object-fit:cover}.brand strong{display:block;font-size:15px;letter-spacing:1.6px}.brand small{display:block;margin-top:1px;color:#64748b;font-size:9px;text-transform:uppercase;letter-spacing:1px}.actions{display:flex;gap:9px;align-items:center}.home,.menu{height:40px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.025);color:#cbd5e1;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font-size:11px;font-weight:700;padding:0 13px}.home:hover,.menu:hover{background:rgba(99,102,241,.1);border-color:rgba(99,102,241,.3);color:#fff}.menu{width:42px;padding:0;cursor:pointer}.menu svg{width:18px;fill:currentColor}
    main{flex:1;width:min(980px,calc(100% - 28px));margin:auto;padding:65px 0 80px;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:20px;align-items:center}.intro{padding:10px 0}.eyebrow{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border-radius:999px;border:1px solid rgba(103,232,249,.14);background:rgba(6,182,212,.05);color:#67e8f9;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:1.3px}.dot{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px rgba(34,197,94,.8)}h1{margin:18px 0 12px;font-size:clamp(36px,6vw,60px);line-height:1.02;letter-spacing:-2px}.intro p{max-width:560px;color:var(--muted);font-size:13px;line-height:1.85}.features{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:26px}.feature{padding:14px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.025)}.feature b{font-size:11px}.feature span{display:block;margin-top:3px;color:var(--dim);font-size:9px;line-height:1.5}
    .card{position:relative;overflow:hidden;padding:26px;border:1px solid rgba(148,163,184,.13);border-radius:25px;background:linear-gradient(145deg,rgba(15,23,42,.82),rgba(3,7,18,.78));box-shadow:0 30px 100px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.035);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}.card:before{content:"";position:absolute;width:240px;height:160px;top:-100px;left:50%;transform:translateX(-50%);background:rgba(99,102,241,.17);filter:blur(65px);pointer-events:none}.card>*{position:relative;z-index:1}.card h2{margin:0;font-size:19px}.card .sub{margin:6px 0 20px;color:var(--dim);font-size:10px;line-height:1.6}.providers{display:grid;gap:10px}.provider{min-height:66px;display:flex;align-items:center;gap:12px;padding:12px;border-radius:15px;border:1px solid var(--line);background:rgba(255,255,255,.025);text-decoration:none;transition:.2s}.provider.discord:hover{transform:translateY(-2px);border-color:rgba(88,101,242,.5);background:rgba(88,101,242,.08);box-shadow:0 12px 35px rgba(88,101,242,.12)}.provider.google{opacity:.55;cursor:not-allowed}.icon{width:40px;height:40px;flex:0 0 40px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:17px}.discord .icon{background:rgba(88,101,242,.15);color:#818cf8}.google .icon{background:rgba(255,255,255,.06);color:#e2e8f0}.copy{min-width:0;flex:1}.copy strong{display:block;font-size:11px;color:#f1f5f9}.copy span{display:block;margin-top:3px;color:#64748b;font-size:9px}.arrow{color:#64748b;font-size:16px}.google .arrow{font-size:8px;color:#a78bfa;font-weight:900;text-transform:uppercase;letter-spacing:.4px}.secure{display:flex;gap:9px;margin-top:16px;padding:11px;border:1px solid rgba(148,163,184,.07);border-radius:12px;background:rgba(15,23,42,.58);color:#64748b;font-size:9px;line-height:1.6}.secure b{color:#94a3b8}.security-icon{color:#67e8f9;font-size:13px}.legal{text-align:center;margin-top:18px;color:#475569;font-size:9px}.legal a{color:#64748b}.legal a:hover{color:#94a3b8}footer{text-align:center;padding:0 15px 25px;color:#475569;font-size:9px}.omnix-sidebar-open .shell{margin-right:min(340px,92vw)}
    @media(max-width:820px){main{grid-template-columns:1fr;max-width:560px;padding-top:45px}.intro{text-align:center}.intro p{margin:auto}.features{display:none}.omnix-sidebar-open .shell{margin-right:0}}@media(max-width:600px){.head{width:calc(100% - 22px);min-height:64px}.home{display:none}main{width:calc(100% - 22px);padding:32px 0 55px}.card{padding:21px;border-radius:21px}h1{font-size:38px}.intro p{font-size:12px}}
  </style>
</head>
<body>
<div class="bg"><div class="grid"></div><div class="glow g1"></div><div class="glow g2"></div></div>
<div class="shell">
<header><div class="head"><a href="/" class="brand"><span class="logo"><img src="/logo.png" alt="OMNIX"></span><span><strong>OMNIX</strong><small>Control Center</small></span></a><div class="actions"><a class="home" href="/">Accueil</a><button class="menu" type="button" onclick="openOmnixSidebar()" aria-label="Ouvrir le menu" aria-controls="omnix-sidebar" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-5V6h18v2H3z"/></svg></button></div></div></header>
<main>
<section class="intro"><span class="eyebrow"><span class="dot"></span>Accès sécurisé</span><h1>Bienvenue sur OMNIX.</h1><p>Connectez-vous pour accéder à votre espace, gérer vos serveurs et retrouver les fonctionnalités disponibles pour votre compte.</p><div class="features"><div class="feature"><b>Session sécurisée</b><span>Authentification centralisée côté serveur.</span></div><div class="feature"><b>Accès Discord</b><span>Connexion via OAuth Discord.</span></div></div></section>
<section class="card"><h2>Choisir une connexion</h2><p class="sub">Sélectionnez le fournisseur avec lequel vous souhaitez continuer.</p><div class="providers"><a class="provider discord" href="/api/auth/login"><span class="icon">◉</span><span class="copy"><strong>Continuer avec Discord</strong><span>Connexion officielle via Discord OAuth</span></span><span class="arrow">→</span></a><div class="provider google" aria-disabled="true"><span class="icon">G</span><span class="copy"><strong>Continuer avec Google</strong><span>Cette méthode est temporairement suspendue.</span></span><span class="arrow">Suspendue</span></div></div><div class="secure"><span class="security-icon">⌁</span><span><b>Vos données restent protégées.</b> OMNIX utilise le système de session existant et ne demande pas votre mot de passe Discord.</span></div><div class="legal">En continuant, vous acceptez les <a href="/cgv">CGV / CGU</a> et prenez connaissance de la <a href="/confidentialite">confidentialité</a>.</div></section>
</main><footer>© OMNIX · <a href="/mentions-legales">Mentions légales</a> · <a href="/cookies">Cookies</a> · <a href="/contact">Contact</a></footer>
</div><%- include('partials/sidebar') %>
<script>(function(){const s=document.getElementById('omnix-sidebar');if(!s)return;const shell=document.querySelector('.shell');const sync=()=>{if(shell)shell.style.marginRight=s.classList.contains('open')&&innerWidth>820?'min(340px,92vw)':''};new MutationObserver(sync).observe(s,{attributes:true,attributeFilter:['class']});addEventListener('resize',sync,{passive:true});sync()})();</script>
</body></html>
