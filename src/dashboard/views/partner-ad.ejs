<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OMNIX — <%= partner.adTitle || partner.title %></title><style>
:root{--bg:#050914;--panel:#0b1220;--line:rgba(255,255,255,.10);--text:#f7f8ff;--muted:#a3adc2;--violet:#8b5cf6;--cyan:#67e8f9}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 20% 0%,rgba(139,92,246,.18),transparent 34%),radial-gradient(circle at 90% 70%,rgba(103,232,249,.10),transparent 30%),var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.shell{width:min(1050px,calc(100% - 28px));margin:auto;padding:28px 0 80px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.brand{font-weight:950;letter-spacing:2px}.back{color:var(--muted);text-decoration:none;font-size:12px}.hero{border:1px solid var(--line);border-radius:28px;overflow:hidden;background:linear-gradient(145deg,rgba(15,23,42,.9),rgba(5,9,20,.88));box-shadow:0 35px 100px rgba(0,0,0,.35)}.visual{width:100%;height:min(52vw,420px);object-fit:cover;display:block}.content{padding:34px}.eyebrow{display:inline-flex;padding:7px 11px;border-radius:999px;background:rgba(103,232,249,.08);border:1px solid rgba(103,232,249,.16);color:var(--cyan);font-size:9px;font-weight:900;letter-spacing:1.3px}.content h1{font-size:clamp(32px,6vw,58px);letter-spacing:-2px;margin:16px 0 12px}.content p{color:var(--muted);line-height:1.9;font-size:14px;white-space:pre-line;max-width:800px}.cta{display:inline-flex;margin-top:18px;padding:13px 18px;border-radius:13px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;text-decoration:none;font-size:11px;font-weight:900}.founder{margin-top:22px;padding:18px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.025)}.founder b{display:block;margin-bottom:6px}.muted{color:var(--muted);font-size:12px}.foot{margin-top:18px;color:#69758c;font-size:10px;text-align:center}@media(max-width:650px){.content{padding:24px}.visual{height:260px}}
</style></head><body><div class="shell"><div class="top"><div class="brand">OMNIX</div><a class="back" href="/partenaires">← Retour aux partenaires</a></div><article class="hero"><% if (partner.adImageData || partner.adImageUrl) { %><img class="visual" src="<%= partner.adImageData || partner.adImageUrl %>" alt="<%= partner.adTitle || partner.title %>"><% } %><div class="content"><span class="eyebrow">PUBLICITÉ PARTENAIRE</span><h1><%= partner.adTitle || partner.title %></h1><p><%= partner.adText || partner.description %></p><% if (partner.adUrl) { %><a class="cta" href="<%= partner.adUrl %>" target="_blank" rel="noopener noreferrer"><%= partner.adButtonText || 'Découvrir' %> →</a><% } %><% if (partner.founderName) { %><div class="founder"><b><%= partner.founderName %></b><span class="muted"><%= partner.founderRole || 'Founder' %><% if (partner.founderDiscordId) { %> · Discord : <%= partner.founderDiscordId %><% } %></span><% if (partner.founderNote) { %><p style="margin-bottom:0"><%= partner.founderNote %></p><% } %></div><% } %></div></article><div class="foot">Partenaire de l’écosystème OMNIX · Contenu fourni par le partenaire</div></div></body></html>
