/* =========================================================
   GLOBAL REFRESH
========================================================= */

document
  .getElementById(
    "refreshAll"
  )
  ?.addEventListener(
    "click",
    async () => {

      const button =
        document.getElementById(
          "refreshAll"
        );

      if (!button) {
        return;
      }

      const original =
        button.textContent;

      button.disabled =
        true;

      button.textContent =
        "↻ Chargement...";

      try {

        await reloadCurrentSection();

      } catch (error) {

        console.error(
          "[OMNIX ADMIN] Refresh:",
          error
        );

      } finally {

        button.disabled =
          false;

        button.textContent =
          original ||
          "↻ Actualiser";
      }

    }
  );

/* =========================================================
   CURRENT SECTION RELOAD
========================================================= */

async function reloadCurrentSection() {

  switch (
    AdminState.currentSection
  ) {

    case "overview":

      await loadOverview();

      break;

    case "users":

      await loadUsers(
        AdminState.usersPage
      );

      break;

    case "guilds":

      await loadGuilds(
        AdminState.guildsPage
      );

      break;

    case "ai":

      await loadAiStatistics();

      break;

    case "aiLogs":

      await loadAiLogs(
        AdminState.aiLogsPage
      );

      break;

    case "health":

      await loadHealth();

      break;

    default:

      await loadOverview();

      break;
  }
}

/* =========================================================
   PERIODIC HEALTH CHECK
========================================================= */

let healthInterval =
  null;

function startHealthMonitor() {

  if (healthInterval) {

    clearInterval(
      healthInterval
    );

  }

  healthInterval =
    setInterval(
      () => {

        if (
          AdminState.currentSection ===
          "health"
        ) {

          loadHealth();

        }

      },
      60000
    );
}

startHealthMonitor();

/* =========================================================
   CHART.JS CHECK
========================================================= */

function chartLibraryReady() {

  if (
    typeof Chart ===
    "undefined"
  ) {

    console.error(
      "[OMNIX ADMIN] Chart.js n'est pas disponible."
    );

    return false;
  }

  return true;
}

/* =========================================================
   SAFE CHART WRAPPER
========================================================= */

const originalDrawLineChart =
  drawLineChart;

drawLineChart =
  function (
    canvasId,
    rows,
    valueKey,
    label
  ) {

    if (
      !chartLibraryReady()
    ) {

      return;

    }

    return originalDrawLineChart(
      canvasId,
      rows,
      valueKey,
      label
    );
  };

/* =========================================================
   PAGE VISIBILITY
========================================================= */

document.addEventListener(
  "visibilitychange",
  () => {

    if (
      document.visibilityState ===
      "visible"
    ) {

      if (
        AdminState.currentSection ===
        "health"
      ) {

        loadHealth();

      }

    }

  }
);

/* =========================================================
   NETWORK ERROR HANDLING
========================================================= */

window.addEventListener(
  "unhandledrejection",
  event => {

    console.error(
      "[OMNIX ADMIN] Promise rejetée:",
      event.reason
    );

  }
);

/* =========================================================
   FINAL BOOT
========================================================= */

async function bootAdminPanel() {

  console.log(
    "%cOMNIX Staff Panel",
    "font-weight:900;font-size:18px;"
  );

  console.log(
    "[OMNIX ADMIN] Initialisation..."
  );

  if (
    !chartLibraryReady()
  ) {

    console.warn(
      "[OMNIX ADMIN] Chart.js indisponible."
    );

  }

  try {

    await loadOverview();

    console.log(
      "[OMNIX ADMIN] Panel opérationnel."
    );

  } catch (error) {

    console.error(
      "[OMNIX ADMIN] Boot error:",
      error
    );

  }

}

/* =========================================================
   DOM READY
========================================================= */

if (
  document.readyState ===
  "loading"
) {

  document.addEventListener(
    "DOMContentLoaded",
    bootAdminPanel,
    {
      once: true
    }
  );

} else {

  bootAdminPanel();

}

