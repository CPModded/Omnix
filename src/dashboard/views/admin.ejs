      "start",
      `${start}T00:00:00`
    );
  }

  if (end) {
    params.set(
      "end",
      `${end}T23:59:59`
    );
  }

  try {

    const query =
      params.toString();

    const url =
      query
        ? `${ADMIN_ROUTES.overview}?${query}`
        : ADMIN_ROUTES.overview;

    const data =
      await adminFetch(
        url
