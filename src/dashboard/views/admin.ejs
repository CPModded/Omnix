/* =========================================================
   AI STATISTICS RENDER
========================================================= */
function renderAiStatistics(
  rows
) {
  const totalRequests =
    rows.reduce(
      (sum, row) =>
        sum +
        Number(
          row.requests || 0
        ),
      0
    );
  const totalTokens =
    rows.reduce(
      (sum, row) =>
        sum +
        Number(
          row.tokens || 0
        ),
      0
    );
  const totalErrors =
    rows.reduce(
      (sum, row) =>
        sum +
        Number(
          row.errors || 0
        ),
      0
    );
  const errorRate =
    totalRequests > 0
      ? (
          totalErrors /
          totalRequests *
          100
        ).toFixed(2) + "%"
      : "0%";
  setText(
    "aiTotalRequests",
    formatNumber(
      totalRequests
    )
  );
  setText(
    "aiTotalTokens",
    formatNumber(
