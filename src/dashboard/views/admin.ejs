========================================================= */
function destroyChart(
  id
) {
  if (
    AdminState.charts[id]
  ) {
    AdminState.charts[id].destroy();
    delete AdminState.charts[id];
  }
}
function drawLineChart(
  canvasId,
  rows,
  valueKey,
  label
) {
  const canvas =
    document.getElementById(
      canvasId
    );
  if (!canvas) {
    return;
  }
  const ctx =
    canvas.getContext(
      "2d"
    );
  if (!ctx) {
    return;
  }
  destroyChart(
    canvasId
  );
  const values =
    rows.map(
      row =>
        Number(
          row[valueKey] || 0
        )
    );
  const labels =
    rows.map(
      row =>
        row.date || ""
    );
  AdminState.charts[
    canvasId
  ] = new Chart(
    ctx,
    {
      type: "line",
      data: {
        labels,
        datasets: [
          {
            label,
            data: values,
            borderColor:
              "#22d3ee",
            backgroundColor:
              "rgba(34,211,238,.08)",
            borderWidth: 2,
            pointRadius: 2,
            pointHoverRadius: 5,
            tension: .35,
            fill: true
          }
        ]
      },
      options: chartOptions()
    }
  );
}
function drawAiChart(
  rows
) {
  const canvas =
    document.getElementById(
      "aiChart"
    );
