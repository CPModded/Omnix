<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  >
  <title>OMNIX — Staff Panel</title>
  <style>
    /* =========================================================
       OMNIX STAFF PANEL
       PART 1 / 2
    ========================================================= */
    :root {
      --bg: #020617;
      --bg-soft: #030b1c;
      --panel: rgba(15, 23, 42, .72);
      --panel-strong: rgba(15, 23, 42, .92);
      --border: rgba(148, 163, 184, .12);
      --text: #f8fafc;
      --muted: #94a3b8;
      --muted-2: #64748b;
      --cyan: #22d3ee;
      --blue: #60a5fa;
      --violet: #a78bfa;
      --green: #34d399;
      --yellow: #fbbf24;
      --red: #fb7185;
      --radius: 18px;
      --radius-sm: 12px;
      --sidebar-width: 270px;
      --shadow:
        0 20px 60px rgba(0,0,0,.35);
      --transition:
        180ms ease;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      min-height: 100vh;
      background:
        radial-gradient(
          circle at 15% 10%,
          rgba(34,211,238,.07),
          transparent 28%
        ),
        radial-gradient(
          circle at 85% 15%,
          rgba(124,58,237,.08),
          transparent 30%
        ),
        var(--bg);
      color: var(--text);
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
      overflow-x: hidden;
    }
    button,
    input,
    select {
      font: inherit;
    }
    button {
      cursor: pointer;
    }
    a {
      color: inherit;
    }
    /* =========================================================
       APP
    ========================================================= */
    .admin-app {
      min-height: 100vh;
      display: flex;
    }
    /* =========================================================
       SIDEBAR
    ========================================================= */
    .admin-sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--sidebar-width);
      padding: 22px 16px;
      background:
        linear-gradient(
          180deg,
          rgba(15,23,42,.96),
          rgba(2,6,23,.98)
        );
      border-right: 1px solid var(--border);
      z-index: 100;
      display: flex;
      flex-direction: column;
      transition:
        transform var(--transition);
    }
    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 4px 10px 22px;
      border-bottom: 1px solid var(--border);
    }
    .brand-logo {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        linear-gradient(
          135deg,
          #06b6d4,
          #4f46e5,
          #7c3aed
        );
      box-shadow:
        0 8px 25px rgba(79,70,229,.25);
    }
    .brand-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .brand-fallback {
      font-size: 19px;
      font-weight: 900;
    }
    .brand-name {
      font-size: 16px;
      font-weight: 900;
      letter-spacing: 1px;
      background:
        linear-gradient(
          90deg,
          #60a5fa,
          #22d3ee,
          #a78bfa
        );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .brand-role {
      margin-top: 2px;
      color: var(--muted-2);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }
    .sidebar-nav {
      margin-top: 22px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      overflow-y: auto;
    }
    .nav-section {
      margin: 18px 10px 8px;
      color: var(--muted-2);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }
    .nav-button {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 12px;
      border: 1px solid transparent;
      border-radius: 11px;
      background: transparent;
      color: var(--muted);
      text-align: left;
      transition:
        background var(--transition),
        color var(--transition),
        border-color var(--transition);
    }
    .nav-button:hover {
      background: rgba(255,255,255,.035);
      color: white;
    }
    .nav-button.active {
      color: white;
      background:
        linear-gradient(
          90deg,
          rgba(34,211,238,.10),
          rgba(99,102,241,.08)
        );
      border-color:
        rgba(34,211,238,.10);
    }
    .nav-icon {
      width: 19px;
      min-width: 19px;
      text-align: center;
      font-size: 15px;
    }
    .nav-label {
      font-size: 12px;
      font-weight: 700;
    }
    .sidebar-bottom {
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }
    .staff-card {
      padding: 13px;
      border:
        1px solid rgba(255,255,255,.05);
      border-radius: 13px;
      background:
        rgba(255,255,255,.025);
    }
    .staff-card-label {
      color: var(--muted-2);
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .staff-card-name {
      margin-top: 5px;
      font-size: 12px;
      font-weight: 800;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .staff-status {
      margin-top: 7px;
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--green);
      font-size: 10px;
      font-weight: 700;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      box-shadow:
        0 0 10px currentColor;
    }
    /* =========================================================
       MAIN
    ========================================================= */
    .admin-main {
      width: calc(100% - var(--sidebar-width));
      margin-left: var(--sidebar-width);
      min-height: 100vh;
      padding: 22px;
    }
    .topbar {
      min-height: 66px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 4px 18px;
      border-bottom: 1px solid var(--border);
    }
    .topbar-title {
      font-size: 21px;
      font-weight: 900;
    }
    .topbar-subtitle {
      margin-top: 3px;
      color: var(--muted);
      font-size: 11px;
    }
    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .mobile-menu {
      display: none;
      width: 40px;
      height: 40px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--panel);
      color: white;
    }
    /* =========================================================
       BUTTONS
    ========================================================= */
    .btn {
      min-height: 38px;
      padding: 0 13px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background:
        rgba(255,255,255,.035);
      color: var(--text);
      font-size: 11px;
      font-weight: 800;
      transition:
        transform var(--transition),
        background var(--transition),
        border-color var(--transition);
    }
    .btn:hover {
      background:
        rgba(255,255,255,.07);
      border-color:
        rgba(255,255,255,.13);
    }
    .btn:active {
      transform: scale(.98);
    }
    .btn-primary {
      border: none;
      background:
        linear-gradient(
          135deg,
          #06b6d4,
          #4f46e5
        );
      box-shadow:
        0 8px 22px rgba(79,70,229,.18);
    }
    .btn-danger {
      color: #fecdd3;
      border-color:
        rgba(251,113,133,.18);
      background:
        rgba(251,113,133,.07);
    }
    .btn-success {
      color: #a7f3d0;
      border-color:
        rgba(52,211,153,.18);
      background:
        rgba(52,211,153,.07);
    }
    /* =========================================================
       CONTENT
    ========================================================= */
    .page-section {
      display: none;
      padding-top: 22px;
      animation:
        sectionIn .22s ease;
    }
    .page-section.active {
      display: block;
    }
    @keyframes sectionIn {
      from {
        opacity: 0;
        transform: translateY(5px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 16px;
    }
    .section-header h2 {
      font-size: 18px;
      font-weight: 900;
    }
    .section-header p {
      margin-top: 4px;
      color: var(--muted);
      font-size: 11px;
    }
    /* =========================================================
       STAT CARDS
    ========================================================= */
    .stats-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 13px;
      margin-bottom: 16px;
    }
    .stat-card {
      min-width: 0;
      padding: 17px;
      border:
        1px solid var(--border);
      border-radius: var(--radius);
      background:
        linear-gradient(
          145deg,
          rgba(15,23,42,.78),
          rgba(15,23,42,.42)
        );
      box-shadow: var(--shadow);
      overflow: hidden;
      position: relative;
    }
    .stat-card::after {
      content: "";
      position: absolute;
      width: 100px;
      height: 100px;
      right: -45px;
      bottom: -45px;
      border-radius: 50%;
      background:
        rgba(34,211,238,.06);
      filter: blur(12px);
    }
    .stat-label {
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .7px;
    }
    .stat-value {
      margin-top: 8px;
      font-size: 26px;
      font-weight: 900;
      letter-spacing: -.5px;
    }
    .stat-meta {
      margin-top: 6px;
      color: var(--muted-2);
      font-size: 10px;
    }
    .stat-meta.good {
      color: var(--green);
    }
    .stat-meta.warning {
      color: var(--yellow);
    }
    .stat-meta.error {
      color: var(--red);
    }
    /* =========================================================
       PANELS
    ========================================================= */
    .panel-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 15px;
      margin-bottom: 15px;
    }
    .panel {
      min-width: 0;
      border:
        1px solid var(--border);
      border-radius: var(--radius);
      background:
        rgba(15,23,42,.62);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .panel-header {
      min-height: 55px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 0 16px;
      border-bottom:
        1px solid var(--border);
    }
    .panel-title {
      font-size: 12px;
      font-weight: 900;
    }
    .panel-subtitle {
      margin-top: 2px;
      color: var(--muted-2);
      font-size: 9px;
    }
    .panel-body {
      padding: 16px;
    }
    /* =========================================================
       CHARTS
    ========================================================= */
    .chart-box {
      width: 100%;
      height: 270px;
      position: relative;
    }
    .chart-box canvas {
      width: 100% !important;
      height: 100% !important;
    }
    /* =========================================================
       TABLES
    ========================================================= */
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
    }
    .data-table th {
      padding: 11px 10px;
      color: var(--muted-2);
      font-size: 9px;
      font-weight: 900;
      text-align: left;
      text-transform: uppercase;
      letter-spacing: .6px;
      border-bottom:
        1px solid var(--border);
      white-space: nowrap;
    }
    .data-table td {
      padding: 12px 10px;
      color: #cbd5e1;
      border-bottom:
        1px solid rgba(148,163,184,.06);
      vertical-align: middle;
    }
    .data-table tr:hover td {
      background:
        rgba(255,255,255,.018);
    }
    .user-cell {
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .avatar {
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      border-radius: 9px;
      background:
        linear-gradient(
          135deg,
          #334155,
          #1e293b
        );
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 900;
      color: white;
    }
    .user-name {
      color: white;
      font-size: 11px;
      font-weight: 800;
    }
    .user-id {
      margin-top: 2px;
      color: var(--muted-2);
      font-size: 9px;
    }
    /* =========================================================
       BADGES
    ========================================================= */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 7px;
      border-radius: 7px;
      font-size: 9px;
      font-weight: 800;
    }
    .badge-green {
      color: #a7f3d0;
      background: rgba(52,211,153,.09);
    }
    .badge-blue {
      color: #bae6fd;
      background: rgba(56,189,248,.09);
    }
    .badge-violet {
      color: #ddd6fe;
      background: rgba(139,92,246,.10);
    }
    .badge-yellow {
      color: #fde68a;
      background: rgba(251,191,36,.09);
    }
    .badge-red {
      color: #fecdd3;
      background: rgba(251,113,133,.09);
    }
    .badge-gray {
      color: #cbd5e1;
      background: rgba(148,163,184,.08);
    }
    /* =========================================================
       TOOLBAR
    ========================================================= */
    .toolbar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 13px;
    }
    .input,
    .select {
      height: 38px;
      padding: 0 11px;
      border:
        1px solid var(--border);
      border-radius: 10px;
      background:
        rgba(2,6,23,.65);
      color: white;
      outline: none;
      font-size: 11px;
    }
    .input {
      min-width: 180px;
      flex: 1;
    }
    .select {
      min-width: 145px;
    }
    .input:focus,
    .select:focus {
      border-color:
        rgba(34,211,238,.35);
      box-shadow:
        0 0 0 3px
        rgba(34,211,238,.05);
    }
    /* =========================================================
       LOADING / EMPTY
    ========================================================= */
    .loading {
      padding: 40px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 11px;
    }
    .spinner {
      width: 22px;
      height: 22px;
      margin: 0 auto 10px;
      border:
        2px solid rgba(255,255,255,.08);
      border-top-color:
        var(--cyan);
      border-radius: 50%;
      animation:
        spin .7s linear infinite;
    }
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
    .empty {
      padding: 35px 20px;
      text-align: center;
      color: var(--muted-2);
      font-size: 11px;
    }
    /* =========================================================
       PAGINATION
    ========================================================= */
    .pagination {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 7px;
      padding: 12px 15px;
    }
    .pagination-info {
      margin-right: auto;
      color: var(--muted-2);
      font-size: 10px;
    }
    /* =========================================================
       OVERLAY
    ========================================================= */
    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background:
        rgba(0,0,0,.55);
      z-index: 90;
    }
    /* =========================================================
       RESPONSIVE
    ========================================================= */
    @media (max-width: 1150px) {
      .stats-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 900px) {
      :root {
        --sidebar-width: 245px;
      }
      .panel-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 720px) {
      .admin-sidebar {
        transform:
          translateX(-100%);
      }
      .admin-sidebar.open {
        transform:
          translateX(0);
      }
      .sidebar-overlay.open {
        display: block;
      }
      .admin-main {
        width: 100%;
        margin-left: 0;
        padding: 15px;
      }
      .mobile-menu {
        display: block;
      }
      .topbar {
        align-items: flex-start;
      }
      .topbar-actions .btn {
        display: none;
      }
    }
    @media (max-width: 520px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
      .toolbar {
        align-items: stretch;
      }
      .input,
      .select {
        width: 100%;
        min-width: 0;
      }
      .section-header {
        align-items: flex-start;
        flex-direction: column;
      }
      .chart-box {
        height: 220px;
      }
    }
  </style>
</head>
<body>
<div class="admin-app">
  <!-- =======================================================
       SIDEBAR
  ======================================================== -->
  <aside id="adminSidebar" class="admin-sidebar">
    <div class="sidebar-brand">
      <div class="brand-logo">
        <img
          src="/logo.png"
          alt="OMNIX"
          onerror="
            this.style.display='none';
            document.getElementById('brandFallback').style.display='flex';
          "
        >
        <span
          id="brandFallback"
          class="brand-fallback"
          style="display:none;"
        >
          O
        </span>
      </div>
      <div>
        <div class="brand-name">
          OMNIX
        </div>
        <div class="brand-role">
          Staff Control Center
        </div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section">
        Général
      </div>
      <button
        class="nav-button active"
        data-section="overview"
      >
        <span class="nav-icon">📊</span>
        <span class="nav-label">
          Vue générale
        </span>
      </button>
      <button
        class="nav-button"
        data-section="users"
      >
        <span class="nav-icon">👥</span>
        <span class="nav-label">
          Utilisateurs
        </span>
      </button>
      <button
        class="nav-button"
        data-section="guilds"
      >
        <span class="nav-icon">🖥️</span>
        <span class="nav-label">
          Serveurs Discord
        </span>
      </button>
      <div class="nav-section">
        Intelligence artificielle
      </div>
      <button
        class="nav-button"
        data-section="ai"
      >
        <span class="nav-icon">🤖</span>
        <span class="nav-label">
          Statistiques IA
        </span>
      </button>
      <button
        class="nav-button"
        data-section="aiLogs"
      >
        <span class="nav-icon">💬</span>
        <span class="nav-label">
          Logs conversations IA
        </span>
      </button>
      <div class="nav-section">
        Plateforme
      </div>
      <button class="nav-button" data-section="bot"><span class="nav-icon">🤖</span><span class="nav-label">Bot Discord</span></button>
      <button class="nav-button" data-section="payments"><span class="nav-icon">💳</span><span class="nav-label">Paiements</span></button>
      <button class="nav-button" data-section="emails"><span class="nav-icon">📧</span><span class="nav-label">Emails</span></button>
      <button class="nav-button" data-section="events"><span class="nav-icon">📡</span><span class="nav-label">Activité temps réel</span></button>
      <button class="nav-button" data-section="analytics"><span class="nav-icon">📈</span><span class="nav-label">Analytics</span></button>
      <div class="nav-section">
        Sécurité
      </div>
      <button class="nav-button" data-section="audit"><span class="nav-icon">🛡️</span><span class="nav-label">Audit Logs</span></button>
      <div class="nav-section">
        Système
      </div>
      <button
        class="nav-button"
        data-section="health"
      >
        <span class="nav-icon">❤️</span>
        <span class="nav-label">
          Santé système
        </span>
      </button>
    </nav>
    <div class="sidebar-bottom">
      <div class="staff-card">
        <div class="staff-card-label">
          Session Staff
        </div>
        <div
          id="staffName"
          class="staff-card-name"
        >
          Chargement...
        </div>
        <div class="staff-status">
          <span class="status-dot"></span>
          Panel sécurisé
        </div>
      </div>
    </div>
  </aside>
  <div
    id="sidebarOverlay"
    class="sidebar-overlay"
  ></div>
  <!-- =======================================================
       MAIN
  ======================================================== -->
  <main class="admin-main">
    <header class="topbar">
      <div
        style="
          display:flex;
          align-items:center;
          gap:12px;
        "
      >
        <button
          id="mobileMenu"
          class="mobile-menu"
          type="button"
        >
          ☰
        </button>
        <div>
          <div class="topbar-title">
            Staff Panel
          </div>
          <div class="topbar-subtitle">
            Centre de contrôle administratif OMNIX
          </div>
        </div>
      </div>
      <div class="topbar-actions">
        <button
          class="btn"
          id="refreshAll"
          type="button"
        >
          ↻ Actualiser
        </button>
        <a
          href="/"
          class="btn"
        >
          ← Retour
        </a>
      </div>
    </header>
    <!-- =====================================================
         OVERVIEW
    ====================================================== -->
    <section
      id="section-overview"
      class="page-section active"
    >
      <div class="section-header">
        <div>
          <h2>
            Vue générale
          </h2>
          <p>
            Vue globale de l'activité OMNIX.
          </p>
        </div>
        <div
          style="
            display:flex;
            gap:7px;
            align-items:center;
          "
        >
