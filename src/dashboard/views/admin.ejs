<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>OMNIX — Control Center</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>
<style>
:root{--bg:#050816;--panel:#0b1020;--panel2:#0f172a;--panel3:#121b31;--line:rgba(148,163,184,.13);--text:#f4f7ff;--muted:#8793aa;--primary:#7c5cff;--primary2:#9a7cff;--cyan:#5ee7ff;--green:#34d399;--yellow:#fbbf24;--red:#fb7185;--shadow:0 22px 70px rgba(0,0,0,.28)}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 20% -10%,rgba(124,92,255,.18),transparent 30%),radial-gradient(circle at 100% 10%,rgba(94,231,255,.08),transparent 25%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}.app{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:270px;padding:18px 14px;background:rgba(5,8,22,.91);border-right:1px solid var(--line);backdrop-filter:blur(22px);z-index:50;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:12px;padding:8px 10px 22px}.brand-logo{width:42px;height:42px;border-radius:13px;object-fit:cover;background:linear-gradient(135deg,#5ee7ff,#7c5cff)}.brand-title{font-weight:950;letter-spacing:1.8px}.brand-sub{display:block;color:#68758d;font-size:9px;letter-spacing:1.2px;text-transform:uppercase;margin-top:2px}.nav{overflow:auto;padding-right:4px}.nav-label{padding:14px 11px 7px;color:#4e5b72;font-size:8px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase}.nav button{width:100%;display:flex;align-items:center;gap:11px;padding:10px 11px;margin:2px 0;border:1px solid transparent;border-radius:11px;background:transparent;color:#8e9bb2;text-align:left;font-size:11px;font-weight:800}.nav button:hover{background:rgba(124,92,255,.08);color:#fff}.nav button.active{background:linear-gradient(135deg,rgba(124,92,255,.19),rgba(94,231,255,.05));border-color:rgba(124,92,255,.18);color:#fff;box-shadow:inset 3px 0 0 var(--primary)}.nav-icon{width:20px;text-align:center;font-size:14px}.sidebar-footer{margin-top:auto;border-top:1px solid var(--line);padding:13px 8px 3px}.staff-mini{display:flex;align-items:center;gap:9px}.avatar{width:32px;height:32px;border-radius:10px;object-fit:cover;background:#182238}.staff-mini b{display:block;font-size:10px}.staff-mini span{color:#6f7d95;font-size:8px}.main{margin-left:270px;padding:26px 28px 50px;max-width:1800px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:22px}.crumb{color:#69768d;font-size:10px}.title{margin:3px 0 0;font-size:25px;letter-spacing:-.8px}.actions{display:flex;gap:8px}.btn{border:1px solid var(--line);background:rgba(255,255,255,.035);color:#d8def0;border-radius:10px;padding:9px 12px;font-size:10px;font-weight:850}.btn:hover{border-color:rgba(124,92,255,.28);background:rgba(124,92,255,.09)}.btn.primary{background:linear-gradient(135deg,#6f4dff,#9a7cff);border-color:transparent;color:#fff}.btn.danger{background:rgba(251,113,133,.10);color:#fecdd3;border-color:rgba(251,113,133,.2)}.mobile-menu{display:none}.section{display:none}.section.active{display:block}.hero{display:grid;grid-template-columns:1.5fr .9fr;gap:14px;margin-bottom:14px}.hero-card{position:relative;overflow:hidden;padding:25px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(18,27,49,.92),rgba(8,13,28,.9));box-shadow:var(--shadow)}.hero-card:after{content:"";position:absolute;width:250px;height:250px;border-radius:50%;right:-80px;top:-110px;background:rgba(124,92,255,.18);filter:blur(2px)}.eyebrow{color:var(--cyan);font-size:8px;font-weight:950;letter-spacing:1.7px;text-transform:uppercase}.hero h2{margin:9px 0 8px;font-size:27px;letter-spacing:-1px}.hero p{max-width:720px;color:#8d99af;font-size:11px;line-height:1.8;margin:0}.hero-status{display:flex;align-items:center;gap:10px;margin-top:16px}.dot{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 15px rgba(52,211,153,.55)}.dot.bad{background:var(--red);box-shadow:none}.hero-side{display:flex;flex-direction:column;justify-content:space-between}.sync{display:flex;justify-content:space-between;gap:10px;align-items:center}.sync strong{font-size:12px}.sync span{color:#738198;font-size:9px}.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}.stat{padding:16px;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,rgba(18,27,49,.78),rgba(8,13,28,.82));min-height:108px}.stat .label{color:#77849a;font-size:9px;font-weight:850;text-transform:uppercase;letter-spacing:.8px}.stat .value{font-size:25px;font-weight:950;margin-top:8px;letter-spacing:-.7px}.stat .meta{margin-top:5px;color:#64728a;font-size:9px}.grid2{display:grid;grid-template-columns:1.25fr .75fr;gap:12px;margin-top:12px}.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.panel{border:1px solid var(--line);border-radius:18px;background:rgba(10,16,31,.78);box-shadow:0 12px 45px rgba(0,0,0,.16);overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:15px 17px;border-bottom:1px solid var(--line)}.panel-head h3{font-size:12px;margin:0}.panel-head p{margin:3px 0 0;color:#69768d;font-size:9px}.panel-body{padding:16px}.chart-wrap{height:270px}.toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}.input,.select,.textarea{background:#080e1c;border:1px solid var(--line);color:#eef2ff;border-radius:10px;padding:10px 11px;font-size:10px;outline:none}.input:focus,.select:focus,.textarea:focus{border-color:rgba(124,92,255,.45);box-shadow:0 0 0 3px rgba(124,92,255,.08)}.input{min-width:230px}.upload-field{padding:12px;border:1px dashed var(--line);border-radius:12px;background:rgba(255,255,255,.018)}.upload-label{display:block;color:#d8def0;font-size:10px;font-weight:900;margin-bottom:7px}.upload-help{margin-top:6px;color:#68758d;font-size:8px;line-height:1.6}.upload-preview{display:block;width:100%;max-width:280px;max-height:150px;object-fit:cover;border-radius:10px;margin-top:9px;border:1px solid var(--line)}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:760px}.table th,.table td{padding:12px 13px;border-bottom:1px solid rgba(148,163,184,.08);text-align:left;vertical-align:middle;font-size:10px}.table th{color:#64728a;font-size:8px;text-transform:uppercase;letter-spacing:.8px}.table tr.click{cursor:pointer}.table tr.click:hover{background:rgba(124,92,255,.055)}.user-cell{display:flex;align-items:center;gap:10px;min-width:180px}.user-cell img{width:31px;height:31px;border-radius:10px;object-fit:cover;background:#172238}.user-cell b{font-size:10px}.sub{display:block;color:#637089;font-size:8px;margin-top:2px}.badge{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;border-radius:999px;background:#121c31;color:#aeb9cc;font-size:8px;font-weight:900}.badge.green{background:rgba(52,211,153,.09);color:#86efac}.badge.red{background:rgba(251,113,133,.10);color:#fda4af}.badge.gold{background:rgba(251,191,36,.10);color:#fde68a}.badge.violet{background:rgba(124,92,255,.11);color:#c4b5fd}.empty{padding:40px;text-align:center;color:#69768d;font-size:10px}.cards-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-card{border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.02);padding:13px}.info-card b{font-size:10px}.info-card p{color:#7f8ba1;font-size:9px;line-height:1.7;margin:6px 0 0}.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.mini{padding:11px;border-radius:12px;background:#0b1324;border:1px solid var(--line)}.mini span{display:block;color:#68758b;font-size:8px}.mini strong{display:block;margin-top:5px;font-size:15px}.modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(1,4,12,.76);backdrop-filter:blur(9px);z-index:100}.modal.open{display:flex}.modal-box{width:min(1080px,100%);max-height:92vh;overflow:auto;border:1px solid rgba(148,163,184,.17);border-radius:23px;background:linear-gradient(145deg,#0e1629,#070d1b);box-shadow:0 35px 120px rgba(0,0,0,.55)}.modal-head{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:17px 19px;background:rgba(9,14,27,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.modal-head h2{font-size:15px;margin:0}.modal-body{padding:19px}.detail-hero{display:flex;align-items:center;gap:14px;padding:16px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.025)}.detail-avatar{width:58px;height:58px;border-radius:16px;object-fit:cover;background:#172238}.detail-hero h3{margin:0 0 4px;font-size:17px}.detail-hero p{margin:0;color:#77849a;font-size:9px}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:12px}.detail-section{border:1px solid var(--line);border-radius:15px;padding:14px;background:rgba(255,255,255,.018)}.detail-section h4{margin:0 0 10px;font-size:10px;color:#aeb9cc;text-transform:uppercase;letter-spacing:.7px}.kv{display:grid;grid-template-columns:145px 1fr;gap:6px;padding:6px 0;border-bottom:1px solid rgba(148,163,184,.06);font-size:9px}.kv:last-child{border-bottom:0}.kv span:first-child{color:#637089}.kv span:last-child{color:#d8deeb;word-break:break-word}.chip-list{display:flex;flex-wrap:wrap;gap:5px}.chip{padding:5px 7px;border-radius:8px;background:#111b2f;color:#9da9be;font-size:8px}.partner-form{display:grid;grid-template-columns:1fr 1fr;gap:9px}.partner-form .full{grid-column:1/-1}.toggle{display:flex;align-items:center;gap:8px;color:#aab5c7;font-size:9px}.toggle input{accent-color:var(--primary)}.notice{padding:11px 13px;border-radius:12px;background:rgba(94,231,255,.055);border:1px solid rgba(94,231,255,.12);color:#a8eefa;font-size:9px;line-height:1.7}.danger-zone{padding:12px;border-radius:12px;background:rgba(251,113,133,.05);border:1px solid rgba(251,113,133,.12)}.toast{position:fixed;right:20px;bottom:20px;z-index:200;transform:translateY(20px);opacity:0;pointer-events:none;padding:12px 15px;border-radius:12px;background:#111a2d;border:1px solid var(--line);box-shadow:var(--shadow);font-size:10px;transition:.22s}.toast.show{transform:none;opacity:1}.drawer-close{display:none}@media(max-width:1100px){.stat-grid{grid-template-columns:repeat(2,1fr)}.hero,.grid2{grid-template-columns:1fr}.grid3{grid-template-columns:1fr}.sidebar{width:235px}.main{margin-left:235px}}@media(max-width:780px){.sidebar{transform:translateX(-105%);transition:.22s;width:min(285px,88vw);box-shadow:30px 0 80px rgba(0,0,0,.35)}.sidebar.open{transform:none}.main{margin-left:0;padding:17px 13px 35px}.mobile-menu{display:inline-flex}.drawer-close{display:block}.topbar{align-items:flex-start}.title{font-size:20px}.stat-grid{grid-template-columns:1fr 1fr}.cards-list,.detail-grid,.partner-form{grid-template-columns:1fr}.partner-form .full{grid-column:auto}.kpi-row{grid-template-columns:1fr 1fr}.table{min-width:680px}.modal{padding:8px}.modal-box{max-height:96vh;border-radius:18px}.hero-card{padding:20px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar" id="sidebar">
  <div class="brand"><img class="brand-logo" src="/logo.png" alt="OMNIX"><div><div class="brand-title">OMNIX</div><span class="brand-sub">Staff Control Center</span></div><button class="btn drawer-close" onclick="toggleMenu()">×</button></div>
  <nav class="nav" id="nav">
    <div class="nav-label">Pilotage</div>
    <button data-section="overview" class="active"><span class="nav-icon">◈</span>Vue générale</button>
    <button data-section="bot"><span class="nav-icon">◉</span>Robot Discord</button>
    <button data-section="guilds"><span class="nav-icon">▣</span>Serveurs</button>
    <button data-section="users"><span class="nav-icon">♙</span>Membres OMNIX</button>
    <button data-section="blacklist"><span class="nav-icon">⛨</span>Blacklist</button>
    <div class="nav-label">Intelligence</div>
    <button data-section="ai"><span class="nav-icon">✦</span>Intelligence IA</button>
    <button data-section="aiLogs"><span class="nav-icon">◌</span>Conversations IA</button>
    <button data-section="events"><span class="nav-icon">⌁</span>Activité temps réel</button>
    <button data-section="analytics"><span class="nav-icon">◒</span>Analytics</button>
    <div class="nav-label">Écosystème</div>
    <button data-section="partners"><span class="nav-icon">♛</span>Partenaires & Founder</button>
    <button data-section="support"><span class="nav-icon">✉</span>Support</button>
    <div class="nav-label">Gestion</div>
    <button data-section="payments"><span class="nav-icon">€</span>Paiements</button>
    <button data-section="pricing"><span class="nav-icon">◇</span>Offres Premium</button>
    <button data-section="promos"><span class="nav-icon">%</span>Codes promo</button>
    <button data-section="admins"><span class="nav-icon">♟</span>Staff & rôles</button>
    <button data-section="audit"><span class="nav-icon">⌘</span>Audit</button>
    <button data-section="health"><span class="nav-icon">♥</span>Système</button>
    <button data-section="control"><span class="nav-icon">⚙</span>Contrôle OMNIX</button>
  </nav>
  <div class="sidebar-footer"><div class="staff-mini"><img id="staffAvatar" class="avatar" src="/logo.png"><div><b id="staffName">Staff OMNIX</b><span id="staffRole">Chargement…</span></div></div></div>
</aside>
<main class="main">
  <header class="topbar"><div><div class="crumb">OMNIX / <span id="crumb">Vue générale</span></div><h1 class="title" id="pageTitle">Centre de contrôle</h1></div><div class="actions"><button class="btn mobile-menu" onclick="toggleMenu()">☰ Menu</button><button class="btn" onclick="refreshCurrent()">↻ Actualiser</button></div></header>

  <section id="s-overview" class="section active">
    <div class="hero"><div class="hero-card"><span class="eyebrow">OMNIX CONTROL CENTER</span><h2>Bonjour, <span id="heroStaff">Staff</span>.</h2><p>Supervision centralisée du bot, des serveurs, des membres, de l’IA, des licences et de l’écosystème partenaire. Les données sensibles restent protégées côté serveur.</p><div class="hero-status"><i class="dot" id="heroDot"></i><span id="heroStatus">Synchronisation des services…</span></div></div><div class="hero-card hero-side"><div class="sync"><div><strong>Dernière synchronisation</strong><span id="lastSync">—</span></div><button class="btn primary" onclick="refreshCurrent()">Synchroniser</button></div><div class="notice">Le panneau est pensé pour être exploité sur mobile comme sur desktop. Cliquez sur un membre ou un serveur pour ouvrir sa fiche détaillée.</div></div></div>
    <div class="stat-grid" id="overviewCards"></div>
    <div class="grid2"><div class="panel"><div class="panel-head"><div><h3>Évolution de l’activité</h3><p>Utilisateurs, serveurs et IA sur la période active.</p></div></div><div class="panel-body"><div class="chart-wrap"><canvas id="overviewChart"></canvas></div></div></div><div class="panel"><div class="panel-head"><div><h3>État des services</h3><p>État réel du runtime OMNIX.</p></div></div><div class="panel-body" id="serviceCards"></div></div></div>
  </section>

  <section id="s-users" class="section"><div class="panel"><div class="panel-head"><div><h3>Membres OMNIX</h3><p>Recherche complète. Cliquez sur une ligne pour ouvrir le dossier membre.</p></div></div><div class="panel-body"><div class="toolbar"><input class="input" id="userSearch" placeholder="Pseudo, Discord ID, email"><button class="btn primary" onclick="loadUsers()">Rechercher</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Membre</th><th>Rôle</th><th>Serveurs</th><th>Premium</th><th>Blacklist</th><th>Dernière connexion</th><th>Créé le</th></tr></thead><tbody id="usersBody"></tbody></table></div></div></div></section>
  <section id="s-blacklist" class="section"><div class="panel"><div class="panel-head"><div><h3>Blacklist membres</h3><p>La blacklist est volontairement séparée de la liste normale des membres.</p></div><span class="badge red" id="blacklistCount">0 compte</span></div><div class="panel-body"><div class="toolbar"><input class="input" id="blacklistSearch" placeholder="Rechercher un compte blacklisté"><button class="btn primary" onclick="loadBlacklist()">Actualiser</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Membre</th><th>Rôle</th><th>Email</th><th>Blacklist</th><th>Dernière activité</th><th>Action</th></tr></thead><tbody id="blacklistBody"></tbody></table></div></div></div></section>
  <section id="s-guilds" class="section"><div class="panel"><div class="panel-head"><div><h3>Serveurs Discord</h3><p>Vue administrative globale des serveurs connus par OMNIX.</p></div></div><div class="panel-body"><div class="toolbar"><input class="input" id="guildSearch" placeholder="Nom ou ID du serveur"><button class="btn primary" onclick="loadGuilds()">Rechercher</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Serveur</th><th>Membres</th><th>Propriétaire</th><th>OMNIX</th><th>Premium</th><th>Blacklist</th></tr></thead><tbody id="guildsBody"></tbody></table></div></div></div></section>
  <section id="s-bot" class="section"><div class="grid3" id="botCards"></div><div class="panel" style="margin-top:12px"><div class="panel-head"><div><h3>Inventaire du robot</h3><p>Runtime, Discord et ressources.</p></div></div><div class="panel-body" id="botDetails"></div></div></section>
  <section id="s-ai" class="section"><div class="stat-grid" id="aiCards"></div><div class="panel" style="margin-top:12px"><div class="panel-head"><div><h3>Activité IA</h3><p>Requêtes, erreurs et consommation de tokens.</p></div></div><div class="panel-body"><div class="chart-wrap"><canvas id="aiChart"></canvas></div></div></div></section>
  <section id="s-aiLogs" class="section"><div class="panel"><div class="panel-head"><div><h3>Conversations IA</h3><p>Chaque session ouvre son historique détaillé.</p></div></div><div class="panel-body"><div class="table-wrap"><table class="table"><thead><tr><th>Utilisateur</th><th>Serveur</th><th>Requêtes</th><th>Erreurs</th><th>Début</th><th>Dernière activité</th></tr></thead><tbody id="aiConversationsBody"></tbody></table></div></div></div></section>
  <section id="s-events" class="section"><div class="panel"><div class="panel-head"><div><h3>Activité temps réel</h3><p>Événements enregistrés par la plateforme.</p></div><button class="btn" onclick="loadEvents()">↻</button></div><div class="panel-body"><div class="table-wrap"><table class="table"><thead><tr><th>Type</th><th>Utilisateur</th><th>Serveur</th><th>Métadonnées</th><th>Date</th></tr></thead><tbody id="eventsBody"></tbody></table></div></div></div></section>
  <section id="s-analytics" class="section"><div class="grid3" id="analyticsCards"></div><div class="panel" style="margin-top:12px"><div class="panel-head"><div><h3>Répartition des événements</h3><p>Vision synthétique de l’activité.</p></div></div><div class="panel-body" id="analyticsBody"></div></div></section>
  <section id="s-partners" class="section"><div class="grid2"><div class="panel"><div class="panel-head"><div><h3>Partenaires</h3><p>Gestion de la présence publique et du statut Founder.</p></div></div><div class="panel-body"><div class="toolbar"><button class="btn primary" onclick="resetPartnerForm()">+ Nouveau partenaire</button></div><div id="partnersList"></div></div></div><div class="panel"><div class="panel-head"><div><h3 id="partnerFormTitle">Créer un partenaire</h3><p>Les champs Founder et publicité sont indépendants.</p></div></div><div class="panel-body"><input type="hidden" id="partnerId"><div class="partner-form"><input class="input" id="partnerTitle" placeholder="Nom du partenaire"><div class="upload-field full"><label class="upload-label" for="partnerImage">Image principale</label><input class="input" id="partnerImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif"><div class="upload-help">Choisissez une image directement depuis votre appareil. OMNIX la redimensionne automatiquement pour limiter le poids.</div><img id="partnerImagePreview" class="upload-preview" alt="Aperçu image principale" hidden></div><textarea class="textarea full" id="partnerDescription" rows="3" placeholder="Description"></textarea><input class="input" id="partnerDiscord" placeholder="Lien Discord"><label class="toggle"><input type="checkbox" id="partnerFeatured"> Mettre en avant</label><div></div><input class="input" id="founderName" placeholder="Founder — nom"><input class="input" id="founderDiscordId" placeholder="Founder — Discord ID"><input class="input" id="founderRole" placeholder="Founder — rôle"><textarea class="textarea full" id="founderNote" rows="2" placeholder="Note Founder / présentation"></textarea><div class="full notice">Publicité : elle s’affichera en haut de la carte partenaire et disposera d’une page dédiée <b>/partenaires/:id/pub</b>.</div><label class="toggle"><input type="checkbox" id="adEnabled"> Activer la publicité</label><div></div><input class="input" id="adTitle" placeholder="Titre de la publicité"><input class="input" id="adUrl" placeholder="Lien de destination"><textarea class="textarea full" id="adText" rows="3" placeholder="Texte de publicité"></textarea><div class="upload-field"><label class="upload-label" for="adImage">Image publicité</label><input class="input" id="adImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif"><div class="upload-help">Image locale pour la publicité partenaire.</div><img id="adImagePreview" class="upload-preview" alt="Aperçu publicité" hidden></div><input class="input" id="adButtonText" placeholder="Texte du bouton"><input class="input" id="adExpiresAt" type="datetime-local"><div class="full" style="display:flex;gap:8px"><button class="btn primary" onclick="savePartner()">Enregistrer</button><button class="btn" onclick="resetPartnerForm()">Réinitialiser</button></div></div></div></div></section>
  <section id="s-support" class="section"><div class="grid2"><div class="panel"><div class="panel-head"><div><h3>Tickets support</h3><p>Suivi des demandes de la plateforme.</p></div></div><div class="panel-body" id="supportList"></div></div><div class="panel"><div class="panel-head"><h3 id="supportTitle">Sélectionnez un ticket</h3></div><div class="panel-body" id="supportViewer"><div class="empty">Cliquez sur un ticket.</div></div></div></div></section>
  <section id="s-payments" class="section"><div class="panel"><div class="panel-head"><div><h3>Paiements</h3><p>Transactions et revenus enregistrés.</p></div></div><div class="panel-body"><div class="table-wrap"><table class="table"><thead><tr><th>Utilisateur</th><th>Montant</th><th>Statut</th><th>Référence</th><th>Date</th></tr></thead><tbody id="paymentsBody"></tbody></table></div></div></div></section>
  <section id="s-pricing" class="section"><div class="panel"><div class="panel-head"><div><h3>Offres Premium</h3><p>Gestion des plans visibles sur OMNIX.</p></div><button class="btn" onclick="seedPricing()">Initialiser les offres</button></div><div class="panel-body"><div class="table-wrap"><table class="table"><thead><tr><th>Offre</th><th>Prix</th><th>Durée</th><th>État</th><th>Action</th></tr></thead><tbody id="pricingBody"></tbody></table></div></div></div></section>
  <section id="s-promos" class="section"><div class="grid2"><div class="panel"><div class="panel-head"><h3>Créer un code promo</h3></div><div class="panel-body"><div class="partner-form"><input class="input" id="promoCode" placeholder="CODE"><select class="select" id="promoType"><option value="percentage">Pourcentage</option><option value="fixed">Montant fixe</option></select><input class="input" id="promoValue" type="number" placeholder="Valeur"><input class="input" id="promoMax" type="number" placeholder="Utilisations max"><input class="input" id="promoExpire" type="datetime-local"><button class="btn primary" onclick="createPromo()">Créer</button></div></div></div><div class="panel"><div class="panel-head"><h3>Codes existants</h3></div><div class="panel-body"><div class="table-wrap"><table class="table"><thead><tr><th>Code</th><th>Réduction</th><th>Utilisations</th><th>Expiration</th><th>État</th><th></th></tr></thead><tbody id="promoBody"></tbody></table></div></div></div></div></section>
  <section id="s-admins" class="section"><div class="panel"><div class="panel-head"><div><h3>Staff & rôles</h3><p>Les changements sont journalisés.</p></div></div><div class="panel-body"><div class="table-wrap"><table class="table"><thead><tr><th>Membre</th><th>Rôle</th><th>Permissions</th><th>Premium</th><th>Dernière connexion</th></tr></thead><tbody id="staffBody"></tbody></table></div></div></div></section>
  <section id="s-audit" class="section"><div class="panel"><div class="panel-head"><div><h3>Audit Staff</h3><p>Traçabilité des opérations administratives.</p></div></div><div class="panel-body"><div class="toolbar"><input class="input" id="auditSearch" placeholder="Recherche"><select class="select" id="auditAction"><option value="">Toutes les actions</option><option>create</option><option>update</option><option>delete</option><option>enable</option><option>disable</option></select><button class="btn primary" onclick="loadAudit()">Filtrer</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Staff</th><th>Action</th><th>Catégorie</th><th>Cible</th><th>Description</th><th>Date</th></tr></thead><tbody id="auditBody"></tbody></table></div></div></div></section>
  <section id="s-health" class="section"><div class="grid3" id="healthCards"></div><div class="panel" style="margin-top:12px"><div class="panel-head"><div><h3>Services & runtime</h3><p>Informations techniques du processus.</p></div></div><div class="panel-body" id="healthServices"></div></div></section>
  <section id="s-control" class="section">
    <div class="grid2">
      <div class="panel"><div class="panel-head"><div><h3>Présence du robot Discord</h3><p>Modifie ce qui apparaît dans la bulle d’activité du bot.</p></div><span class="badge violet">ADMIN</span></div>
        <div class="panel-body"><div class="partner-form">
          <label class="toggle full"><input type="checkbox" id="activityEnabled" checked> Afficher une activité</label>
          <select class="select" id="activityType"><option value="Playing">Joue à</option><option value="Watching">Regarde</option><option value="Listening">Écoute</option><option value="Competing">Participe à</option></select>
          <input class="input" id="activityMessage" maxlength="128" placeholder="Ex. OMNIX • /help">
          <select class="select" id="botStatus"><option value="online">En ligne</option><option value="idle">Inactif</option><option value="dnd">Ne pas déranger</option><option value="invisible">Invisible</option></select>
          <button class="btn primary full" onclick="saveBotActivity()">Enregistrer la présence</button>
        </div></div>
      </div>
      <div class="panel"><div class="panel-head"><div><h3>Mode maintenance</h3><p>Accès de modification réservé exclusivement au Founder.</p></div><span class="badge red">FOUNDER ONLY</span></div>
        <div class="panel-body"><div class="notice"><b>Protection propriétaire</b><div class="upload-help">Seul ton compte Owner peut activer ou désactiver ce mode. Les autres administrateurs reçoivent une réponse 403.</div></div>
          <label class="toggle" style="margin:13px 0"><input type="checkbox" id="maintenanceEnabled"> Activer le mode maintenance</label>
          <textarea class="textarea" id="maintenanceMessage" rows="4" style="width:100%;resize:vertical" maxlength="500" placeholder="Message affiché pendant la maintenance..."></textarea>
          <div style="display:flex;justify-content:flex-end;margin-top:10px"><button class="btn danger" onclick="saveMaintenance()">Enregistrer le mode maintenance</button></div>
          <div id="maintenanceState" class="sub" style="margin-top:10px">État non chargé.</div>
        </div>
      </div>
    </div>
  </section>
</main></div>
<div class="modal" id="modal"><div class="modal-box"><div class="modal-head"><h2 id="modalTitle">Détails</h2><button class="btn" onclick="closeModal()">Fermer</button></div><div class="modal-body" id="modalBody"></div></div></div><div class="toast" id="toast"></div>
<script>
const $=id=>document.getElementById(id), state={section:'overview'}, charts={};
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const fmt=n=>new Intl.NumberFormat('fr-FR').format(Number(n||0));
const date=v=>v?new Date(v).toLocaleString('fr-FR',{dateStyle:'medium',timeStyle:'short'}):'—';
function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2600)}
async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json',...(opt.headers||{})},...opt});let d={};try{d=await r.json()}catch{}if(!r.ok)throw new Error(d.error||'Erreur serveur');return d}
function toggleMenu(){ $('sidebar').classList.toggle('open') }
function closeModal(){ $('modal').classList.remove('open') }
function openModal(title,html){$('modalTitle').textContent=title;$('modalBody').innerHTML=html;$('modal').classList.add('open')}
function stat(label,value,meta='',kind=''){return `<div class="stat"><div class="label">${esc(label)}</div><div class="value ${kind}">${esc(value)}</div><div class="meta">${esc(meta)}</div></div>`}
function openSection(s){state.section=s;document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));$('s-'+s)?.classList.add('active');document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.section===s));const names={overview:'Vue générale',bot:'Robot Discord',guilds:'Serveurs',users:'Membres OMNIX',blacklist:'Blacklist',ai:'Intelligence IA',aiLogs:'Conversations IA',events:'Activité temps réel',analytics:'Analytics',partners:'Partenaires & Founder',support:'Support',payments:'Paiements',pricing:'Offres Premium',promos:'Codes promo',admins:'Staff & rôles',audit:'Audit',health:'Système',control:'Contrôle OMNIX'};const n=names[s]||s;$('crumb').textContent=n;$('pageTitle').textContent=s==='overview'?'Centre de contrôle':n;$('sidebar').classList.remove('open');loadSection(s)}
document.querySelectorAll('#nav button').forEach(b=>b.addEventListener('click',()=>openSection(b.dataset.section)));
async function loadOverview(){try{const d=await api('/api/admin/overview');const u=d.users||{},g=d.guilds||{},a=d.ai||{},rev=Array.isArray(d.payments?.revenue)?d.payments.revenue.reduce((x,y)=>x+Number(y.amount||0),0):0;$('heroStaff').textContent=d.user?.username||'Staff';$('staffName').textContent=d.user?.username||'Staff OMNIX';$('staffRole').textContent=d.user?.role||'staff';$('overviewCards').innerHTML=stat('Membres',fmt(u.total),`+${fmt(u.new)} sur la période`)+stat('Serveurs',fmt(g.total),`${fmt(g.members)} membres Discord`)+stat('Premium',fmt(u.premium),`${fmt(g.premium)} serveurs Premium`)+stat('Blacklist',fmt(u.blacklisted),'Comptes suspendus','bad')+stat('IA',fmt(a.requests),`${fmt(a.errors)} erreurs`)+stat('Revenus',rev.toFixed(2)+' €','Paiements validés')+stat('Canaux',fmt(g.channels),'Inventaire Discord')+stat('Uptime',formatUptime(d.system?.uptime),'Processus OMNIX');$('heroDot').className='dot '+(d.system?.discordReady&&d.system?.mongodb==='connected'?'':'bad');$('heroStatus').textContent=d.system?.discordReady?'Bot Discord opérationnel':'Services à vérifier';$('lastSync').textContent=date(new Date());$('serviceCards').innerHTML=[['Discord',d.system?.discordReady,d.system?.discordPing?d.system.discordPing+' ms':''],['MongoDB',d.system?.mongodb==='connected',d.system?.mongodb||''],['API',true,'Express'],['Node',true,process.version]].map(x=>`<div class="info-card"><b>${esc(x[0])}</b><p>${x[1]?'🟢 Opérationnel':'🔴 Indisponible'} ${esc(x[2])}</p></div>`).join('');await loadOverviewChart()}catch(e){toast(e.message)}}
function formatUptime(s){s=Number(s||0);const d=Math.floor(s/86400);s%=86400;const h=Math.floor(s/3600);s%=3600;const m=Math.floor(s/60);return `${d?d+'j ':''}${h}h ${m}m`}
async function loadOverviewChart(){try{const [u,g,a]=await Promise.all([api('/api/admin/statistics/users'),api('/api/admin/statistics/guilds'),api('/api/admin/statistics/ai')]);const labels=(u.data||[]).map(x=>x.date);if(charts.overview)charts.overview.destroy();charts.overview=new Chart($('overviewChart'),{type:'line',data:{labels,datasets:[{label:'Utilisateurs',data:(u.data||[]).map(x=>x.count),tension:.35},{label:'Serveurs',data:(g.data||[]).map(x=>x.count),tension:.35},{label:'IA',data:(a.data||[]).map(x=>x.requests),tension:.35}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#94a3b8',font:{size:9}}}},scales:{x:{ticks:{color:'#64748b',font:{size:8}},grid:{color:'rgba(148,163,184,.05)'}},y:{ticks:{color:'#64748b',font:{size:8}},grid:{color:'rgba(148,163,184,.05)'}}}}})}catch{}}
async function loadUsers(){try{const q=encodeURIComponent($('userSearch').value.trim()),d=await api('/api/admin/users?limit=100&search='+q);$('usersBody').innerHTML=(d.data||[]).map(u=>`<tr class="click" onclick="openUser('${esc(u.discordId)}')"><td><div class="user-cell"><img src="${esc(u.avatar||'/logo.png')}"><div><b>${esc(u.globalName||u.username)}</b><span class="sub">${esc(u.discordId)}</span></div></div></td><td><span class="badge violet">${esc(u.role||'user')}</span></td><td>${fmt((u.guilds||[]).length)}</td><td>${u.isPremium?'<span class="badge gold">★ Premium</span>':'<span class="badge">Free</span>'}</td><td>${u.isBlacklisted?'<span class="badge red">Blacklist</span>':'<span class="badge green">Actif</span>'}</td><td>${date(u.lastLogin)}</td><td>${date(u.createdAt)}</td></tr>`).join('')||`<tr><td colspan="7" class="empty">Aucun membre trouvé.</td></tr>`}catch(e){toast(e.message)}}
async function loadBlacklist(){try{const q=encodeURIComponent($('blacklistSearch').value.trim()),d=await api('/api/admin/blacklist/users?search='+q);$('blacklistCount').textContent=fmt(d.total)+' compte(s)';$('blacklistBody').innerHTML=(d.data||[]).map(u=>`<tr><td><div class="user-cell"><img src="${esc(u.avatar||'/logo.png')}"><div><b>${esc(u.globalName||u.username)}</b><span class="sub">${esc(u.discordId)}</span></div></div></td><td>${esc(u.role||'user')}</td><td>${esc(u.email||'—')}</td><td><span class="badge red">Suspendu</span></td><td>${date(u.updatedAt)}</td><td><button class="btn" onclick="unblacklist('${esc(u.discordId)}')">Réactiver</button></td></tr>`).join('')||`<tr><td colspan="6" class="empty">Blacklist vide.</td></tr>`}catch(e){toast(e.message)}}
async function unblacklist(id){if(!confirm('Réactiver ce compte ?'))return;try{await api('/api/admin/users/'+encodeURIComponent(id)+'/blacklist',{method:'PATCH',body:JSON.stringify({enabled:false})});toast('Compte réactivé.');await loadBlacklist();await loadUsers()}catch(e){toast(e.message)}}
async function openUser(id){try{const d=await api('/api/admin/users/'+encodeURIComponent(id)),u=d.user||{},a=d.ai||{};const guilds=(u.guilds||[]).map(g=>`<span class="chip">${esc(g.name)} · ${g.owner?'Owner':'Admin'}</span>`).join('')||'<span class="sub">Aucun serveur stocké</span>';const events=(d.events||[]).slice(0,20).map(e=>`<div class="kv"><span>${esc(e.type)}</span><span>${date(e.createdAt)} · ${esc(JSON.stringify(e.metadata||{}))}</span></div>`).join('')||'<div class="empty">Aucun événement.</div>';const payments=(d.payments||[]).slice(0,10).map(p=>`<div class="kv"><span>${esc(p.status||'—')}</span><span>${Number(p.amount||0).toFixed(2)} ${esc(p.currency||'EUR')} · ${date(p.createdAt)}</span></div>`).join('')||'<div class="empty">Aucun paiement.</div>';const licenses=(d.licenses||[]).slice(0,10).map(l=>`<div class="kv"><span>${esc(l.tier||'license')}</span><span>${esc(l.status||'—')} · expire ${date(l.expiresAt)}</span></div>`).join('')||'<div class="empty">Aucune licence.</div>';openModal('Dossier membre — '+(u.globalName||u.username),`<div class="detail-hero"><img class="detail-avatar" src="${esc(u.avatar||'/logo.png')}"><div><h3>${esc(u.globalName||u.username)}</h3><p>${esc(u.discordId)} · ${esc(u.email||'email non renseigné')}</p><div style="margin-top:7px">${u.isBlacklisted?'<span class="badge red">BLACKLIST</span>':'<span class="badge green">COMPTE ACTIF</span>'} ${u.isPremium?'<span class="badge gold">PREMIUM</span>':''} <span class="badge violet">${esc(u.role||'user')}</span></div></div></div><div class="detail-grid"><div class="detail-section"><h4>Identité & compte</h4><div class="kv"><span>Discord ID</span><span>${esc(u.discordId)}</span></div><div class="kv"><span>Username</span><span>${esc(u.username)}</span></div><div class="kv"><span>Global name</span><span>${esc(u.globalName||'—')}</span></div><div class="kv"><span>Email</span><span>${esc(u.email||'—')}</span></div><div class="kv"><span>Provider</span><span>${esc(u.authProvider||'discord')}</span></div><div class="kv"><span>Créé</span><span>${date(u.createdAt)}</span></div><div class="kv"><span>Dernière connexion</span><span>${date(u.lastLogin)}</span></div></div><div class="detail-section"><h4>Serveurs administrables</h4><div class="chip-list">${guilds}</div></div><div class="detail-section"><h4>Intelligence IA</h4><div class="kpi-row"><div class="mini"><span>Requêtes</span><strong>${fmt(a.requests)}</strong></div><div class="mini"><span>Erreurs</span><strong>${fmt(a.errors)}</strong></div><div class="mini"><span>Tokens</span><strong>${fmt(a.tokens)}</strong></div><div class="mini"><span>Sessions</span><strong>${fmt(a.sessions)}</strong></div></div></div><div class="detail-section"><h4>Licences</h4>${licenses}</div><div class="detail-section"><h4>Paiements</h4>${payments}</div><div class="detail-section"><h4>Historique plateforme</h4>${events}</div></div><div class="danger-zone" style="margin-top:12px"><b style="font-size:10px">Actions de sécurité</b><p style="color:#9d7d86;font-size:9px;line-height:1.7">Les tokens OAuth ne sont jamais affichés. La blacklist agit séparément du tableau membres.</p><button class="btn danger" onclick="toggleUserBlacklist('${esc(u.discordId)}',${!u.isBlacklisted})">${u.isBlacklisted?'Réactiver le compte':'Placer en blacklist'}</button></div>`)}catch(e){toast(e.message)}}
async function toggleUserBlacklist(id,enabled){const reason=enabled?(prompt('Motif de blacklist (optionnel)')||''):'';try{await api('/api/admin/users/'+encodeURIComponent(id)+'/blacklist',{method:'PATCH',body:JSON.stringify({enabled,reason})});toast(enabled?'Compte blacklisté.':'Compte réactivé.');closeModal();await loadUsers();await loadBlacklist()}catch(e){toast(e.message)}}
async function loadGuilds(){try{const q=encodeURIComponent($('guildSearch').value.trim()),d=await api('/api/admin/guilds?limit=100&search='+q);$('guildsBody').innerHTML=(d.data||[]).map(g=>`<tr class="click" onclick="openGuild('${esc(g.guildId)}')"><td><div class="user-cell"><img src="${esc(g.icon||'/logo.png')}"><div><b>${esc(g.name)}</b><span class="sub">${esc(g.guildId)}</span></div></div></td><td>${fmt(g.memberCount)}</td><td>${esc(g.ownerId||'—')}</td><td>${g.botPresent?'<span class="badge green">En ligne</span>':'<span class="badge">Absent</span>'}</td><td>${g.premium?.isPremium?'<span class="badge gold">Premium</span>':'<span class="badge">Free</span>'}</td><td>${g.blacklisted?'<span class="badge red">Blacklist</span>':'<span class="badge green">OK</span>'}</td></tr>`).join('')||`<tr><td colspan="6" class="empty">Aucun serveur trouvé.</td></tr>`}catch(e){toast(e.message)}}
async function openGuild(id){try{const d=await api('/api/admin/guilds/'+encodeURIComponent(id)),g=d.guild||{},a=d.ai||{};const modules=g.modules||{};const moduleChips=Object.entries(modules).map(([k,v])=>`<span class="chip">${esc(k)} · ${v?.enabled?'ON':'OFF'}</span>`).join('')||'<span class="sub">Aucun module</span>';const roles=(g.roles||[]).slice(0,80).map(r=>`<span class="chip">${esc(r.name)} · ${esc(r.id)}</span>`).join('');const channels=(g.channels||[]).slice(0,80).map(c=>`<div class="kv"><span># ${esc(c.name)}</span><span>${esc(c.type)} · ${esc(c.id)}</span></div>`).join('');const members=(g.membersSnapshot||[]).slice(0,50).map(m=>`<div class="kv"><span>${esc(m.displayName||m.username)} ${m.owner?'★':''}</span><span>${esc(m.id)} · ${m.administrator?'Administrator':''}</span></div>`).join('');const events=(d.events||[]).slice(0,20).map(e=>`<div class="kv"><span>${esc(e.type)}</span><span>${date(e.createdAt)}</span></div>`).join('');openModal('Dossier serveur — '+(g.name||id),`<div class="detail-hero"><img class="detail-avatar" src="${esc(g.icon||'/logo.png')}"><div><h3>${esc(g.name||'Serveur Discord')}</h3><p>${esc(g.guildId)} · propriétaire ${esc(g.ownerId||'—')}</p><div style="margin-top:7px">${g.botPresent?'<span class="badge green">OMNIX PRÉSENT</span>':'<span class="badge red">OMNIX ABSENT</span>'} ${g.blacklisted?'<span class="badge red">BLACKLIST</span>':''} ${g.premium?.isPremium?'<span class="badge gold">PREMIUM</span>':'<span class="badge">FREE</span>'}</div></div></div><div class="detail-grid"><div class="detail-section"><h4>Identité Discord</h4><div class="kv"><span>ID</span><span>${esc(g.guildId)}</span></div><div class="kv"><span>Nom</span><span>${esc(g.name)}</span></div><div class="kv"><span>Description</span><span>${esc(g.description||'—')}</span></div><div class="kv"><span>Owner ID</span><span>${esc(g.ownerId||'—')}</span></div><div class="kv"><span>Owner tag</span><span>${esc(g.verification?.ownerTag||'—')}</span></div><div class="kv"><span>Boost</span><span>Niveau ${esc(g.verification?.boostLevel||'—')} · ${fmt(g.verification?.boosts)} boosts</span></div><div class="kv"><span>Vanity URL</span><span>${esc(g.verification?.vanityUrl||'—')}</span></div></div><div class="detail-section"><h4>Statistiques</h4><div class="kpi-row"><div class="mini"><span>Membres</span><strong>${fmt(g.memberCount)}</strong></div><div class="mini"><span>Salons</span><strong>${fmt((g.channels||[]).length)}</strong></div><div class="mini"><span>Rôles</span><strong>${fmt((g.roles||[]).length)}</strong></div><div class="mini"><span>IA</span><strong>${fmt(a.requests)}</strong></div></div><div style="margin-top:10px" class="chip-list">${moduleChips}</div></div><div class="detail-section"><h4>Rôles</h4><div class="chip-list">${roles||'<span class="sub">Aucun rôle chargé</span>'}</div></div><div class="detail-section"><h4>Salons</h4>${channels||'<div class="empty">Aucun salon chargé.</div>'}</div><div class="detail-section"><h4>Membres visibles dans le cache</h4>${members||'<div class="empty">Aucun membre en cache.</div>'}</div><div class="detail-section"><h4>Événements récents</h4>${events||'<div class="empty">Aucun événement.</div>'}</div></div>`)}catch(e){toast(e.message)}}
async function loadBot(){try{const d=await api('/api/admin/bot/details'),b=d.bot||{};$('botCards').innerHTML=stat('État',b.ready?'ONLINE':'OFFLINE',b.ready?'Discord connecté':'Discord déconnecté')+stat('Serveurs',fmt(b.guilds),`${fmt(b.members)} membres`)+stat('Commandes',fmt(b.commands),'Chargées')+stat('Ping',b.ping==null?'—':b.ping+' ms','Gateway')+stat('Salons',fmt(b.channels),'Cache Discord')+stat('Rôles',fmt(b.roles),'Cache Discord');$('botDetails').innerHTML=`<div class="detail-grid"><div class="detail-section"><h4>Identité du bot</h4><div class="kv"><span>Tag</span><span>${esc(b.tag||'—')}</span></div><div class="kv"><span>ID</span><span>${esc(b.id||'—')}</span></div><div class="kv"><span>Node</span><span>${esc(b.node||'—')}</span></div><div class="kv"><span>Plateforme</span><span>${esc(b.platform||'—')} / ${esc(b.architecture||'—')}</span></div><div class="kv"><span>Uptime</span><span>${formatUptime(b.uptime)}</span></div></div><div class="detail-section"><h4>Ressources</h4><div class="kv"><span>RSS</span><span>${Math.round(Number(b.memory?.rss||0)/1048576)} MiB</span></div><div class="kv"><span>Heap utilisé</span><span>${Math.round(Number(b.memory?.heapUsed||0)/1048576)} MiB</span></div><div class="kv"><span>Utilisateurs cache</span><span>${fmt(b.cachedUsers)}</span></div></div></div>`}catch(e){toast(e.message)}}
async function loadAi(){try{const d=await api('/api/admin/ai-summary');$('aiCards').innerHTML=stat('Requêtes',fmt(d.requests||0))+stat('Erreurs',fmt(d.errors||0))+stat('Tokens',fmt(d.tokens||0))+stat('Utilisateurs',fmt(d.users||0))+stat('Serveurs',fmt(d.guilds||0))+stat('Sessions',fmt(d.sessions||0))}catch(e){toast(e.message)}}
async function loadConversations(){try{const d=await api('/api/admin/ai-conversations');$('aiConversationsBody').innerHTML=(d.data||[]).map(x=>`<tr class="click" onclick="openConversation('${esc(x.sessionId)}')"><td><b>${esc(x.username||x.userId)}</b><span class="sub">${esc(x.userId||'—')}</span></td><td>${esc(x.guildName||x.guildId||'—')}</td><td>${fmt(x.requests)}</td><td>${fmt(x.errors)}</td><td>${date(x.createdAt)}</td><td>${date(x.updatedAt)}</td></tr>`).join('')||`<tr><td colspan="6" class="empty">Aucune conversation.</td></tr>`}catch(e){toast(e.message)}}
async function openConversation(id){try{const d=await api('/api/admin/ai-conversations/'+encodeURIComponent(id));openModal('Conversation IA',`<div class="detail-section">${(d.data||[]).map(x=>`<div style="padding:10px 0;border-bottom:1px solid var(--line)"><b style="font-size:10px">${esc(x.username||x.userId||'Utilisateur')}</b><span class="sub">${date(x.createdAt)} · ${esc(x.model||'modèle inconnu')}</span><p style="white-space:pre-wrap;color:#9aa7bb;font-size:9px;line-height:1.7">${esc(x.prompt||x.message||x.content||'')}</p><p style="white-space:pre-wrap;color:#d8deeb;font-size:9px;line-height:1.7">${esc(x.response||x.output||'')}</p></div>`).join('')||'<div class="empty">Session vide.</div>'}</div>`)}catch(e){toast(e.message)}}
async function loadEvents(){try{const d=await api('/api/admin/events?limit=100');$('eventsBody').innerHTML=(d.data||[]).map(x=>`<tr><td><span class="badge violet">${esc(x.type)}</span></td><td>${esc(x.userId||'—')}</td><td>${esc(x.guildId||'—')}</td><td><span class="sub">${esc(JSON.stringify(x.metadata||{}).slice(0,220))}</span></td><td>${date(x.createdAt)}</td></tr>`).join('')||`<tr><td colspan="5" class="empty">Aucun événement.</td></tr>`}catch(e){toast(e.message)}}
async function loadAnalytics(){try{const d=await api('/api/admin/analytics');$('analyticsCards').innerHTML=stat('Utilisateurs',fmt(d.totalUsers))+stat('Serveurs',fmt(d.totalGuilds))+stat('Requêtes IA',fmt(d.totalAiRequests))+stat('Tokens',fmt(d.totalAiTokens))+stat('Erreurs IA',fmt(d.aiErrors));$('analyticsBody').innerHTML=(d.events||[]).map(x=>`<div class="kv"><span>${esc(x._id)}</span><span>${fmt(x.count)} événement(s)</span></div>`).join('')||'<div class="empty">Aucune donnée.</div>'}catch(e){toast(e.message)}}
let editingPartner=null;
function resetPartnerForm(){editingPartner=null;['partnerId','partnerTitle','partnerImage','partnerDescription','partnerDiscord','founderName','founderDiscordId','founderRole','founderNote','adTitle','adUrl','adText','adImage','adButtonText','adExpiresAt'].forEach(id=>{if($(id))$(id).value=''});$('partnerFeatured').checked=false;$('adEnabled').checked=false;$('partnerFormTitle').textContent='Créer un partenaire';['partnerImagePreview','adImagePreview'].forEach(id=>{if($(id)){ $(id).src=''; $(id).hidden=true; }});}
async function loadPartners(){try{const d=await api('/api/partners/admin');$('partnersList').innerHTML=(d.data||[]).map(p=>`<div class="info-card" style="margin-bottom:8px"><div style="display:flex;justify-content:space-between;gap:10px"><div><b>${esc(p.title)}</b><p>${p.featured?'★ Mis en avant · ':''}${p.adEnabled?'📣 Publicité active · ':''}${p.founderName?'♛ '+esc(p.founderName):'Aucun Founder renseigné'}</p></div><div style="display:flex;gap:5px"><button class="btn" onclick='editPartner(${JSON.stringify(p).replace(/'/g,"&#39;")})'>Modifier</button><button class="btn danger" onclick="deletePartner('${esc(p._id)}')">Supprimer</button></div></div></div>`).join('')||'<div class="empty">Aucun partenaire.</div>'}catch(e){toast(e.message)}}
function editPartner(p){editingPartner=p;$('partnerFormTitle').textContent='Modifier — '+p.title;const vals={partnerId:p._id,partnerTitle:p.title,partnerDescription:p.description,partnerDiscord:p.discordUrl,founderName:p.founderName||'',founderDiscordId:p.founderDiscordId||'',founderRole:p.founderRole||'',founderNote:p.founderNote||'',adTitle:p.adTitle||'',adUrl:p.adUrl||'',adText:p.adText||'',adButtonText:p.adButtonText||'',adExpiresAt:p.adExpiresAt?new Date(p.adExpiresAt).toISOString().slice(0,16):''};Object.entries(vals).forEach(([k,v])=>$(k).value=v);$('partnerFeatured').checked=!!p.featured;$('adEnabled').checked=!!p.adEnabled;if(p.imageData||p.imageUrl){$('partnerImagePreview').src=p.imageData||p.imageUrl;$('partnerImagePreview').hidden=false}else{$('partnerImagePreview').hidden=true}if(p.adImageData||p.adImageUrl){$('adImagePreview').src=p.adImageData||p.adImageUrl;$('adImagePreview').hidden=false}else{$('adImagePreview').hidden=true}}
function imageToDataUrl(file,maxW=1600,maxH=900,quality=.82){return new Promise((resolve,reject)=>{if(!file)return resolve('');if(!/^image\/(?:png|jpe?g|webp|gif)$/i.test(file.type))return reject(new Error('Format image non pris en charge.'));const reader=new FileReader();reader.onerror=()=>reject(new Error('Impossible de lire l’image.'));reader.onload=()=>{const img=new Image();img.onerror=()=>reject(new Error('Image invalide.'));img.onload=()=>{const scale=Math.min(1,maxW/img.width,maxH/img.height);const w=Math.max(1,Math.round(img.width*scale)),h=Math.max(1,Math.round(img.height*scale));const c=document.createElement('canvas');c.width=w;c.height=h;const ctx=c.getContext('2d');if(!ctx)return reject(new Error('Préparation de l’image impossible.'));ctx.drawImage(img,0,0,w,h);const out=c.toDataURL('image/webp',quality);if(out.length>4400000)return reject(new Error('Image trop volumineuse après compression.'));resolve(out)}};reader.readAsDataURL(file)})}
async function preparePartnerImage(input,preview){if(!input.files?.[0])return '';const data=await imageToDataUrl(input.files[0]);$(preview).src=data;$(preview).hidden=false;return data}
async function savePartner(){try{const body={title:$('partnerTitle').value.trim(),description:$('partnerDescription').value.trim(),discordUrl:$('partnerDiscord').value.trim(),featured:$('partnerFeatured').checked,founderName:$('founderName').value.trim(),founderDiscordId:$('founderDiscordId').value.trim(),founderRole:$('founderRole').value.trim(),founderNote:$('founderNote').value.trim(),adEnabled:$('adEnabled').checked,adTitle:$('adTitle').value.trim(),adUrl:$('adUrl').value.trim(),adText:$('adText').value.trim(),adButtonText:$('adButtonText').value.trim(),adExpiresAt:$('adExpiresAt').value||null};if($('partnerImage').files?.[0])body.imageData=await preparePartnerImage($('partnerImage'),'partnerImagePreview');if($('adImage').files?.[0])body.adImageData=await preparePartnerImage($('adImage'),'adImagePreview');if(!editingPartner&&!body.imageData)throw new Error('Sélectionnez l’image principale depuis votre appareil.');if(editingPartner&&body.imageData===undefined)delete body.imageData;if(!body.adEnabled)delete body.adImageData;if(editingPartner)await api('/api/partners/admin/'+encodeURIComponent(editingPartner._id),{method:'PATCH',body:JSON.stringify(body)});else await api('/api/partners/admin',{method:'POST',body:JSON.stringify(body)});toast('Partenaire enregistré.');resetPartnerForm();await loadPartners()}catch(e){toast(e.message)}}
async function deletePartner(id){if(!confirm('Supprimer ce partenaire ?'))return;try{await api('/api/partners/admin/'+encodeURIComponent(id),{method:'DELETE'});toast('Partenaire supprimé.');await loadPartners()}catch(e){toast(e.message)}}
async function loadSupport(){try{const d=await api('/api/support/tickets');$('supportList').innerHTML=(d.data||[]).map(t=>`<div class="info-card click" style="margin-bottom:8px" onclick="openSupport(${Number(t.ticketNumber)})"><b>#${fmt(t.ticketNumber)} · ${esc(t.subject)}</b><p>${esc(t.username)} · ${date(t.updatedAt)} · ${esc(t.status)}</p></div>`).join('')||'<div class="empty">Aucun ticket.</div>'}catch(e){toast(e.message)}}
async function openSupport(id){try{const d=await api('/api/support/tickets/'+id),t=d.data;$('supportTitle').textContent='#'+t.ticketNumber+' · '+t.subject;$('supportViewer').innerHTML=(t.messages||[]).map(m=>`<div style="padding:10px 0;border-bottom:1px solid var(--line)"><b style="font-size:10px">${esc(m.authorName)}</b><span class="sub">${esc(m.authorRole)} · ${date(m.createdAt)}</span><p style="white-space:pre-wrap;color:#a5b0c2;font-size:9px;line-height:1.7">${esc(m.content)}</p></div>`).join('')||'<div class="empty">Aucun message.</div>'}catch(e){toast(e.message)}}
async function loadPayments(){try{const d=await api('/api/admin/payments?limit=100');$('paymentsBody').innerHTML=(d.data||[]).map(p=>`<tr><td>${esc(p.userId||'—')}</td><td><b>${Number(p.amount||0).toFixed(2)} ${esc(p.currency||'EUR')}</b></td><td>${esc(p.status||'—')}</td><td>${esc(p.reference||p.paymentId||p._id||'—')}</td><td>${date(p.createdAt)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">Aucun paiement.</td></tr>'}catch(e){toast(e.message)}}
async function loadPricing(){try{const d=await api('/api/admin/pricing?includeInactive=true');$('pricingBody').innerHTML=(d.data||[]).map(x=>`<tr><td><b>${esc(x.name)}</b><span class="sub">${esc(x.description||'')}</span></td><td>${Number(x.price||0).toFixed(2)} ${esc(x.currency||'EUR')}</td><td>${esc(x.durationLabel||x.duration||((x.durationDays||0)+' jours'))}</td><td>${x.active?'<span class="badge green">Actif</span>':'<span class="badge">Inactif</span>'}</td><td><button class="btn" onclick="togglePricing('${esc(x._id)}',${!x.active})">${x.active?'Désactiver':'Activer'}</button></td></tr>`).join('')||'<tr><td colspan="5" class="empty">Aucune offre.</td></tr>'}catch(e){toast(e.message)}}
async function seedPricing(){try{await api('/api/admin/pricing/seed',{method:'POST'});toast('Offres initialisées.');await loadPricing()}catch(e){toast(e.message)}}
async function togglePricing(id,active){try{await api('/api/admin/pricing/'+encodeURIComponent(id),{method:'PATCH',body:JSON.stringify({active})});await loadPricing()}catch(e){toast(e.message)}}
async function createPromo(){try{await api('/api/admin/promos',{method:'POST',body:JSON.stringify({code:$('promoCode').value,discountType:$('promoType').value,discountValue:Number($('promoValue').value),maxUses:Number($('promoMax').value||0),expiresAt:$('promoExpire').value})});toast('Code promo créé.');await loadPromos()}catch(e){toast(e.message)}}
async function loadPromos(){try{const d=await api('/api/admin/promos');$('promoBody').innerHTML=(d.data||[]).map(x=>`<tr><td><code>${esc(x.code)}</code></td><td>${x.discountType==='percentage'?x.discountValue+'%':Number(x.discountValue||0).toFixed(2)+' €'}</td><td>${fmt(x.usesCount)}/${x.maxUses?fmt(x.maxUses):'∞'}</td><td>${date(x.expiresAt)}</td><td>${x.isActive?'<span class="badge green">Actif</span>':'<span class="badge">Inactif</span>'}</td><td><button class="btn danger" onclick="deletePromo('${esc(x.code)}')">Supprimer</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">Aucun code.</td></tr>'}catch(e){toast(e.message)}}
async function deletePromo(code){if(!confirm('Supprimer ce code promo ?'))return;try{await api('/api/admin/promos/'+encodeURIComponent(code),{method:'DELETE'});await loadPromos()}catch(e){toast(e.message)}}
async function loadStaff(){try{const d=await api('/api/admin/staff');$('staffBody').innerHTML=(d.data||[]).map(x=>`<tr><td><div class="user-cell"><img src="${esc(x.avatar||'/logo.png')}"><div><b>${esc(x.globalName||x.username)}</b><span class="sub">${esc(x.discordId)}</span></div></div></td><td><select class="select" onchange="changeRole('${esc(x.discordId)}',this.value)">${['user','support','moderator','admin','super_admin','owner'].map(r=>`<option ${r===x.role?'selected':''}>${r}</option>`).join('')}</select></td><td>${esc((x.permissions||[]).join(', ')||'Permissions par rôle')}</td><td>${x.isPremium?'★':'—'}</td><td>${date(x.lastLogin)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">Aucun staff.</td></tr>'}catch(e){toast(e.message)}}
async function changeRole(id,role){try{await api('/api/admin/users/'+encodeURIComponent(id)+'/role',{method:'PATCH',body:JSON.stringify({role})});toast('Rôle mis à jour.');await loadStaff()}catch(e){toast(e.message)}}
async function loadAudit(){try{const q=new URLSearchParams();if($('auditSearch').value)q.set('search',$('auditSearch').value);if($('auditAction').value)q.set('action',$('auditAction').value);const d=await api('/api/admin/audit-logs?limit=100&'+q.toString());$('auditBody').innerHTML=(d.data||[]).map(x=>`<tr><td>${esc(x.staffUsername||x.staffId)}</td><td>${esc(x.action)}</td><td>${esc(x.category)}</td><td>${esc(x.targetName||x.targetId||'—')}</td><td>${esc(x.description||'')}</td><td>${date(x.createdAt)}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">Aucun journal.</td></tr>'}catch(e){toast(e.message)}}
async function loadControl(){try{const d=await api('/api/admin/control'),x=d.data||{};$('activityEnabled').checked=x.activityEnabled!==false;$('activityType').value=x.activityType||'Playing';$('activityMessage').value=x.activityMessage||'';$('botStatus').value=x.botStatus||'online';$('maintenanceEnabled').checked=Boolean(x.maintenance);$('maintenanceMessage').value=x.maintenanceMessage||'';$('maintenanceState').textContent=x.maintenance?'⚠️ Maintenance active':'🟢 Maintenance désactivée'}catch(e){toast(e.message)}}
async function saveBotActivity(){try{await api('/api/admin/control/activity',{method:'PATCH',body:JSON.stringify({activityEnabled:$('activityEnabled').checked,activityType:$('activityType').value,activityMessage:$('activityMessage').value,botStatus:$('botStatus').value})});toast('Activité du robot mise à jour.')}catch(e){toast(e.message)}}
async function saveMaintenance(){try{const d=await api('/api/admin/control/maintenance',{method:'PATCH',body:JSON.stringify({enabled:$('maintenanceEnabled').checked,message:$('maintenanceMessage').value})});$('maintenanceState').textContent=d.data?.maintenance?'⚠️ Maintenance active':'🟢 Maintenance désactivée';toast(d.data?.maintenance?'Mode maintenance activé.':'Mode maintenance désactivé.')}catch(e){toast(e.message)}}
async function loadHealth(){try{const d=await api('/api/admin/health/full'),s=d.services||{},m=d.system?.memory||{};$('healthCards').innerHTML=stat('Application',s.api?'ONLINE':'OFFLINE')+stat('Discord',s.discord?'CONNECTÉ':'HORS LIGNE')+stat('MongoDB',s.mongodb?'CONNECTÉ':'HORS LIGNE')+stat('RAM',Math.round(Number(m.rss||0)/1048576)+' MiB')+stat('Node',d.system?.node||'—')+stat('Uptime',formatUptime(d.system?.uptime));$('healthServices').innerHTML=Object.entries({Stripe:s.stripe,email:s.email}).map(([k,v])=>`<div class="info-card" style="margin-bottom:8px"><b>${esc(k)}</b><p>${v?'🟢 Configuré':'🔴 Non configuré'}</p></div>`).join('')}catch(e){toast(e.message)}}
document.getElementById('partnerImage')?.addEventListener('change',()=>{if(document.getElementById('partnerImage').files?.[0])preparePartnerImage(document.getElementById('partnerImage'),'partnerImagePreview').catch(e=>toast(e.message))});document.getElementById('adImage')?.addEventListener('change',()=>{if(document.getElementById('adImage').files?.[0])preparePartnerImage(document.getElementById('adImage'),'adImagePreview').catch(e=>toast(e.message))});
function loadSection(s){return ({overview:loadOverview,users:loadUsers,blacklist:loadBlacklist,guilds:loadGuilds,bot:loadBot,ai:loadAi,aiLogs:loadConversations,events:loadEvents,analytics:loadAnalytics,partners:loadPartners,support:loadSupport,payments:loadPayments,pricing:loadPricing,promos:loadPromos,admins:loadStaff,audit:loadAudit,health:loadHealth,control:loadControl})[s]?.()}
async function refreshCurrent(){await loadSection(state.section);toast('Données actualisées.')} 
$('modal').addEventListener('click',e=>{if(e.target===$('modal'))closeModal()});
loadOverview();
</script>
