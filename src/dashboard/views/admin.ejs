            log.discordUsername ||
            log.ownerId ||
            "Utilisateur";

          const guildId =
            log.guildId ||
            log.guild?.id ||
            "—";

          const source =
            String(
              log.source ||
              "unknown"
            ).toLowerCase();

          const status =
            String(
              log.status ||
              (
                log.error
                  ? "error"
                  : "success"
              )
            ).toLowerCase();

          const prompt =
            log.prompt ||
            log.message ||
            log.input ||
            log.question ||
            "—";

          const tokens =
            Number(
              log.tokens ??
              log.totalTokens ??
              log.usage?.total_tokens ??
              0
            );

          return `
            <tr>

              <td>

                <div class="user-cell">

                  <div class="avatar">
                    ${escapeHtml(
                      getInitials(
                        username
                      )
                    )}
                  </div>

                  <div>

                    <div class="user-name">
                      ${escapeHtml(
                        username
                      )}
                    </div>

                    <div class="user-id">
                      ${escapeHtml(
                        log.userId ||
                        log.discordId ||
                        log.ownerId ||
                        "ID inconnu"
                      )}
                    </div>

                  </div>

                </div>

              </td>

              <td>

                ${
                  source === "discord"

                    ? `
                      <span class="badge badge-violet">
                        DISCORD
                      </span>
                    `

                    : source === "website"

                      ? `
                        <span class="badge badge-blue">
                          SITE
                        </span>
                      `

                      : `
                        <span class="badge badge-gray">
                          ${escapeHtml(
                            source
                          )}
                        </span>
                      `
                }

              </td>

              <td>
                ${escapeHtml(
                  guildId
                )}
              </td>

              <td
                title="${escapeHtml(
                  prompt
                )}"
                style="
                  max-width:300px;
                  overflow:hidden;
                  text-overflow:ellipsis;
                  white-space:nowrap;
                "
              >
                ${escapeHtml(
                  prompt
                )}
              </td>

              <td>
                ${formatNumber(
                  tokens
                )}
              </td>

              <td>

                ${
                  status === "success"

                    ? `
                      <span class="badge badge-green">
                        SUCCÈS
                      </span>
                    `

                    : `
                      <span class="badge badge-red">
                        ERREUR
                      </span>
                    `
                }

              </td>

              <td>
                ${formatDate(
                  log.createdAt ||
                  log.timestamp ||
                  log.date
                )}
              </td>

            </tr>
          `;

        }).join("")}

      </tbody>

    </table>

    ${renderPagination(
      data?.pagination,
      "aiLogs"
    )}
  `;
}

/* =========================================================
   HEALTH
========================================================= */

async function loadHealth() {

  setText(
    "healthStatus",
    "..."
  );

  setText(
    "healthMongo",
    "..."
  );

  setText(
    "healthMemory",
    "..."
  );

  setText(
    "healthNode",
    "..."
  );

  setText(
    "healthUptime",
    "Vérification..."
  );

  setText(
    "healthMongoState",
    "..."
  );

  setText(
    "healthPlatform",
    "..."
  );

  const raw =
    document.getElementById(
      "healthRaw"
    );

  if (raw) {
    raw.textContent =
      "Vérification de l'infrastructure...";
  }

  try {

    const data =
      await adminFetch(
        ADMIN_ROUTES.health
      );

    renderHealth(
      data
    );

  } catch (error) {

    console.error(
      "[OMNIX ADMIN] Health:",
      error
    );

    setText(
      "healthStatus",
      "ERREUR"
    );

    setText(
      "healthMongo",
      "INCONNU"
    );

    setText(
      "healthMemory",
      "—"
    );

    setText(
      "healthNode",
      "—"
    );

    setText(
      "healthUptime",
      "Impossible de vérifier"
    );

    setText(
      "healthMongoState",
      error.message
    );

    if (raw) {
      raw.textContent =
        JSON.stringify(
          {
            error:
              error.message
          },
          null,
          2
        );
    }
  }
}

/* =========================================================
   RENDER HEALTH
========================================================= */

function renderHealth(
  data
) {

  const application =
    data?.application ||
    data?.app ||
    {};

  const mongo =
    data?.mongodb ||
    data?.mongo ||
    data?.database ||
    {};

  const memory =
    data?.memory ||
    data?.process?.memory ||
    {};

  const node =
    data?.node ||
    {};

  const status =
    data?.status ||
    application?.status ||
    "unknown";

  const uptime =
    data?.uptime ??
    application?.uptime ??
    0;

  const mongoStatus =
    mongo?.status ||
    mongo?.state ||
    (
      mongo?.connected === true
        ? "connected"
        : "unknown"
    );

  const heapUsed =
    memory?.heapUsed ??
    memory?.heapUsedBytes ??
    memory?.rss ??
    0;

  const nodeVersion =
    data?.nodeVersion ||
    node?.version ||
    "—";

  const platform =
    data?.platform ||
    node?.platform ||
    navigator.platform ||
    "—";

  setText(
    "healthStatus",
    String(
      status
    ).toUpperCase()
  );

  setText(
    "healthUptime",
    formatUptime(
      uptime
    )
  );

  setText(
    "healthMongo",
    String(
      mongoStatus
    ).toUpperCase()
  );

  setText(
    "healthMongoState",
    mongo?.message ||
    mongo?.details ||
    "État de la connexion MongoDB"
  );

  setText(
    "healthMemory",
    formatBytes(
      heapUsed
    )
  );

  setText(
    "healthNode",
    nodeVersion
  );

  setText(
    "healthPlatform",
    platform
  );

  const raw =
    document.getElementById(
      "healthRaw"
    );

  if (raw) {

    raw.textContent =
      JSON.stringify(
        data,
        null,
        2
      );
  }
}

/* =========================================================
   GUILD DETAIL
========================================================= */

/*
 * La PARTIE 1 appelle openGuildDetail().
 *
 * On ne fait pas ici un appel vers une route non déclarée
 * dans les routes Admin déjà présentes.
 *
 * La fonction affiche les informations disponibles et
 * prépare le point d'extension pour une route de détail
 * lorsque celle-ci existe côté backend.
 */

function openGuildDetail(
  guildId
) {

  if (!guildId) {
    return;
  }

  const encoded =
    encodeURIComponent(
      guildId
    );

  const url =
    `/api/admin/guilds?search=${encoded}&page=1&limit=1`;

  adminFetch(
    url
  )
    .then(
      data => {

        const guild =
          Array.isArray(
            data?.data
          )
            ? data.data[0]
            : null;

        if (!guild) {

          alert(
            "Serveur introuvable."
          );

          return;
        }

        showGuildDetailModal(
          guild
        );
      }
    )
    .catch(
      error => {

        console.error(
          "[OMNIX ADMIN] Guild detail:",
          error
        );

        alert(
          error.message ||
          "Impossible de charger le serveur."
        );
      }
    );
}

