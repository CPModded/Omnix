<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OMNIX — Admin</title><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script><style>
:root{--bg:#070b14;--panel:#0d1422;--panel2:#111a2b;--line:rgba(255,255,255,.08);--text:#eef2ff;--muted:#8fa0b8;--pri:#7c5cff;--ok:#10b981;--warn:#f59e0b;--bad:#ef4444}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 10% 10%,rgba(124,92,255,.12),transparent 30%),var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.wrap{display:block;min-height:100vh}.admin-menu-toggle{position:fixed;top:16px;right:16px;z-index:1300}.admin-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1190}.admin-overlay.open{display:block}.side{border-left:1px solid var(--line);background:rgba(7,11,20,.98);padding:16px;position:fixed;top:0;right:0;height:100vh;width:min(340px,92vw);overflow:auto;z-index:1200;transform:translateX(105%);transition:transform .25s ease}.side.open{transform:translateX(0)}.brand{font-weight:900;font-size:19px;padding:12px 10px 20px}.nav{display:flex;flex-direction:column;gap:6px}.nav button{width:100%;text-align:left;background:transparent;color:var(--muted);border:1px solid transparent;border-radius:11px;padding:11px;cursor:pointer}.nav button:hover,.nav button.active{color:#fff;background:rgba(124,92,255,.12);border-color:rgba(124,92,255,.18)}.main{padding:72px 24px 24px;max-width:1600px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.top h1{margin:0;font-size:24px}.top small{color:var(--muted)}.section{display:none}.section.active{display:block}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.card{background:linear-gradient(145deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:16px;padding:16px}.card strong{font-size:24px;display:block;margin-top:7px}.muted{color:var(--muted);font-size:12px}.toolbar{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.input,.select,.textarea{background:#0a111e;color:#fff;border:1px solid var(--line);border-radius:10px;padding:10px}.input{min-width:220px}.btn{background:var(--pri);color:#fff;border:0;border-radius:10px;padding:10px 14px;cursor:pointer;font-weight:700}.btn.secondary{background:#172235}.btn.danger{background:#b91c1c}.table{width:100%;border-collapse:collapse;background:rgba(10,17,30,.72);border:1px solid var(--line);border-radius:14px;overflow:hidden}.table th,.table td{padding:11px;border-bottom:1px solid var(--line);text-align:left;font-size:12px;vertical-align:top}.table th{color:#aab8cc}.click{cursor:pointer}.click:hover{background:rgba(124,92,255,.06)}.chart{height:310px}.split{display:grid;grid-template-columns:1.2fr .8fr;gap:12px}.modal{position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;align-items:center;justify-content:center;padding:18px;z-index:100}.modal.open{display:flex}.modal-box{width:min(900px,100%);max-height:90vh;overflow:auto;background:#0b1321;border:1px solid var(--line);border-radius:18px;padding:18px}.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{padding:5px 8px;border-radius:999px;background:#162238;color:#cbd5e1;font-size:11px}.row{display:flex;justify-content:space-between;gap:10px;align-items:center}.ok{color:#6ee7b7}.bad{color:#fca5a5}.warn{color:#fcd34d}@media(max-width:900px){.split{grid-template-columns:1fr}}
</style></head><body><div class="wrap"><button id="adminMenuToggle" class="btn secondary admin-menu-toggle">☰ Menu</button><div id="adminOverlay" class="admin-overlay"></div><aside class="side" id="adminSide"><div class="brand">👑 OMNIX ADMIN <button id="adminMenuClose" class="btn secondary">×</button></div><nav class="nav" id="nav"></nav></aside><main class="main"><div class="top"><div><h1 id="title">Vue générale</h1><small id="staff">Session Staff — chargement…</small></div><button class="btn secondary" onclick="refreshCurrent()">↻ Actualiser</button></div><div id="sections">
<section id="s-overview" class="section active"><div class="grid" id="overviewCards"></div><div class="split" style="margin-top:12px"><div class="card"><h3>Inscriptions</h3><canvas id="usersChart" class="chart"></canvas></div><div class="card"><h3>Nouveaux serveurs</h3><canvas id="guildChart" class="chart"></canvas></div></div><div class="card" style="margin-top:12px"><h3>Activité IA</h3><canvas id="aiChart" class="chart"></canvas></div></section>
<section id="s-users" class="section"><div class="toolbar"><input id="userSearch" class="input" placeholder="Discord ID, pseudo, email"><button class="btn" onclick="loadUsers()">Rechercher</button></div><div class="card"><table class="table"><thead><tr><th>Utilisateur</th><th>Email</th><th>Rôle</th><th>Premium</th><th>Inscrit</th></tr></thead><tbody id="usersBody"></tbody></table></div></section>
<section id="s-guilds" class="section"><div class="toolbar"><input id="guildSearch" class="input" placeholder="Nom ou ID serveur"><button class="btn" onclick="loadGuilds()">Rechercher</button></div><div class="card"><table class="table"><thead><tr><th>Serveur</th><th>ID</th><th>Membres</th><th>Propriétaire</th><th>État</th></tr></thead><tbody id="guildsBody"></tbody></table></div></section>
<section id="s-ai" class="section"><div class="grid" id="aiCards"></div><div class="split" style="margin-top:12px"><div class="card"><h3>Réussites</h3><canvas id="aiSuccessChart" class="chart"></canvas></div><div class="card"><h3>Erreurs</h3><canvas id="aiErrorChart" class="chart"></canvas></div></div></section>
<section id="s-aiLogs" class="section"><div class="card"><table class="table"><thead><tr><th>Personne</th><th>Serveur</th><th>Requêtes</th><th>Erreurs</th><th>Dernière activité</th></tr></thead><tbody id="aiConversationsBody"></tbody></table></div></section>
<section id="s-bot" class="section"><div class="grid" id="botCards"></div><div class="card" style="margin-top:12px" id="botDetails"></div></section>
<section id="s-payments" class="section"><div class="grid" id="paymentCards"></div><div class="card" style="margin-top:12px"><table class="table"><thead><tr><th>Utilisateur</th><th>Montant</th><th>Statut</th><th>Offre</th><th>Date</th></tr></thead><tbody id="paymentsBody"></tbody></table></div></section>
<section id="s-emails" class="section"><div class="grid" id="emailCards"></div><div class="card" style="margin-top:12px"><h3>Nouveau message</h3><div class="toolbar"><input id="mailTo" class="input" placeholder="Destinataire(s), séparés par des virgules"><input id="mailSubject" class="input" placeholder="Objet"></div><textarea id="mailText" class="textarea" style="width:100%;min-height:180px" placeholder="Votre message…"></textarea><div class="toolbar"><input id="mailFiles" type="file" multiple><button class="btn" onclick="sendEmail(false)">Envoyer</button><button class="btn secondary" onclick="sendEmail(true)">Envoyer à tous les inscrits</button></div><div class="muted">Expéditeur : support.omnix@gmail.com</div></div><div class="card" style="margin-top:12px"><h3>Boîte de réception Gmail</h3><button class="btn secondary" onclick="loadInbox()">↻ Actualiser</button><div id="inbox"></div></div></section>
<section id="s-events" class="section"><div class="split"><div class="card"><h3>✅ Requêtes réussies</h3><div id="successEvents"></div></div><div class="card"><h3>❌ Erreurs</h3><div id="errorEvents"></div></div></div></section>
<section id="s-analytics" class="section"><div class="grid" id="analyticsCards"></div><div class="card" style="margin-top:12px"><table class="table"><thead><tr><th>Événement</th><th>Nombre</th></tr></thead><tbody id="analyticsBody"></tbody></table></div></section>
<section id="s-pricing" class="section"><div class="toolbar"><button class="btn" onclick="seedPricing()">Créer les offres recommandées</button><input id="pName" class="input" placeholder="Nom"><input id="pPrice" class="input" type="number" step="0.01" placeholder="Prix"><input id="pDays" class="input" type="number" placeholder="Durée jours"><input id="pStripe" class="input" placeholder="Lien Stripe"><input id="pStripePrice" class="input" placeholder="Stripe Price ID (price_…)"><button class="btn" onclick="createPricing()">Créer l’offre</button></div><div class="card"><table class="table"><thead><tr><th>Offre</th><th>Prix</th><th>Durée</th><th>État</th><th></th></tr></thead><tbody id="pricingBody"></tbody></table></div></section>
<section id="s-promos" class="section"><div class="toolbar"><input id="promoCode" class="input" placeholder="CODE"><select id="promoType" class="select"><option value="percentage">%</option><option value="fixed">€</option></select><input id="promoValue" class="input" type="number" placeholder="Remise"><input id="promoMax" class="input" type="number" placeholder="Max uses (0 = ∞)"><input id="promoExpire" class="input" type="datetime-local"><button class="btn" onclick="createPromo()">Créer</button></div><div class="card"><table class="table"><thead><tr><th>Code</th><th>Remise</th><th>Utilisations</th><th>Expire</th><th>État</th></tr></thead><tbody id="promoBody"></tbody></table></div></section>
<section id="s-admins" class="section"><div class="card"><table class="table"><thead><tr><th>Administrateur</th><th>Rôle</th><th>Permissions</th><th>Premium</th><th>Dernière connexion</th></tr></thead><tbody id="staffBody"></tbody></table></div></section>
<section id="s-audit" class="section"><div class="toolbar"><input id="auditSearch" class="input" placeholder="Membre, cible, description"><select id="auditAction" class="select"><option value="">Toutes les actions</option><option>create</option><option>update</option><option>delete</option><option>grant</option><option>revoke</option><option>enable</option><option>disable</option></select><select id="auditCategory" class="select"><option value="">Toutes catégories</option><option>user</option><option>guild</option><option>ai</option><option>pricing</option><option>payment</option><option>staff</option><option>system</option></select><button class="btn" onclick="loadAudit()">Filtrer</button></div><div class="card"><table class="table"><thead><tr><th>Staff</th><th>Action</th><th>Catégorie</th><th>Cible</th><th>Description</th><th>Date</th></tr></thead><tbody id="auditBody"></tbody></table></div></section>
<section id="s-health" class="section"><div class="grid" id="healthCards"></div><div class="card" style="margin-top:12px"><h3>Services</h3><div id="healthServices"></div></div></section>
</div></main></div><div id="modal" class="modal"><div class="modal-box"><div class="row"><h2 id="modalTitle">Détails</h2><button class="btn secondary" onclick="closeModal()">Fermer</button></div><div id="modalBody"></div></div></div>
<script>
const state={section:'overview',charts:{}};const $=id=>document.getElementById(id);const F=n=>new Intl.NumberFormat('fr-FR').format(Number(n||0));const D=v=>v?new Date(v).toLocaleString('fr-FR'):'—';const H=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
async function api(url,opt={}){const r=await fetch(url,{credentials:'include',cache:'no-store',...opt,headers:{Accept:'application/json',...(opt.body?{'Content-Type':'application/json'}:{}),...(opt.headers||{})}});let d={};try{d=await r.json()}catch{}if(!r.ok)throw new Error(d.error||`HTTP ${r.status}`);return d}
const sections=['overview','users','guilds','ai','aiLogs','bot','payments','emails','events','analytics','pricing','promos','admins','audit','health'];
$('nav').innerHTML=sections.map(x=>`<button data-section="${x}">${({overview:'📊 Vue générale',users:'👥 Utilisateurs',guilds:'🖥️ Serveurs Discord',ai:'🤖 Statistiques IA',aiLogs:'💬 Conversations IA',bot:'🤖 Bot Discord',payments:'💳 Paiements',emails:'📧 Emails',events:'📡 Activité temps réel',analytics:'📈 Analytics',pricing:'💰 Abonnements & tarifs',promos:'🏷️ Codes promo',admins:'👑 Admins & rôles',audit:'🛡️ Audit Logs',health:'❤️ Santé système'})[x]}</button>`).join('');document.querySelectorAll('#nav button').forEach(b=>b.onclick=()=>openSection(b.dataset.section));
function openSection(s){state.section=s;document.querySelectorAll('.section').forEach(e=>e.classList.remove('active'));$('s-'+s)?.classList.add('active');document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.section===s));$('title').textContent=document.querySelector(`#nav button[data-section="${s}"]`)?.textContent.replace(/^\S+\s/,'')||s;loadSection(s)}
async function staff(){const d=await api('/api/admin/overview');const u=d.user||{};$('staff').textContent=`${u.username||'Staff OMNIX'} · ${u.role||'staff'}`;return d}
function card(label,value,sub=''){return `<div class="card"><div class="muted">${H(label)}</div><strong>${H(value)}</strong><div class="muted">${H(sub)}</div></div>`}
function chart(id,labels,datasets){if(typeof Chart!=='function')return;state.charts[id]?.destroy?.();state.charts[id]=new Chart($(id),{type:'line',data:{labels,datasets},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#cbd5e1'}}},scales:{x:{ticks:{color:'#94a3b8'},grid:{color:'rgba(255,255,255,.05)'}},y:{ticks:{color:'#94a3b8'},grid:{color:'rgba(255,255,255,.05)'}}}}})}
async function loadOverview(){const d=await api('/api/admin/overview');$('staff').textContent=`${d.user?.username||'Staff OMNIX'} · ${d.user?.role||'staff'}`;$('overviewCards').innerHTML=card('Utilisateurs',F(d.users?.total),`+${F(d.users?.new)} période`)+card('Premium',F(d.users?.premium))+card('Serveurs',F(d.guilds?.total))+card('IA',F(d.ai?.requests),`${F(d.ai?.errors)} erreurs`)+card('Paiements',Array.isArray(d.payments?.revenue)?d.payments.revenue.reduce((a,x)=>a+Number(x.amount||0),0).toFixed(2)+' €':'0 €')+card('Uptime',Math.floor(Number(d.system?.uptime||0))+' s');await Promise.all([loadChartData(),loadAi()])}
async function loadChartData(){const [u,g]=await Promise.all([api('/api/admin/statistics/users'),api('/api/admin/statistics/guilds')]);chart('usersChart',(u.data||[]).map(x=>x.date),[{label:'Inscriptions',data:(u.data||[]).map(x=>x.count),borderColor:'#7c5cff',tension:.35}]);chart('guildChart',(g.data||[]).map(x=>x.date),[{label:'Nouveaux serveurs',data:(g.data||[]).map(x=>x.count),borderColor:'#06b6d4',tension:.35}])}
async function loadAi(){const d=await api('/api/admin/statistics/ai');const rows=d.data||[];const labels=rows.map(x=>x.date);$('aiCards').innerHTML=card('Requêtes',F(rows.reduce((a,x)=>a+x.requests,0)))+card('Erreurs',F(rows.reduce((a,x)=>a+x.errors,0)))+card('Tokens',F(rows.reduce((a,x)=>a+x.tokens,0)))+card('Taux erreur',rows.length?((rows.reduce((a,x)=>a+x.errors,0)/Math.max(1,rows.reduce((a,x)=>a+x.requests,0)))*100).toFixed(1)+'%':'0%');chart('aiSuccessChart',labels,[{label:'Réussites',data:rows.map(x=>Math.max(0,x.requests-x.errors)),borderColor:'#10b981',tension:.35}]);chart('aiErrorChart',labels,[{label:'Erreurs',data:rows.map(x=>x.errors),borderColor:'#ef4444',tension:.35}]);chart('aiChart',labels,[{label:'Requêtes',data:rows.map(x=>x.requests),borderColor:'#7c5cff',tension:.35},{label:'Erreurs',data:rows.map(x=>x.errors),borderColor:'#ef4444',tension:.35}])}
async function loadUsers(){const q=encodeURIComponent($('userSearch').value.trim());const d=await api('/api/admin/users?limit=100&search='+q);$('usersBody').innerHTML=(d.data||[]).map(u=>`<tr class="click" onclick="openUser('${H(u.discordId)}')"><td><b>${H(u.globalName||u.username)}</b><div class="muted">${H(u.discordId)}</div></td><td>${H(u.email||'—')}</td><td>${H(u.role||'user')}</td><td>${u.isPremium?'⭐ Oui':'Non'}</td><td>${D(u.createdAt)}</td></tr>`).join('')||'<tr><td colspan="5">Aucun utilisateur.</td></tr>'}
async function openUser(id){const d=await api('/api/admin/users/'+encodeURIComponent(id));$('modalTitle').textContent=d.user?.globalName||d.user?.username||id;$('modalBody').innerHTML=`<div class="grid">${card('Discord ID',d.user.discordId)}${card('Email',d.user.email||'—')}${card('Rôle',d.user.role)}${card('Premium',d.user.isPremium?'Oui':'Non')}${card('Inscrit',D(d.user.createdAt))}${card('Dernière connexion',D(d.user.lastLogin))}</div><div class="toolbar"><input id="premiumDays" class="input" type="number" min="0" max="3650" value="30" placeholder="Jours Premium (0 = illimité)"><button class="btn" onclick="setPremium('${id}',true)">Ajouter Premium</button><button class="btn secondary" onclick="setPremium('${id}',false)">Retirer Premium</button></div><div class="toolbar"><select id="userRole" class="select">${['user','support','moderator','admin','super_admin','owner'].map(r=>`<option ${r===d.user.role?'selected':''}>${r}</option>`).join('')}</select><button class="btn" onclick="setRole('${id}')">Enregistrer le rôle</button></div><div class="card"><h3>Serveurs</h3><div class="chips">${(d.user.guilds||[]).map(g=>`<span class="chip">${H(g.name)} · ${F(g.memberCount||0)} membres</span>`).join('')||'Aucun'}</div></div>`;$('modal').classList.add('open')}
async function setPremium(id,v){const days=v?Number($('premiumDays')?.value||30):0;await api('/api/admin/users/'+encodeURIComponent(id)+'/premium',{method:'PATCH',body:JSON.stringify({isPremium:v,durationDays:days})});openUser(id)}async function setRole(id){await api('/api/admin/users/'+encodeURIComponent(id)+'/role',{method:'PATCH',body:JSON.stringify({role:$('userRole').value})});openUser(id)}
async function loadGuilds(){const q=encodeURIComponent($('guildSearch').value.trim());const d=await api('/api/admin/guilds?limit=100&search='+q);$('guildsBody').innerHTML=(d.data||[]).map(g=>`<tr class="click" onclick="openGuild('${H(g.guildId)}')"><td><b>${H(g.name)}</b></td><td>${H(g.guildId)}</td><td>${F(g.memberCount)}</td><td>${H(g.ownerId||'—')}</td><td>${g.blacklisted?'🔴 Blacklist':g.botPresent?'🟢 OMNIX':'⚪ Hors ligne'}</td></tr>`).join('')||'<tr><td colspan="5">Aucun serveur.</td></tr>'}
async function openGuild(id){const d=await api('/api/admin/guilds/'+encodeURIComponent(id));const g=d.guild||{};$('modalTitle').textContent=g.name||id;$('modalBody').innerHTML=`<div class="grid">${card('Guild ID',id)}${card('Membres',F(g.memberCount))}${card('Propriétaire',g.ownerId||'—')}${card('IA',F(d.ai?.requests||0),`${F(d.ai?.errors||0)} erreurs`)}${card('Bot',g.botPresent?'Présent':'Absent')}${card('Blacklist',g.blacklisted?'Activée':'Désactivée')}</div><div class="toolbar"><button class="btn ${g.blacklisted?'':'danger'}" onclick="blacklistGuild('${id}',${!g.blacklisted})">${g.blacklisted?'Retirer de la blacklist':'Blacklister le serveur'}</button></div><div class="card"><h3>Administrateurs Discord</h3><div class="chips">${(g.administrators||[]).map(a=>`<span class="chip">${H(a.displayName||a.username)}${a.owner?' 👑':''}${a.administrator?' 🛡️':''}</span>`).join('')||'Non disponible (guild non mise en cache).'} </div></div><div class="card" style="margin-top:12px"><h3>Activité récente</h3>${(d.events||[]).map(e=>`<div style="padding:8px 0;border-bottom:1px solid var(--line)"><b>${H(e.type)}</b> · ${H(e.userId||'—')} · ${D(e.createdAt)}</div>`).join('')||'Aucune activité.'}</div>`;$('modal').classList.add('open')}
async function blacklistGuild(id,enabled){await api('/api/admin/guilds/'+encodeURIComponent(id)+'/blacklist',{method:'PATCH',body:JSON.stringify({enabled,reason:enabled?'Blacklist Staff OMNIX':''})});openGuild(id);loadGuilds()}
async function loadConversations(){const d=await api('/api/admin/ai-conversations');$('aiConversationsBody').innerHTML=(d.data||[]).map(x=>`<tr class="click" onclick="openConversation('${H(x.sessionId)}')"><td><b>${H(x.username)}</b><div class="muted">${H(x.userId)}</div></td><td>${H(x.guildName||x.guildId||'—')}</td><td>${F(x.requests)}</td><td>${F(x.errors)}</td><td>${D(x.updatedAt)}</td></tr>`).join('')||'<tr><td colspan="5">Aucune conversation.</td></tr>'}
async function openConversation(id){const d=await api('/api/admin/ai-conversations/'+encodeURIComponent(id));$('modalTitle').textContent='Conversation IA';$('modalBody').innerHTML=(d.data||[]).map(x=>`<div class="card" style="margin:8px 0"><div class="muted">${H(x.role||'message')} · ${D(x.createdAt)}</div><div style="white-space:pre-wrap;margin-top:6px">${H(x.userMessage||x.assistantMessage||x.error||'')}</div></div>`).join('')||'Conversation vide';$('modal').classList.add('open')}
async function loadBot(){const d=await api('/api/admin/bot');$('botCards').innerHTML=card('Statut',d.ready?'🟢 En ligne':'🔴 Hors ligne')+card('Ping',d.ping==null?'—':d.ping+' ms')+card('Serveurs',F(d.guilds))+card('Membres',F(d.members))+card('Commandes',F(d.commands))+card('Uptime',Math.floor(d.uptime||0)+' s');$('botDetails').innerHTML=`<div class="muted">Dernière vérification : ${D(new Date())}</div>`}
async function loadPayments(){const d=await api('/api/admin/payments?limit=100');const arr=d.data||[];const revenue=arr.filter(x=>x.status==='paid').reduce((a,x)=>a+Number(x.amount||0),0);$('paymentCards').innerHTML=card('Transactions',F(d.pagination?.total))+card('Payées',F(arr.filter(x=>x.status==='paid').length))+card('Revenus',revenue.toFixed(2)+' €')+card('Échecs',F(arr.filter(x=>x.status==='failed').length));$('paymentsBody').innerHTML=arr.map(x=>`<tr><td>${H(x.userId)}</td><td>${Number(x.amount||0).toFixed(2)} ${(x.currency||'EUR').toUpperCase()}</td><td>${H(x.status)}</td><td>${H(x.tier||'—')}</td><td>${D(x.createdAt)}</td></tr>`).join('')||'<tr><td colspan="5">Aucun paiement.</td></tr>'}
async function loadEmails(){const d=await api('/api/email/config');$('emailCards').innerHTML=card('Fournisseur',d.provider||'gmail')+card('Envoi',d.sendConfigured?'🟢 Configuré':'🔴 Non configuré')+card('Réception',d.receiveConfigured?'🟢 Configuré':'🔴 Non configuré')+card('Adresse',d.from||'—');await loadInbox()}
async function loadInbox(){try{const d=await api('/api/email/inbox?limit=50');$('inbox').innerHTML=(d.data||[]).map(x=>`<div style="padding:10px;border-bottom:1px solid var(--line)"><b>${H(x.subject)}</b><div class="muted">${H(x.from?.[0]?.address||'')} · ${D(x.date)}</div></div>`).join('')||'<div class="muted" style="padding:12px">Boîte vide.</div>'}catch(e){$('inbox').innerHTML='<div class="bad">'+H(e.message)+'</div>'}}
async function sendEmail(all){const subject=$('mailSubject').value.trim(),text=$('mailText').value.trim();if(!subject||!text)return alert('Objet et message obligatoires.');const files=[...($('mailFiles').files||[])];const attachments=[];for(const f of files.slice(0,5)){const b=await new Promise(r=>{const rd=new FileReader();rd.onload=()=>r(String(rd.result).split(',')[1]||'');rd.readAsDataURL(f)});attachments.push({filename:f.name,contentBase64:b,contentType:f.type})}if(all){await api('/api/email/broadcast',{method:'POST',body:JSON.stringify({subject,text,attachments})});alert('Campagne envoyée.')}else{const to=$('mailTo').value.split(',').map(x=>x.trim()).filter(Boolean);await api('/api/email/send',{method:'POST',body:JSON.stringify({to,subject,text,attachments})});alert('Email envoyé.')}}
async function loadEvents(){const d=await api('/api/admin/events?limit=100');const rows=d.data||[];const isErr=(x)=>String(x.type).includes('error')||x.metadata?.status==='error';$('successEvents').innerHTML=rows.filter(x=>!isErr(x)).map(x=>`<div style="padding:8px 0;border-bottom:1px solid var(--line)"><b>${H(x.type)}</b><div class="muted">${H(x.userId||'—')} · ${H(x.guildId||'—')} · ${D(x.createdAt)}</div></div>`).join('')||'Aucune requête réussie.';$('errorEvents').innerHTML=rows.filter(isErr).map(x=>`<div style="padding:8px 0;border-bottom:1px solid var(--line)"><b>${H(x.type)}</b><div class="muted">${H(JSON.stringify(x.metadata||{}))} · ${D(x.createdAt)}</div></div>`).join('')||'Aucune erreur.'}
async function loadAnalytics(){const d=await api('/api/admin/analytics');$('analyticsCards').innerHTML=card('Utilisateurs',F(d.totalUsers))+card('Serveurs',F(d.totalGuilds))+card('IA',F(d.totalAiRequests))+card('Tokens',F(d.totalAiTokens))+card('Erreurs',F(d.aiErrors));$('analyticsBody').innerHTML=(d.events||[]).map(x=>`<tr><td>${H(x._id)}</td><td>${F(x.count)}</td></tr>`).join('')}
async function loadPricing(){const d=await api('/api/admin/pricing?includeInactive=true');$('pricingBody').innerHTML=(d.data||[]).map(x=>`<tr><td><b>${H(x.name)}</b><div class="muted">${H(x.description||'')}</div></td><td>${Number(x.price||0).toFixed(2)} ${H(x.currency||'EUR')}</td><td>${H(x.durationLabel||((x.durationDays||0)+' jours'))}</td><td>${x.active?'🟢 Actif':'⚪ Inactif'}</td><td><button class="btn secondary" onclick="togglePricing('${H(x._id)}',${!x.active})">${x.active?'Désactiver':'Activer'}</button></td></tr>`).join('')||'<tr><td colspan="5">Aucune offre.</td></tr>'}
async function createPricing(){const body={name:$('pName').value.trim(),price:Number($('pPrice').value),durationDays:Number($('pDays').value),duration:`${$('pDays').value} jours`,stripeUrl:$('pStripe').value.trim(),stripePriceId:$('pStripePrice').value.trim()||null,active:true,featured:false};await api('/api/admin/pricing',{method:'POST',body:JSON.stringify(body)});await loadPricing()}
async function seedPricing(){await api('/api/admin/pricing/seed',{method:'POST'});await loadPricing()}
async function togglePricing(id,active){await api('/api/admin/pricing/'+encodeURIComponent(id),{method:'PATCH',body:JSON.stringify({active})});await loadPricing()}
async function createPromo(){const body={code:$('promoCode').value,discountType:$('promoType').value,discountValue:Number($('promoValue').value),maxUses:Number($('promoMax').value||0),expiresAt:$('promoExpire').value,emailEnabled:false,autoEmailOnCreate:false};await api('/api/admin/promos',{method:'POST',body:JSON.stringify(body)});await loadPromos()}
async function loadPromos(){const d=await api('/api/admin/promos');$('promoBody').innerHTML=(d.data||[]).map(x=>`<tr><td><code>${H(x.code)}</code></td><td>${x.discountType==='percentage'?x.discountValue+'%':Number(x.discountValue||0).toFixed(2)+' €'}</td><td>${F(x.usesCount)}/${x.maxUses?F(x.maxUses):'∞'}</td><td>${D(x.expiresAt)}</td><td>${x.isActive?'🟢 Actif':'⚪ Inactif'}</td></tr>`).join('')||'<tr><td colspan="5">Aucun code promo.</td></tr>'}
async function loadStaff(){const d=await api('/api/admin/staff');$('staffBody').innerHTML=(d.data||[]).map(x=>`<tr><td><b>${H(x.globalName||x.username)}</b><div class="muted">${H(x.discordId)}</div></td><td><select class="select" onchange="changeRole('${H(x.discordId)}',this.value)">${['user','support','moderator','admin','super_admin','owner'].map(r=>`<option ${r===x.role?'selected':''}>${r}</option>`).join('')}</select></td><td>${H((x.permissions||[]).join(', ')||'Permissions par rôle')}</td><td>${x.isPremium?'⭐':'—'}</td><td>${D(x.lastLogin)}</td></tr>`).join('')||'<tr><td colspan="5">Aucun staff enregistré.</td></tr>'}
async function changeRole(id,role){await api('/api/admin/users/'+encodeURIComponent(id)+'/role',{method:'PATCH',body:JSON.stringify({role})});await loadStaff()}
async function loadAudit(){const q=new URLSearchParams();if($('auditSearch').value)q.set('search',$('auditSearch').value);if($('auditAction').value)q.set('action',$('auditAction').value);if($('auditCategory').value)q.set('category',$('auditCategory').value);const d=await api('/api/admin/audit-logs?limit=100&'+q.toString());$('auditBody').innerHTML=(d.data||[]).map(x=>`<tr><td>${H(x.staffUsername||x.staffId)}</td><td>${H(x.action)}</td><td>${H(x.category)}</td><td>${H(x.targetName||x.targetId||'—')}</td><td>${H(x.description||'')}</td><td>${D(x.createdAt)}</td></tr>`).join('')||'<tr><td colspan="6">Aucun journal.</td></tr>'}
async function loadHealth(){const d=await api('/api/admin/health/full');const s=d.services||{},m=d.system?.memory||{};$('healthCards').innerHTML=card('Application',s.api?'🟢 Online':'🔴 Offline')+card('Discord',s.discord?'🟢 Connecté':'🔴 Hors ligne')+card('MongoDB',s.mongodb?'🟢 Connecté':'🔴 Hors ligne')+card('RAM',Math.round((m.rss||0)/1024/1024)+' MB')+card('Node',d.system?.node||'—')+card('Uptime',Math.floor(d.system?.uptime||0)+' s');$('healthServices').innerHTML=Object.entries({stripe:s.stripe,email:s.email}).map(([k,v])=>`<div class="row" style="padding:10px 0;border-bottom:1px solid var(--line)"><b>${H(k.toUpperCase())}</b><span>${v?'🟢 Configuré':'🔴 Non configuré'}</span></div>`).join('')}
function refreshCurrent(){loadSection(state.section)}
function loadSection(s){return ({overview:loadOverview,users:loadUsers,guilds:loadGuilds,ai:loadAi,aiLogs:loadConversations,bot:loadBot,payments:loadPayments,emails:loadEmails,events:loadEvents,analytics:loadAnalytics,pricing:loadPricing,promos:loadPromos,admins:loadStaff,audit:loadAudit,health:loadHealth})[s]?.()}
function closeModal(){$('modal').classList.remove('open')}
document.getElementById('adminMenuToggle')?.addEventListener('click',()=>{document.getElementById('adminSide').classList.add('open');document.getElementById('adminOverlay').classList.add('open')});document.getElementById('adminMenuClose')?.addEventListener('click',()=>{document.getElementById('adminSide').classList.remove('open');document.getElementById('adminOverlay').classList.remove('open')});document.getElementById('adminOverlay')?.addEventListener('click',()=>{document.getElementById('adminSide').classList.remove('open');document.getElementById('adminOverlay').classList.remove('open')});document.querySelectorAll('#nav button').forEach(b=>b.addEventListener('click',()=>{document.getElementById('adminSide').classList.remove('open');document.getElementById('adminOverlay').classList.remove('open')}));loadOverview();
</script></body></html>
