<script>
/* =========================================================
   OMNIX SIDEBAR — PARTIE 3/3 — JAVASCRIPT
   API publique unique : toggleOmnixSidebar / toggleDrawer.
========================================================= */
(function () {
  'use strict';
  if (window.__OMNIX_SIDEBAR_INITIALIZED__) return;
  window.__OMNIX_SIDEBAR_INITIALIZED__ = true;

  const byId = (id) => document.getElementById(id);
  const sidebar = () => byId('omnix-sidebar');
  const overlay = () => byId('sidebar-overlay');
  const closeButton = () => byId('omnix-sidebar-close');

  function setState(open) {
    const panel = sidebar();
    const shade = overlay();
    if (!panel) return;
    const value = Boolean(open);
    panel.classList.toggle('open', value);
    panel.setAttribute('aria-hidden', String(!value));
    const close = closeButton();
    if (close) close.setAttribute('aria-expanded', String(value));
    if (shade) {
      shade.classList.toggle('open', value);
      shade.setAttribute('aria-hidden', String(!value));
    }
    document.body.classList.toggle('omnix-sidebar-open', value);
    const buttons = document.querySelectorAll(
      '[aria-controls="omnix-sidebar"], .btn-burger, .menu-button, .dashboard-menu-button'
    );
    buttons.forEach((button) => button.setAttribute('aria-expanded', String(value)));
  }

  window.toggleOmnixSidebar = function (open) {
    if (typeof open !== 'boolean') {
      open = !sidebar()?.classList.contains('open');
    }
    setState(open);
  };
  window.openOmnixSidebar = function () { setState(true); };
  window.closeOmnixSidebar = function () { setState(false); };
  window.toggleDrawer = function (open) {
    if (typeof open !== 'boolean') open = !sidebar()?.classList.contains('open');
    setState(open);
  };

  function markActive() {
    const path = window.location.pathname;
    const hash = window.location.hash.replace('#','');
    document.querySelectorAll('.nav-link[data-route]').forEach((link) => {
      link.classList.remove('active');
      const route = link.dataset.route || '';
      const section = link.dataset.section || '';
      if (route === '/dashboard' && path === '/dashboard' && section) {
        if (hash === section) link.classList.add('active');
        return;
      }
      if (route === path || (route !== '/' && path.startsWith(route + '/'))) {
        link.classList.add('active');
      }
    });
  }

  async function loadUser() {
    try {
      const response = await fetch('/api/auth/me', {
        method:'GET', credentials:'include', cache:'no-store', headers:{Accept:'application/json'}
      });
      if (!response.ok) return;
      const data = await response.json();
      const user = data?.user;
      const login = byId('sidebar-login');
      const userBox = byId('sidebar-user');
      const logout = document.querySelector('[data-sidebar-action="logout"]');
      if (!user) {
        if (login) login.hidden = false;
        if (userBox) userBox.hidden = true;
        if (logout) logout.hidden = true;
        return;
      }
      if (login) login.hidden = true;
      if (userBox) userBox.hidden = false;
      if (logout) logout.hidden = false;

      // Une fois connecté, les CTA de connexion présents dans la page
      // ne doivent plus être affichés. Les actions du dashboard restent intactes.
      document.querySelectorAll('.login-btn, [data-login-button], a[href="/connexion"]').forEach((element) => {
        if (element !== login) element.hidden = true;
      });

      const avatar = document.querySelector('.sidebar-avatar');
      const username = document.querySelector('.sidebar-user-info strong');
      const role = document.querySelector('.sidebar-user-info span');
      if (avatar) {
        if (user.avatar) {
          avatar.innerHTML = '<img src="' + String(user.avatar).replace(/"/g,'&quot;') + '" alt="">';
        } else {
          avatar.textContent = String(user.globalName || user.username || 'O').charAt(0).toUpperCase();
        }
      }
      if (username) username.textContent = user.globalName || user.username || 'Utilisateur';
      if (role) role.textContent = user.isOwner ? 'Owner OMNIX' : (user.isAdmin ? 'Administrateur OMNIX' : (['support','moderator'].includes(String(user.role||'').toLowerCase()) ? 'Staff OMNIX' : 'Utilisateur OMNIX'));
      const admin = byId('sidebar-admin-section');
      const roleName = String(user.role || '').toLowerCase();
      if (admin) {
        admin.hidden = !Boolean(
          user.isOwner ||
          user.isAdmin ||
          ['support', 'moderator', 'admin', 'super_admin', 'owner'].includes(roleName)
        );
      }
    } catch (error) {
      console.warn('[Sidebar] Session unavailable', error);
    }
  }

  async function loadSidebarGuildContext() {
    const card = document.querySelector('.sidebar-server-context');
    const name = document.getElementById('sidebar-guild-name');
    if (!card || !name) return;
    const guildId = card.getAttribute('data-guild-id') || '';
    if (!guildId || name.textContent.trim() !== 'Sélectionner un serveur') return;
    try { const r=await fetch('/api/guilds',{credentials:'include',cache:'no-store',headers:{Accept:'application/json'}}); if(!r.ok)return; const d=await r.json(); const list=d?.guilds||d?.data||d?.servers||[]; const g=Array.isArray(list)?list.find(x=>String(x.id||x.guildId)===String(guildId)):null; if(g?.name)name.textContent=g.name; } catch {}
  }

  function init() {
    const close = closeButton();
    const shade = overlay();
    if (close) close.addEventListener('click', () => setState(false));
    if (shade) shade.addEventListener('click', () => setState(false));
    document.querySelectorAll('.nav-link, [data-sidebar-action="logout"]').forEach((link) => {
      link.addEventListener('click', () => setState(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setState(false);
    });
    window.addEventListener('hashchange', markActive);
    markActive();
    void loadUser();
    void loadSidebarGuildContext();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, {once:true});
  else init();
})();
</script>
