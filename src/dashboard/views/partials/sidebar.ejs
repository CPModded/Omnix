  }


  .brand-content {
    display:flex;
    flex-direction:column;
  }


  .brand-content strong {
    font-size:15px;
    letter-spacing:1.5px;
  }


  .brand-content span {
    font-size:9px;
    color:#64748b;
    text-transform:uppercase;
    letter-spacing:1px;
    margin-top:2px;
  }


  .sidebar-close {
