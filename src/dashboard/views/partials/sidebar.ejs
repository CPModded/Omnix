<!-- =========================================================
     OMNIX SIDEBAR — PARTIE 1/3 — STRUCTURE
     Drawer global OMNIX : ouverture depuis le bouton du header.
     Position : DROITE. Aucun hamburger supplémentaire n'est injecté.
========================================================= -->
<aside
  id="omnix-sidebar"
  class="omnix-sidebar"
  aria-label="Navigation principale OMNIX"
  aria-hidden="true"
>
  <div class="sidebar-brand">
    <a href="/" class="brand-link" aria-label="Accueil OMNIX">
      <div class="brand-logo">
        <img
          src="/logo.png"
          alt="OMNIX"
          id="omnix-sidebar-logo"
          onerror="this.style.display='none'; const f=this.parentElement.querySelector('.brand-fallback'); if(f) f.style.display='flex';"
        >
        <span class="brand-fallback" aria-hidden="true">O</span>
      </div>
      <div class="brand-content">
        <strong>OMNIX</strong>
        <span>Control Center</span>
