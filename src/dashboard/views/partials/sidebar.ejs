      display:block;
    }

    .sidebar-overlay {
      position:fixed;
      inset:0;

      background:rgba(0,0,0,.55);

      backdrop-filter:blur(3px);

      z-index:899;
    }

    .sidebar-overlay.open {
      display:block;
    }

