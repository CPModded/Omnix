</style>


<script>

  function toggleOmnixSidebar(open) {

    const sidebar =
      document.getElementById('omnix-sidebar');

    const overlay =
      document.getElementById('sidebar-overlay');

    if (!sidebar || !overlay) return;

    sidebar.classList.toggle('open', open);
    overlay.classList.toggle('open', open);
  }


  function markActiveSidebarLink() {

    const currentPath =
      window.location.pathname;

    document
      .querySelectorAll('.nav-link[data-route]')
      .forEach(link => {

        const route =
          link.dataset.route;

        if (
          route === currentPath ||
          (
            route !== '/' &&
            currentPath.startsWith(route)
          )
        ) {
          link.classList.add('active');
        }

      });

  }


  async function initializeSidebar() {

    try {

      const response =
        await fetch(
          '/api/auth/me',
          {
            credentials:'include',
            cache:'no-store',
            headers:{
              Accept:'application/json'
            }
          }
        );

      if (!response.ok) return;

      const data =
        await response.json();

      if (!data?.user) return;

      const user =
        data.user;

      const avatar =
        document.querySelector(
          '.sidebar-avatar'
        );

      const username =
        document.querySelector(
          '.sidebar-user-info strong'
        );

      const role =
        document.querySelector(
          '.sidebar-user-info span'
        );

      if (avatar) {

        if (user.avatar) {

          avatar.innerHTML = `
            <img
              src="${user.avatar}"
              alt=""
              style="
                width:100%;
                height:100%;
                object-fit:cover;
                border-radius:50%;
              "
            >
          `;

        } else {

          avatar.textContent =
            (
              user.username ||
              'O'
            )
            .charAt(0)
            .toUpperCase();

        }

      }

      if (username) {

        username.textContent =
          user.globalName ||
          user.username ||
          'Utilisateur';

      }

      if (role) {

        role.textContent =
          user.isOwner
            ? 'Owner OMNIX'
            : 'Utilisateur OMNIX';

      }

      if (user.isOwner) {

        const admin =
          document.getElementById(
            'sidebar-admin-section'
          );

        if (admin) {
          admin.style.display = '';
        }

      }

    } catch (error) {

      console.warn(
        '[Sidebar] Session unavailable',
        error
      );

    }

    markActiveSidebarLink();

  }


  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initializeSidebar
    );

  } else {

    initializeSidebar();

  }

</script>