.sidebar-close:hover { color:#fff; background:rgba(255,255,255,.06); }
.sidebar-user { display:flex; align-items:center; gap:10px; padding:10px; border-radius:14px; background:rgba(255,255,255,.025); border:1px solid rgba(255,255,255,.045); margin-bottom:12px; flex-shrink:0; }
.sidebar-login { display:flex; align-items:center; gap:10px; padding:11px; margin-bottom:18px; border-radius:13px; color:#fff; text-decoration:none; background:linear-gradient(135deg,rgba(99,102,241,.22),rgba(6,182,212,.09)); border:1px solid rgba(99,102,241,.24); box-shadow:0 10px 30px rgba(79,70,229,.10); transition:.2s; }
.sidebar-login:hover { transform:translateY(-1px); border-color:rgba(103,232,249,.3); background:linear-gradient(135deg,rgba(99,102,241,.30),rgba(6,182,212,.12)); }
