.brand-logo img { width:100%; height:100%; display:block; object-fit:cover; }
.brand-fallback { display:none; align-items:center; justify-content:center; width:100%; height:100%; color:#fff; font-size:20px; font-weight:900; }
.brand-content { display:flex; flex-direction:column; min-width:0; }
.brand-content strong { font-size:15px; letter-spacing:1.5px; }
.brand-content span { margin-top:2px; color:#64748b; font-size:9px; text-transform:uppercase; letter-spacing:1px; }
