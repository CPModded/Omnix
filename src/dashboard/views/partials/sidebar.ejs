<script>
/* =========================================================
   OMNIX SIDEBAR
   PARTIE 3/3 — JAVASCRIPT
========================================================= */
(function () {
  'use strict';
  /* =======================================================
     PROTECTION CONTRE DOUBLE INITIALISATION
  ======================================================== */
  if (
    window.__OMNIX_SIDEBAR_INITIALIZED__
  ) {
    return;
  }
  window.__OMNIX_SIDEBAR_INITIALIZED__ =
    true;
  /* =======================================================
     ELEMENTS
  ======================================================== */
  function getSidebar() {
    return document.getElementById(
      'omnix-sidebar'
    );
  }
  function getOverlay() {
    return document.getElementById(
      'sidebar-overlay'
    );
  }
  function getToggleButton() {
    return document.getElementById(
      'omnix-sidebar-toggle'
    );
  }
  function getCloseButton() {
    return document.getElementById(
      'omnix-sidebar-close'
    );
  }
  /* =======================================================
     SIDEBAR STATE
  ======================================================== */
  function setSidebarState(
    open
  ) {
    const sidebar =
      getSidebar();
    const overlay =
      getOverlay();
    const toggle =
      getToggleButton();
    const close =
      getCloseButton();
    if (!sidebar) {
      return;
    }
    const isMobile =
      window.innerWidth <= 900;
    /*
     * Desktop:
     *
     * Le sidebar reste toujours visible.
     */
    if (!isMobile) {
      sidebar.classList.remove(
        'open'
      );
      if (overlay) {
        overlay.classList.remove(
          'open'
        );
        overlay.setAttribute(
          'aria-hidden',
          'true'
        );
      }
      document.body.classList.remove(
        'omnix-sidebar-open'
      );
      if (toggle) {
        toggle.setAttribute(
          'aria-expanded',
          'false'
        );
      }
      return;
    }
    sidebar.classList.toggle(
      'open',
      open
    );
    if (overlay) {
      overlay.classList.toggle(
        'open',
        open
      );
      overlay.setAttribute(
        'aria-hidden',
        open
          ? 'false'
          : 'true'
      );
    }
    document.body.classList.toggle(
      'omnix-sidebar-open',
      open
    );
    if (toggle) {
      toggle.setAttribute(
        'aria-expanded',
        open
          ? 'true'
          : 'false'
      );
    }
    if (close) {
      close.setAttribute(
        'aria-expanded',
        open
          ? 'true'
          : 'false'
      );
    }
  }
  /* =======================================================
     PUBLIC FUNCTION
  ======================================================== */
  window.toggleOmnixSidebar =
    function (open) {
      if (
        typeof open !==
        'boolean'
      ) {
        const sidebar =
          getSidebar();
        open =
          !sidebar?.classList.contains(
            'open'
          );
      }
      setSidebarState(
        open
      );
    };
  /* =======================================================
     COMPATIBILITY ANCIEN SYSTÈME
  ======================================================== */
  /*
   * Certaines anciennes pages OMNIX
   * peuvent encore appeler :
   *
   * toggleDrawer()
   * openOmnixSidebar()
   * closeOmnixSidebar()
   *
   * On les redirige proprement vers
   * le nouveau système.
   */
  window.toggleDrawer =
    function (open) {
      if (
        typeof open !==
        'boolean'
      ) {
        const sidebar =
          getSidebar();
        open =
          !sidebar?.classList.contains(
            'open'
          );
      }
      setSidebarState(
        open
      );
    };
  window.openOmnixSidebar =
    function () {
      setSidebarState(
        true
      );
    };
  window.closeOmnixSidebar =
    function () {
      setSidebarState(
        false
      );
    };
  /* =======================================================
     ACTIVE ROUTE
  ======================================================== */
  function markActiveSidebarLink() {
    const currentPath =
      window.location.pathname;
    const currentHash =
      window.location.hash
        .replace(
          '#',
          ''
        );
    const links =
      document.querySelectorAll(
        '.nav-link[data-route]'
      );
    links.forEach(
      function (link) {
        link.classList.remove(
          'active'
        );
        const route =
          link.dataset.route ||
          '';
        const section =
          link.dataset.section ||
          '';
        /*
         * Dashboard sections
         */
        if (
          route ===
          '/dashboard'
        ) {
          if (
            currentPath ===
              '/dashboard' &&
            section
          ) {
            if (
              currentHash ===
              section
            ) {
              link.classList.add(
                'active'
              );
            }
            return;
          }
        }
        /*
         * Exact route
         */
        if (
          route ===
          currentPath
        ) {
          /*
           * "/" doit uniquement
           * correspondre à "/".
           */
          if (
            route ===
              '/' &&
            currentPath !==
              '/'
          ) {
            return;
          }
          link.classList.add(
            'active'
          );
          return;
        }
        /*
         * Sous-routes
         *
         * /admin
         * /admin/users
         * /admin/stats
         */
        if (
          route !==
            '/' &&
          currentPath.startsWith(
            route + '/'
          )
        ) {
          link.classList.add(
            'active'
          );
        }
      }
    );
  }
  /* =======================================================
     NAVIGATION MOBILE
  ======================================================== */
  function bindNavigation() {
    const links =
      document.querySelectorAll(
        '.nav-link'
      );
    links.forEach(
      function (link) {
        link.addEventListener(
          'click',
          function () {
            /*
             * On ferme immédiatement
             * le drawer mobile.
             */
            if (
              window.innerWidth <=
              900
            ) {
              setSidebarState(
                false
              );
            }
          }
        );
      }
    );
    const logout =
      document.querySelector(
        '[data-sidebar-action="logout"]'
      );
    if (logout) {
      logout.addEventListener(
        'click',
        function () {
          setSidebarState(
            false
          );
        }
      );
    }
  }
  /* =======================================================
     BOUTON HAMBURGER
  ======================================================== */
  function bindToggleButton() {
    const toggle =
      getToggleButton();
    if (!toggle) {
      console.warn(
        '[Sidebar] Bouton hamburger introuvable.'
      );
      return;
    }
    toggle.addEventListener(
      'click',
      function () {
        const sidebar =
          getSidebar();
        if (!sidebar) {
          return;
        }
        const open =
          !sidebar.classList.contains(
            'open'
          );
        setSidebarState(
          open
        );
      }
    );
  }
  /* =======================================================
     BOUTON FERMETURE
  ======================================================== */
  function bindCloseButton() {
    const close =
      getCloseButton();
    if (!close) {
      return;
    }
    close.addEventListener(
      'click',
      function () {
        setSidebarState(
          false
        );
      }
    );
  }
  /* =======================================================
     OVERLAY
  ======================================================== */
  function bindOverlay() {
    const overlay =
      getOverlay();
    if (!overlay) {
      return;
    }
    overlay.addEventListener(
      'click',
      function () {
        setSidebarState(
          false
        );
      }
    );
  }
  /* =======================================================
     ESCAPE
  ======================================================== */
  function bindEscape() {
    document.addEventListener(
      'keydown',
      function (event) {
        if (
          event.key !==
          'Escape'
        ) {
          return;
        }
        const sidebar =
          getSidebar();
        if (
          sidebar &&
          sidebar.classList.contains(
            'open'
          )
        ) {
          setSidebarState(
            false
          );
        }
      }
    );
  }
  /* =======================================================
     RESIZE
  ======================================================== */
  function bindResize() {
    let resizeTimer;
    window.addEventListener(
      'resize',
      function () {
        clearTimeout(
          resizeTimer
        );
        resizeTimer =
          setTimeout(
            function () {
              /*
               * Si on repasse desktop,
               * on nettoie l'état mobile.
               */
              if (
                window.innerWidth >
                900
              ) {
                setSidebarState(
                  false
                );
              }
            },
            100
          );
      }
    );
  }
  /* =======================================================
     LOAD USER
  ======================================================== */
  async function initializeSidebarUser() {
    try {
      const response =
        await fetch(
          '/api/auth/me',
          {
            method:
              'GET',
            credentials:
              'include',
            cache:
              'no-store',
            headers: {
              Accept:
                'application/json'
            }
          }
        );
      /*
       * Pas connecté :
       *
       * On garde simplement
       * l'état "Connexion...".
       */
      if (
        !response.ok
      ) {
        return;
      }
      const data =
        await response.json();
      if (
        !data ||
        !data.user
      ) {
        return;
      }
      const user =
        data.user;
      /* =====================================================
         AVATAR
      ====================================================== */
      const avatar =
        document.querySelector(
          '.sidebar-avatar'
        );
      if (avatar) {
        if (
          user.avatar
        ) {
          /*
           * Discord CDN :
           *
           * https://cdn.discordapp.com/avatars/...
           */
          avatar.innerHTML = '';
          const image =
            document.createElement(
              'img'
            );
          image.src =
            String(
              user.avatar
            );
          image.alt =
            '';
          image.loading =
            'lazy';
          image.onerror =
            function () {
              avatar.textContent =
                (
                  user.globalName ||
                  user.username ||
                  'O'
                )
                .charAt(0)
                .toUpperCase();
            };
          avatar.appendChild(
            image
          );
        } else {
          avatar.textContent =
            (
              user.globalName ||
              user.username ||
              'O'
            )
            .charAt(0)
            .toUpperCase();
        }
      }
      /* =====================================================
         USERNAME
      ====================================================== */
      const username =
        document.querySelector(
          '.sidebar-user-info strong'
        );
      if (username) {
        username.textContent =
          user.globalName ||
          user.username ||
          'Utilisateur';
      }
      /* =====================================================
         ROLE
      ====================================================== */
      const role =
        document.querySelector(
          '.sidebar-user-info span'
        );
      if (role) {
        if (
          user.isOwner
        ) {
          role.textContent =
            'Owner OMNIX';
        } else if (
          user.isAdmin
        ) {
          role.textContent =
            'Administrateur OMNIX';
        } else if (
          user.isPremium
        ) {
          role.textContent =
            'Membre Premium';
        } else {
          role.textContent =
            'Utilisateur OMNIX';
        }
      }
      /* =====================================================
         OWNER CENTER
      ====================================================== */
      const adminSection =
        document.getElementById(
          'sidebar-admin-section'
        );
      if (
        adminSection
      ) {
        if (
          user.isOwner
        ) {
          adminSection.hidden =
            false;
        } else {
          adminSection.hidden =
            true;
        }
      }
    } catch (error) {
      console.warn(
        '[Sidebar] Session unavailable:',
        error
      );
    }
  }
  /* =======================================================
     INITIALIZATION
  ======================================================== */
  function initializeSidebar() {
    /*
     * Vérifie que le HTML existe.
     */
    if (
      !getSidebar()
    ) {
      console.warn(
        '[Sidebar] #omnix-sidebar introuvable.'
      );
      return;
    }
    bindToggleButton();
    bindCloseButton();
    bindOverlay();
    bindEscape();
    bindResize();
    bindNavigation();
    markActiveSidebarLink();
    initializeSidebarUser();
  }
  /* =======================================================
     DOM READY
  ======================================================== */
  if (
    document.readyState ===
    'loading'
  ) {
    document.addEventListener(
      'DOMContentLoaded',
      initializeSidebar,
      {
        once: true
      }
    );
  } else {
    initializeSidebar();
  }
  /* =======================================================
     HASH CHANGE
  ======================================================== */
  window.addEventListener(
    'hashchange',
    function () {
      markActiveSidebarLink();
    }
  );
})();
</script>