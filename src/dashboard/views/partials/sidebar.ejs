.sidebar-login span:last-child { display:flex; flex-direction:column; min-width:0; }
.sidebar-login strong { font-size:11px; }
.sidebar-login small { margin-top:2px; color:#94a3b8; font-size:9px; }
.sidebar-avatar { width:36px; height:36px; flex:0 0 36px; border-radius:50%; overflow:hidden; background:linear-gradient(135deg,#4f46e5,#06b6d4); display:flex; align-items:center; justify-content:center; color:#fff; font-size:12px; font-weight:800; }
.sidebar-avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
.sidebar-user-info { min-width:0; flex:1; display:flex; flex-direction:column; }
.sidebar-user-info strong { font-size:12px; color:#e2e8f0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
