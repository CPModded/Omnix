<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <meta
    name="description"
    content="OMNIX — Page introuvable."
  >
  <meta
    name="theme-color"
    content="#030712"
  >
  <title>OMNIX — 404</title>
  <style>
    /* =========================================================
       RESET
    ========================================================= */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    /* =========================================================
       BASE
    ========================================================= */
    html {
      min-height: 100%;
    }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow: hidden;
      background:
        radial-gradient(
          circle at 50% -10%,
          rgba(79, 70, 229, 0.18),
          transparent 42%
        ),
        radial-gradient(
          circle at 100% 100%,
          rgba(6, 182, 212, 0.07),
          transparent 35%
        ),
        #030712;
      color: #f8fafc;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
      line-height: 1.5;
    }
    /* =========================================================
       BACKGROUND GRID
    ========================================================= */
    .background {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .background-grid {
      position: absolute;
      inset: 0;
      opacity: 0.18;
      background-image:
        linear-gradient(
          rgba(148, 163, 184, 0.045) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(148, 163, 184, 0.045) 1px,
          transparent 1px
        );
      background-size: 48px 48px;
      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 90%
        );
    }
    /* =========================================================
       GLOW
    ========================================================= */
    .glow {
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      filter: blur(110px);
      background:
        rgba(79, 70, 229, 0.13);
    }
    .glow-top {
      top: -260px;
      left: 50%;
      transform:
        translateX(-50%);
    }
    .glow-bottom {
      right: -250px;
      bottom: -280px;
      background:
        rgba(6, 182, 212, 0.08);
    }
    /* =========================================================
       ERROR CONTAINER
    ========================================================= */
    .container {
      position: relative;
      z-index: 2;
      width:
        min(100%, 560px);
      padding: 45px 30px;
      text-align: center;
      border:
        1px solid
        rgba(148, 163, 184, 0.09);
      border-radius: 24px;
      background:
        linear-gradient(
          145deg,
          rgba(15, 23, 42, 0.82),
          rgba(3, 7, 18, 0.92)
        );
      box-shadow:
        0 35px 100px
        rgba(0, 0, 0, 0.40);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    /* =========================================================
       BRAND
    ========================================================= */
    .brand {
      margin-bottom: 25px;
      color: #94a3b8;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .brand span {
      background:
        linear-gradient(
          90deg,
          #60a5fa,
          #22d3ee,
          #a78bfa
        );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    /* =========================================================
       ERROR CODE
    ========================================================= */
    .code {
      font-size:
        clamp(80px, 18vw, 130px);
      font-weight: 950;
      line-height: 0.95;
      letter-spacing: -6px;
      background:
        linear-gradient(
          135deg,
          #60a5fa,
          #22d3ee 45%,
          #a78bfa
        );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter:
        drop-shadow(
          0 0 30px
          rgba(96, 165, 250, 0.12)
        );
    }
    /* =========================================================
       CONTENT
    ========================================================= */
    h1 {
      margin:
        24px 0 10px;
      color: white;
      font-size:
        clamp(23px, 5vw, 30px);
      font-weight: 900;
      letter-spacing: -0.8px;
    }
    p {
      max-width: 430px;
      margin:
        0 auto 28px;
      color: #8d98ad;
      font-size: 14px;
      line-height: 1.7;
    }
    /* =========================================================
       BUTTON
    ========================================================= */
    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding:
        0 22px;
      border:
        1px solid
        rgba(96, 165, 250, 0.15);
      border-radius: 12px;
      background:
        linear-gradient(
          135deg,
          #4f46e5,
          #06b6d4
        );
      color: white;
      text-decoration: none;
      font-size: 12px;
      font-weight: 850;
      box-shadow:
        0 12px 30px
        rgba(79, 70, 229, 0.22);
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        filter 0.2s ease;
    }
    .button:hover {
      transform:
        translateY(-2px);
      filter:
        brightness(1.08);
      box-shadow:
        0 16px 38px
        rgba(6, 182, 212, 0.20);
    }
    .button:active {
      transform:
        translateY(0);
    }
    .button:focus-visible {
      outline:
        2px solid
        #38bdf8;
      outline-offset: 4px;
    }
    /* =========================================================
       MOBILE
    ========================================================= */
    @media (max-width: 480px) {
      body {
        padding: 16px;
      }
      .container {
        padding:
          35px 22px;
      }
      .code {
        letter-spacing: -4px;
      }
      h1 {
        font-size: 23px;
      }
      p {
        font-size: 13px;
      }
      .button {
        width: 100%;
      }
    }
    /* =========================================================
       REDUCED MOTION
    ========================================================= */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration:
          0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <!-- =======================================================
       BACKGROUND
  ======================================================== -->
  <div
    class="background"
    aria-hidden="true"
  >
    <div class="background-grid"></div>
    <div
      class="glow glow-top"
    ></div>
    <div
      class="glow glow-bottom"
    ></div>
  </div>
  <!-- =======================================================
       404 CONTENT
  ======================================================== -->
  <main
    class="container"
    role="main"
  >
    <div class="brand">
      <span>OMNIX</span>
      &nbsp; / &nbsp;
      ERROR
    </div>
    <div
      class="code"
      aria-label="Erreur 404"
    >
      404
    </div>
    <h1>
      Page introuvable
    </h1>
    <p>
      Cette page OMNIX n'existe pas
      ou n'est plus disponible.
    </p>
    <a
      href="/dashboard"
      class="button"
    >
      Retour au Dashboard
    </a>
  </main>
</body>
</html>