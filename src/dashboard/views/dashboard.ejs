  <script>

    /* =====================================================
       OMNIX GLOBAL STATE
    ===================================================== */

    window.OMNIX =
      window.OMNIX || {

        user:
          null,

        guilds:
          [],

        selectedGuild:
          null,

        stats:
          null,

        socket:
          null

      };


    /* =====================================================
       HTML SECURITY HELPERS
    ===================================================== */

    function escapeHTML(value) {

      return String(
        value ?? ''
      )

        .replace(
          /&/g,
          '&amp;'
        )

        .replace(
          /</g,
          '&lt;'
        )

        .replace(
          />/g,
          '&gt;'
        )

        .replace(
          /"/g,
          '&quot;'
        )

        .replace(
          /'/g,
          '&#039;'
        );

    }


    function escapeAttribute(value) {

      return escapeHTML(
        value
      );

    }


    /* =====================================================
       NUMBER FORMAT
    ===================================================== */

    function formatNumber(value) {

      const number =
        Number(value);

      if (
        !Number.isFinite(number)
      ) {

        return '0';

      }

      return new Intl.NumberFormat(
        'fr-FR'
      ).format(
        number
      );

    }


    /* =====================================================
       TOAST
    ===================================================== */

    function showToast(
      message,
      type = 'success'
    ) {

      const container =
        document.getElementById(
          'toast-container'
        );

      if (!container) {
        return;
      }


      const toast =
        document.createElement(
          'div'
        );


      toast.className =
        `toast ${type}`;


      toast.textContent =
        String(message);


      container.appendChild(
        toast
      );


      setTimeout(
        () => {

          toast.style.opacity =
            '0';

          toast.style.transform =
            'translateY(8px)';


          setTimeout(
            () => {

              toast.remove();

            },
            220
          );

        },
        3200
      );

    }


    /* =====================================================
       SIDEBAR
    ===================================================== */

    function toggleSidebar() {

      if (typeof window.toggleOmnixSidebar === 'function') {
        window.toggleOmnixSidebar();
      }

    }


    /* =====================================================
       SESSION
       IMPORTANT:
       OMNIX utilise désormais la session serveur/cookie.
       Aucun JWT n'est lu depuis localStorage.
       Aucun token n'est accepté depuis l'URL.
    ===================================================== */

    function initializeSession() {

      /*
       * Le cookie httpOnly n'est volontairement
       * pas accessible depuis JavaScript.
       *
       * La session sera vérifiée par :
       *
       *     /api/auth/me
       *
       * avec :
       *
       *     credentials: 'include'
       */

      return null;

    }


    /* =====================================================
       LOAD CURRENT USER
    ===================================================== */

    async function loadCurrentUser() {

      try {

        const response =
          await fetch(
            '/api/auth/me',
            {
              method:
                'GET',

              credentials:
                'include',

              cache:
                'no-store',

              headers: {

                Accept:
                  'application/json'

              }

            }
          );


        if (
          response.status === 401
        ) {

          window.location.href =
            '/api/auth/login';

          return null;

        }


        if (!response.ok) {

          throw new Error(
            `HTTP ${response.status}`
          );

        }


        const data =
          await response.json();


        const user =
          data?.user ||
          data;


        if (!user) {

          throw new Error(
            'Utilisateur absent de la réponse.'
          );

        }


        OMNIX.user =
          {
            ...OMNIX.user,
            ...user
          };


        updateUserUI();


        return OMNIX.user;

      } catch (error) {

        console.error(
          '[OMNIX] Impossible de récupérer le profil:',
          error
        );

        return null;

      }

    }


    /* =====================================================
       USER UI
    ===================================================== */

    function updateUserUI() {

      const user =
        OMNIX.user || {};


      const username =
        user.globalName ||
        user.global_name ||
        user.username ||
        user.name ||
        'Utilisateur';


      const avatar =
        user.avatarURL ||
        user.avatarUrl ||
        user.avatar ||
        user.avatar_url ||
        '/logo.png';


      const plan =
        user.plan ||
        user.subscription ||
        (
          user.premium
            ? 'Premium'
            : 'Free'
        );


      const welcome =
        document.getElementById(
          'welcome-title'
        );


      if (welcome) {

        welcome.textContent =
          `Bonjour ${username} 👋`;

      }


      const name =
        document.getElementById(
          'sidebar-user-name'
        );


      if (name) {

        name.textContent =
          username;

      }


      const planElement =
        document.getElementById(
          'sidebar-user-plan'
        );


      if (planElement) {

        planElement.textContent =
          plan;

      }


      const avatarElement =
        document.getElementById(
          'sidebar-user-avatar'
        );


      if (avatarElement) {

        avatarElement.src =
          avatar;


        avatarElement.onerror =
          () => {

            avatarElement.onerror =
              null;

            avatarElement.src =
              '/logo.png';

          };

      }

    }


    /* =====================================================
       API REQUEST
    ===================================================== */

    async function apiRequest(
      url,
      options = {}
    ) {

      const controller =
        new AbortController();


      const timeout =
        setTimeout(
          () => {

            controller.abort();

          },
          options.timeout || 10000
        );


      try {

        const response =
          await fetch(
            url,
            {
              ...options,

              credentials:
                'include',

              cache:
                'no-store',

              signal:
                controller.signal,

              headers: {

                Accept:
                  'application/json',

                ...(options.body
                  ? {
                      'Content-Type':
                        'application/json'
                    }
                  : {}),

                ...(options.headers || {})

              }

            }
          );


        if (
          response.status === 401
        ) {

          window.location.href =
            '/api/auth/login';

          throw new Error(
            'Session expirée'
          );

        }


        const contentType =
          response.headers.get(
            'content-type'
          ) || '';


        let data =
          null;


        if (
          contentType.includes(
            'application/json'
          )
        ) {

          data =
            await response.json();

        }


        if (!response.ok) {

          throw new Error(
            data?.error ||
            data?.message ||
            `HTTP ${response.status}`
          );

        }


        return data;

      } finally {

        clearTimeout(
          timeout
        );

      }

    }


    /* =====================================================
       STATS ANIMATION
    ===================================================== */

    function animateNumber(
      element,
      target,
      duration = 650,
      suffix = ''
    ) {

      if (!element) {
        return;
      }


      const numericTarget =
        Number(target);


      if (
        !Number.isFinite(
          numericTarget
        )
      ) {

        element.textContent =
          '—';

        return;

      }


      const start =
        Number(
          element.dataset.value || 0
        );


      const startTime =
        performance.now();


      function frame(currentTime) {

        const progress =
          Math.min(
            (
              currentTime -
              startTime
            ) / duration,
            1
          );


        const eased =
          1 -
          Math.pow(
            1 - progress,
            3
          );


        const value =
          Math.round(
            start +
            (
              numericTarget -
              start
            ) *
            eased
          );


        element.textContent =
          `${formatNumber(value)}${suffix}`;


        if (
          progress < 1
        ) {

          requestAnimationFrame(
            frame
          );

        } else {

          element.dataset.value =
            numericTarget;

        }

      }


      requestAnimationFrame(
        frame
      );

    }


    function updateStat(
      id,
      value,
      suffix = ''
    ) {

      const element =
        document.getElementById(
          id
        );


      if (!element) {
        return;
      }


      if (
        value === null ||
        value === undefined
      ) {

        element.textContent =
          '—';

        return;

      }


      animateNumber(
        element,
        value,
        650,
        suffix
      );

    }


    /* =====================================================
       CONNECTION STATUS
    ===================================================== */

    function updateConnectionStatus(
      online
    ) {

      const status =
        document.getElementById(
          'system-status'
        );


      if (!status) {
        return;
      }


      if (online) {

        status.innerHTML = `

          <span
            class="status-dot"
          ></span>

          Tous les systèmes opérationnels

        `;


        status.style.color =
          '#6ee7b7';


        status.style.background =
          'rgba(16,185,129,.07)';


        status.style.borderColor =
          'rgba(16,185,129,.15)';

      } else {

        status.innerHTML = `

          <span
            class="status-dot"
            style="
              background:#f59e0b;
              box-shadow:
                0 0 10px
                rgba(245,158,11,.8);
            "
          ></span>

          Connexion instable

        `;


        status.style.color =
          '#fbbf24';


        status.style.background =
          'rgba(245,158,11,.07)';


        status.style.borderColor =
          'rgba(245,158,11,.15)';

      }

    }


    /* =====================================================
       EXPORT BASIC API
    ===================================================== */

    window.OMNIXDashboard =
      window.OMNIXDashboard || {

        toggleSidebar:
          toggleSidebar,

        showToast:
          showToast,

        refreshStats:
          null,

        refreshGuilds:
          null,

        selectGuild:
          null,

        openGuild:
          null,

        state:
          OMNIX

      };

  </script>
  
    <script>

    /* =====================================================
       GUILD HELPERS
    ===================================================== */

    function normalizeGuild(guild) {

      if (!guild || typeof guild !== 'object') {
        return null;
      }

      return {
        ...guild,

        id:
          guild.id ||
          guild.guildId ||
          guild.guild_id ||
          null,

        name:
          guild.name ||
          guild.guildName ||
          'Serveur sans nom',

        icon:
          guild.iconURL ||
          guild.iconUrl ||
          guild.icon_url ||
          guild.icon ||
          '/logo.png',

        memberCount:
          guild.memberCount ??
          guild.members ??
          guild.membersCount ??
          0,

        botPresent:
          guild.botPresent ??
          guild.bot ??
          true
      };

    }


    function getGuildIcon(guild) {

      if (!guild) {
        return '/logo.png';
      }

      return (
        guild.iconURL ||
        guild.iconUrl ||
        guild.icon_url ||
        guild.icon ||
        '/logo.png'
      );

    }


    function getGuildId(guild) {

      if (!guild) {
        return null;
      }

      return (
        guild.id ||
        guild.guildId ||
        guild.guild_id ||
        null
      );

    }


    /* =====================================================
       SERVER FILTER
    ===================================================== */

    function getFilteredGuilds() {

      const input =
        document.getElementById(
          'server-search'
        );

      const search =
        input
          ? input.value.trim().toLowerCase()
          : '';

      if (!search) {

        return [
          ...OMNIX.guilds
        ];

      }

      return OMNIX.guilds.filter(
        guild => {

          const name =
            String(
              guild?.name || ''
            ).toLowerCase();

          const id =
            String(
              guild?.id || ''
            ).toLowerCase();

          return (
            name.includes(search) ||
            id.includes(search)
          );

        }
      );

    }


    /* =====================================================
       RENDER SERVERS
    ===================================================== */

    function renderGuilds() {

      const container =
        document.getElementById(
          'servers-container'
        );

      if (!container) {
        return;
      }


      const guilds =
        getFilteredGuilds();


      if (!guilds.length) {

        container.innerHTML = `

          <div
            class="empty-state"
            style="grid-column:1/-1;"
          >

            <div class="empty-icon">
              🔎
            </div>

            <strong>
              Aucun serveur trouvé
            </strong>

            <p>
              Aucun serveur ne correspond à votre recherche.
            </p>

          </div>

        `;

        return;

      }


      container.innerHTML =
        guilds
          .map(
            guild => {

              const id =
                getGuildId(
                  guild
                );

              const name =
                escapeHTML(
                  guild.name
                );

              const icon =
                escapeAttribute(
                  getGuildIcon(
                    guild
                  )
                );

              const memberCount =
                formatNumber(
                  guild.memberCount || 0
                );

              const selected =
                OMNIX.selectedGuild &&
                getGuildId(
                  OMNIX.selectedGuild
                ) === id;


              return `

                <article
                  class="
                    server-card
                    ${selected ? 'selected' : ''}
                  "
                  data-guild-id="${escapeAttribute(id)}"
                  onclick="
                    selectGuild(
                      '${escapeAttribute(id)}'
                    )
                  "
                >

                  <img
                    class="server-icon"
                    src="${icon}"
                    alt="${name}"
                    loading="lazy"
                    onerror="
                      this.onerror=null;
                      this.src='/logo.png';
                    "
                  >

                  <div class="server-details">

                    <span class="server-name">
                      ${name}
                    </span>

                    <span class="server-meta">
                      ${memberCount} membres
                    </span>

                  </div>

                  <span
                    class="server-status"
                    title="Serveur accessible"
                  ></span>

                </article>

              `;

            }
          )
          .join('');

    }


    /* =====================================================
       LOAD GUILDS
    ===================================================== */

    async function refreshGuilds() {

      const container =
        document.getElementById(
          'servers-container'
        );


      if (container) {

        container.innerHTML = `

          <div
            class="empty-state"
            style="grid-column:1/-1;"
          >

            <div class="empty-icon">
              ⏳
            </div>

            <strong>
              Chargement des serveurs...
            </strong>

            <p>
              Récupération de vos serveurs Discord.
            </p>

          </div>

        `;

      }


      try {

        /*
         * La route de récupération des serveurs
         * reste centralisée ici.
         *
         * Le backend doit retourner soit :
         *
         *     { guilds: [...] }
         *
         * soit directement :
         *
         *     [...]
         */

        const data =
          await apiRequest(
            '/api/guilds?refresh=1'
          );


        const guildList =
          Array.isArray(data)
            ? data
            : (
                data?.guilds ||
                data?.servers ||
                data?.data ||
                []
              );


        OMNIX.guilds =
          guildList
            .map(
              normalizeGuild
            )
            .filter(
              Boolean
            );


        renderGuilds();


        if (
          OMNIX.guilds.length === 0
        ) {

          showToast(
            'Aucun serveur Discord accessible.',
            'error'
          );

        }


        return OMNIX.guilds;

      } catch (error) {

        console.error(
          '[OMNIX] Erreur lors du chargement des serveurs:',
          error
        );


        if (container) {

          container.innerHTML = `

            <div
              class="empty-state"
              style="grid-column:1/-1;"
            >

              <div class="empty-icon">
                ⚠️
              </div>

              <strong>
                Impossible de charger les serveurs
              </strong>

              <p>
                Une erreur est survenue pendant la récupération
                de vos serveurs Discord.
              </p>

              <div
                style="
                  margin-top:14px;
                "
              >

                <button
                  type="button"
                  class="btn btn-secondary"
                  onclick="refreshGuilds()"
                >
                  ↻ Réessayer
                </button>

              </div>

            </div>

          `;

        }


        updateConnectionStatus(
          false
        );


        return [];

      }

    }


    /* =====================================================
       SELECT GUILD
    ===================================================== */

    function selectGuild(
      guildId
    ) {

      if (!guildId) {
        return;
      }


      const guild =
        OMNIX.guilds.find(
          item =>
            String(
              getGuildId(item)
            ) === String(
              guildId
            )
        );


      if (!guild) {

        showToast(
          'Serveur introuvable.',
          'error'
        );

        return;

      }


      OMNIX.selectedGuild =
        guild;


      renderGuilds();


      openGuild(
        guild
      );

    }


    /* =====================================================
       OPEN GUILD
    ===================================================== */

    function openGuild(
      guild
    ) {

      if (!guild) {
        return;
      }


      const guildId =
        getGuildId(
          guild
        );


      if (!guildId) {

        showToast(
          'Identifiant du serveur invalide.',
          'error'
        );

        return;

      }


      OMNIX.selectedGuild =
        guild;


      /*
       * Navigation vers la configuration
       * du serveur sélectionné.
       *
       * L'identifiant reste dans le chemin
       * et non dans un token d'authentification.
       */

      window.location.href =
        `/dashboard/${encodeURIComponent(
          guildId
        )}`;

    }


    /* =====================================================
       LOAD STATS
    ===================================================== */

    async function refreshStats() {

      try {

        const data =
          await apiRequest(
            '/api/stats'
          );


        OMNIX.stats =
          data;


        /*
         * Compatibilité avec plusieurs formes
         * de réponse backend déjà utilisées
         * par OMNIX.
         */

        const stats =
          data?.stats ||
          data?.data ||
          data ||
          {};


        const bot =
          stats?.bot ||
          {};


        const database =
          stats?.database ||
          {};


        const servers =
          stats?.servers ??
          stats?.guilds ??
          stats?.guildCount ??
          bot?.guildsCount ??
          0;


        const members =
          stats?.members ??
          stats?.memberCount ??
          stats?.membersCount ??
          bot?.membersCount ??
          database?.totalMembers ??
          0;


        const commands =
          stats?.commands ??
          stats?.commandsCount ??
          bot?.commandsCount ??
          0;


        const ping =
          stats?.ping ??
          stats?.latency ??
          bot?.ping ??
          bot?.latency ??
          null;


        updateStat(
          'stat-servers',
          servers
        );


        updateStat(
          'stat-members',
          members
        );


        updateStat(
          'stat-commands',
          commands
        );


        updateStat(
          'stat-ping',
          ping,
          ping !== null ? ' ms' : ''
        );

        updateStat('stat-ai', Number(stats?.user?.aiRequests ?? 0));
        const planEl = document.getElementById('stat-plan');
        if (planEl) planEl.textContent = String(stats?.user?.plan || (OMNIX.user?.isPremium ? 'Premium' : 'Free')).toUpperCase();


        updateConnectionStatus(
          true
        );


        return stats;

      } catch (error) {

        console.error(
          '[OMNIX] Erreur statistiques:',
          error
        );


        updateConnectionStatus(
          false
        );


        return null;

      }

    }


    /* =====================================================
       SEARCH EVENTS
    ===================================================== */

    function initializeServerSearch() {

      const input =
        document.getElementById(
          'server-search'
        );


      if (!input) {
        return;
      }


      input.addEventListener(
        'input',
        () => {

          renderGuilds();

        }
      );

    }


    /* =====================================================
       SOCKET.IO
    ===================================================== */

    function initializeSocket() {

      if (
        typeof io !== 'function'
      ) {

        console.warn(
          '[OMNIX] Socket.IO non disponible.'
        );

        return null;

      }


      try {

        const socket =
          io(
            {
              withCredentials:
                true,

              transports:
                [
                  'websocket',
                  'polling'
                ]
            }
          );


        OMNIX.socket =
          socket;


        socket.on(
          'connect',
          () => {

            console.info(
              '[OMNIX] Socket.IO connecté:',
              socket.id
            );


            updateConnectionStatus(
              true
            );

          }
        );


        socket.on(
          'disconnect',
          reason => {

            console.warn(
              '[OMNIX] Socket.IO déconnecté:',
              reason
            );


            updateConnectionStatus(
              false
            );

          }
        );


        socket.on(
          'connect_error',
          error => {

            console.error(
              '[OMNIX] Socket.IO erreur:',
              error
            );


            updateConnectionStatus(
              false
            );

          }
        );


        /*
         * Mise à jour des statistiques
         * envoyée par le serveur.
         */

        socket.on(
          'stats:update',
          payload => {

            if (!payload) {
              return;
            }


            OMNIX.stats =
              payload;


            const stats =
              payload?.stats ||
              payload?.data ||
              payload ||
              {};


            const bot =
              stats?.bot ||
              {};


            const database =
              stats?.database ||
              {};


            updateStat(
              'stat-servers',
              stats?.servers ??
              stats?.guilds ??
              bot?.guildsCount ??
              0
            );


            updateStat(
              'stat-members',
              stats?.members ??
              stats?.memberCount ??
              bot?.membersCount ??
              database?.totalMembers ??
              0
            );


            updateStat(
              'stat-commands',
              stats?.commands ??
              stats?.commandsCount ??
              bot?.commandsCount ??
              0
            );


            updateStat(
              'stat-ping',
              stats?.ping ??
              stats?.latency ??
              bot?.ping ??
              bot?.latency ??
              null,
              ' ms'
            );

          }
        );


        /*
         * Si le backend signale une modification
         * des serveurs, on recharge la liste.
         */

        socket.on(
          'guilds:update',
          () => {

            refreshGuilds();

          }
        );


        socket.on(
          'guild:update',
          () => {

            refreshGuilds();

          }
        );


        return socket;

      } catch (error) {

        console.error(
          '[OMNIX] Impossible d'initialiser Socket.IO:',
          error
        );


        return null;

      }

    }


    /* =====================================================
       REFRESH EVERYTHING
    ===================================================== */

    async function refreshDashboard() {

      await Promise.allSettled(
        [
          loadCurrentUser(),
          refreshStats(),
          refreshGuilds()
        ]
      );

    }


    /* =====================================================
       INITIALIZATION
    ===================================================== */

    async function initializeDashboard() {

      console.info(
        '[OMNIX] Initialisation du dashboard...'
      );


      initializeSession();


      initializeServerSearch();


      initializeSocket();


      /*
       * Les données sont chargées uniquement
       * après l'initialisation de la session.
       */

      const user =
        await loadCurrentUser();


      if (!user) {

        return;

      }


      await Promise.allSettled(
        [
          refreshStats(),
          refreshGuilds()
        ]
      );


      console.info(
        '[OMNIX] Dashboard initialisé.'
      );

    }


    /* =====================================================
       GLOBAL API
    ===================================================== */

    window.OMNIXDashboard =
      {
        ...window.OMNIXDashboard,

        toggleSidebar:
          toggleSidebar,

        showToast:
          showToast,

        refreshStats:
          refreshStats,

        refreshGuilds:
          refreshGuilds,

        refreshDashboard:
          refreshDashboard,

        selectGuild:
          selectGuild,

        openGuild:
          openGuild,

        renderGuilds:
          renderGuilds,

        state:
          OMNIX

      };


    /* =====================================================
       DOM READY
    ===================================================== */

    if (
      document.readyState ===
      'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        initializeDashboard,
        {
          once:
            true
        }
      );

    } else {

      initializeDashboard();

    }


    /* =====================================================
       WINDOW EVENTS
    ===================================================== */

    window.addEventListener(
      'resize',
      () => {

        if (
          window.innerWidth > 800
        ) {

          const sidebar =
            document.getElementById(
              'dashboard-sidebar'
            );


          if (sidebar) {

            sidebar.classList.remove(
              'open'
            );

          }

        }

      }
    );


    /* =====================================================
       ESCAPE — CLOSE MOBILE SIDEBAR
    ===================================================== */

    document.addEventListener(
      'keydown',
      event => {

        if (
          event.key !== 'Escape'
        ) {

          return;

        }


        const sidebar =
          document.getElementById(
            'dashboard-sidebar'
          );


        if (sidebar) {

          sidebar.classList.remove(
            'open'
          );

        }

      }
    );

  </script>


</body>

</html>