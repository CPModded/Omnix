<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#080b14"
  >

  <title>OMNIX — Dashboard</title>

  <link
    rel="icon"
    href="/logo.png"
  >

  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #070a12;
      --bg-secondary: #0b0f1a;
      --panel: rgba(15, 20, 34, .82);
      --panel-strong: #101628;

      --border: rgba(255,255,255,.08);
      --border-hover: rgba(124,92,255,.35);

      --text: #f8fafc;
      --muted: #8d98ad;

      --primary: #7c5cff;
      --primary-2: #4f46e5;

      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;

      --sidebar-width: 260px;
      --header-height: 72px;

      --radius: 16px;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    body {
      overflow-x: hidden;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* =====================================================
       BACKGROUND
    ===================================================== */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;

      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(124,92,255,.12),
          transparent 30%
        ),
        radial-gradient(
          circle at 90% 20%,
          rgba(79,70,229,.10),
          transparent 30%
        );

      z-index: -2;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;

      background-image:
        linear-gradient(
          rgba(255,255,255,.018) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255,255,255,.018) 1px,
          transparent 1px
        );

      background-size: 40px 40px;

      pointer-events: none;
      opacity: .25;

      z-index: -1;
    }

    /* =====================================================
       APP
    ===================================================== */

    .app {
      min-height: 100vh;
      display: flex;
    }

    /* =====================================================
       SIDEBAR
    ===================================================== */

    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;

      width: var(--sidebar-width);

      background:
        rgba(8,11,20,.92);

      backdrop-filter:
        blur(24px);

      border-right:
        1px solid var(--border);

      display: flex;
      flex-direction: column;

      z-index: 1000;

      transition:
        transform .25s ease;
    }

    .sidebar-header {
      height: var(--header-height);

      display: flex;
      align-items: center;

      padding: 0 20px;

      border-bottom:
        1px solid var(--border);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;

      font-weight: 900;
      letter-spacing: -.4px;
    }

    .brand img {
      width: 38px;
      height: 38px;

      border-radius: 12px;

      object-fit: cover;

      box-shadow:
        0 0 25px rgba(124,92,255,.3);
    }

    .brand span {
      font-size: 18px;
    }

    .brand small {
      display: block;

      margin-top: 2px;

      color: var(--muted);
      font-size: 9px;
      font-weight: 700;

      letter-spacing: .8px;
      text-transform: uppercase;
    }

    .sidebar-content {
      flex: 1;

      padding: 18px 12px;

      overflow-y: auto;
    }

    .sidebar-section {
      margin-bottom: 22px;
    }

    .sidebar-title {
      padding:
        0 11px
        8px;

      color: #667085;

      font-size: 10px;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .nav-item {
      width: 100%;

      display: flex;
      align-items: center;

      gap: 11px;

      padding: 11px 12px;

      margin-bottom: 4px;

      border-radius: 11px;

      color: #9ca7bb;

      cursor: pointer;

      transition:
        background .18s ease,
        color .18s ease,
        transform .18s ease;
    }

    .nav-item:hover {
      background:
        rgba(124,92,255,.08);

      color: white;

      transform:
        translateX(2px);
    }

    .nav-item.active {
      background:
        linear-gradient(
          135deg,
          rgba(124,92,255,.20),
          rgba(79,70,229,.12)
        );

      color: white;

      border:
        1px solid
        rgba(124,92,255,.15);
    }

    .nav-icon {
      width: 20px;

      display: flex;
      justify-content: center;

      font-size: 15px;
    }

    .nav-label {
      flex: 1;

      font-size: 12px;
      font-weight: 700;
    }

    .nav-badge {
      padding:
        3px 6px;

      border-radius: 6px;

      background:
        rgba(124,92,255,.16);

      color:
        #b7aaff;

      font-size: 9px;
      font-weight: 900;
    }

    .sidebar-user {
      padding: 14px;

      border-top:
        1px solid var(--border);
    }

    .user-card {
      display: flex;
      align-items: center;

      gap: 10px;

      padding: 10px;

      border-radius: 12px;

      background:
        rgba(255,255,255,.025);
    }

    .user-avatar {
      width: 34px;
      height: 34px;

      border-radius: 50%;

      object-fit: cover;

      background:
        #151b2b;
    }

    .user-info {
      min-width: 0;
      flex: 1;
    }

    .user-name {
      font-size: 11px;
      font-weight: 800;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .user-plan {
      color: var(--muted);

      font-size: 9px;

      margin-top: 2px;
    }

    /* =====================================================
       MAIN
    ===================================================== */

    .main {
      width: calc(
        100% - var(--sidebar-width)
      );

      margin-left:
        var(--sidebar-width);

      min-height: 100vh;
    }

    /* =====================================================
       HEADER
    ===================================================== */

    .header {
      height: var(--header-height);

      position: sticky;
      top: 0;

      z-index: 500;

      display: flex;
      align-items: center;

      justify-content: space-between;

      padding:
        0 26px;

      background:
        rgba(7,10,18,.72);

      backdrop-filter:
        blur(20px);

      border-bottom:
        1px solid var(--border);
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .mobile-menu {
      display: none;

      width: 38px;
      height: 38px;

      border-radius: 10px;

      background:
        rgba(255,255,255,.05);

      color: white;

      cursor: pointer;
    }

    .page-title {
      font-size: 18px;
      font-weight: 900;
    }

    .page-subtitle {
      margin-top: 2px;

      color: var(--muted);

      font-size: 10px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .status-pill {
      display: flex;
      align-items: center;
      gap: 7px;

      padding:
        8px 12px;

      border-radius: 999px;

      background:
        rgba(16,185,129,.07);

      border:
        1px solid
        rgba(16,185,129,.15);

      color: #6ee7b7;

      font-size: 10px;
      font-weight: 800;
    }

    .status-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: #10b981;

      box-shadow:
        0 0 10px
        rgba(16,185,129,.8);
    }

    /* =====================================================
       CONTENT
    ===================================================== */

    .content {
      padding: 28px;
      max-width: 1500px;
      margin: auto;
    }

    .welcome {
      margin-bottom: 24px;
    }

    .welcome h1 {
      font-size: 28px;
      line-height: 1.15;

      font-weight: 950;

      letter-spacing: -.8px;
    }

    .welcome p {
      margin-top: 7px;

      color: var(--muted);

      font-size: 12px;
    }

    /* =====================================================
       STATS
    ===================================================== */

    .stats-grid {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 14px;

      margin-bottom: 24px;
    }

    .stat-card {
      position: relative;

      padding: 18px;

      border-radius: var(--radius);

      background:
        linear-gradient(
          145deg,
          rgba(18,24,40,.92),
          rgba(10,14,25,.92)
        );

      border:
        1px solid var(--border);

      overflow: hidden;

      transition:
        transform .2s ease,
        border-color .2s ease;
    }

    .stat-card:hover {
      transform:
        translateY(-2px);

      border-color:
        var(--border-hover);
    }

    .stat-card::after {
      content: "";

      position: absolute;

      width: 100px;
      height: 100px;

      right: -45px;
      bottom: -45px;

      border-radius: 50%;

      background:
        rgba(124,92,255,.08);
    }

    .stat-label {
      color: var(--muted);

      font-size: 10px;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: .7px;
    }

    .stat-value {
      margin-top: 9px;

      font-size: 26px;
      font-weight: 950;

      letter-spacing: -.7px;
    }

    .stat-description {
      margin-top: 5px;

      color: #657086;

      font-size: 9px;
    }

    /* =====================================================
       SERVER SECTION
    ===================================================== */

    .section {
      margin-bottom: 25px;
    }

    .section-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      margin-bottom: 12px;
    }

    .section-heading h2 {
      font-size: 15px;
      font-weight: 900;
    }

    .section-heading p {
      margin-top: 3px;

      color: var(--muted);

      font-size: 10px;
    }

    .section-actions {
      display: flex;
      gap: 8px;
    }

    .btn {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 7px;

      padding:
        9px 13px;

      border-radius: 9px;

      cursor: pointer;

      font-size: 10px;
      font-weight: 800;

      transition:
        transform .18s ease,
        opacity .18s ease,
        background .18s ease;
    }

    .btn:hover {
      transform:
        translateY(-1px);
    }

    .btn-primary {
      background:
        linear-gradient(
          135deg,
          #7c5cff,
          #4f46e5
        );

      color: white;

      box-shadow:
        0 8px 25px
        rgba(79,70,229,.18);
    }

    .btn-secondary {
      background:
        rgba(255,255,255,.05);

      color: #dbe2ef;

      border:
        1px solid var(--border);
    }

    .server-toolbar {
      display: flex;

      gap: 10px;

      margin-bottom: 14px;
    }

    .search-box {
      flex: 1;

      position: relative;
    }

    .search-box input {
      width: 100%;

      height: 40px;

      padding:
        0 13px;

      border-radius: 10px;

      border:
        1px solid var(--border);

      outline: none;

      background:
        rgba(255,255,255,.035);

      color: white;

      font-size: 11px;
    }

    .search-box input::placeholder {
      color: #667085;
    }

    .search-box input:focus {
      border-color:
        rgba(124,92,255,.4);

      background:
        rgba(255,255,255,.045);
    }

    /* =====================================================
       SERVER GRID
    ===================================================== */

    #servers-container {
      display: grid;

      grid-template-columns:
        repeat(
          auto-fill,
          minmax(240px, 1fr)
        );

      gap: 12px;
    }

    .server-card {
      display: flex;

      align-items: center;

      gap: 11px;

      min-width: 0;

      padding: 13px;

      border-radius: 13px;

      background:
        rgba(15,20,34,.78);

      border:
        1px solid var(--border);

      cursor: pointer;

      transition:
        transform .18s ease,
        border-color .18s ease,
        background .18s ease;
    }

    .server-card:hover {
      transform:
        translateY(-2px);

      border-color:
        rgba(124,92,255,.3);

      background:
        rgba(20,26,44,.9);
    }

    .server-card.selected {
      border-color:
        rgba(124,92,255,.55);

      box-shadow:
        0 0 0 1px
        rgba(124,92,255,.08),
        0 10px 30px
        rgba(0,0,0,.18);
    }

    .server-icon {
      width: 45px;
      height: 45px;

      flex-shrink: 0;

      border-radius: 12px;

      object-fit: cover;

      background:
        #161c2c;
    }

    .server-details {
      min-width: 0;
      flex: 1;
    }

    .server-name {
      display: block;

      overflow: hidden;

      white-space: nowrap;
      text-overflow: ellipsis;

      font-size: 11px;
      font-weight: 850;
    }

    .server-meta {
      display: block;

      margin-top: 4px;

      color: var(--muted);

      font-size: 9px;
    }

    .server-status {
      width: 7px;
      height: 7px;

      flex-shrink: 0;

      border-radius: 50%;

      background:
        #10b981;

      box-shadow:
        0 0 8px
        rgba(16,185,129,.7);
    }

    /* =====================================================
       EMPTY STATE
    ===================================================== */

    .empty-state {
      padding: 45px 20px;

      text-align: center;

      border:
        1px dashed
        rgba(255,255,255,.09);

      border-radius: 15px;

      background:
        rgba(255,255,255,.018);
    }

    .empty-icon {
      font-size: 30px;
      margin-bottom: 12px;
    }

    .empty-state strong {
      display: block;

      font-size: 13px;
    }

    .empty-state p {
      max-width: 420px;

      margin:
        7px auto 0;

      color: var(--muted);

      font-size: 10px;
      line-height: 1.6;
    }

    /* =====================================================
       TOAST
    ===================================================== */

    #toast-container {
      position: fixed;

      right: 20px;
      bottom: 20px;

      display: flex;
      flex-direction: column;

      gap: 9px;

      z-index: 5000;
    }

    .toast {
      min-width: 260px;

      padding: 13px 15px;

      border-radius: 12px;

      background:
        rgba(16,22,38,.96);

      border:
        1px solid var(--border);

      box-shadow:
        0 20px 50px
        rgba(0,0,0,.3);

      color: white;

      font-size: 11px;
      font-weight: 700;

      animation:
        toastIn .22s ease;
    }

    .toast.error {
      border-color:
        rgba(239,68,68,.3);
    }

    .toast.success {
      border-color:
        rgba(16,185,129,.3);
    }

    @keyframes toastIn {
      from {
        opacity: 0;
        transform:
          translateY(10px);
      }

      to {
        opacity: 1;
        transform:
          translateY(0);
      }
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (
      max-width: 1100px
    ) {

      .stats-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media (
      max-width: 800px
    ) {

      :root {
        --sidebar-width: 260px;
      }

      .sidebar {
        transform:
          translateX(-100%);
      }

      .sidebar.open {
        transform:
          translateX(0);
      }

      .main {
        width: 100%;
        margin-left: 0;
      }

      .mobile-menu {
        display: block;
      }

      .header {
        padding:
          0 15px;
      }

      .content {
        padding: 18px 14px;
      }

      .status-pill {
        display: none;
      }

    }

    @media (
      max-width: 520px
    ) {

      .stats-grid {
        grid-template-columns:
          1fr;
      }

      .server-toolbar {
        flex-direction: column;
      }

      .welcome h1 {
        font-size: 23px;
      }

      #servers-container {
        grid-template-columns:
          1fr;
      }

    }

  </style>
</head>

<body>

  <div class="app">

    <!-- ===================================================
         SIDEBAR
    ==================================================== -->

    <aside
      class="sidebar"
      id="dashboard-sidebar"
    >

      <div class="sidebar-header">

        <a
          href="/dashboard"
          class="brand"
        >

          <img
            src="/logo.png"
            alt="OMNIX"
            onerror="
              this.style.display='none'
            "
          >

          <div>
            <span>OMNIX</span>

            <small>
              Le robot de demain
            </small>
          </div>

        </a>

      </div>

      <div class="sidebar-content">

        <div class="sidebar-section">

          <div class="sidebar-title">
            Dashboard
          </div>

          <a
            class="nav-item active"
            href="/dashboard"
          >

            <span class="nav-icon">
              ◈
            </span>

            <span class="nav-label">
              Vue générale
            </span>

          </a>

          <a
            class="nav-item"
            href="/dashboard"
          >

            <span class="nav-icon">
              ◫
            </span>

            <span class="nav-label">
              Mes serveurs
            </span>

          </a>

        </div>

        <div class="sidebar-section">

          <div class="sidebar-title">
            OMNIX
          </div>

          <a
            class="nav-item"
            href="/premium"
          >

            <span class="nav-icon">
              ◆
            </span>

            <span class="nav-label">
              Premium
            </span>

            <span class="nav-badge">
              PRO
            </span>

          </a>

          <a
            class="nav-item"
            href="/support"
          >

            <span class="nav-icon">
              ?
            </span>

            <span class="nav-label">
              Support
            </span>

          </a>

        </div>

      </div>

      <div class="sidebar-user">

        <div class="user-card">

          <img
            id="sidebar-user-avatar"
            class="user-avatar"
            src="/logo.png"
            alt=""
          >

          <div class="user-info">

            <div
              id="sidebar-user-name"
              class="user-name"
            >
              Chargement...
            </div>

            <div
              id="sidebar-user-plan"
              class="user-plan"
            >
              Compte OMNIX
            </div>

          </div>

        </div>

      </div>

    </aside>


    <!-- ===================================================
         MAIN
    ==================================================== -->

    <main class="main">

      <header class="header">

        <div class="header-left">

          <button
            type="button"
            class="mobile-menu"
            onclick="toggleSidebar()"
            aria-label="Menu"
          >
            ☰
          </button>

          <div>

            <div class="page-title">
              Dashboard
            </div>

            <div class="page-subtitle">
              Gestion de votre environnement OMNIX
            </div>

          </div>

        </div>

        <div class="header-actions">

          <div
            class="status-pill"
          >

            <span
              class="status-dot"
            ></span>

            Tous les systèmes opérationnels

          </div>

        </div>

      </header>


      <section class="content">

        <div class="welcome">

          <h1 id="welcome-title">
            Bonjour 👋
          </h1>

          <p>
            Gérez vos serveurs Discord et
            contrôlez OMNIX depuis un seul endroit.
          </p>

        </div>


        <!-- =================================================
             STATS
        ================================================== -->

        <section class="section">

          <div class="stats-grid">

            <article class="stat-card">

              <div class="stat-label">
                Serveurs
              </div>

              <div
                class="stat-value"
                id="stat-servers"
                data-value="0"
              >
                —
              </div>

              <div class="stat-description">
                Serveurs Discord accessibles
              </div>

            </article>


            <article class="stat-card">

              <div class="stat-label">
                Membres
              </div>

              <div
                class="stat-value"
                id="stat-members"
                data-value="0"
              >
                —
              </div>

              <div class="stat-description">
                Membres suivis par OMNIX
              </div>

            </article>


            <article class="stat-card">

              <div class="stat-label">
                Commandes
              </div>

              <div
                class="stat-value"
                id="stat-commands"
                data-value="0"
              >
                —
              </div>

              <div class="stat-description">
                Commandes disponibles
              </div>

            </article>


            <article class="stat-card">

              <div class="stat-label">
                Latence
              </div>

              <div
                class="stat-value"
                id="stat-ping"
                data-value="0"
              >
                —
              </div>

              <div class="stat-description">
                Temps de réponse du bot
              </div>

            </article>

          </div>

        </section>


        <!-- =================================================
             SERVERS
        ================================================== -->

        <section class="section">

          <div class="section-header">

            <div class="section-heading">

              <h2>
                Vos serveurs Discord
              </h2>

              <p>
                Sélectionnez un serveur pour
                accéder à sa configuration.
              </p>

            </div>

            <div class="section-actions">

              <button
                type="button"
                class="btn btn-secondary"
                onclick="refreshGuilds()"
              >
                ↻ Actualiser
              </button>

            </div>

          </div>


          <div class="server-toolbar">

            <div class="search-box">

              <input
                id="server-search"
                type="search"
                placeholder="Rechercher un serveur..."
                autocomplete="off"
              >

            </div>

          </div>


          <div
            id="servers-container"
          >

            <div
              class="empty-state"
              style="grid-column:1/-1;"
            >

              <div class="empty-icon">
                ⏳
              </div>

              <strong>
                Chargement des serveurs...
              </strong>

              <p>
                Récupération de vos serveurs Discord.
              </p>

            </div>

          </div>

        </section>

      </section>

    </main>

  </div>


  <!-- =====================================================
       TOAST CONTAINER
  ====================================================== -->

  <div
    id="toast-container"
    aria-live="polite"
    aria-atomic="true"
  ></div>


  <script>

    /* =====================================================
       OMNIX GLOBAL STATE
    ===================================================== */

    window.OMNIX =
      window.OMNIX || {

        user: null,

        guilds: [],

        selectedGuild: null,

        stats: null

      };


    /* =====================================================
       HTML SECURITY HELPERS
    ===================================================== */

    function escapeHTML(
      value
    ) {

      return String(
        value ?? ''
      )
      .replace(
        /&/g,
        '&amp;'
      )
      .replace(
        /</g,
        '&lt;'
      )
      .replace(
        />/g,
        '&gt;'
      )
      .replace(
        /"/g,
        '&quot;'
      )
      .replace(
        /'/g,
        '&#039;'
      );

    }


    function escapeAttribute(
      value
    ) {

      return escapeHTML(
        value
      );

    }


    /* =====================================================
       NUMBER FORMAT
    ===================================================== */

    function formatNumber(
      value
    ) {

      const number =
        Number(value);

      if (
        !Number.isFinite(number)
      ) {

        return '0';

      }

      return new Intl.NumberFormat(
        'fr-FR'
      ).format(
        number
      );

    }


    /* =====================================================
       TOAST
    ===================================================== */

    function showToast(
      message,
      type = 'success'
    ) {

      const container =
        document.getElementById(
          'toast-container'
        );

      if (!container) {
        return;
      }

      const toast =
        document.createElement(
          'div'
        );

      toast.className =
        `toast ${type}`;

      toast.textContent =
        String(message);

      container.appendChild(
        toast
      );

      setTimeout(
        () => {

          toast.style.opacity =
            '0';

          toast.style.transform =
            'translateY(8px)';

          setTimeout(
            () => toast.remove(),
            220
          );

        },
        3200
      );

    }


    /* =====================================================
       SIDEBAR
    ===================================================== */

    function toggleSidebar() {

      const sidebar =
        document.getElementById(
          'dashboard-sidebar'
        );

      sidebar?.classList.toggle(
        'open'
      );

    }


    /* =====================================================
       JWT HELPERS
    ===================================================== */

    function decodeJwt(
      token
    ) {

      try {

        const parts =
          String(token)
            .split('.');

        if (
          parts.length !== 3
        ) {

          return null;

        }

        const payload =
          parts[1]
            .replace(
              /-/g,
              '+'
            )
            .replace(
              /_/g,
              '/'
            );

        const decoded =
          atob(
            payload
          );

        return JSON.parse(
          decodeURIComponent(
            Array.from(
              decoded
            )
            .map(
              char =>
                `%${(
                  '00' +
                  char
                    .charCodeAt(0)
                    .toString(16)
                ).slice(-2)}`
            )
            .join('')
          )
        );

      } catch {

        return null;

      }

    }


    function getStoredToken() {

      const keys = [
        'omnix_token',
        'token',
        'jwt',
        'access_token'
      ];

      for (
        const key of keys
      ) {

        try {

          const value =
            localStorage.getItem(
              key
            );

          if (value) {
            return value;
          }

        } catch {}

      }

      return null;

    }


    /* =====================================================
       SESSION
    ===================================================== */

    function initializeSession() {

      let token =
        getStoredToken();

      try {

        const params =
          new URLSearchParams(
            window.location.search
          );

        const queryToken =
          params.get(
            'token'
          );

        if (queryToken) {

          token =
            queryToken;

          localStorage.setItem(
            'omnix_token',
            queryToken
          );

          const cleanUrl =
            window.location.pathname;

          window.history.replaceState(
            {},
            document.title,
            cleanUrl
          );

        }

      } catch {}

      if (!token) {
        return null;
      }

      const payload =
        decodeJwt(token);

      if (!payload) {
        return null;
      }

      OMNIX.user =
        payload;

      return payload;

    }


    /* =====================================================
       LOAD USER
    ===================================================== */

    async function loadCurrentUser() {

      try {

        const response =
          await fetch(
            '/api/auth/me',
            {
              credentials: 'include',
              headers: {
                Accept:
                  'application/json'
              }
            }
          );

        if (!response.ok) {

          return;

        }

        const data =
          await response.json();

        const user =
          data?.user ||
          data;

        if (!user) {
          return;
        }

        OMNIX.user =
          {
            ...OMNIX.user,
            ...user
          };

        updateUserUI();

      } catch (error) {

        console.warn(
          '[OMNIX] Impossible de récupérer le profil:',
          error
        );

      }

    }


    /* =====================================================
       USER UI
    ===================================================== */

    function updateUserUI() {

      const user =
        OMNIX.user ||
        {};

      const username =
        user.username ||
        user.global_name ||
        user.name ||
        'Utilisateur';

      const avatar =
        user.avatarURL ||
        user.avatarUrl ||
        user.avatar ||
        user.avatar_url ||
        '/logo.png';

      const plan =
        user.plan ||
        user.subscription ||
        (
          user.premium
            ? 'Premium'
            : 'Free'
        );

      const welcome =
        document.getElementById(
          'welcome-title'
        );

      if (welcome) {

        welcome.textContent =
          `Bonjour ${username} 👋`;

      }

      const name =
        document.getElementById(
          'sidebar-user-name'
        );

      if (name) {

        name.textContent =
          username;

      }

      const planElement =
        document.getElementById(
          'sidebar-user-plan'
        );

      if (planElement) {

        planElement.textContent =
          plan;

      }

      const avatarElement =
        document.getElementById(
          'sidebar-user-avatar'
        );

      if (avatarElement) {

        avatarElement.src =
          avatar;

        avatarElement.onerror =
          () => {

            avatarElement.src =
              '/logo.png';

          };

      }

    }


    /* =====================================================
       API
    ===================================================== */

    async function apiRequest(
      url,
      options = {}
    ) {

      const controller =
        new AbortController();

      const timeout =
        setTimeout(
          () =>
            controller.abort(),
          options.timeout || 10000
        );

      try {

        const response =
          await fetch(
            url,
            {
              ...options,

              credentials:
                'include',

              cache:
                'no-store',

              signal:
                controller.signal,

              headers: {

                Accept:
                  'application/json',

                ...(options.body
                  ? {
                      'Content-Type':
                        'application/json'
                    }
                  : {}),

                ...(options.headers || {})

              }

            }
          );

        if (
          response.status === 401
        ) {

          try {
            localStorage.removeItem(
              'omnix_token'
            );
          } catch {}

          window.location.href =
            '/api/auth/login';

          throw new Error(
            'Session expirée'
          );

        }

        const contentType =
          response.headers.get(
            'content-type'
          ) || '';

        let data = null;

        if (
          contentType.includes(
            'application/json'
          )
        ) {

          data =
            await response.json();

        }

        if (!response.ok) {

          throw new Error(
            data?.error ||
            data?.message ||
            `HTTP ${response.status}`
          );

        }

        return data;

      } finally {

        clearTimeout(
          timeout
        );

      }

    }


    /* =====================================================
       STATS ANIMATION
    ===================================================== */

    function animateNumber(
      element,
      target,
      duration = 650,
      suffix = ''
    ) {

      if (!element) {
        return;
      }

      const numericTarget =
        Number(target);

      if (
        !Number.isFinite(
          numericTarget
        )
      ) {

        element.textContent =
          '—';

        return;

      }

      const start =
        Number(
          element.dataset.value || 0
        );

      const startTime =
        performance.now();

      function frame(
        currentTime
      ) {

        const progress =
          Math.min(
            (
              currentTime -
              startTime
            ) / duration,
            1
          );

        const eased =
          1 -
          Math.pow(
            1 - progress,
            3
          );

        const value =
          Math.round(
            start +
            (
              numericTarget -
              start
            ) *
            eased
          );

        element.textContent =
          `${formatNumber(value)}${suffix}`;

        if (
          progress < 1
        ) {

          requestAnimationFrame(
            frame
          );

        } else {

          element.dataset.value =
            numericTarget;

        }

      }

      requestAnimationFrame(
        frame
      );

    }


    function updateStat(
      id,
      value,
      suffix = ''
    ) {

      const element =
        document.getElementById(
          id
        );

      if (!element) {
        return;
      }

      if (
        value === null ||
        value === undefined
      ) {

        element.textContent =
          '—';

        return;

      }

      animateNumber(
        element,
        value,
        650,
        suffix
      );

    }


    /* =====================================================
       CONNECTION
    ===================================================== */

    function updateConnectionStatus(
      online
    ) {

      const status =
        document.querySelector(
          '.status-pill'
        );

      if (!status) {
        return;
      }

      if (online) {

        status.innerHTML = `
          <span class="status-dot"></span>
          Tous les systèmes opérationnels
        `;

        status.style.color =
          '#6ee7b7';

      } else {

        status.innerHTML = `
          <span
            class="status-dot"
            style="
              background:#f59e0b;
              box-shadow:0 0 10px rgba(245,158,11,.8);
            "
          ></span>
          Connexion instable
        `;

        status.style.color =
          '#fbbf24';

      }

    }

  </script>
  
  <script>

  /* =====================================================
     GUILD NORMALIZER
  ===================================================== */

  function normalizeGuild(guild) {

    if (!guild) {
      return null;
    }

    const id =
      guild.id ||
      guild.guildId ||
      guild._id;

    if (!id) {
      return null;
    }

    const name =
      guild.name ||
      guild.guildName ||
      'Serveur Discord';

    let icon =
      guild.icon ||
      guild.iconURL ||
      guild.iconUrl ||
      null;

    if (
      !icon &&
      guild.iconHash
    ) {

      icon =
        `https://cdn.discordapp.com/icons/${id}/${guild.iconHash}.png?size=128`;

    }

    if (!icon) {
      icon = '/logo.png';
    }

    const memberCount =
      guild.memberCount ??
      guild.members ??
      guild.approximateMemberCount ??
      0;

    return {

      ...guild,

      id: String(id),

      name: String(name),

      icon,

      memberCount:
        Number(memberCount) || 0,

      botPresent:
        guild.botPresent ??
        guild.bot ??
        true,

      manageable:
        guild.manageable ??
        guild.canManage ??
        true

    };

  }


  /* =====================================================
     SORT GUILDS
  ===================================================== */

  function sortGuilds(guilds) {

    return [...guilds].sort(
      (a, b) => {

        if (
          Boolean(a.manageable) !==
          Boolean(b.manageable)
        ) {

          return a.manageable
            ? -1
            : 1;

        }

        if (
          Number(a.memberCount) !==
          Number(b.memberCount)
        ) {

          return (
            Number(b.memberCount) -
            Number(a.memberCount)
          );

        }

        return String(a.name)
          .localeCompare(
            String(b.name),
            'fr'
          );

      }
    );

  }


  /* =====================================================
     FILTER GUILDS
  ===================================================== */

  function filterGuilds(search) {

    const query =
      String(search || '')
        .trim()
        .toLowerCase();

    if (!query) {

      return [
        ...OMNIX.guilds
      ];

    }

    return OMNIX.guilds.filter(
      guild => {

        const name =
          String(
            guild.name || ''
          ).toLowerCase();

        const id =
          String(
            guild.id || ''
          );

        return (
          name.includes(query) ||
          id.includes(query)
        );

      }
    );

  }


  /* =====================================================
     CREATE SERVER CARD
  ===================================================== */

  function createServerCard(guild) {

    const card =
      document.createElement(
        'div'
      );

    card.className =
      'server-card';

    card.dataset.guildId =
      guild.id;

    const manageable =
      guild.manageable !== false;

    const members =
      Number(
        guild.memberCount || 0
      );

    const icon =
      guild.icon ||
      '/logo.png';

    const name =
      guild.name ||
      'Serveur Discord';

    card.innerHTML = `

      <img
        class="server-icon"
        src="${escapeAttribute(icon)}"
        alt=""
        loading="lazy"
      >

      <div class="server-details">

        <span
          class="server-name"
          title="${escapeAttribute(name)}"
        >
          ${escapeHTML(name)}
        </span>

        <span class="server-meta">

          ${formatNumber(members)}
          membre${members > 1 ? 's' : ''}

          ${
            manageable
              ? ''
              : ' • accès limité'
          }

        </span>

      </div>

      <span
        class="server-status"
        ${
          manageable
            ? ''
            : `
              style="
                background:#f59e0b;
                box-shadow:
                  0 0 8px
                  rgba(245,158,11,.7);
              "
            `
        }
      ></span>

    `;

    card.addEventListener(
      'click',
      () => {

        selectGuild(
          guild.id
        );

      }
    );

    const image =
      card.querySelector(
        '.server-icon'
      );

    image?.addEventListener(
      'error',
      () => {

        image.src =
          '/logo.png';

      },
      {
        once: true
      }
    );

    return card;

  }


  /* =====================================================
     RENDER GUILDS
  ===================================================== */

  function renderGuilds(guilds) {

    const container =
      document.getElementById(
        'servers-container'
      );

    if (!container) {
      return;
    }

    container.innerHTML =
      '';

    if (
      !guilds ||
      !guilds.length
    ) {

      container.innerHTML = `

        <div
          class="empty-state"
          style="grid-column:1/-1;"
        >

          <div class="empty-icon">
            🌐
          </div>

          <strong>
            Aucun serveur trouvé
          </strong>

          <p>
            Aucun serveur Discord ne
            correspond à votre recherche.
          </p>

        </div>

      `;

      return;

    }

    const sorted =
      sortGuilds(
        guilds
      );

    sorted.forEach(
      guild => {

        const card =
          createServerCard(
            guild
          );

        if (
          OMNIX.selectedGuild &&
          String(
            OMNIX.selectedGuild.id
          ) ===
          String(
            guild.id
          )
        ) {

          card.classList.add(
            'selected'
          );

        }

        container.appendChild(
          card
        );

      }
    );

  }


  /* =====================================================
     LOAD GUILDS
  ===================================================== */

  async function refreshGuilds() {

    const container =
      document.getElementById(
        'servers-container'
      );

    if (!container) {
      return;
    }

    try {

      container.innerHTML = `

        <div
          class="empty-state"
          style="grid-column:1/-1;"
        >

          <div class="empty-icon">
            ⏳
          </div>

          <strong>
            Chargement des serveurs...
          </strong>

          <p>
            Récupération de vos serveurs Discord.
          </p>

        </div>

      `;

      const data =
        await apiRequest(
          '/api/guilds'
        );

      let rawGuilds = [];

      if (
        Array.isArray(data)
      ) {

        rawGuilds =
          data;

      } else if (
        Array.isArray(
          data?.guilds
        )
      ) {

        rawGuilds =
          data.guilds;

      } else if (
        Array.isArray(
          data?.servers
        )
      ) {

        rawGuilds =
          data.servers;

      } else if (
        Array.isArray(
          data?.data
        )
      ) {

        rawGuilds =
          data.data;

      }

      const guilds =
        rawGuilds
          .map(
            normalizeGuild
          )
          .filter(
            Boolean
          );

      OMNIX.guilds =
        guilds;

      renderGuilds(
        guilds
      );

      restoreSelectedGuild();

      updateStat(
        'stat-servers',
        guilds.length
      );

    } catch (error) {

      console.error(
        '[OMNIX] Guilds:',
        error
      );

      container.innerHTML = `

        <div
          class="empty-state"
          style="grid-column:1/-1;"
        >

          <div class="empty-icon">
            ⚠️
          </div>

          <strong>
            Serveurs indisponibles
          </strong>

          <p>
            Impossible de récupérer
            vos serveurs Discord.
          </p>

          <button
            type="button"
            class="btn btn-primary"
            style="margin-top:15px;"
            onclick="refreshGuilds()"
          >
            Réessayer
          </button>

        </div>

      `;

      showToast(
        'Impossible de charger les serveurs.',
        'error'
      );

    }

  }


  /* =====================================================
     SELECT SERVER
  ===================================================== */

  function selectGuild(guildId) {

    const id =
      String(
        guildId || ''
      );

    if (!id) {
      return;
    }

    const guild =
      OMNIX.guilds.find(
        item =>
          String(item.id) === id
      );

    if (!guild) {

      showToast(
        'Serveur introuvable.',
        'error'
      );

      return;

    }

    OMNIX.selectedGuild =
      guild;

    try {

      localStorage.setItem(
        'omnix_selected_guild',
        id
      );

    } catch {}

    document
      .querySelectorAll(
        '.server-card'
      )
      .forEach(
        card => {

          card.classList.toggle(
            'selected',
            card.dataset.guildId === id
          );

        }
      );

    /*
     * Accès au dashboard du serveur.
     */

    openGuild(
      id
    );

  }


  /* =====================================================
     OPEN GUILD
  ===================================================== */

  function openGuild(guildId) {

    const id =
      String(
        guildId || ''
      );

    if (!id) {
      return;
    }

    try {

      localStorage.setItem(
        'omnix_selected_guild',
        id
      );

    } catch {}

    window.location.href =
      `/dashboard/${encodeURIComponent(id)}`;

  }


  /* =====================================================
     RESTORE SELECTED GUILD
  ===================================================== */

  function restoreSelectedGuild() {

    let savedGuild =
      null;

    try {

      savedGuild =
        localStorage.getItem(
          'omnix_selected_guild'
        );

    } catch {}

    if (!savedGuild) {
      return;
    }

    const guild =
      OMNIX.guilds.find(
        item =>
          String(item.id) ===
          String(savedGuild)
      );

    if (!guild) {
      return;
    }

    OMNIX.selectedGuild =
      guild;

    document
      .querySelectorAll(
        '.server-card'
      )
      .forEach(
        card => {

          card.classList.toggle(
            'selected',
            card.dataset.guildId ===
              String(savedGuild)
          );

        }
      );

  }


  /* =====================================================
     SEARCH
  ===================================================== */

  function initializeServerSearch() {

    const input =
      document.getElementById(
        'server-search'
      );

    if (!input) {
      return;
    }

    input.addEventListener(
      'input',
      event => {

        const results =
          filterGuilds(
            event.target.value
          );

        renderGuilds(
          results
        );

      }
    );

  }


  /* =====================================================
     LOAD DASHBOARD STATS
  ===================================================== */

  async function refreshDashboardStats() {

    try {

      const data =
        await apiRequest(
          '/api/stats'
        );

      OMNIX.stats =
        data;

      const bot =
        data?.bot || {};

      const database =
        data?.database || {};

      const servers =
        bot.guildsCount ??
        data?.guildsCount ??
        data?.guilds ??
        OMNIX.guilds.length;

      const members =
        database.totalUsers ??
        data?.totalUsers ??
        data?.members ??
        bot.membersCount;

      const commands =
        data?.commands ??
        data?.commandsCount ??
        data?.totalCommands;

      const ping =
        bot.ping ??
        data?.ping ??
        data?.latency;

      updateStat(
        'stat-servers',
        servers
      );

      updateStat(
        'stat-members',
        members
      );

      updateStat(
        'stat-commands',
        commands
      );

      updateStat(
        'stat-ping',
        ping,
        ' ms'
      );

      updateConnectionStatus(
        true
      );

    } catch (error) {

      console.error(
        '[OMNIX] Stats:',
        error
      );

      updateConnectionStatus(
        false
      );

    }

  }


  /* =====================================================
     ONLINE / OFFLINE
  ===================================================== */

  function initializeNetworkMonitor() {

    window.addEventListener(
      'online',
      () => {

        updateConnectionStatus(
          true
        );

        showToast(
          'Connexion Internet rétablie.',
          'success'
        );

        refreshDashboardStats();

        refreshGuilds();

      }
    );

    window.addEventListener(
      'offline',
      () => {

        updateConnectionStatus(
          false
        );

        showToast(
          'Connexion Internet perdue.',
          'error'
        );

      }
    );

  }


  /* =====================================================
     VISIBILITY
  ===================================================== */

  function initializeVisibilityRefresh() {

    document.addEventListener(
      'visibilitychange',
      () => {

        if (
          document.visibilityState ===
          'visible'
        ) {

          refreshDashboardStats();

        }

      }
    );

  }


  /* =====================================================
     AUTOMATIC REFRESH
  ===================================================== */

  let dashboardRefreshTimer =
    null;

  function startDashboardRefresh() {

    if (
      dashboardRefreshTimer
    ) {

      clearInterval(
        dashboardRefreshTimer
      );

    }

    dashboardRefreshTimer =
      setInterval(
        () => {

          if (
            document.visibilityState !==
            'visible'
          ) {

            return;

          }

          refreshDashboardStats();

        },
        30000
      );

  }


  /* =====================================================
     SOCKET.IO REALTIME
  ===================================================== */

  function initializeRealtime() {

    if (
      typeof window.io !==
      'function'
    ) {

      console.info(
        '[OMNIX] Socket.IO non chargé.'
      );

      return;

    }

    try {

      const socket =
        window.io(
          {
            transports: [
              'websocket',
              'polling'
            ],

            withCredentials:
              true
          }
        );

      OMNIX.socket =
        socket;

      socket.on(
        'connect',
        () => {

          console.log(
            '[OMNIX] Realtime connecté.'
          );

          updateConnectionStatus(
            true
          );

        }
      );

      socket.on(
        'disconnect',
        () => {

          console.warn(
            '[OMNIX] Realtime déconnecté.'
          );

          updateConnectionStatus(
            navigator.onLine
          );

        }
      );

      socket.on(
        'dashboard:update',
        payload => {

          if (
            payload?.stats
          ) {

            OMNIX.stats =
              payload.stats;

          }

          refreshDashboardStats();

        }
      );

      socket.on(
        'stats:update',
        () => {

          refreshDashboardStats();

        }
      );

      socket.on(
        'guild:update',
        () => {

          refreshGuilds();

        }
      );

    } catch (error) {

      console.warn(
        '[OMNIX] Socket.IO indisponible:',
        error
      );

    }

  }


  /* =====================================================
     KEYBOARD SHORTCUTS
  ===================================================== */

  function initializeKeyboard() {

    document.addEventListener(
      'keydown',
      event => {

        /*
         * ESC
         */

        if (
          event.key ===
          'Escape'
        ) {

          document
            .getElementById(
              'dashboard-sidebar'
            )
            ?.classList.remove(
              'open'
            );

        }

        /*
         * R = refresh
         */

        if (
          event.key.toLowerCase() ===
            'r' &&
          ![
            'INPUT',
            'TEXTAREA',
            'SELECT'
          ].includes(
            document.activeElement?.tagName
          )
        ) {

          event.preventDefault();

          refreshDashboardStats();

          refreshGuilds();

        }

      }
    );

  }


  /* =====================================================
     MOBILE SIDEBAR CLOSE
  ===================================================== */

  function initializeMobileSidebar() {

    document.addEventListener(
      'click',
      event => {

        const sidebar =
          document.getElementById(
            'dashboard-sidebar'
          );

        const menu =
          document.querySelector(
            '.mobile-menu'
          );

        if (
          window.innerWidth > 800
        ) {

          return;

        }

        if (
          !sidebar?.classList.contains(
            'open'
          )
        ) {

          return;

        }

        if (
          sidebar.contains(
            event.target
          )
        ) {

          return;

        }

        if (
          menu?.contains(
            event.target
          )
        ) {

          return;

        }

        sidebar.classList.remove(
          'open'
        );

      }
    );

  }


  /* =====================================================
     INITIALIZATION
  ===================================================== */

  async function initializeDashboard() {

    console.log(
      '[OMNIX] Initialisation du dashboard...'
    );

    /*
     * Session locale.
     */

    const session =
      initializeSession();

    if (session) {

      updateUserUI();

    }

    /*
     * Profil serveur.
     */

    await loadCurrentUser();

    /*
     * Interface.
     */

    initializeServerSearch();

    initializeNetworkMonitor();

    initializeVisibilityRefresh();

    initializeKeyboard();

    initializeMobileSidebar();

    /*
     * Données.
     */

    await Promise.allSettled([
      refreshDashboardStats(),
      refreshGuilds()
    ]);

    /*
     * Realtime.
     */

    initializeRealtime();

    /*
     * Refresh automatique.
     */

    startDashboardRefresh();

    console.log(
      '[OMNIX] Dashboard prêt.'
    );

  }


  /* =====================================================
     GLOBAL API
  ===================================================== */

  window.OMNIXDashboard = {

    refreshStats:
      refreshDashboardStats,

    refreshGuilds:
      refreshGuilds,

    selectGuild:
      selectGuild,

    openGuild:
      openGuild,

    toggleSidebar:
      toggleSidebar,

    state:
      OMNIX

  };


  /* =====================================================
     START
  ===================================================== */

  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      () => {

        initializeDashboard();

      },
      {
        once: true
      }
    );

  } else {

    initializeDashboard();

  }

</script>

</body>
</html>