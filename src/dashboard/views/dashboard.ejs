  <script>

    /* =====================================================
       OMNIX GLOBAL STATE
    ===================================================== */

    window.OMNIX =
      window.OMNIX || {

        user:
          null,

        guilds:
          [],

        selectedGuild:
          null,

        stats:
          null,

        socket:
          null

      };


    /* =====================================================
       HTML SECURITY HELPERS
    ===================================================== */

    function escapeHTML(value) {

      return String(
        value ?? ''
      )

        .replace(
          /&/g,
          '&amp;'
        )

        .replace(
          /</g,
          '&lt;'
        )

        .replace(
          />/g,
          '&gt;'
        )

        .replace(
          /"/g,
          '&quot;'
        )

        .replace(
          /'/g,
          '&#039;'
        );

    }


    function escapeAttribute(value) {

      return escapeHTML(
        value
      );

    }


    /* =====================================================
       NUMBER FORMAT
    ===================================================== */

    function formatNumber(value) {

      const number =
        Number(value);

      if (
        !Number.isFinite(number)
      ) {

        return '0';

      }

      return new Intl.NumberFormat(
        'fr-FR'
      ).format(
        number
      );

    }


    /* =====================================================
       TOAST
    ===================================================== */

    function showToast(
      message,
      type = 'success'
    ) {

      const container =
        document.getElementById(
          'toast-container'
        );

      if (!container) {
        return;
      }


      const toast =
        document.createElement(
          'div'
        );


      toast.className =
        `toast ${type}`;


      toast.textContent =
        String(message);


      container.appendChild(
        toast
      );


      setTimeout(
        () => {

          toast.style.opacity =
            '0';

          toast.style.transform =
            'translateY(8px)';


          setTimeout(
            () => {

              toast.remove();

            },
            220
          );

        },
        3200
      );

    }


    /* =====================================================
       SIDEBAR
    ===================================================== */

    function toggleSidebar() {

      if (typeof window.toggleOmnixSidebar === 'function') {
        window.toggleOmnixSidebar();
      }

    }


    /* =====================================================
       SESSION
       IMPORTANT:
       OMNIX utilise désormais la session serveur/cookie.
       Aucun JWT n'est lu depuis localStorage.
       Aucun token n'est accepté depuis l'URL.
    ===================================================== */

    function initializeSession() {

      /*
       * Le cookie httpOnly n'est volontairement
       * pas accessible depuis JavaScript.
       *
       * La session sera vérifiée par :
       *
       *     /api/auth/me
       *
       * avec :
       *
       *     credentials: 'include'
       */

      return null;

    }


    /* =====================================================
       LOAD CURRENT USER
    ===================================================== */

    async function loadCurrentUser() {

      try {

        const response =
          await fetch(
            '/api/auth/me',
            {
              method:
                'GET',

              credentials:
                'include',

              cache:
                'no-store',

              headers: {

                Accept:
                  'application/json'

              }

            }
          );


        if (
          response.status === 401
        ) {

          window.location.href =
            '/api/auth/login';

          return null;

        }


        if (!response.ok) {

          throw new Error(
            `HTTP ${response.status}`
          );

        }


        const data =
          await response.json();


        const user =
          data?.user ||
          data;


        if (!user) {

          throw new Error(
            'Utilisateur absent de la réponse.'
          );

        }


        OMNIX.user =
          {
            ...OMNIX.user,
            ...user
          };


        updateUserUI();


        return OMNIX.user;

      } catch (error) {

        console.error(
          '[OMNIX] Impossible de récupérer le profil:',
          error
        );

        return null;

      }

    }


    /* =====================================================
       USER UI
    ===================================================== */

    function updateUserUI() {

      const user =
        OMNIX.user || {};


      const username =
        user.globalName ||
        user.global_name ||
        user.username ||
        user.name ||
        'Utilisateur';


      const avatar =
        user.avatarURL ||
        user.avatarUrl ||
        user.avatar ||
        user.avatar_url ||
        '/logo.png';


      const plan =
        user.plan ||
        user.subscription ||
        (
          user.premium
            ? 'Premium'
            : 'Free'
        );


      const welcome =
        document.getElementById(
          'welcome-title'
        );


      if (welcome) {

        welcome.textContent =
          `Bonjour ${username} 👋`;

      }


      const name =
        document.getElementById(
          'sidebar-user-name'
        );


      if (name) {

        name.textContent =
          username;

      }


      const planElement =
        document.getElementById(
          'sidebar-user-plan'
        );


      if (planElement) {

        planElement.textContent =
          plan;

      }


      const avatarElement =
        document.getElementById(
          'sidebar-user-avatar'
        );


      if (avatarElement) {

        avatarElement.src =
          avatar;


        avatarElement.onerror =
          () => {

            avatarElement.onerror =
              null;

            avatarElement.src =
              '/logo.png';

          };

      }

    }


    /* =====================================================
       API REQUEST
    ===================================================== */

    async function apiRequest(
      url,
      options = {}
    ) {

      const controller =
        new AbortController();


      const timeout =
        setTimeout(
          () => {

            controller.abort();

          },
          options.timeout || 10000
        );


      try {

        const response =
          await fetch(
            url,
            {
              ...options,

              credentials:
                'include',

              cache:
                'no-store',

              signal:
                controller.signal,

              headers: {

                Accept:
                  'application/json',

                ...(options.body
                  ? {
                      'Content-Type':
                        'application/json'
                    }
                  : {}),

                ...(options.headers || {})

              }

            }
          );


        if (
          response.status === 401
        ) {

          window.location.href =
            '/api/auth/login';

          throw new Error(
            'Session expirée'
          );

        }


        const contentType =
          response.headers.get(
            'content-type'
          ) || '';


        let data =
          null;


        if (
          contentType.includes(
            'application/json'
          )
        ) {

          data =
            await response.json();

        }


        if (!response.ok) {

          throw new Error(
            data?.error ||
            data?.message ||
            `HTTP ${response.status}`
          );

        }


        return data;

      } finally {

        clearTimeout(
          timeout
        );

      }

    }


    /* =====================================================
       STATS ANIMATION
    ===================================================== */

    function animateNumber(
      element,
      target,
      duration = 650,
      suffix = ''
    ) {

      if (!element) {
        return;
      }


      const numericTarget =
        Number(target);


      if (
        !Number.isFinite(
          numericTarget
        )
      ) {

        element.textContent =
          '—';

        return;

      }


      const start =
        Number(
          element.dataset.value || 0
        );


      const startTime =
        performance.now();


      function frame(currentTime) {

        const progress =
          Math.min(
            (
              currentTime -
              startTime
            ) / duration,
            1
          );


        const eased =
          1 -
          Math.pow(
            1 - progress,
            3
          );


        const value =
          Math.round(
            start +
            (
              numericTarget -
              start
            ) *
            eased
          );


        element.textContent =
          `${formatNumber(value)}${suffix}`;


        if (
          progress < 1
        ) {

          requestAnimationFrame(
            frame
          );

        } else {

          element.dataset.value =
            numericTarget;

        }

      }


      requestAnimationFrame(
        frame
      );

    }


    function updateStat(
      id,
      value,
      suffix = ''
    ) {

      const element =
        document.getElementById(
          id
        );


      if (!element) {
        return;
      }


      if (
        value === null ||
        value === undefined
      ) {

        element.textContent =
          '—';

        return;

      }


      animateNumber(
        element,
        value,
        650,
        suffix
      );

    }


    /* =====================================================
       CONNECTION STATUS
    ===================================================== */

    function updateConnectionStatus(
      online
    ) {

      const status =
        document.getElementById(
          'system-status'
        );


      if (!status) {
        return;
      }


      if (online) {

        status.innerHTML = `

          <span
            class="status-dot"
          ></span>

          Tous les systèmes opérationnels

        `;


        status.style.color =
          '#6ee7b7';


        status.style.background =
          'rgba(16,185,129,.07)';


        status.style.borderColor =
          'rgba(16,185,129,.15)';

      } else {

        status.innerHTML = `

          <span
            class="status-dot"
            style="
              background:#f59e0b;
              box-shadow:
                0 0 10px
                rgba(245,158,11,.8);
            "
          ></span>

          Connexion instable

        `;


        status.style.color =
          '#fbbf24';


        status.style.background =
          'rgba(245,158,11,.07)';


        status.style.borderColor =
          'rgba(245,158,11,.15)';

      }

    }


    /* =====================================================
       EXPORT BASIC API
    ===================================================== */

    window.OMNIXDashboard =
      window.OMNIXDashboard || {

        toggleSidebar:
          toggleSidebar,

        showToast:
          showToast,

        refreshStats:
          null,

        refreshGuilds:
          null,

        selectGuild:
          null,

        openGuild:
          null,

        state:
          OMNIX

      };

  </script>
  
    <script>

    /* =====================================================
       GUILD HELPERS
    ===================================================== */

    function normalizeGuild(guild) {

      if (!guild || typeof guild !== 'object') {
        return null;
      }

      return {
        ...guild,

        id:
          guild.id ||
          guild.guildId ||
          guild.guild_id ||
          null,

        name:
          guild.name ||
          guild.guildName ||
          'Serveur sans nom',

        icon:
          guild.iconURL ||
          guild.iconUrl ||
          guild.icon_url ||
          guild.icon ||
          '/logo.png',

        memberCount:
          guild.memberCount ??
          guild.approximate_member_count ??
          guild.approximateMemberCount ??
          guild.members ??
          guild.membersCount ??
          0,

        botPresent:
          guild.botPresent === true ||
          guild.botInstalled === true ||
          guild.bot === true,

        premium: guild.premium === true,
        premiumTier: guild.premiumTier || null,
        premiumExpiresAt: guild.premiumExpiresAt || null
      };

    }


    function getGuildIcon(guild) {

      if (!guild) {
        return '/logo.png';
      }

      return (
        guild.iconURL ||
        guild.iconUrl ||
        guild.icon_url ||
        guild.icon ||
        '/logo.png'
      );

    }


    function getGuildId(guild) {

      if (!guild) {
        return null;
      }

      return (
        guild.id ||
        guild.guildId ||
        guild.guild_id ||
        null
      );

    }


    /* =====================================================
       SERVER FILTER
    ===================================================== */

    function getFilteredGuilds() {

      const input =
        document.getElementById(
          'server-search'
        );

      const search =
        input
          ? input.value.trim().toLowerCase()
          : '';

      if (!search) {

        return [
          ...OMNIX.guilds
        ];

      }

      return OMNIX.guilds.filter(
        guild => {

          const name =
            String(
              guild?.name || ''
            ).toLowerCase();

          const id =
            String(
              guild?.id || ''
            ).toLowerCase();

          return (
            name.includes(search) ||
            id.includes(search)
          );

        }
      );

    }


    /* =====================================================
       RENDER SERVERS
    ===================================================== */

    function renderGuilds() {
      const container = document.getElementById('servers-container');
      if (!container) return;
      const guilds = getFilteredGuilds().sort((a,b) => {
        const score = (g) => (g.botPresent ? 4 : 0) + (g.premium ? 2 : 0) + (g.owner ? 1 : 0);
        return score(b) - score(a) || String(a.name||'').localeCompare(String(b.name||''),'fr');
      });
      const count = document.getElementById('server-count');
      if (count) count.textContent = `${guilds.length} serveur${guilds.length > 1 ? 's' : ''}`;
      if (!guilds.length) {
        container.innerHTML = `<div class="omx-empty" style="grid-column:1/-1"><span>⌕</span><b>Aucun serveur trouvé</b><small>Aucun serveur ne correspond à votre recherche.</small></div>`;
        return;
      }
      container.innerHTML = guilds.map(guild => {
        const id = getGuildId(guild);
        const installed = guild.botPresent === true || guild.botInstalled === true;
        const name = escapeHTML(guild.name || 'Serveur Discord');
        const icon = escapeAttribute(getGuildIcon(guild));
        const members = formatNumber(guild.memberCount || 0);
        const invite = escapeAttribute(guild.inviteUrl || guild.botInvite || '');
        if (!installed) {
          return `<article class="omx-server-card is-locked" data-guild-id="${escapeAttribute(id || '')}">
            <div class="omx-server-icon-wrap"><img src="${icon}" alt="${name}" class="omx-server-icon" onerror="this.onerror=null;this.src='/logo.png'"><span class="omx-lock">🔒</span></div>
            <div class="omx-server-main"><b>${name}</b><small>${members} membres</small><span class="omx-server-state locked">OMNIX n'est pas installé</span></div>
            <div class="omx-server-action"><span>Verrouillé</span>${invite ? `<a href="${invite}" target="_blank" rel="noopener" class="omx-install-btn">Installer</a>` : '<button class="omx-install-btn" disabled>Installer</button>'}</div>
          </article>`;
        }
        const selected = OMNIX.selectedGuild && getGuildId(OMNIX.selectedGuild) === id;
        return `<article class="omx-server-card ${selected ? 'is-selected ' : ''}${guild.premium ? 'premium' : ''}" data-guild-id="${escapeAttribute(id)}" onclick="selectGuild('${escapeAttribute(id)}')">
          <div class="omx-server-icon-wrap"><img src="${icon}" alt="${name}" class="omx-server-icon" onerror="this.onerror=null;this.src='/logo.png'"><span class="omx-online-dot"></span></div>
          <div class="omx-server-main"><b>${name}<span class="omx-server-plan ${guild.premium ? 'premium' : 'free'}">${guild.premium ? '★ PREMIUM' : '○ FREE'}</span></b><small>${members} membres</small><span class="omx-server-state ${guild.premium ? 'premium' : 'online'}">● ${guild.premium ? 'OMNIX Premium actif' : 'OMNIX actif'}</span></div>
          <div class="omx-server-action"><span>Ouvrir</span><strong>→</strong></div>
        </article>`;
      }).join('');
    }

    /* =====================================================
       LOAD GUILDS
    ===================================================== */

    async function refreshGuilds() {

      const container =
        document.getElementById(
          'servers-container'
        );


      if (container) {

        container.innerHTML = `

          <div
            class="empty-state"
            style="grid-column:1/-1;"
          >

            <div class="empty-icon">
              ⏳
            </div>

            <strong>
              Chargement des serveurs...
            </strong>

            <p>
              Récupération de vos serveurs Discord.
            </p>

          </div>

        `;

      }


      try {

        /*
         * La route de récupération des serveurs
         * reste centralisée ici.
         *
         * Le backend doit retourner soit :
         *
         *     { guilds: [...] }
         *
         * soit directement :
         *
         *     [...]
         */

        const data =
          await apiRequest(
            '/api/guilds?refresh=1'
          );


        const guildList =
          Array.isArray(data)
            ? data
            : (
                data?.guilds ||
                data?.servers ||
                data?.data ||
                []
              );


        OMNIX.guilds =
          guildList
            .map(
              normalizeGuild
            )
            .filter(
              Boolean
            );


        renderGuilds();


        if (
          OMNIX.guilds.length === 0
        ) {

          showToast(
            'Aucun serveur Discord accessible.',
            'error'
          );

        }


        return OMNIX.guilds;

      } catch (error) {

        console.error(
          '[OMNIX] Erreur lors du chargement des serveurs:',
          error
        );


        if (container) {

          container.innerHTML = `

            <div
              class="empty-state"
              style="grid-column:1/-1;"
            >

              <div class="empty-icon">
                ⚠️
              </div>

              <strong>
                Impossible de charger les serveurs
              </strong>

              <p>
                Une erreur est survenue pendant la récupération
                de vos serveurs Discord.
              </p>

              <div
                style="
                  margin-top:14px;
                "
              >

                <button
                  type="button"
                  class="btn btn-secondary"
                  onclick="refreshGuilds()"
                >
                  ↻ Réessayer
                </button>

              </div>

            </div>

          `;

        }


        updateConnectionStatus(
          false
        );


        return [];

      }

    }


    function updateOverviewServerState() {
      const guild = OMNIX.selectedGuild;
      const plan = document.getElementById('overview-plan');
      const title = document.getElementById('overview-title');
      const description = document.getElementById('overview-description');
      if (!plan || !title || !description) return;
      if (!guild) {
        plan.className = 'omx-hero-plan free';
        plan.textContent = '◈ OMNIX FREE';
        title.textContent = 'Votre serveur Discord';
        description.textContent = 'Sélectionnez un serveur pour administrer Omnix depuis un seul endroit.';
        return;
      }
      const premium = guild.premium === true;
      plan.className = `omx-hero-plan ${premium ? 'premium' : 'free'}`;
      plan.textContent = premium ? '★ OMNIX PREMIUM' : '◈ OMNIX FREE';
      title.textContent = guild.name || 'Votre serveur Discord';
      description.textContent = premium
        ? 'Votre serveur est Premium. Les fonctionnalités et réglages Premium restent associés à ce serveur.'
        : 'Votre serveur est en formule Free. Passez-le en Premium depuis son espace de configuration quand vous le souhaitez.';
    }

    /* =====================================================
       SELECT GUILD
    ===================================================== */

    function selectGuild(
      guildId
    ) {

      if (!guildId) {
        return;
      }


      const guild =
        OMNIX.guilds.find(
          item =>
            String(
              getGuildId(item)
            ) === String(
              guildId
            )
        );


      if (!guild) {
        showToast('Serveur introuvable.', 'error');
        return;
      }
      if (guild.botPresent !== true && guild.botInstalled !== true) {
        showToast('Omnix n’est pas installé sur ce serveur. Installez le bot pour continuer.', 'error');
        return;
      }
      OMNIX.selectedGuild =
        guild;

      updateOverviewServerState();
      renderGuilds();


      openGuild(
        guild
      );

    }


    function configureSelectedModule(moduleName) {
      const guild = OMNIX.selectedGuild || OMNIX.guilds[0];
      if (!guild) {
        showToast('Sélectionnez d’abord un serveur Discord.', 'error');
        document.getElementById('space-servers')?.scrollIntoView();
        return;
      }
      if (guild.botPresent !== true && guild.botInstalled !== true) {
        showToast('Installez Omnix sur ce serveur avant de le configurer.', 'error');
        return;
      }
      openGuild(guild);
    }

    /* =====================================================
       OPEN GUILD
    ===================================================== */

    function openGuild(
      guild
    ) {

      if (!guild) return;
      if (guild.botPresent !== true && guild.botInstalled !== true) {
        showToast('Ce serveur est verrouillé : Omnix n’est pas installé.', 'error');
        return;
      }

      const guildId =
        getGuildId(
          guild
        );


      if (!guildId) {

        showToast(
          'Identifiant du serveur invalide.',
          'error'
        );

        return;

      }


      OMNIX.selectedGuild =
        guild;


      /*
       * Navigation vers la configuration
       * du serveur sélectionné.
       *
       * L'identifiant reste dans le chemin
       * et non dans un token d'authentification.
       */

      window.location.href =
        `/dashboard/${encodeURIComponent(
          guildId
        )}`;

    }


    /* =====================================================
       LOAD STATS
    ===================================================== */

    async function refreshStats() {

      try {

        const data =
          await apiRequest(
            '/api/stats'
          );


        OMNIX.stats =
          data;


        /*
         * Compatibilité avec plusieurs formes
         * de réponse backend déjà utilisées
         * par OMNIX.
         */

        const stats =
          data?.stats ||
          data?.data ||
          data ||
          {};


        const bot =
          stats?.bot ||
          {};


        const database =
          stats?.database ||
          {};


        const servers =
          stats?.servers ??
          stats?.guilds ??
          stats?.guildCount ??
          bot?.guildsCount ??
          0;


        const members = Number(Array.isArray(stats?.user?.guilds) ? stats.user.guilds.reduce((n,g)=>n+Number(g?.memberCount ?? g?.approximate_member_count ?? 0),0) : 0);


        const commands =
          stats?.commands ??
          stats?.commandsCount ??
          bot?.commandsCount ??
          0;


        const ping =
          stats?.ping ??
          stats?.latency ??
          bot?.ping ??
          bot?.latency ??
          null;


        updateStat(
          'stat-servers',
          servers
        );


        updateStat(
          'stat-members',
          members
        );


        updateStat(
          'stat-commands',
          commands
        );


        updateStat(
          'stat-ping',
          ping,
          ping !== null ? ' ms' : ''
        );

        updateStat('stat-ai', Number(stats?.user?.aiRequests ?? 0));
        const planEl = document.getElementById('stat-plan');
        if (planEl) planEl.textContent = String(stats?.user?.plan || (OMNIX.user?.isPremium ? 'Premium' : 'Free')).toUpperCase();
        updateOverviewServerState();


        updateConnectionStatus(
          true
        );


        return stats;

      } catch (error) {

        console.error(
          '[OMNIX] Erreur statistiques:',
          error
        );


        updateConnectionStatus(
          false
        );


        return null;

      }

    }


    /* =====================================================
       SEARCH EVENTS
    ===================================================== */

    function initializeServerSearch() {

      const input =
        document.getElementById(
          'server-search'
        );


      if (!input) {
        return;
      }


      input.addEventListener(
        'input',
        () => {

          renderGuilds();

        }
      );

    }


    /* =====================================================
       SOCKET.IO
    ===================================================== */

    function initializeSocket() {

      if (
        typeof io !== 'function'
      ) {

        console.warn(
          '[OMNIX] Socket.IO non disponible.'
        );

        return null;

      }


      try {

        const socket =
          io(
            {
              withCredentials:
                true,

              transports:
                [
                  'websocket',
                  'polling'
                ]
            }
          );


        OMNIX.socket =
          socket;


        socket.on(
          'connect',
          () => {

            console.info(
              '[OMNIX] Socket.IO connecté:',
              socket.id
            );


            updateConnectionStatus(
              true
            );

          }
        );


        socket.on(
          'disconnect',
          reason => {

            console.warn(
              '[OMNIX] Socket.IO déconnecté:',
              reason
            );


            updateConnectionStatus(
              false
            );

          }
        );


        socket.on(
          'connect_error',
          error => {

            console.error(
              '[OMNIX] Socket.IO erreur:',
              error
            );


            updateConnectionStatus(
              false
            );

          }
        );


        /*
         * Mise à jour des statistiques
         * envoyée par le serveur.
         */

        socket.on(
          'stats:update',
          payload => {

            if (!payload) {
              return;
            }


            OMNIX.stats =
              payload;


            const stats =
              payload?.stats ||
              payload?.data ||
              payload ||
              {};


            const bot =
              stats?.bot ||
              {};


            const database =
              stats?.database ||
              {};


            updateStat(
              'stat-servers',
              stats?.servers ??
              stats?.guilds ??
              bot?.guildsCount ??
              0
            );


            updateStat(
              'stat-members',
              stats?.members ??
              stats?.memberCount ??
              bot?.membersCount ??
              database?.totalMembers ??
              0
            );


            updateStat(
              'stat-commands',
              stats?.commands ??
              stats?.commandsCount ??
              bot?.commandsCount ??
              0
            );


            updateStat(
              'stat-ping',
              stats?.ping ??
              stats?.latency ??
              bot?.ping ??
              bot?.latency ??
              null,
              ' ms'
            );

          }
        );


        /*
         * Si le backend signale une modification
         * des serveurs, on recharge la liste.
         */

        socket.on(
          'guilds:update',
          () => {

            refreshGuilds();

          }
        );


        socket.on(
          'guild:update',
          () => {

            refreshGuilds();

          }
        );


        return socket;

      } catch (error) {

        console.error(
          "[OMNIX] Impossible d'initialiser Socket.IO:",
          error
        );


        return null;

      }

    }


    /* =====================================================
       REFRESH EVERYTHING
    ===================================================== */

    async function refreshDashboard() {

      await Promise.allSettled(
        [
          loadCurrentUser(),
          refreshStats(),
          refreshGuilds()
        ]
      );

    }


    /* =====================================================
       MON ESPACE HASH SECTIONS
    ===================================================== */
    function applySpaceHash(){
      const hash=String(window.location.hash||'').replace('#','');
      document.querySelectorAll('[data-space-section]').forEach(el=>el.style.display='none');
      if(hash==='activity'||hash==='statistics'||hash==='servers'){
        const target=hash==='activity'?'space-activity':hash==='statistics'?'space-statistics':null;
        if(target){document.getElementById(target)?.style.setProperty('display','block');}
        if(hash==='servers') document.getElementById('servers-container')?.scrollIntoView({behavior:'smooth',block:'start'});
        if(hash==='activity') void loadSpaceActivity();
        if(hash==='statistics') void loadSpaceStatistics();
      }
    }
    async function loadSpaceActivity(){
      const g=OMNIX.selectedGuild || OMNIX.guilds[0];
      if(!g){$('space-activity-server').innerHTML='<strong>Aucun serveur</strong>';return;}
      const id=getGuildId(g); const d=await apiRequest('/api/guilds/'+encodeURIComponent(id)+'/activity');
      $('space-activity-server').innerHTML='<strong>'+escapeHTML(g.name)+'</strong><p>'+formatNumber(g.memberCount||0)+' membres</p>';
      $('space-activity-list').innerHTML=(d.data||[]).map(x=>'<div class="card" style="margin:8px 0"><b>'+escapeHTML(x.type||'activité')+'</b><div class="stat-description">'+escapeHTML(x.userId||'')+' · '+new Date(x.createdAt).toLocaleString('fr-FR')+'</div><div style="margin-top:6px;white-space:pre-wrap">'+escapeHTML(JSON.stringify(x.metadata||{}))+'</div></div>').join('')||'<div class="empty-state">Aucune activité enregistrée.</div>';
    }
    async function loadSpaceStatistics(){
      const g=OMNIX.selectedGuild || OMNIX.guilds[0]; if(!g){$('space-stat-cards').innerHTML='<div class="empty-state">Aucun serveur.</div>';return;}
      const d=await apiRequest('/api/guilds/'+encodeURIComponent(getGuildId(g))+'/statistics'); const s=d.statistics||{};
      $('space-stat-cards').innerHTML=`<article class="stat-card"><div class="stat-label">Membres</div><div class="stat-value">${formatNumber(d.guild?.memberCount||g.memberCount||0)}</div></article><article class="stat-card"><div class="stat-label">Nouveaux membres</div><div class="stat-value">${formatNumber(s.joins)}</div></article><article class="stat-card"><div class="stat-label">Départs</div><div class="stat-value">${formatNumber(s.leaves)}</div></article><article class="stat-card"><div class="stat-label">Actifs</div><div class="stat-value">${formatNumber(s.active)}</div></article><article class="stat-card"><div class="stat-label">Requêtes IA</div><div class="stat-value">${formatNumber(s.aiRequests)}</div></article><article class="stat-card"><div class="stat-label">Commandes</div><div class="stat-value">${formatNumber(s.commands)}</div></article>`;
    }
    window.addEventListener('hashchange',applySpaceHash);
    
    /* =====================================================
       INITIALIZATION
    ===================================================== */

    async function initializeDashboard() {

      console.info(
        '[OMNIX] Initialisation du dashboard...'
      );


      initializeSession();


      initializeServerSearch();


      initializeSocket();


      /*
       * Les données sont chargées uniquement
       * après l'initialisation de la session.
       */

      const user =
        await loadCurrentUser();


      if (!user) {

        return;

      }


      await Promise.allSettled(
        [
          refreshStats(),
          refreshGuilds()
        ]
      );


      applySpaceHash();
      const lockedGuild = new URLSearchParams(window.location.search).get('lockedGuild');
      if (lockedGuild) {
        showToast('Ce serveur est verrouillé : installez Omnix pour accéder à sa configuration.', 'error');
        history.replaceState({}, '', '/dashboard');
      }
      console.info('[OMNIX] Dashboard initialisé.');

    }


    /* =====================================================
       GLOBAL API
    ===================================================== */

    window.OMNIXDashboard =
      {
        ...window.OMNIXDashboard,

        toggleSidebar:
          toggleSidebar,

        showToast:
          showToast,

        refreshStats:
          refreshStats,

        refreshGuilds:
          refreshGuilds,

        refreshDashboard:
          refreshDashboard,

        selectGuild:
          selectGuild,

        openGuild:
          openGuild,

        renderGuilds:
          renderGuilds,

        state:
          OMNIX

      };


    /* =====================================================
       DOM READY
    ===================================================== */

    if (
      document.readyState ===
      'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        initializeDashboard,
        {
          once:
            true
        }
      );

    } else {

      initializeDashboard();

    }


    /* =====================================================
       WINDOW EVENTS
    ===================================================== */

    window.addEventListener(
      'resize',
      () => {

        if (
          window.innerWidth > 800
        ) {

          const sidebar =
            document.getElementById(
              'dashboard-sidebar'
            );


          if (sidebar) {

            sidebar.classList.remove(
              'open'
            );

          }

        }

      }
    );


    /* =====================================================
       ESCAPE — CLOSE MOBILE SIDEBAR
    ===================================================== */

    document.addEventListener(
      'keydown',
      event => {

        if (
          event.key !== 'Escape'
        ) {

          return;

        }


        const sidebar =
          document.getElementById(
            'dashboard-sidebar'
          );


        if (sidebar) {

          sidebar.classList.remove(
            'open'
          );

        }

      }
    );

  </script>



<div id="dashboard-preferences" class="prefs-backdrop" role="dialog" aria-modal="true" aria-labelledby="prefs-title">
  <div class="prefs-panel">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px"><div><h2 id="prefs-title" style="font-size:18px;margin:0">Personnaliser OMNIX</h2><p style="color:#7f8ba3;font-size:11px;margin-top:5px">Ces réglages sont propres à votre compte.</p></div><button class="prefs-btn cancel" onclick="closeDashboardPreferences()">✕</button></div>
    <div class="prefs-grid">
      <label class="pref-row"><span>Mode compact<small>Réduit l’espace des fiches</small></span><input id="pref-compact" type="checkbox"></label>
      <label class="pref-row"><span>Animations<small>Transitions et mouvements</small></span><input id="pref-animations" type="checkbox" checked></label>
      <label class="pref-row"><span>Statistiques<small>Afficher les indicateurs</small></span><input id="pref-stats" type="checkbox" checked></label>
      <label class="pref-row"><span>Serveurs<small>Afficher la liste des serveurs</small></span><input id="pref-servers" type="checkbox" checked></label>
      <label class="pref-row"><span>Activité<small>Afficher l’activité récente</small></span><input id="pref-activity" type="checkbox" checked></label>
      <label class="pref-row"><span>Analyses<small>Afficher les statistiques détaillées</small></span><input id="pref-statistics" type="checkbox" checked></label>
      <label class="pref-row"><span>Densité compacte<small>Interface plus serrée</small></span><input id="pref-density" type="checkbox"></label>
      <label class="pref-row"><span>Barre latérale réduite<small>Réglage mémorisé par compte</small></span><input id="pref-sidebar" type="checkbox"></label>
    </div>
    <div class="prefs-actions"><button class="prefs-btn cancel" onclick="closeDashboardPreferences()">Annuler</button><button class="prefs-btn save" onclick="saveDashboardPreferences()">Enregistrer</button></div>
  </div>
</div>
<div id="omnix-toast" class="omnix-toast"></div>


<script>
(function(){
  const $=id=>document.getElementById(id);
  function applyPrefs(p={}){
    document.body.classList.toggle('omnix-compact',!!p.compactMode||p.density==='compact');
    document.body.classList.toggle('omnix-no-animations',p.animations===false);
    document.body.classList.toggle('omnix-sidebar-compact',!!p.sidebarCollapsed);
    const map={stats:'stats-grid',servers:'space-servers',activity:'space-activity',statistics:'space-statistics'};
    Object.entries(map).forEach(([key,id])=>{const el=$(id);if(el)el.style.display=p[key==='stats'?'showStats':key==='servers'?'showServers':key==='activity'?'showActivity':'showStatistics']===false?'none':'';});
  }
  function toast(message,ok){const t=$('omnix-toast');if(!t)return;t.textContent=(ok?'✓ ':'✕ ')+message;t.className='omnix-toast '+(ok?'success':'error')+' show';clearTimeout(window.__omnixToast);window.__omnixToast=setTimeout(()=>t.classList.remove('show'),3200)}
  window.openDashboardPreferences=async function(){
    $('dashboard-preferences').classList.add('open');
    try{const r=await fetch('/api/dashboard/preferences',{credentials:'same-origin',cache:'no-store'});const d=await r.json();const p=d.preferences||{}; $('pref-compact').checked=!!p.compactMode;$('pref-animations').checked=p.animations!==false;$('pref-stats').checked=p.showStats!==false;$('pref-servers').checked=p.showServers!==false;$('pref-activity').checked=p.showActivity!==false;$('pref-statistics').checked=p.showStatistics!==false;$('pref-density').checked=p.density==='compact';$('pref-sidebar').checked=!!p.sidebarCollapsed;}catch{toast('Impossible de charger vos préférences',false)}
  };
  window.closeDashboardPreferences=()=> $('dashboard-preferences').classList.remove('open');
  window.saveDashboardPreferences=async function(){
    const p={compactMode:$('pref-compact').checked,animations:$('pref-animations').checked,showStats:$('pref-stats').checked,showServers:$('pref-servers').checked,showActivity:$('pref-activity').checked,showStatistics:$('pref-statistics').checked,density:$('pref-density').checked?'compact':'comfortable',sidebarCollapsed:$('pref-sidebar').checked};
    try{const r=await fetch('/api/dashboard/preferences',{method:'PATCH',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});if(!r.ok)throw new Error();applyPrefs(p);closeDashboardPreferences();toast('Préférences enregistrées',true);}catch{toast('Échec de l’enregistrement',false)}
  };
  fetch('/api/dashboard/preferences',{credentials:'same-origin',cache:'no-store'}).then(r=>r.json()).then(d=>applyPrefs(d.preferences||{})).catch(()=>{});
})();

    /* =====================================================
       RESYNCHRONISATION APRÈS RÉVEIL / RETOUR DE VEILLE
       Le backend force alors une lecture Discord via refresh=1.
       Aucune modification visuelle du Dashboard principal.
    ===================================================== */
    let lastGuildRefreshAt = 0;
    async function refreshGuildsAfterWake(reason) {
      const now = Date.now();
      if (now - lastGuildRefreshAt < 15000) return;
      lastGuildRefreshAt = now;
      try {
        console.log('[OMNIX] Resynchronisation des serveurs après réveil :', reason);
        await refreshGuilds();
      } catch (error) {
        console.warn('[OMNIX] Resynchronisation après réveil impossible :', error);
      }
    }
    window.addEventListener('pageshow', () => refreshGuildsAfterWake('pageshow'));
    window.addEventListener('focus', () => refreshGuildsAfterWake('focus'));
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refreshGuildsAfterWake('visibilitychange');
    });
</script>

