<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OMNIX — Mon espace</title><link rel="stylesheet" href="/css/omnix-web.css"><style>body{margin:0;background:#07070c;color:#f8f7ff;font-family:Inter,system-ui,sans-serif}.shell{min-height:100vh;padding:56px 24px 90px}.wrap{max-width:1080px;margin:auto}.hero,.card{background:linear-gradient(145deg,rgba(18,16,31,.92),rgba(8,8,15,.92));border:1px solid rgba(255,255,255,.07);border-radius:20px;box-shadow:0 24px 70px rgba(0,0,0,.2)}.hero{padding:28px}.kicker{color:#a78bfa;font-size:10px;font-weight:900;letter-spacing:1.5px}.hero h1{margin:9px 0;font-size:32px}.muted{color:#9ba4b7;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}.card{padding:20px}.card h2{margin:0 0 12px;font-size:16px}.kv{display:flex;justify-content:space-between;gap:15px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:11px}.kv span:first-child{color:#737b90}.kv span:last-child{text-align:right;color:#e9e6f5}.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{padding:8px 10px;border-radius:10px;background:rgba(124,92,255,.10);border:1px solid rgba(124,92,255,.18);font-size:10px}.btn{display:inline-flex;padding:11px 14px;border-radius:11px;background:linear-gradient(135deg,#7c5cff,#5b4bdc);color:#fff;text-decoration:none;font-size:10px;font-weight:850;border:0}.danger{background:rgba(239,68,68,.10);border:1px solid rgba(239,68,68,.2)}.event{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.06)}.event b{font-size:10px}.event small{display:block;color:#667085;margin-top:4px}@media(max-width:760px){.grid{grid-template-columns:1fr}.hero h1{font-size:26px}}.omnix-sidebar-open .shell{margin-right:min(340px,92vw)}@media(max-width:850px){.omnix-sidebar-open .shell{margin-right:0}}</style></head><body><main class="shell"><div class="wrap"><section class="hero"><span class="kicker">OMNIX · <%= page==='profile'?'PROFIL':page==='servers'?'MES SERVEURS':page==='activity'?'ACTIVITÉ':'STATISTIQUES' %></span><h1><%= page==='profile'?'Mon profil':page==='servers'?'Mes serveurs':page==='activity'?'Mon activité':'Mes statistiques' %></h1><p class="muted">Votre espace personnel OMNIX, synchronisé avec les données réellement enregistrées sur votre compte.</p></section><div id="content" class="grid"></div></div></main><%- include('partials/sidebar') %><script>const page=<%- JSON.stringify(page||'profile') %>;const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));const date=v=>v?new Date(v).toLocaleString('fr-FR',{dateStyle:'medium',timeStyle:'short'}):'—';async function get(u){const r=await fetch(u,{credentials:'same-origin',cache:'no-store'});const d=await r.json();if(!r.ok)throw new Error(d.error||'Erreur');return d}function card(t,b){return `<section class="card"><h2>${t}</h2>${b}</section>`}async function load(){try{if(page==='profile'){const d=await get('/api/me/overview'),u=d.user||{},p=d.premium||{};const servers=(d.servers||[]).map(g=>`<span class="chip">${esc(g.name)} · ${g.owner?'Owner Discord':'Accès/Admin'}</span>`).join('')||'<span class="muted">Aucun serveur enregistré.</span>';document.getElementById('content').innerHTML=card('Compte',`<div class="kv"><span>Nom</span><span>${esc(u.globalName||u.username)}</span></div><div class="kv"><span>Discord ID</span><span>${esc(u.discordId)}</span></div><div class="kv"><span>Email</span><span>${esc(u.email||'Non renseigné')}</span></div><div class="kv"><span>Membre depuis</span><span>${date(u.createdAt)}</span></div><div class="kv"><span>Dernière connexion</span><span>${date(u.lastLogin)}</span></div>`)+card('Premium',`<div class="kv"><span>Statut</span><span>${p.active?'Premium actif':'Aucun Premium actif'}</span></div><div class="kv"><span>Premium depuis</span><span>${date(p.since)}</span></div><div class="kv"><span>Expiration</span><span>${p.expiresAt?date(p.expiresAt):p.active?'Sans expiration':'—'}</span></div><div class="kv"><span>Serveurs Premium</span><span>${p.usedServers||0} / ${p.serverLimit||10}</span></div>`)+card('Serveurs accessibles',`<div class="chips">${servers}</div>`)+card('Modifier ou supprimer mes informations',`<p class="muted">Pour modifier ou demander la suppression d’une information personnelle, ouvre un ticket sur le Discord officiel OMNIX. L’équipe pourra vérifier la demande avant toute modification.</p><a class="btn" target="_blank" rel="noopener noreferrer" href="https://discord.gg/rmes9YdgG9">Ouvrir le Discord OMNIX</a>`)}else if(page==='servers'){const d=await get('/api/me/overview');document.getElementById('content').innerHTML=card('Serveurs réellement associés au compte',`<div class="chips">${(d.servers||[]).map(g=>`<span class="chip">${esc(g.name)} · ${g.owner?'Propriétaire':'Administrateur/Accès'}</span>`).join('')||'<span class="muted">Aucun serveur.</span>'}</div>`)}else if(page==='activity'){const d=await get('/api/me/activity');document.getElementById('content').innerHTML=card('Historique récent',(d.data||[]).map(e=>`<div class="event"><b>${esc(e.type)}</b><small>${date(e.createdAt)}${e.guildId?' · serveur '+esc(e.guildId):''}</small></div>`).join('')||'<p class="muted">Aucune activité enregistrée.</p>')}else{const d=await get('/api/me/statistics'),s=d.statistics||{};document.getElementById('content').innerHTML=card('Statistiques du membre',`<div class="kv"><span>Serveurs</span><span>${s.servers||0}</span></div><div class="kv"><span>Événements</span><span>${s.events||0}</span></div><div class="kv"><span>Tickets créés</span><span>${s.tickets||0}</span></div><div class="kv"><span>Requêtes IA</span><span>${s.aiRequests||0}</span></div><div class="kv"><span>Membre depuis</span><span>${date(s.memberSince)}</span></div>`)} }catch(e){document.getElementById('content').innerHTML=card('Espace indisponible',`<p class="muted">${esc(e.message)}</p>`)}}load();</script></body></html>